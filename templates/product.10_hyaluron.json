            "custom_liquid": "<section class=\"lt-gutzuwissen section\">\n  <div class=\"lt-gutzuwissen__inner\">\n    <div class=\"lt-gutzuwissen__header\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0621/2173/8340/files/capsule-svgrepo-com_3.svg?v=1758190422\" \n        alt=\"Kapsel Icon\" \n        width=\"18\" height=\"18\" \n        style=\"margin-right:6px;\">\n      <span class=\"lt-gutzuwissen__title\">Dosierung & Inhalt</span>\n    </div>\n\n    <div class=\"lt-gutzuwissen__tags\">\n      <span class=\"lt-tag-pill\">60 Kapseln</span>\n      <span class=\"lt-tag-pill\">2 Kapseln täglich</span>\n      <span class=\"lt-tag-pill\">600 mg pro Portion</span>\n    </div>\n  </div>\n</section>\n\n<style>\n  .lt-gutzuwissen {\n    margin: -0.5rem 0 1rem;   \n    border-radius: 10px;\n    padding: 12px 16px;   /* mehr Luft oben/unten + seitlich */\n    background: #FAFAFA;      \n  }\n\n  .lt-gutzuwissen__title {\n    font-size: 1rem;\n    font-weight: 600;\n  }\n\n  .lt-gutzuwissen__header {\n    display: flex;\n    align-items: center;\n    margin-bottom: .5rem;\n  }\n\n  .lt-gutzuwissen__tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: .5rem; /* gleicher Abstand horizontal & vertikal */\n  }\n\n  .lt-tag-pill {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: .28rem .55rem;\n    font-size: .8rem;\n    line-height: 1;\n    border: 1px solid #dcdfe3;\n    border-radius: 9999px;\n    background: #fff;\n    color: #666;\n    text-decoration: none;\n    transition: border-color .15s ease, background-color .15s ease;\n    white-space: nowrap;\n  }\n\n  .lt-tag-pill:hover {\n    border-color: #9ca3af;\n    background: #f9fafb;\n  }\n</style>"
