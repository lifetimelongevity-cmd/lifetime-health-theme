    "f66fcf17-bb28-4561-8b47-855842b66b2f": {
      "type": "content-toggles",
      "blocks": {
        "2bc8cf89-27d4-416b-a00a-753aba5bb68a": {
          "type": "text",
          "settings": {
            "title": "Wie wirkt Melatonin?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Melatonin ist ein körpereigenes Hormon. Sobald es dunkel wird, steigt der Melatoninspiegel an und signalisiert dem Körper, dass es Zeit zum Schlafen ist.</p><p>Melatonin trägt dazu bei, die Einschlafzeit zu verkürzen. Die positive Wirkung stellt sich ein, wenn 1 mg Melatonin kurz vor dem Schlafengehen verzehrt wird.</p>",
            "hide_block_if": false
          }
        },
        "template--16165087445092__f66fcf17-bb28-4561-8b47-855842b66b2f-text-1": {
          "type": "text",
          "settings": {
            "title": "Wann und wie sollte ich das Spray einnehmen?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Sprühe <strong>2 Sprühstöße</strong> etwa <strong>20 Minuten vor dem Schlafengehen</strong> direkt in den Mund. Nicht mit Wasser nachspülen, damit die Aufnahme über die Mundschleimhaut optimal funktioniert.</p>",
            "hide_block_if": false
          }
        },
        "template--16165087445092__f66fcf17-bb28-4561-8b47-855842b66b2f-text-2": {
          "type": "text",
          "settings": {
            "title": "Ist das Spray für die langfristige Anwendung geeignet?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Halte dich an die Verzehrempfehlung auf dem Etikett: täglich 2 Sprühstöße (1 mg Melatonin) etwa 20 Minuten vor dem Schlafengehen. Nicht geeignet für Schwangere, Stillende und Kinder. Bei Fragen zur Anwendung sprich mit deiner Ärztin oder deinem Arzt.</p>",
            "hide_block_if": false
          }
        },
        "text_eaKLir": {
          "type": "text",
          "settings": {
            "title": "Kann ich das Spray auch nur gelegentlich verwenden?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Ja, du kannst es flexibel einsetzen – ob täglich oder nur bei Bedarf, z. B. bei Jetlag, unruhigen Nächten oder wechselnden Schlafzeiten.</p>",
            "hide_block_if": false
          }
        },
        "text_byhqec": {
          "type": "text",
          "settings": {
            "title": "Wie schnell wirkt das Melatonin Sleep Spray?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Durch die Aufnahme über die Mundschleimhaut setzt die Wirkung meist <strong>innerhalb von 15-30 Minuten</strong> ein.</p>",
            "hide_block_if": false
          }
        },
        "text_XGDYpX": {
          "type": "text",
          "settings": {
            "title": "Ist das Spray vegan und frei von Zusatzstoffen?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Ja, das Spray enthält nur <strong>pflanzliches Glycerin, Wasser und Melatonin</strong>. Es ist <strong>vegan, zuckerfrei und ohne künstliche Zusatzstoffe</strong>.</p>",
            "hide_block_if": false
          }
        },
        "text_9r99XP": {
          "type": "text",
          "settings": {
            "title": "Gibt es Nebenwirkungen?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Bei Einhaltung der empfohlenen Dosierung sind keine Nebenwirkungen zu erwarten. Zu hohe Mengen können jedoch Schläfrigkeit am Morgen verursachen.</p>",
            "hide_block_if": false
          }
        },
        "text_CTGRAe": {
          "type": "text",
          "settings": {
            "title": "Kann ich Melatonin auch bei Jetlag nutzen?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Ja, Melatonin kann helfen, den Schlafrhythmus nach Reisen mit Zeitverschiebung schneller anzupassen.</p>",
            "hide_block_if": false
          }
        },
        "text_H9Uf4N": {
          "type": "text",
          "settings": {
            "title": "Wie lange reicht eine Flasche?",
            "subtitle": "",
            "icon": "no-icon",
            "button_label": "",
            "button_link": "",
            "body": "<p>Eine Flasche enthält 30 ml (75 Portionen) und reicht bei täglicher Einnahme für bis zu 75 Nächte.</p>",
            "hide_block_if": false
          }
        }
      },
