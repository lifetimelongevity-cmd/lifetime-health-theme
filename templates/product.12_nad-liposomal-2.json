    "faq_accordion": {
      "type": "crs-faq-accordion",
      "blocks": {
        "faq_was": {
          "type": "item",
          "settings": {
            "question": "Was ist NAD⁺?",
            "answer": "NAD⁺ steht für Nicotinamidadenindinukleotid. Es ist ein Coenzym, das in jeder Körperzelle vorkommt und an der Energiegewinnung aus der Nahrung beteiligt ist."
          }
        },
        "faq_vorstufe": {
          "type": "item",
          "settings": {
            "question": "Ist das NAD⁺ oder eine Vorstufe?",
            "answer": "NAD⁺ selbst. Viele Produkte mit „NAD“ im Namen enthalten nur eine Vorstufe, aus der der Körper NAD⁺ erst bilden muss. In unserer Kapsel steckt das Coenzym direkt, 250 mg je Kapsel."
          }
        },
        "faq_liposomal": {
          "type": "item",
          "settings": {
            "question": "Was heißt liposomal?",
            "answer": "Das NAD⁺ ist in Phospholipide aus Sonnenblumenlecithin eingebettet. Diese Hülle aus Fettbausteinen nennt man Liposom. Phospholipide sind auch der Grundstoff jeder Zellmembran."
          }
        },
        "faq_einnahme": {
          "type": "item",
          "settings": {
            "question": "Wie nehme ich die Kapseln ein?",
            "answer": "Täglich eine Portion aus 2 Kapseln zu einer Mahlzeit. Die angegebene empfohlene tägliche Verzehrmenge darf nicht überschritten werden."
          }
        },
        "faq_gehalt": {
          "type": "item",
          "settings": {
            "question": "Wie viel NAD⁺ steckt in einer Portion?",
            "answer": "500 mg pro Tagesportion aus 2 Kapseln, also 250 mg je Kapsel."
          }
        },
        "faq_vegan": {
          "type": "item",
          "settings": {
            "question": "Sind die Kapseln vegan?",
            "answer": "Ja. Die Kapselhülle besteht aus Hydroxypropylmethylcellulose, einem pflanzlichen Stoff, die Phospholipide stammen aus Sonnenblumen. Tierische Bestandteile sind nicht enthalten."
          }
        },
        "faq_reichweite": {
          "type": "item",
          "settings": {
            "question": "Wie lange reicht eine Dose?",
            "answer": "Eine Dose enthält 60 Kapseln. Bei 2 Kapseln täglich reicht sie 30 Tage."
          }
        },
        "faq_lagerung": {
          "type": "item",
          "settings": {
            "question": "Wie lagere ich die Kapseln?",
            "answer": "Kühl, trocken und lichtgeschützt, außerhalb der Reichweite von kleinen Kindern. Die Dose nach der Entnahme wieder verschließen."
          }
        },
        "faq_abo": {
          "type": "item",
          "settings": {
            "question": "Kann ich das Abo jederzeit kündigen?",
            "answer": "Ja. Du kannst dein Abo jederzeit pausieren, anpassen oder kündigen, direkt im Kundenkonto, ohne Angabe von Gründen und ohne Fristen."
          }
        },
        "faq_garantie": {
          "type": "item",
          "settings": {
            "question": "Gilt die 90-Tage-Garantie auch im Abo?",
            "answer": "Ja, für deine erste Bestellung, einmalig oder im Abo. Eine E-Mail innerhalb von 90 Tagen nach Erhalt genügt, wir erstatten den Kaufpreis."
          }
        }
      },
