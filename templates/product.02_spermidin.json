    "faq_accordion": {
      "type": "crs-faq-accordion",
      "blocks": {
        "faq_rohstoff": {
          "type": "item",
          "settings": {
            "question": "Woraus wird das Spermidin gewonnen?",
            "answer": "Aus Weizenkeimen. Die zugelassene Bezeichnung des Rohstoffs lautet Spermidin-reicher Weizenkeimextrakt, botanisch Triticum aestivum. Isoliertes Spermidin ist nicht zugelassen, der Extrakt schon."
          }
        },
        "faq_allergen": {
          "type": "item",
          "settings": {
            "question": "Enthält das Produkt Weizen oder Gluten?",
            "answer": "Ja. Der Rohstoff stammt aus Weizenkeimen, das Produkt enthält Weizen und damit Gluten. Wer Weizen oder Gluten meidet, sollte es nicht einnehmen."
          }
        },
        "faq_zielgruppe": {
          "type": "item",
          "settings": {
            "question": "Für wen ist das Produkt nicht geeignet?",
            "answer": "Der Weizenkeimextrakt ist für Erwachsene bestimmt. Für Schwangere und Stillende ist er nicht vorgesehen, ebenso wenig für Kinder und Jugendliche."
          }
        },
        "faq_einnahme": {
          "type": "item",
          "settings": {
            "question": "Wie nehme ich die Kapseln ein?",
            "answer": "Täglich 2 Kapseln zu einer Mahlzeit mit ausreichend Flüssigkeit. Die angegebene empfohlene tägliche Verzehrmenge darf nicht überschritten werden."
          }
        },
        "faq_gehalt": {
          "type": "item",
          "settings": {
            "question": "Wie viel Spermidin steckt in einer Portion?",
            "answer": "10 mg pro Tagesportion aus 2 Kapseln, also 5 mg je Kapsel. Sie stammen aus 1.000 mg Weizenkeimextrakt, der auf 1 % Spermidin standardisiert ist."
          }
        },
        "faq_vegan": {
          "type": "item",
          "settings": {
            "question": "Sind die Kapseln vegan?",
            "answer": "Ja. Die Kapselhülle besteht aus Hydroxypropylmethylcellulose, einem pflanzlichen Stoff. Tierische Bestandteile sind nicht enthalten."
          }
        },
        "faq_reichweite": {
          "type": "item",
          "settings": {
            "question": "Wie lange reicht eine Dose?",
            "answer": "Eine Dose enthält 60 Kapseln. Bei 2 Kapseln täglich reicht sie 30 Tage."
          }
        },
        "faq_lagerung": {
          "type": "item",
          "settings": {
