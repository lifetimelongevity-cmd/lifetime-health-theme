/*
 * ------------------------------------------------------------
 * LIFETIME — Link-in-Bio-Seite für die Instagram-Bio
 * Live-Slug: /pages/instagram   (Handle `instagram`, Suffix `instagram`)
 *
 * Ersetzt linktr.ee/lifetimelongevity (Stand 30.07.2026: .com-Links ohne
 * UTMs, TikTok- und App-Links, kein Quiz, kein Blog). Die Bio-URL in
 * Instagram muss die UTMs tragen, die Karten-Links hier bewusst nicht
 * (GA4-Session-Attribution, siehe Kommentar in sections/lt-link-hub.liquid):
 *   https://www.lifetime-health.de/pages/instagram?utm_source=instagram&utm_medium=social&utm_campaign=linkinbio
 *
 * Karten-Set und Labels folgen dem mobilen Karten-Menü (header-group.json
 * mc_*, BJ-Entscheide 27./28.07.): Test- und NMN-Karte gleichwertig,
 * Shop-Textlink, Quiz-Zeile. Blog-Zeile ergänzt; Sublabel „Artikel,
 * fachlich geprüft" gemäß BJ-Entscheid vom 28.07. (Prüf-Botschaft nur an
 * diesem einen Eintrag). App-Store-Badges (Original-Assets, BJ-Wunsch
 * 30.07.) am Ende: beide Store-Ziele am 30.07. mit HTTP 200 verifiziert;
 * der Play-Link bewusst ohne das `pcampaignid=web_share` des alten
 * Linktree (Share-Dialog-Artefakt, verfälscht die Install-Quelle).
 * Die Seite trägt das Metafield seo.hidden=1 (noindex, aus der Sitemap):
 * sie ist Einstieg für Instagram-Besucher, kein Suchtreffer.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "disabled": true,
      "settings": {
        "center": false,
        "page_cover_metafield": "",
        "color_background_main": "rgba(0,0,0,0)",
        "color_text_main": "rgba(0,0,0,0)",
        "height": "small"
      }
    },
    "linkhub": {
      "type": "lt-link-hub",
      "blocks": {
        "card_test": {
          "type": "card",
          "settings": {
            "title": "AGE & DNA-Test",
            "sub": "Dein biologisches Alter, bestimmt im Labor",
            "url": "/products/lifetime-age-dna",
            "image": "shopify://shop_images/Product-gallery_tst.png",
            "track": "test"
          }
        },
        "card_nmn": {
          "type": "card",
          "settings": {
            "title": "NMN Pulver",
            "sub": "Uthever®, jede Charge laborgeprüft",
            "url": "/products/lifetime-nmn",
            "image": "shopify://shop_images/Product-gallery_nmn.jpg",
            "track": "nmn"
          }
        },
        "link_shop": {
          "type": "textlink",
          "settings": {
            "title": "Alle Produkte",
            "url": "/collections/all",
            "track": "shop"
          }
        },
        "row_quiz": {
          "type": "row",
          "settings": {
            "title": "Passt der AGE-Test zu mir?",
            "sub": "In zwei Minuten geklärt",
            "url": "/pages/quiz-age",
            "track": "quiz"
          }
        },
        "row_blog": {
          "type": "row",
          "settings": {
            "title": "Longevity-Blog",
            "sub": "Artikel, fachlich geprüft",
            "url": "/blogs/longevity-blog",
            "track": "blog"
          }
        },
        "app_badges": {
          "type": "badges",
          "settings": {
            "ios_url": "https://apps.apple.com/de/app/lifetime-longevity-2/id6754841859",
            "android_url": "https://play.google.com/store/apps/details?id=com.lifetime_long_health.app",
            "note": "Apple, das Apple-Logo und App Store sind Marken von Apple Inc. Google Play und das Google Play-Logo sind Marken von Google LLC."
          }
        }
      },
      "block_order": [
        "card_test",
        "card_nmn",
        "link_shop",
        "row_quiz",
        "row_blog",
        "app_badges"
      ],
      "settings": {
        "kicker": "@lifetime.longevity",
        "heading": "Erfahre dein biologisches Alter",
        "subheading": ""
      }
    }
  },
  "order": [
    "main",
    "linkhub"
  ]
}
