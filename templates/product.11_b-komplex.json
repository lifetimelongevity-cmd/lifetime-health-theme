          }
        },
        "faq_tmg": {
          "type": "item",
          "settings": {
            "question": "Ich nehme schon TMG. Passt das zusammen?",
            "answer": "Ja. Folat, Vitamin B6 und Vitamin B12 tragen zu einem normalen Homocystein-Stoffwechsel bei, Betain aus TMG ebenfalls, auf einem eigenen Weg. Die beiden ergänzen sich."
          }
        }
