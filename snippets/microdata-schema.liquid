{%- comment -%}
  This snippet structures the micro-data using JSON-LD specification. For product and article pages, the data is 100% outputted by Shopify. The theme only offers schema for the organization and breadcrumb.
{%- endcomment -%}

{%- liquid
  assign org_logo = null
  if shop.brand.logo
    assign org_logo = shop.brand.logo | image_url: width: 512
  elsif settings.favicon != blank
    assign org_logo = settings.favicon | image_url: width: 512
  endif
-%}
<script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ shop.url | append: '/#website' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "description": {{ 'LIFETIME Health ist eine deutsche Longevity- und Gesundheitsmarke für epigenetische Alterstests und Nahrungsergänzung.' | json }},
      {%- if org_logo %}
      "logo": {{ org_logo | json }},
      "image": {{ org_logo | json }},
      {%- endif %}
      "sameAs": [
        "https://www.instagram.com/lifetime.longevity/",
        "https://www.facebook.com/lifetimehealthlongevity",
        "https://www.linkedin.com/company/lifetime-health-longevity",
        "https://www.tiktok.com/@lifetimelongevity"
      ]
    }
  ]
</script>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumb.homepage' | t | json }},
      "item": "{{ shop.url }}"
    }
    {%- if request.page_type == 'product' -%}
      {%- assign product_position = '2' -%}
      {%- if collection -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        }
        {%- assign product_position = '3' -%}
      {%- endif -%}
      ,{
        "@type": "ListItem",
        "position": {{ product_position }},
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
    {%- elsif request.page_type == 'collection' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    {%- elsif request.page_type == 'blog' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      }
    {%- elsif request.page_type == 'article' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": "{{ shop.url }}{{ blog.url }}"
      }, {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": "{{ shop.url }}{{ article.url }}"
      }
    {%- elsif request.page_type == 'page' -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": "{{ shop.url }}{{ page.url }}"
      }
    {%- endif -%}
  ]
}
</script>

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    NMN wird zu Forschungs- und Analysezwecken abgegeben und ist nicht zum Verzehr bestimmt.
    Der structured_data-Filter uebernimmt die Shopify-Taxonomie-Kategorie ungefiltert; sie
    lautet dort aus Feed-Gruenden "Vitamine & Nahrungsergaenzungsmittel" und wuerde das Produkt
    maschinenlesbar als Lebensmittel auszeichnen. Die Kategorie wird deshalb nur fuer dieses
    Produkt aus dem JSON-LD entfernt. Die Kategorie am Produkt selbst bleibt unveraendert,
    damit der Merchant-Center-Feed nicht bricht.
    Entfernt wird per split/join, weil Liquid kein JSON parsen kann. Der Guard auf size == 2
    stellt sicher, dass genau ein "category"-Feld existiert; sonst bleibt der Output unberuehrt.
  {%- endcomment -%}
  {%- liquid
    capture lt_sd
      echo product | structured_data
    endcapture
    if product.handle == 'lifetime-nmn'
      assign lt_sd_parts = lt_sd | split: '"category":"'
      if lt_sd_parts.size == 2
        assign lt_sd_tail = lt_sd_parts[1] | split: '","'
        assign lt_sd_rest = ''
        for lt_part in lt_sd_tail offset: 1
          if forloop.first
            assign lt_sd_rest = lt_part
          else
            assign lt_sd_rest = lt_sd_rest | append: '","' | append: lt_part
          endif
        endfor
        assign lt_sd = lt_sd_parts[0] | append: '"' | append: lt_sd_rest
      endif
    endif
  -%}
  <script type="application/ld+json">{{ lt_sd }}</script>

  {%- comment -%}
    Begleitknoten fuer die Bewertung.
    Der structured_data-Filter nimmt keine Parameter und gibt kein aggregateRating aus,
    deshalb wird es hier ueber dieselbe @id nachgeliefert.
    Bewusst OHNE @type: der Filter liefert je nach Produkt "Product" (eine Variante) oder
    "ProductGroup" (mehrere Varianten), ein fest verdrahteter Typ wuerde dort kollidieren.
    Bewusst OHNE einzelne review-Knoten: die Loox-Volltexte enthalten Wirkaussagen, die
    auf einer Novel-Food-Seite nicht maschinenlesbar ausgezeichnet werden duerfen.
  {%- endcomment -%}
  {%- liquid
    assign lt_rating = product.metafields.loox.avg_rating.value | default: 0 | plus: 0
    assign lt_count = product.metafields.loox.num_reviews.value | default: 0 | plus: 0
  -%}
  {%- if lt_rating > 0 and lt_count > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@id": {{ product.url | append: '#product' | json }},
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ lt_rating }},
          "ratingCount": {{ lt_count }},
          "bestRating": 5,
          "worstRating": 1
        }
      }
    </script>
  {%- endif -%}
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">{{ article | structured_data }}</script>

  {%- comment -%}
    Begleitknoten fuer die fachliche Pruefung. Gleiches Muster wie aggregateRating oben:
    Der structured_data-Filter nimmt keine Parameter und kennt kein reviewedBy, deshalb
    wird der Knoten ueber dieselbe @id nachgeliefert. Der Filter gibt die @id relativ aus
    ("/blogs/<blog>/<article>#article"), article.url liefert exakt denselben Pfad.

    Warum ueberhaupt: Der Reviewer steht heute nur als sichtbarer Text in der Byline.
    Fuer Gesundheitsthemen ist der Pruefprozess eine der Achsen, an denen Suchsysteme
    Autoritaet festmachen, und die ist maschinenlesbar bisher nicht vorhanden.

    Quelle ist das Artikel-Metafeld, sonst die feste Redaktions-Konvention aus
    docs/nmn-blog-geo/redaktionsplan.md (Schritt 6). Ohne Namen kein Knoten,
    Platzhalter-Credentials werden nie gerendert.

    "@id" und "url" erscheinen automatisch, sobald die Seite /pages/aerzte existiert.
    Solange sie fehlt, bleiben beide Felder weg, damit das Schema nicht auf einen 404
    zeigt. Die "@id" ist der eigentliche Punkt: erst sie verbindet diesen Knoten mit dem
    Person-Knoten auf /pages/aerzte (sections/lt-expert-profile.liquid, Anker aus
    `schema_anchor`). Ohne sie waere `reviewedBy` nur eine namensgleiche Person mit
    einer URL-Eigenschaft, kein Verweis auf eine aufloesbare Entitaet.

    Der Anker muss mit `schema_anchor` im Person-Block uebereinstimmen. Beide Seiten
    sind ueber docs/limmroth-faktenblatt.md dokumentiert. Weicht er ab, mergen die
    Knoten nicht, und das faellt in keinem Validator auf.
  {%- endcomment -%}
  {%- liquid
    assign lt_reviewer = article.metafields.custom.reviewer_name.value | default: 'Prof. Dr. med. Volker Limmroth'
    assign lt_reviewer_role = article.metafields.custom.reviewer_credential.value | default: 'Chefarzt Neurologie, Chief Scientific Officer LIFETIME'
    assign lt_reviewer_anchor = article.metafields.custom.reviewer_anchor.value | default: 'limmroth'
    assign lt_expert_page = pages['aerzte']
    if lt_expert_page != blank
      assign lt_expert_url = shop.url | append: lt_expert_page.url
      assign lt_expert_node = lt_expert_url | append: '#' | append: lt_reviewer_anchor
    endif
  -%}
  {%- if lt_reviewer != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@id": {{ article.url | append: '#article' | json }},
        "reviewedBy": {
          "@type": "Person",
          {%- if lt_expert_page != blank -%}
            "@id": {{ lt_expert_node | json }},
            "url": {{ lt_expert_node | json }},
          {%- endif -%}
          "name": {{ lt_reviewer | json }}
          {%- if lt_reviewer_role != blank -%}
            , "jobTitle": {{ lt_reviewer_role | json }}
          {%- endif -%}
        }
      }
    </script>
  {%- endif -%}
{%- endif -%}
