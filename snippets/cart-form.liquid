{% comment %}
  Renders cart form (drawer version).

  Usage:
  {% render 'cart-form' %}
{% endcomment %}

<cart-form id="AjaxCartForm">

  {%- liquid
    if settings.show_currency_codes
      assign iso_code = localization.country.currency.iso_code | prepend: ' ' 
    endif
  -%}

	{%- if template != 'cart' and settings.cart_free_shipping -%}
		{%- liquid
			# Abo im Warenkorb → Bestellung ist versandfrei (Auto-Discount "Gratisversand im Abo"),
			# die Schwellen-Rechnung wäre falsch und würde Geld nachfordern, das keiner zahlt
			assign cart_has_sub = false
			for item in cart.items
				if item.selling_plan_allocation
					assign cart_has_sub = true
					break
				endif
			endfor
			# Schwelle je Land aus lt-shipping-rule (Conversion-Plan 2.5), in Cent
			capture lt_ship_rule
				render 'lt-shipping-rule'
			endcapture
			assign lt_ship_rule = lt_ship_rule | split: '|'
		-%}
		<div class="cart-notice text-size--small hide-if-empty-cart">
			<shipping-notice
				data-free-shipping="{{ lt_ship_rule[1] | plus: 0 }}"
				data-cart-total="{{ cart.total_price }}"
				data-has-subscription="{{ cart_has_sub }}"
			>
				<span data-js-free-shipping-text></span>
				<span class="cart-notice__slider">
					<span class="cart-notice__slider-bar" data-js-free-shipping-slider></span>
				</span>
			</shipping-notice>
		</div>
		<script src="{{ 'component-shipping-notice.js' | asset_url }}" defer></script>
	{%- endif -%}

	<form action="{{ routes.cart_url }}" method="post" novalidate class="cart__form {% if cart.item_count == 0 %} cart--empty {% endif %}" id="cart">
	
		<div class="cart-holder" data-items="{{ cart.items.size }}">
			
			<div class="cart__items">

				{%- if cart.item_count > 0 -%}
				
					{%- for item in cart.items -%}

						<div id="item-{{ item.id }}" class="cart-item {% if item.product.id == settings.gift_wrap_product.id %} cart-item--gift-wrapping {% endif %}" data-title="{{ item.product.title | escape }} {%- unless item.product.has_only_default_variant -%} ({{ item.variant.title | escape }}) {%- endunless -%}" data-id="{{ item.key }}" data-product-id="{{ item.product.id }}" data-line="{{ forloop.index }}" data-qty="{{ item.quantity }}" data-js-cart-item>

							<a href="{{ item.url }}" class="cart-item__thumbnail">
								{%- render 'lazy-image-small', image: item.image, aspect_ratio: settings.cart_image_ratio, fit: settings.cart_image_fit, class: 'lazy-image--scale-animation' -%}
							</a>

							<div class="cart-item__content">

								<div>


									{%- unless item.gift_card -%}
										<div class="cart-item__price">
											{%- comment -%} Labels passend zum Element: der fette Betrag ist der gezahlte (Sale),
												der gestrichene der regulaere. Vorher vertauscht, Screenreader lasen 349 € als
												regulaer und 449 € als Sale (Conversion-Plan 4.5). 2026-09-29 {%- endcomment -%}
											{%- if item.final_line_price < item.original_line_price -%}
												<span class="visually-hidden">{{ 'general.accessibility_labels.price.sale' | t }}</span>
												<strong>{{ item.final_line_price | money | append: iso_code }}</strong>
												<span class="visually-hidden">{{ 'general.accessibility_labels.price.regular' | t }}</span>
												<span><del>{{ item.original_line_price | money | append: iso_code }}</del></span>
											{%- elsif item.variant.compare_at_price > item.variant.price -%}
												<span class="visually-hidden">{{ 'general.accessibility_labels.price.sale' | t }}</span>
												<strong>{{ item.final_line_price | money | append: iso_code }}</strong>
												<span class="visually-hidden">{{ 'general.accessibility_labels.price.regular' | t }}</span>
												<span><del>{{ item.variant.compare_at_price | times: item.quantity | money | append: iso_code }}</del></span>
											{%- else -%}
												<span class="visually-hidden">{{ 'general.accessibility_labels.price.regular' | t }}</span>
												<strong>{{ item.final_line_price | money | append: iso_code }}</strong>
											{%- endif -%}

										</div>
									{%- endunless -%}

									{%- if item.unit_price_measurement -%}
										<span class="cart-item__unit-price text-size--small text-color--opacity">
											{{ item.unit_price | money | append: iso_code }} / 
											{% if item.unit_price_measurement.reference_value != 1 %}
												{{ item.unit_price_measurement.reference_value }}
											{% endif %}
											{{ item.unit_price_measurement.reference_unit }}
										</span>
									{%- endif -%}

									<a href="{{ item.url }}" class="cart-item__title">
										<span class="text-animation--underline-thin">{{ item.product.title | escape }}</span>
									</a>

									{%- if item.item_components and item.item_components.size > 0 -%}
										{%- assign count = item.item_components.size -%}
										
										<div class="cart-item__bundle bundle-components-container text-size--small text-line-height--small">

											<details>
												<summary class="cart-item__bundle-toggle">
													<span class="show-bundle">
														{{ 'cart.bundled_items_toggle.show_items' | t: count: count }}
													</span>
													<span class="hide-bundle">
														{{ 'cart.bundled_items_toggle.hide_items' | t: count: count }}
													</span>
													<span aria-hidden="true" class="cart-item__bundle-toggle-icon toggle-bundle-btn__icon">{%- render 'theme-symbols', icon: 'chevron' -%}</span>
												</summary>

												<div class="cart-item__bundle-components">
													{%- for component in item.item_components -%}
														<div class="cart-item__bundle-component align-content align-content--vertical-middle">
	
															<div class="cart-item__thumbnail element--border-width-clamped element--border-radius">
																{%- render 'lazy-image-small', image: component.image, aspect_ratio: settings.cart_image_ratio, fit: settings.cart_image_fit, sizes: '60px' -%}
															</div>
	
															<div class="cart-item__bundle-component-info">
																<span class="text-weight--medium">{{ component.quantity }} × {{ component.product.title | escape }}</span>
																{%- unless component.product.has_only_default_variant -%} 
																	<span class="text-color--opacity">{{ component.variant.title | escape }}</span>
																{%- endunless -%}
															</div>

														</div>
													{%- endfor -%}
												</div>
											</details>
												
										</div>
										
									{%- endif -%}

									{%- unless item.product.has_only_default_variant -%}
										{%- unless item.item_components and item.item_components.size > 0 -%}
											{%- for option in item.options_with_values -%}
												<span class="cart-item__variant text-size--small text-color--opacity">
													{{ option.name }}: {{ option.value }}
												</span>
											{%- endfor -%}
										{%- endunless -%}
									{%- endunless -%}

									{%- if item.selling_plan_allocation -%}
										<span class="text-size--small">
											{{ item.selling_plan_allocation.selling_plan.name }} 
										</span>
									{%- endif -%}

									{%- if item.line_level_discount_allocations.size > 0 -%}
										<span class="cart-item__discounts">
											{%- for discount_allocation in item.line_level_discount_allocations -%}
												{%- capture discount -%}
													{{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money | append: iso_code }})
												{%- endcapture -%}
												{%- render 'cart-item-discount', discount: discount -%}
											{%- endfor -%}
										</span>
									{%- endif -%}

									{%- assign property_size = item.properties | size -%}
									{%- if property_size > 0 -%}
										{%- for p in item.properties -%}
											{%- assign p_first_char = p.first | slice: 0 -%}
											{%- if p.last != blank and p_first_char != '_' -%}
												<span class="cart-item__property text-line-height--small">
													<strong>{{ p.first }}: </strong>
													{%- if p.last contains '/uploads/' -%}
														<a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
													{%- else -%}
														<span>{{ p.last }}</span>
													{%- endif -%}
												</span>
											{%- endif -%}
										{%- endfor -%}
									{%- endif -%}

									<div class="cart-item__actions">

										<product-quantity class="quantity-selector-holder">
											<cart-product-quantity>
												<button class="qty-button qty-minus no-js-hidden" aria-label="{{ 'general.accessibility_labels.decrease_quantity' | t }}" role="button" controls="updates_{{ item.id }}">
													{%- render 'theme-symbols', icon: 'minus' -%}
												</button>
												<label for="updates_{{ item.id }}" class="visually-hidden">{{ 'general.accessibility_labels.quantity' | t }}</label>
												<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="qty qty-selector product__quantity" id="updates_{{ item.id }}" data-href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=$qty">
												<button class="qty-button qty-plus no-js-hidden" aria-label="{{ 'general.accessibility_labels.increase_quantity' | t }}" role="button" controls="updates_{{ item.id }}">
													{%- render 'theme-symbols', icon: 'plus' -%}
												</button>
											</cart-product-quantity>
										</product-quantity>
										<a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="remove text-link text-size--small" title="{{ 'cart.remove_item' | t }}">{{ 'cart.remove_item' | t }}</a>
			
									</div>

									{%- liquid
										# Einmalkauf auf Abo umstellen, ein Klick (Conversion-Plan 3.1, 29.09.2026).
										# 15 Kunden zahlten fuer 30 g NMN einmalig 38,80 € mit Versand statt 28,90 €
										# im Abo. Plan kommt aus der Allocation der Variante: NMN hat je Groesse eine
										# eigene Appstle-Gruppe mit FESTEM Preis (Policy 'price'), die Supplements
										# einen Prozent-Plan. Deshalb erst den Festpreis-Plan, sonst den ersten, wie
										# in lt-pdp-hero. "Versandfrei" gilt fuer jeden Abo-Warenkorb (Auto-Discount
										# "Gratisversand im Abo", alle Laender, ohne Schwelle), "jederzeit kuendbar"
										# fuer jeden Plan (minCycles leer, geprueft 29.09.). Die Abo-Kasse hat kein
										# Klarna, deshalb steht die Zahlart dabei.
										assign lt_sw_alloc = false
										unless item.selling_plan_allocation or item.gift_card
											for alloc in item.variant.selling_plan_allocations
												if alloc.selling_plan.price_adjustments.first.value_type == 'price'
													assign lt_sw_alloc = alloc
													break
												endif
											endfor
											unless lt_sw_alloc
												assign lt_sw_alloc = item.variant.selling_plan_allocations.first
											endunless
										endunless
										if lt_sw_alloc
											assign lt_sw_sub_total = lt_sw_alloc.price | times: item.quantity
											if lt_sw_sub_total >= item.original_line_price
												assign lt_sw_alloc = false
											endif
										endif
									-%}
									{%- if lt_sw_alloc -%}
										{%- liquid
											assign lt_sw_sub_label = lt_sw_sub_total | money | append: iso_code
											assign lt_sw_once_label = item.original_line_price | money | append: iso_code
											assign lt_sw_rhythm = lt_sw_alloc.selling_plan.name | remove: 'Lieferfrequenz:' | strip | replace_first: 'Alle ', 'alle ' | replace_first: 'Jeden ', 'jeden ' | replace_first: 'Jede ', 'jede '
										-%}
										<cart-sub-switch
											class="cart-sub-switch"
											data-line-key="{{ item.key }}"
											data-quantity="{{ item.quantity }}"
											data-selling-plan="{{ lt_sw_alloc.selling_plan.id }}"
										>
											<p class="cart-sub-switch__offer text-size--small text-line-height--small">
												{{- 'cart.lt_sub_switch_offer_html' | t: rhythm: lt_sw_rhythm, sub_price: lt_sw_sub_label, once_price: lt_sw_once_label -}}
											</p>
											<p class="cart-sub-switch__meta text-size--small text-color--opacity text-line-height--small">
												{{- 'cart.lt_sub_switch_meta' | t -}}
											</p>
											{%- capture lt_sw_aria -%}
												{{- 'cart.lt_sub_switch_cta' | t }}: {{ item.product.title }}, {{ 'cart.lt_sub_switch_offer_plain' | t: rhythm: lt_sw_rhythm, sub_price: lt_sw_sub_label, once_price: lt_sw_once_label -}}
											{%- endcapture -%}
											<button
												type="button"
												class="cart-sub-switch__action button button--small button--outline"
												aria-label="{{ lt_sw_aria | strip | escape }}"
												data-js-cart-sub-switch
											>
												<span class="button__text">{{ 'cart.lt_sub_switch_cta' | t }}</span>
											</button>
											<span class="cart-sub-switch__error text-size--small" data-js-cart-sub-switch-error role="status" aria-live="polite"></span>
										</cart-sub-switch>
									{%- endif -%}

								</div>

							</div>
								
						</div>

					{%- endfor -%}

				{%- else -%}

					{{ 'cart.empty' | t }}

				{%- endif -%}

			</div>

		</div>

	</form>

	{%- comment -%}
		Innerhalb von #AjaxCartForm, damit der Vorschlag bei jedem Cart-Update
		neu berechnet wird (component-cart.js ersetzt hier das komplette innerHTML).
		Das Script liegt bewusst ausserhalb der Bedingung: per innerHTML nachgeladene
		<script>-Tags fuehrt der Browser nicht aus, bei anfangs leerem Warenkorb waere
		das Custom Element sonst nie registriert und der Button tot.
	{%- endcomment -%}
	{%- render 'cart-upsell', type: 'sidebar' -%}
	{%- if settings.cart_upsell_enable -%}
		<script src="{{ 'component-cart-upsell.js' | asset_url }}" defer></script>
	{%- endif -%}
	{%- comment -%} Ausserhalb jeder Bedingung, aus demselben Grund wie oben: bei anfangs
			leerem Warenkorb muss das Element trotzdem registriert werden. {%- endcomment -%}
	<script src="{{ 'component-cart-sub-switch.js' | asset_url }}" defer></script>

	<span class="cart__count hidden" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
	<span class="cart__total hidden" aria-hidden="true" data-cart-total>{{ cart.total_price | money | append: iso_code }}</span>

</cart-form>