{%- comment -%}
  Black Week 2026, zentrale Zeitschaltung (10.11.2026).

  Ein Ort für die Zeitpunkte. Sie müssen zu startsAt und endsAt der Shopify-Rabatte passen
  (Stand BJ 24.11.2026):
  - „Black Week: 30 g NMN gratis“ (automatisch): 22.11. 18:00 bis Do 26.11. 23:59:59.
  - Staffel ohne Code auf Nährstoffe, NMN und Bundles (drei automatische Rabatte: 20 %,
    30 % ab 2 Produkten, 40 % ab 3): Fr 27.11. 00:00 bis 30.11. 23:59:59 (BJ 26.11.2026,
    ersetzt den Code BLACK40).
  - Code BLACKFRIDAY, 50 € auf den AGE & DNA-Test: seit 24.11. bis 30.11. 23:59:59.
  Den automatischen 96-€-Rabatt auf den Test gibt es seit 24.11.2026 nicht mehr.

  Zwei Phasen: bis P2 (Fr 27.11. 00:00) das NMN-Geschenk, ab P2 der 40-%-Code. Ab P2 trägt
  html zusätzlich data-lt-bw-p2. Elemente mit data-lt-bw-p1-only verschwinden dann,
  Elemente mit data-lt-bw-p2-only sind nur in Phase 2 sichtbar.

  Setzt html[data-lt-bw] auf before, on oder after:
  - on gilt öffentlich ab START, mit ?bw=1 (Link aus der Frühzugangs-Mail) schon ab EARLY.
  - Elemente mit data-lt-bw-only sind außerhalb von on unsichtbar,
    Elemente mit data-lt-bw-hide während on.
  Vor EARLY und nach END zeigt das Theme nichts von der Aktion, die Dateien dürfen
  also vorher live gehen. Die Rabatte selbst erzwingt Shopify, nicht dieses Skript.

  Test vor dem Start: nur auf einem nicht veröffentlichten Theme schaltet ?bw=test
  die Aktion an (die Kasse rechnet den Rabatt dann noch nicht), ?bw=p2 zusätzlich Phase 2.

  Nach der Aktion: die render-Zeile in layout/theme.liquid entfernen.
{%- endcomment -%}
<script>
  (function () {
    var EARLY = Date.parse('2026-11-22T18:00:00+01:00');
    var START = Date.parse('2026-11-23T00:00:00+01:00');
    var P2 = Date.parse('2026-11-27T00:00:00+01:00');
    var END = Date.parse('2026-11-30T23:59:59+01:00');
    var DEV = {{ theme.role | json }} !== 'main';
    var now = Date.now();
    var early = false;
    var test = false;
    var testP2 = false;
    try {
      if (/[?&]bw=1(?:&|$)/.test(location.search)) localStorage.setItem('lt_bw', '1');
      early = localStorage.getItem('lt_bw') === '1';
      if (DEV) {
        if (/[?&]bw=test(?:&|$)/.test(location.search)) sessionStorage.setItem('lt_bw_test', '1');
        if (/[?&]bw=p2(?:&|$)/.test(location.search)) {
          sessionStorage.setItem('lt_bw_test', '1');
          sessionStorage.setItem('lt_bw_p2', '1');
        }
        test = sessionStorage.getItem('lt_bw_test') === '1';
        testP2 = sessionStorage.getItem('lt_bw_p2') === '1';
      }
    } catch (e) {}
    var on = test || (now < END && (now >= START || (early && now >= EARLY)));
    var phase = on ? 'on' : now >= END ? 'after' : 'before';
    var root = document.documentElement;
    root.setAttribute('data-lt-bw', phase);
    var p2 = on && (testP2 || now >= P2);
    if (p2) root.setAttribute('data-lt-bw-p2', '');
    window.LTBlackWeek = { on: on, phase: phase, end: END, p2: p2 };
    // Ankündigungsleiste: während der Aktion ersetzt die Aktionszeile den Standardtext des
    // ersten Eintrags. Per Skript statt in sections/announcement-bar.liquid, damit die
    // Combine-Section unangetastet bleibt. Der Text kommt aus snippets/lt-black-week-bar.liquid.
    var barOriginal = null;
    function bar(swap) {
      var slot = document.querySelector('announcement-bar .announcement');
      var tpl = document.getElementById('lt-bw-bar');
      if (!slot || !tpl) return;
      if (swap) {
        if (barOriginal === null) barOriginal = slot.innerHTML;
        slot.innerHTML = tpl.innerHTML;
      } else if (barOriginal !== null) {
        slot.innerHTML = barOriginal;
        barOriginal = null;
      }
    }
    if (on) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { bar(true); });
      } else {
        bar(true);
      }
    }
    // Seite bleibt über Mitternacht offen: Phase 2 beginnt, ohne dass jemand neu lädt.
    if (on && !test && !p2 && P2 - now < 2147483647) {
      window.setTimeout(function () {
        if (!window.LTBlackWeek.on) return;
        root.setAttribute('data-lt-bw-p2', '');
        window.LTBlackWeek.p2 = true;
      }, P2 - now);
    }
    if (on && !test && END - now < 2147483647) {
      window.setTimeout(function () {
        root.setAttribute('data-lt-bw', 'after');
        root.removeAttribute('data-lt-bw-p2');
        window.LTBlackWeek.on = false;
        window.LTBlackWeek.p2 = false;
        window.LTBlackWeek.phase = 'after';
        bar(false);
      }, END - now);
    }
    // Laufende Uhr auf das echte Ende (endsAt der Shopify-Rabatte). Füllt jedes
    // [data-lt-bw-clock], auch solche, die erst später in die Seite kommen (Leiste,
    // neu gerenderter Warenkorb). Nach dem Ende bleibt nichts stehen: die Elemente
    // hängen an data-lt-bw-only und verschwinden mit der Phase.
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function clock() {
      if (!window.LTBlackWeek.on) return;
      var diff = END - Date.now();
      if (diff <= 0) return;
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      var html = (d > 0 ? '<b>' + d + '</b><i>' + (d === 1 ? 'Tag' : 'Tage') + '</i>' : '')
        + '<b>' + pad(h) + '</b><i>Std</i><b>' + pad(m) + '</b><i>Min</i><b>' + pad(s) + '</b><i>Sek</i>';
      var els = document.querySelectorAll('[data-lt-bw-clock]');
      for (var i = 0; i < els.length; i++) els[i].innerHTML = html;
    }
    if (on) {
      clock();
      window.setInterval(clock, 1000);
    }
  })();
</script>
<template id="lt-bw-bar">{%- render 'lt-black-week-bar' -%}</template>
<style>
  html:not([data-lt-bw='on']) [data-lt-bw-only] { display: none !important; }
  html[data-lt-bw='on'] [data-lt-bw-hide] { display: none !important; }
  html[data-lt-bw-p2] [data-lt-bw-p1-only] { display: none !important; }
  html:not([data-lt-bw-p2]) [data-lt-bw-p2-only] { display: none !important; }

  /* Uhr: Zahl in Mint, Einheit klein dahinter (wie die Fristleiste der Pilotpraxis-Seite) */
  .lt-bw-clock { display: inline-flex; align-items: baseline; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lt-bw-clock b { font-family: var(--font-heading); font-size: 22px; font-weight: 500; line-height: 1; color: var(--color-teal, #65c0b6); min-width: 1.2em; text-align: right; }
  .lt-bw-clock i { margin: 0 9px 0 4px; font-size: 11px; font-style: normal; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1; opacity: 0.8; }
  .lt-bw-clock i:last-child { margin-right: 0; }

  /* Leiste in Phase 2 */
  .lt-bw-bar { display: inline-flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 2px 12px; }
  .lt-bw-bar__tag { font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .lt-bw-bar__lang { display: none; }
  .lt-bw-clock--bar b { font-size: 18px; }
  .lt-bw-clock--bar i { margin-right: 7px; font-size: 10px; }
  @media (min-width: 750px) {
    .lt-bw-bar__lang { display: inline; }
    .lt-bw-bar__kurz { display: none; }
    .lt-bw-clock--bar b { font-size: 22px; }
  }
  @media (min-width: 990px) {
    .lt-bw-bar { flex-wrap: nowrap; white-space: nowrap; gap: 0 16px; }
  }
  @media (max-width: 400px) {
    .lt-bw-bar__tag { letter-spacing: 0.04em; }
    .lt-bw-clock--bar b { font-size: 16px; min-width: 1.1em; }
    .lt-bw-clock--bar i { margin: 0 5px 0 3px; }
  }

  /* Warenkorb: Hinweis auf die nächste Stufe (snippets/cart-subtotal.liquid). Steht per
     Inline-Style auf display:none und wird nur in Phase 2 eingeblendet, damit Layouts ohne
     dieses Snippet ihn nie zeigen. */
  html[data-lt-bw='on'][data-lt-bw-p2] .lt-bw-korb { display: block !important; }
  .lt-bw-korb { margin: 0 0 14px; padding: 14px 14px 12px; border-radius: var(--radius-md, 12px); background: var(--color-dark, #364f56); color: var(--color-paper, #f7f7f4); font-family: var(--font-body); }
  .lt-bw-korb__text { margin: 0; font-size: 14px; line-height: 1.4; color: inherit; }
  .lt-bw-korb__text strong { color: var(--color-teal, #65c0b6); }
  .lt-bw-korb__stufen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin: 10px 0 0; }
  .lt-bw-korb__stufen span { height: 6px; border-radius: 999px; background: rgba(247, 247, 244, 0.25); }
  .lt-bw-korb__stufen span.is-an { background: var(--color-teal, #65c0b6); }
  .lt-bw-korb__uhr { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; margin: 10px 0 0; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: inherit; }
  .lt-bw-korb .lt-bw-clock b { font-size: 16px; }
  .lt-bw-korb .lt-bw-clock i { font-size: 10px; margin-right: 6px; }
</style>
