{%- comment -%}
  Black Week 2026: Zeile für die Ankündigungsleiste (10.11.2026).
  Wird von snippets/lt-black-week.liquid in ein <template> gerendert und während der
  Aktion per Skript in den ersten Eintrag der Leiste gesetzt. Auf den zwei
  Aktions-Produktseiten nennt sie das Angebot, sonst führt sie zum Katalog
  (bis 24.11. zur Sammelseite /pages/black-week, die nie veröffentlicht war: 404).
  Kurz halten, die Leiste ist mobil einzeilig.
{%- endcomment -%}
{%- liquid
  assign bw_bar_text = 'Black Week bis 30.11. · Zu den Angeboten'
  assign bw_bar_url = '/collections/all'
  if product.handle == 'lifetime-nmn'
    assign bw_bar_text = 'Black Week: 30 g NMN geschenkt · bis 30.11.'
    assign bw_bar_url = blank
  elsif product.handle == 'lifetime-age-dna'
    assign bw_bar_text = 'Test: 50 € Rabatt mit Code BLACKFRIDAY · bis 30.11.'
    assign bw_bar_url = blank
  endif
-%}
{%- if bw_bar_url != blank -%}
  <a href="{{ bw_bar_url }}">{{ bw_bar_text | escape }}</a>
{%- else -%}
  {{- bw_bar_text | escape -}}
{%- endif -%}
