{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lt-check.mjs\"",
            "timeout": 15,
            "statusMessage": "Prüfe Liquid-Regeln"
          }
        ]
      }
    ]
  }
}
