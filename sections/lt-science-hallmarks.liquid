{%- liquid
  assign hallmarks_align = section.settings.content_align | default: 'left'
  if hallmarks_align != 'left' and hallmarks_align != 'center' and hallmarks_align != 'right'
    assign hallmarks_align = 'left'
  endif
  assign hallmarks_kicker = section.settings.kicker | strip
  assign hallmarks_heading = section.settings.heading | strip
  assign hallmarks_subheading = section.settings.subheading | strip
  assign hallmarks_source = section.settings.source_text | strip
  if hallmarks_kicker == '__none__'
    assign hallmarks_kicker = ''
  endif
  assign hallmarks_heading_lg = false
  if section.settings.heading_size == 'product_title'
    assign hallmarks_heading_lg = true
  endif

  comment
    Pre-compute per-category tile data from blocks.
    Supports up to 3 category_header blocks (Primär / Antagonistisch / Integrativ).
  endcomment
  assign shm_cat_index = -1
  assign shm_cat0_name  = '' | append: ''
  assign shm_cat0_desc  = '' | append: ''
  assign shm_cat0_count = 0
  assign shm_cat1_name  = '' | append: ''
  assign shm_cat1_desc  = '' | append: ''
  assign shm_cat1_count = 0
  assign shm_cat2_name  = '' | append: ''
  assign shm_cat2_desc  = '' | append: ''
  assign shm_cat2_count = 0

  for block in section.blocks
    if block.type == 'category_header'
      assign shm_cat_index = shm_cat_index | plus: 1
      if shm_cat_index == 0
        assign shm_cat0_name = block.settings.category_name
        assign shm_cat0_desc = block.settings.category_desc
      elsif shm_cat_index == 1
        assign shm_cat1_name = block.settings.category_name
        assign shm_cat1_desc = block.settings.category_desc
      elsif shm_cat_index == 2
        assign shm_cat2_name = block.settings.category_name
        assign shm_cat2_desc = block.settings.category_desc
      endif
    elsif block.type == 'hallmark'
      if shm_cat_index == 0
        assign shm_cat0_count = shm_cat0_count | plus: 1
      elsif shm_cat_index == 1
        assign shm_cat1_count = shm_cat1_count | plus: 1
      elsif shm_cat_index == 2
        assign shm_cat2_count = shm_cat2_count | plus: 1
      endif
    endif
  endfor

  assign shm_is_expanded = section.settings.show_expanded_default | default: false

  comment
    Nummernbereiche je Kategorie, aus den Block-Zählungen abgeleitet (01–05 / 06–08 / 09–12).
    Sie ersetzen die früheren Deko-Icons auf den Kacheln: das Icon war Dekoration, der
    Bereich sagt, wie viele Mechanismen in der Kategorie stecken.
    Alles rechnet sich selbst, ein 13. Hallmark verschiebt Bereiche und Toggle-Label mit.
  endcomment
  assign shm_total = shm_cat0_count | plus: shm_cat1_count | plus: shm_cat2_count
  assign shm_counts = shm_cat0_count | append: ',' | append: shm_cat1_count | append: ',' | append: shm_cat2_count | split: ','
  assign shm_ranges = ''
  assign shm_running = 0
  for shm_c in shm_counts
    assign shm_c_num = shm_c | times: 1
    if shm_c_num > 0
      assign shm_from = shm_running | plus: 1
      assign shm_to = shm_running | plus: shm_c_num
      if shm_from < 10
        assign shm_from = shm_from | prepend: '0'
      endif
      if shm_to < 10
        assign shm_to = shm_to | prepend: '0'
      endif
      assign shm_ranges = shm_ranges | append: shm_from | append: '–' | append: shm_to
      assign shm_running = shm_running | plus: shm_c_num
    endif
    assign shm_ranges = shm_ranges | append: '|'
  endfor
  assign shm_ranges = shm_ranges | split: '|'

  comment
    Toggle-Beschriftungen: früher im Script hardcodiert ("Alle 12 Mechanismen ansehen"),
    dadurch bei jeder Änderung der Block-Anzahl still falsch. Jetzt Settings mit {count}.
  endcomment
  assign shm_label_more = section.settings.toggle_label_more | default: 'Alle {count} Mechanismen ansehen ↓' | replace: '{count}', shm_total
  assign shm_label_less = section.settings.toggle_label_less | default: 'Weniger anzeigen ↑'
-%}

{% style %}
  #section-{{ section.id }} {
    --science-hallmarks-bg: {{ section.settings.color_bg }};
    --science-hallmarks-card-bg: {{ section.settings.color_card_bg }};
    --science-hallmarks-text: {{ section.settings.color_text }};
    --science-hallmarks-text-secondary: {{ section.settings.color_text | color_modify: 'alpha', 0.6 }};
    --science-hallmarks-text-muted: {{ section.settings.color_text | color_modify: 'alpha', 0.35 }};
    --science-hallmarks-border: {{ section.settings.color_text | color_modify: 'alpha', 0.08 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- comment -%}
  Optionale Anker-ID (28.07.): macht den Abschnitt adressierbar und für ein
  Inhaltsverzeichnis ansprechbar. Ohne Wert bleibt die bisherige ID erhalten.
{%- endcomment -%}
{%- liquid
  assign sec_anchor = section.settings.anchor_id
  if sec_anchor == blank
    assign sec_anchor = 'section-' | append: section.id
  endif
-%}
<section class="science-hallmarks" id="{{ sec_anchor }}">
  <div class="science-hallmarks__container">

    {%- comment -%} Section header — unchanged {%- endcomment -%}
    {%- if hallmarks_kicker != blank or hallmarks_heading != blank or hallmarks_subheading != blank -%}
      <header class="science-hallmarks__header crs-heading-stack crs-heading-stack--align-{{ hallmarks_align }}{% if hallmarks_heading_lg %} crs-heading-stack--headline-lg{% endif %}">
        {%- if hallmarks_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ hallmarks_kicker | escape }}</p>
        {%- endif -%}
        {%- comment -%}
          Numeral-Auftakt: die Zahl ist die Überschrift, nicht ein Satz über die Zahl.
          Steht bewusst außerhalb von __pair, damit der Heading-Stack unberührt bleibt.
        {%- endcomment -%}
        {%- if section.settings.show_count_numeral and shm_total > 0 -%}
          <p class="science-hallmarks__numeral">{{ shm_total }}</p>
        {%- endif -%}
        <div class="crs-heading-stack__pair">
          {%- if hallmarks_heading != blank -%}
            <h2 class="crs-heading-stack__title">{{ hallmarks_heading | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if hallmarks_subheading != blank -%}
            <p class="crs-heading-stack__subtitle">{{ hallmarks_subheading | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- comment -%} Category tiles — derived from category_header blocks {%- endcomment -%}
    {%- if shm_cat_index >= 0 -%}
      <div class="science-hallmarks__tiles">

        {%- if shm_cat0_name != blank -%}
          <div class="science-hallmarks__tile">
            {%- if shm_ranges[0] != blank -%}
              <p class="science-hallmarks__tile-range">{{ shm_ranges[0] }}</p>
            {%- endif -%}
            <h3 class="science-hallmarks__tile-name">{{ shm_cat0_name | escape }}</h3>
            {%- if shm_cat0_desc != blank -%}
              <p class="science-hallmarks__tile-desc">{{ shm_cat0_desc | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if shm_cat1_name != blank -%}
          <div class="science-hallmarks__tile">
            {%- if shm_ranges[1] != blank -%}
              <p class="science-hallmarks__tile-range">{{ shm_ranges[1] }}</p>
            {%- endif -%}
            <h3 class="science-hallmarks__tile-name">{{ shm_cat1_name | escape }}</h3>
            {%- if shm_cat1_desc != blank -%}
              <p class="science-hallmarks__tile-desc">{{ shm_cat1_desc | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if shm_cat2_name != blank -%}
          <div class="science-hallmarks__tile">
            {%- if shm_ranges[2] != blank -%}
              <p class="science-hallmarks__tile-range">{{ shm_ranges[2] }}</p>
            {%- endif -%}
            <h3 class="science-hallmarks__tile-name">{{ shm_cat2_name | escape }}</h3>
            {%- if shm_cat2_desc != blank -%}
              <p class="science-hallmarks__tile-desc">{{ shm_cat2_desc | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- comment -%} Toggle button {%- endcomment -%}
    <div class="science-hallmarks__toggle-wrap">
      <button
        type="button"
        class="science-hallmarks__toggle ltw-btn ltw-btn--ghost"
        data-hallmarks-toggle
        data-label-more="{{ shm_label_more | escape }}"
        data-label-less="{{ shm_label_less | escape }}"
        aria-expanded="{{ shm_is_expanded }}"
        aria-controls="hallmarks-drawer-{{ section.id }}"
      >
        {%- if shm_is_expanded -%}
          {{ shm_label_less | escape }}
        {%- else -%}
          {{ shm_label_more | escape }}
        {%- endif -%}
      </button>
    </div>

    {%- comment -%} Expandable drawer {%- endcomment -%}
    <div
      id="hallmarks-drawer-{{ section.id }}"
      class="science-hallmarks__drawer"
      data-hallmarks-drawer
      data-expanded="{{ shm_is_expanded }}"
      {% if shm_is_expanded %}style="max-height: none"{% endif %}
    >

      <div class="science-hallmarks__body-wrap">
        {%- assign in_group = false -%}
        {%- for block in section.blocks -%}

          {%- if block.type == 'category_header' -%}
            {%- if in_group -%}
              </ol>
            </div>
            {%- endif -%}
            <div class="science-hallmarks__category" {{ block.shopify_attributes }}>
              <div class="science-hallmarks__cat-row">
                {%- if block.settings.category_name != blank -%}
                  <span class="science-hallmarks__cat-label">{{ block.settings.category_name | escape }}</span>
                {%- endif -%}
                {%- if block.settings.category_desc != blank -%}
                  <span class="science-hallmarks__cat-desc">{{ block.settings.category_desc | escape }}</span>
                {%- endif -%}
              </div>
              <ol class="science-hallmarks__grid" role="list">
            {%- assign in_group = true -%}

          {%- elsif block.type == 'hallmark' -%}
            {%- unless in_group -%}
              <div class="science-hallmarks__category">
                <ol class="science-hallmarks__grid" role="list">
              {%- assign in_group = true -%}
            {%- endunless -%}
            {%- assign hallmark_number = block.settings.number | strip -%}
            <li class="science-hallmarks__card" {{ block.shopify_attributes }}>
              <div class="science-hallmarks__card-inner">
                {%- if block.settings.name != blank -%}
                  <h3 class="science-hallmarks__name">
                    {%- if hallmark_number != blank -%}
                      <span class="science-hallmarks__num" aria-hidden="true">{{ hallmark_number | escape }}</span>
                    {%- endif -%}
                    {{ block.settings.name | escape }}
                  </h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="science-hallmarks__desc">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>
            </li>

          {%- endif -%}
        {%- endfor -%}
        {%- if in_group -%}
            </ol>
          </div>
        {%- endif -%}
      </div>

      {%- if hallmarks_source != blank -%}
        <div class="science-hallmarks__source">
          <p class="science-hallmarks__source-text">{{ hallmarks_source | escape }}</p>
        </div>
      {%- endif -%}

    </div>{%- comment -%} /drawer {%- endcomment -%}

  </div>
</section>

<script>
(function () {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;

  var toggle = section.querySelector('[data-hallmarks-toggle]');
  var drawer = section.querySelector('[data-hallmarks-drawer]');
  if (!toggle || !drawer) return;

  var expanded = drawer.dataset.expanded === 'true';
  var labelMore = toggle.dataset.labelMore || toggle.textContent;
  var labelLess = toggle.dataset.labelLess || 'Weniger anzeigen';

  function update(open) {
    expanded = open;
    if (open) {
      drawer.style.maxHeight = drawer.scrollHeight + 'px';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.textContent = labelLess;
    } else {
      drawer.style.maxHeight = '0px';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = labelMore;
    }
  }

  /* Set initial px height without animation */
  drawer.style.transition = 'none';
  update(expanded);

  /* Enable transition after first paint */
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      drawer.style.transition = 'max-height 0.4s ease';
    });
  });

  toggle.addEventListener('click', function () {
    update(!expanded);
  });
})();
</script>

{% stylesheet %}
  .science-hallmarks {
    background: var(--science-hallmarks-bg, #f7f7f4);
  }

  .science-hallmarks__container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .science-hallmarks__header {
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  .science-hallmarks__header.crs-heading-stack--align-center {
    margin-inline: auto;
  }

  /* ─── NUMERAL-AUFTAKT ─── */
  .science-hallmarks__numeral {
    font-family: var(--font-heading);
    /* Fest --text-display: es sind nie mehr als zwei, drei Zeichen, ein clamp()
       hätte die Zahl auf Mobil nur unnötig auf h1 heruntergezogen.
       --text-stat bleibt laut design-components.mdc dem stat-callout auf
       dunkler Fläche vorbehalten. */
    font-size: var(--text-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-stat);
    letter-spacing: -0.02em;
    color: var(--science-hallmarks-text, #26251e);
    margin: 0 0 var(--space-2);
  }

  /* ─── CATEGORY TILES ─── */
  .science-hallmarks__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .science-hallmarks__tile {
    padding: var(--space-6);
    background: var(--science-hallmarks-card-bg, #f2f1ed);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .science-hallmarks__tile-range {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-bold);
    line-height: var(--leading-stat);
    letter-spacing: -0.01em;
    color: var(--science-hallmarks-text-muted, rgba(38, 37, 30, 0.35));
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .science-hallmarks__tile-name {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--science-hallmarks-text, #26251e);
    margin: 0;
  }

  .science-hallmarks__tile-desc {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--science-hallmarks-text-secondary, rgba(38, 37, 30, 0.6));
    margin: 0;
  }

  /* ─── TOGGLE BUTTON ─── */
  .science-hallmarks__toggle-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 0;
  }

  /* Ghost button styles scoped to this section */
  .science-hallmarks__toggle-wrap .ltw-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
    padding: 14px 22px;
    border-radius: var(--radius-full);
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.15s ease;
    -webkit-appearance: none;
  }

  .science-hallmarks__toggle-wrap .ltw-btn--ghost {
    background: transparent;
    color: var(--science-hallmarks-text, #26251e);
    border: 1.5px solid currentColor;
    opacity: 0.55;
  }

  .science-hallmarks__toggle-wrap .ltw-btn--ghost:hover {
    opacity: 0.9;
  }

  /* ─── EXPANDABLE DRAWER ─── */
  .science-hallmarks__drawer {
    max-height: 0;
    overflow: hidden;
    /* transition managed by JS to avoid flash on page load */
  }

  /* ─── CATEGORY GROUPS ─── */
  .science-hallmarks__body-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    padding-top: var(--space-7);
  }

  .science-hallmarks__category {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .science-hallmarks__cat-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--science-hallmarks-border, rgba(38, 37, 30, 0.08));
  }

  .science-hallmarks__cat-label {
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--science-hallmarks-text-secondary, rgba(38, 37, 30, 0.6));
    white-space: nowrap;
  }

  .science-hallmarks__cat-desc {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--science-hallmarks-text-muted, rgba(38, 37, 30, 0.35));
  }

  /* ─── GRID ─── */
  .science-hallmarks__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ─── CARD ─── */
  .science-hallmarks__card {
    min-width: 0;
  }

  .science-hallmarks__card-inner {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--science-hallmarks-card-bg, #f2f1ed);
    height: 100%;
  }

  .science-hallmarks__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    color: var(--science-hallmarks-text, #26251e);
  }

  .science-hallmarks__num {
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: var(--weight-regular);
    color: var(--science-hallmarks-text-muted, rgba(38, 37, 30, 0.35));
    flex-shrink: 0;
    line-height: 1;
    position: relative;
    top: -1px;
  }

  .science-hallmarks__desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--science-hallmarks-text-secondary, rgba(38, 37, 30, 0.6));
  }

  /* ─── SOURCE ─── */
  .science-hallmarks__source {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--science-hallmarks-border, rgba(38, 37, 30, 0.08));
  }

  .science-hallmarks__source-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--science-hallmarks-text-muted, rgba(38, 37, 30, 0.35));
  }

  /* ─── RESPONSIVE ─── */
  @media screen and (max-width: 1024px) {
    .science-hallmarks__tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .science-hallmarks__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .science-hallmarks__cat-row {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  @media screen and (max-width: 767px) {
    .science-hallmarks__container {
      padding-inline: var(--space-4);
    }

    .science-hallmarks__tiles {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .science-hallmarks__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .science-hallmarks__body-wrap {
      gap: var(--space-6);
    }

    .science-hallmarks__card-inner {
      padding: var(--space-4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Science Hallmarks",
  "tag": "section",
  "class": "lt-science-hallmarks",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID",
      "info": "Ohne Wert bleibt die automatische ID."
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f7f7f4"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung (Überschrift)",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "12 Mechanismen. Ein biologischer Prozess."
    },
    {
      "type": "textarea",
