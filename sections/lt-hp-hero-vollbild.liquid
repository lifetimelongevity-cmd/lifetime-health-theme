{% comment %}
  lt-hp-hero-vollbild — Vollbild-Hero nach AG1-Muster (Startseite, 26.10.2026).
  Zwei Folien als Blocks: „Person“ (Foto, Verlauf, Headline, Unterzeile, Mint-Knopf,
  Ghost-Knopf) und „Produkt“ (Teal-Verlauf, Kit rechts mit Schatten und −6°, weißer Knopf).
  Scroll-Snap ohne Autoplay, Punkte immer, Pfeile nur Desktop, reduzierte Bewegung beachtet.
  Keine Sterne, kein Preis, keine Faktenzeile im Hero (Regel 1 der AG1-Analyse); die
  stehen in den Sections darunter. Primärknopf Teal wie alle Knöpfe der Seite (BJ 26.10.:
  „nicht dieses Grün“), der Mint-Knopf aus dem Entwurf ist verworfen.
  Die Kopfzeile liegt auf der Startseite absolut über der ersten Section (header_absolute_homepage);
  darum oben ein Papier-Streifen in Kopfzeilenhöhe, damit Logo und Menü auf Hell stehen.
  Ersetzt auf der Startseite crs-hero-typewriter (Datei und Template-Key bleiben als Rückweg).
  Vorlage: docs/entwurf-startseite-ag1-2026-10-26.html, Regeln: docs/ag1-hero-analyse-2026-10-26.md
{% endcomment %}

{%- liquid
  assign folien = section.blocks | size
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --lthv-h-mobil: {{ section.settings.height_mobile }}px;
    --lthv-h-desk: min({{ section.settings.height_desktop_vh }}vh, {{ section.settings.height_desktop_max }}px);
  }
{% endstyle %}

<div class="lthv" data-lthv aria-roledescription="Karussell" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="lthv__kopfraum" aria-hidden="true"></div>
  <div class="lthv__spur" data-lthv-spur>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'person' -%}
          <article class="lthv__folie lthv__folie--person" aria-label="Folie {{ forloop.index }} von {{ folien }}" {{ block.shopify_attributes }}>
            <div class="lthv__bild" style="--lthv-pos-m: {{ block.settings.position_mobile | default: '50% 18%' }}; --lthv-pos-d: {{ block.settings.position_desktop | default: '50% 22%' }};">
              {%- if block.settings.image != blank -%}
                {%- if forloop.first -%}
                  {{
                    block.settings.image
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      widths: '640, 900, 1200, 1600, 2000',
                      sizes: '100vw',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'lazy',
                      widths: '640, 900, 1200, 1600, 2000',
                      sizes: '100vw',
                      alt: block.settings.image.alt
                  }}
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="lthv__text">
              {%- if block.settings.heading != blank -%}
                {%- if forloop.first -%}
                  <h1 class="lthv__titel">{{ block.settings.heading | escape }}</h1>
                {%- else -%}
                  <p class="lthv__titel">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="lthv__sub">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.cta_label != blank or block.settings.ghost_label != blank -%}
                <div class="lthv__knoepfe">
                  {%- if block.settings.cta_label != blank -%}
                    <a class="lthv__knopf lthv__knopf--primaer" href="{{ block.settings.cta_url | default: '/products/lifetime-age-dna' }}">{{ block.settings.cta_label | escape }} <span aria-hidden="true">→</span></a>
                  {%- endif -%}
                  {%- if block.settings.ghost_label != blank -%}
                    <a class="lthv__knopf lthv__knopf--ghost" href="{{ block.settings.ghost_url | default: '#test' }}">{{ block.settings.ghost_label | escape }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </article>

        {%- when 'produkt' -%}
          <article class="lthv__folie lthv__folie--kit" aria-label="Folie {{ forloop.index }} von {{ folien }}" {{ block.shopify_attributes }}>
            <div class="lthv__bild lthv__bild--kit">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1400',
                    sizes: '(min-width: 769px) 52vw, 78vw',
                    alt: block.settings.image.alt
                }}
              {%- endif -%}
            </div>
            <div class="lthv__text">
              {%- if block.settings.heading != blank -%}
                {%- if forloop.first -%}
                  <h1 class="lthv__titel">{{ block.settings.heading | escape }}</h1>
                {%- else -%}
                  <p class="lthv__titel">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="lthv__sub">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <div class="lthv__knoepfe">
                  <a class="lthv__knopf lthv__knopf--weiss" href="{{ block.settings.cta_url | default: '/products/lifetime-age-dna' }}">{{ block.settings.cta_label | escape }} <span aria-hidden="true">→</span></a>
                </div>
              {%- endif -%}
            </div>
          </article>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if folien > 1 -%}
    <button class="lthv__pfeil lthv__pfeil--l" type="button" data-lthv-richtung="-1" aria-label="Vorige Folie">
      {%- comment -%} ph:caret-left-thin {%- endcomment -%}
      <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M162.83 210.83a4 4 0 0 1-5.66 0l-80-80a4 4 0 0 1 0-5.66l80-80a4 4 0 1 1 5.66 5.66L85.66 128l77.17 77.17a4 4 0 0 1 0 5.66"/></svg>
    </button>
    <button class="lthv__pfeil lthv__pfeil--r" type="button" data-lthv-richtung="1" aria-label="Nächste Folie">
      {%- comment -%} ph:caret-right-thin {%- endcomment -%}
      <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="m178.83 130.83l-80 80a4 4 0 0 1-5.66-5.66L170.34 128L93.17 50.83a4 4 0 0 1 5.66-5.66l80 80a4 4 0 0 1 0 5.66"/></svg>
    </button>
    <div class="lthv__punkte" data-lthv-punkte>
      {%- for block in section.blocks -%}
        <button type="button" data-lthv-ziel="{{ forloop.index0 }}" aria-label="Folie {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.lthv {
  position: relative;
  background: var(--color-dark);
  color: var(--color-paper);
  /* Kopfzeile: Logo-Höhe plus --header-vertical-space aus sections/header.liquid, JS misst nach */
  --lthv-kopf: calc(34px + var(--header-vertical-space, 50px));
}
.lthv__kopfraum { height: var(--lthv-kopf); background: var(--color-paper); }
.lthv__spur {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.lthv__spur::-webkit-scrollbar { display: none; }
.lthv__folie {
  position: relative;
  flex: 0 0 100%;
  min-width: 100%;
  height: var(--lthv-h-mobil, 560px);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  scroll-snap-align: start;
}
.lthv__bild { position: absolute; inset: 0; }
.lthv__bild img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--lthv-pos-m, 50% 18%);
}
/* Verlauf unten (mobil), weil unsere Fotos nicht so dunkel sind wie AG1s Video */
.lthv__folie--person .lthv__bild::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(38, 37, 30, 0.78) 0%, rgba(38, 37, 30, 0.35) 45%, rgba(38, 37, 30, 0) 70%);
}
.lthv__folie--kit {
  background: radial-gradient(120% 90% at 85% 20%, #4b6a72 0%, var(--color-dark) 55%, #2b3f45 100%);
}
/* Mobil: Kit oben rechts, Text unten wie auf Folie 1 (BJ 26.10.: „mobile erst das Bild“) */
.lthv__bild--kit {
  inset: 0 0 auto 0;
  height: 60%;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  pointer-events: none;
}
.lthv__bild--kit img {
  width: auto;
  height: 100%;
  max-width: 78%;
  object-fit: contain;
  object-position: right top;
  filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.35));
  transform: translate(8%, 4%) rotate(-6deg);
}
.lthv__text {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px var(--space-7);
}
.lthv__folie--kit .lthv__text { align-self: flex-end; }
.lthv__titel {
  margin: 0 0 var(--space-3);
  max-width: 12em;
  font-family: var(--font-heading);
  font-size: var(--text-h1);
  font-weight: var(--weight-regular);
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: var(--color-paper);
}
.lthv__sub {
  margin: 0 0 var(--space-5);
  max-width: 30em;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  color: var(--color-paper);
}
.lthv__knoepfe { display: flex; gap: var(--space-3); width: 100%; }
.lthv__knopf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  flex: 1 1 0;
  min-width: 0;
  min-height: 48px;
  padding: 14px 12px;
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-medium);
  line-height: 1.25;
  white-space: nowrap;
  text-decoration: none;
  transition: background var(--ease-default);
}
/* Knöpfe wie sonst auf der Seite (lt-hp-test, lt-leiste, PDP-Kaufknopf): Lato 16 px, 500, 15 × 26 px, 48 px hoch, Pille,
   Primärknopf Teal mit heller Schrift, Hover wie der PDP-Kaufknopf (BJ 26.10.: seitenweit Teal, kein Mint) */
.lthv__knopf--primaer { background: var(--color-dark); color: var(--color-text-on-dark); transition: filter var(--ease-default); }
.lthv__knopf--primaer:hover { filter: brightness(1.12); }
.lthv__knopf--weiss { background: var(--color-paper); color: var(--color-dark); }
.lthv__knopf--weiss:hover { background: var(--color-white); }
.lthv__knopf--ghost {
  background: transparent;
  color: var(--color-paper);
  border: 1px solid rgba(247, 247, 244, 0.85);
}
.lthv__knopf--ghost:hover { background: rgba(247, 247, 244, 0.14); }
.lthv__knopf:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 4px; }
.lthv__punkte {
  position: absolute;
  left: 0;
  right: 0;
  bottom: var(--space-4);
  z-index: 2;
  display: flex;
  justify-content: center;
  gap: 6px;
}
.lthv__punkte button {
  width: 8px;
  height: 8px;
  padding: 0;
  border: 0;
  border-radius: var(--radius-full);
  background: rgba(247, 247, 244, 0.5);
  cursor: pointer;
  transition: width var(--ease-default), background var(--ease-default);
}
.lthv__punkte button[aria-current="true"] { width: 28px; background: var(--color-paper); }
.lthv__punkte button:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 3px; }
.lthv__pfeil {
  display: none;
  position: absolute;
  top: calc(50% + var(--lthv-kopf) / 2);
  z-index: 2;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: var(--radius-full);
  background: rgba(247, 247, 244, 0.92);
  color: var(--color-ink);
  cursor: pointer;
  transform: translateY(-50%);
  align-items: center;
  justify-content: center;
}
.lthv__pfeil svg { width: 22px; height: 22px; }
.lthv__pfeil--l { left: var(--space-4); }
.lthv__pfeil--r { right: var(--space-4); }
.lthv__pfeil:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 2px; }
@media (max-width: 1023px) { .lthv { --lthv-kopf: calc(34px + var(--header-vertical-space, 20px)); } }
@media (max-width: 767px) { .lthv { --lthv-kopf: calc(27px + var(--header-vertical-space, 20px)); } }
@media (min-width: 641px) { .lthv__text { padding-left: 24px; padding-right: 24px; } }
@media (min-width: 769px) {
  .lthv__folie { height: var(--lthv-h-desk, min(80vh, 805px)); min-height: 620px; align-items: center; }
  .lthv__bild img { object-position: var(--lthv-pos-d, 50% 22%); }
  .lthv__folie--person .lthv__bild::after {
    background: linear-gradient(to right, rgba(38, 37, 30, 0.62) 0%, rgba(38, 37, 30, 0.28) 45%, rgba(38, 37, 30, 0) 72%);
  }
  .lthv__text { padding-bottom: 0; }
  .lthv__folie--kit .lthv__text { align-self: center; }
  .lthv__bild--kit { inset: 0 0 0 auto; width: 52%; height: 100%; align-items: center; }
  .lthv__bild--kit img { height: 80%; max-width: 100%; object-position: center; transform: translate(4%, 6%) rotate(-6deg); }
  .lthv__titel { margin-bottom: var(--space-4); max-width: 9.5em; font-size: 64px; line-height: 1.02; }
  .lthv__sub { max-width: 26em; font-size: var(--text-section); }
  .lthv__knoepfe { width: auto; }
  .lthv__knopf { flex: 0 0 auto; padding: 15px 26px; }
  .lthv__punkte { bottom: var(--space-5); }
  .lthv__pfeil { display: inline-flex; }
}
@media (min-width: 1025px) { .lthv__text { padding-left: 40px; padding-right: 40px; } }
@media (prefers-reduced-motion: reduce) {
  .lthv__spur { scroll-behavior: auto; }
  .lthv__knopf, .lthv__punkte button { transition: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.lthvInit) return;
    root.dataset.lthvInit = '1';
    var spur = root.querySelector('[data-lthv-spur]');
    var folien = spur ? spur.children : [];
    var punkte = root.querySelectorAll('[data-lthv-ziel]');
    var ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Kopfzeile liegt absolut über dem Hero: Papier-Streifen oben auf ihre echte Höhe setzen */
    var kopf = document.querySelector('.site-header');
    function messeKopf() {
      if (kopf && kopf.offsetHeight) root.style.setProperty('--lthv-kopf', kopf.offsetHeight + 'px');
    }
    messeKopf();
    window.addEventListener('resize', messeKopf, { passive: true });

    if (!spur || folien.length < 2) return;
    function aktuell() { return Math.round(spur.scrollLeft / spur.clientWidth); }
    function zu(i) {
      i = (i + folien.length) % folien.length;
      spur.scrollTo({ left: folien[i].offsetLeft, behavior: ruhig ? 'auto' : 'smooth' });
    }
    function markiere() {
      var i = aktuell();
      punkte.forEach(function (p, k) { p.setAttribute('aria-current', k === i ? 'true' : 'false'); });
    }
    punkte.forEach(function (p) { p.addEventListener('click', function () { zu(+p.dataset.lthvZiel); }); });
    root.querySelectorAll('[data-lthv-richtung]').forEach(function (b) {
      b.addEventListener('click', function () { zu(aktuell() + (+b.dataset.lthvRichtung)); });
    });
    spur.addEventListener('scroll', function () { window.requestAnimationFrame(markiere); }, { passive: true });
  }
  function alle() { document.querySelectorAll('[data-lthv]').forEach(init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', alle); else alle();
  document.addEventListener('shopify:section:load', function (e) {
    var r = e.target && e.target.querySelector && e.target.querySelector('[data-lthv]');
    if (r) { delete r.dataset.lthvInit; init(r); }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "HP Hero Vollbild",
  "tag": "section",
  "class": "section lt-hp-hero-vollbild",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Vollbild-Hero nach AG1-Muster: ein Bild, ein Satz, ein Knopf. Sterne, Preis und Faktenzeile stehen in den Sections darunter." },
    { "type": "text", "id": "aria_label", "label": "Name des Karussells (Screenreader)", "default": "Startseite" },
    { "type": "header", "content": "Höhe" },
    { "type": "range", "id": "height_mobile", "label": "Handy", "min": 420, "max": 720, "step": 10, "default": 560, "unit": "px" },
    { "type": "range", "id": "height_desktop_vh", "label": "Desktop, Anteil der Fensterhöhe", "min": 50, "max": 100, "step": 5, "default": 80, "unit": "vh" },
    { "type": "range", "id": "height_desktop_max", "label": "Desktop, höchstens", "min": 560, "max": 1000, "step": 5, "default": 805, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Folie Person",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto (Person in Bewegung, Hochformat)" },
        { "type": "text", "id": "position_mobile", "label": "Bildausschnitt Handy (object-position)", "default": "50% 18%" },
        { "type": "text", "id": "position_desktop", "label": "Bildausschnitt Desktop (object-position)", "default": "50% 22%" },
        { "type": "text", "id": "heading", "label": "Headline (höchstens sechs Wörter)", "default": "Finde heraus, was wirkt." },
        { "type": "textarea", "id": "subheading", "label": "Unterzeile (sagt, was es ist)", "default": "Dein biologisches Alter zeigt, ob Training, Ernährung und Supplements bei deinem Körper ankommen. Über 150 DNA-Ergebnisse sagen dir, wo du ansetzt. Aus einer Speichelprobe, zu Hause." },
        { "type": "text", "id": "cta_label", "label": "Primärknopf (Teal)", "default": "Test bestellen" },
        { "type": "url", "id": "cta_url", "label": "Ziel des Primärknopfs" },
        { "type": "text", "id": "ghost_label", "label": "Ghost-Knopf", "default": "Was ist der Test?" },
        { "type": "text", "id": "ghost_url", "label": "Ziel des Ghost-Knopfs (Anker)", "default": "#test" }
      ]
    },
    {
      "type": "produkt",
      "name": "Folie Produkt",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Kit freigestellt" },
        { "type": "text", "id": "heading", "label": "Headline", "default": "Der AGE & DNA-Test." },
        { "type": "textarea", "id": "subheading", "label": "Unterzeile", "default": "Biologisches Alter und Gene aus einer Speichelprobe. Ergebnis in der App, mit AI Health Coach." },
        { "type": "text", "id": "cta_label", "label": "Knopf (weiß)", "default": "Test bestellen" },
        { "type": "url", "id": "cta_url", "label": "Ziel des Knopfs" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP Hero Vollbild",
      "blocks": [ { "type": "person" }, { "type": "produkt" } ]
    }
  ]
}
{% endschema %}
