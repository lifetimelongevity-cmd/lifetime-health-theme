{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign crs_lc_kicker = section.settings.kicker | strip
  assign crs_lc_head = section.settings.heading | strip
  assign crs_lc_sub = section.settings.subheading | strip
  if crs_lc_kicker == '__none__'
    assign crs_lc_kicker = ''
  endif
  assign crs_h_headline_lg = false
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  elsif section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif

  comment
    Anker-ID muss VOR dem style-Block stehen: der Wrapper rendert id="{{ sec_anchor }}",
    und der Selektor unten muss dieselbe ID treffen. Solange hier hart
    "#section-<id>" stand, fielen padding_top/padding_bottom ersatzlos weg,
    sobald anchor_id gesetzt war (die Karten stiessen dann direkt an den Footer).
  endcomment
  assign sec_anchor = section.settings.anchor_id
  if sec_anchor == blank
    assign sec_anchor = 'section-' | append: section.id
  endif
-%}
{% style %}
  #{{ sec_anchor }} {
    --crs-bg:       {{ section.settings.color_bg }};
    --crs-card-bg:  {{ section.settings.color_card_bg }};
    --crs-text:     {{ section.settings.color_text }};
    --crs-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.6 }};
    --crs-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.4 }};
    --crs-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.05 }};
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- comment -%}
  Optionale Anker-ID (28.07.): macht den Abschnitt adressierbar und für ein
  Inhaltsverzeichnis ansprechbar. Ohne Wert bleibt die bisherige ID erhalten.
  Zugewiesen wird sie oben vor dem style-Block, siehe Kommentar dort.
{%- endcomment -%}
<div class="lc-section" id="{{ sec_anchor }}">
  <div class="lc-container">
    {%- if crs_lc_kicker != blank or crs_lc_head != blank or crs_lc_sub != blank -%}
      <header class="lc-section-head crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
        {%- if crs_lc_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ crs_lc_kicker | escape }}</p>
        {%- endif -%}
        {%- if crs_lc_head != blank or crs_lc_sub != blank -%}
          <div class="crs-heading-stack__pair">
            {%- if crs_lc_head != blank -%}
              <h2 class="crs-heading-stack__title">{{ crs_lc_head | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if crs_lc_sub != blank -%}
              <p class="crs-heading-stack__subtitle">{{ crs_lc_sub | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        Foto-Karte (16.11.2026): Karte mit Foto und Linkziel wird zur Bildfläche mit Text darauf,
        wie die Bereichs-Karten der Startseite, und ist als Ganzes der Link. Ohne Foto bleibt die
        Karte, wie sie war. Sobald eine Karte ein Foto trägt, läuft die Reihe auf dem Handy seitlich.
      {%- endcomment -%}
      {%- liquid
        assign lc_hat_foto = false
        for block in section.blocks
          if block.settings.image != blank and block.settings.link_url != blank
            assign lc_hat_foto = true
          endif
        endfor
      -%}
      <div class="lc-grid{% if lc_hat_foto %} lc-grid--foto{% endif %}">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank and block.settings.link_url != blank -%}
            {%- liquid
              assign lc_foto_extern = false
              if block.settings.link_url contains '://'
                unless block.settings.link_url contains request.host
                  assign lc_foto_extern = true
                endunless
              endif
            -%}
            <a
              class="lc-card lc-card--foto"
              href="{{ block.settings.link_url }}"
              {% if lc_foto_extern %}target="_blank" rel="noopener noreferrer"{% endif %}
              {{ block.shopify_attributes }}
            >
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 800',
                  sizes: '(min-width: 1025px) 24vw, (min-width: 641px) 48vw, 78vw',
                  class: 'lc-foto',
                  alt: ''
              }}
              <span class="lc-foto-text">
                {%- if block.settings.title != blank -%}
                  <h3 class="lc-foto-titel">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <span class="lc-foto-satz">{{ block.settings.description | escape }}</span>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <span class="lc-foto-link">{{ block.settings.link_label | escape }}{% if lc_foto_extern %}&nbsp;↗{% endif %}</span>
                {%- endif -%}
              </span>
            </a>
          {%- else -%}
          <div class="lc-card" {{ block.shopify_attributes }}>
            <div class="lc-card-body">
              {%- if block.settings.title != blank -%}
                <h3 class="lc-card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="lc-card-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
            {%- assign lc_popup_plain = block.settings.popup_body | default: '' | strip_html | strip -%}
            {%- if block.settings.link_label != blank and lc_popup_plain != '' -%}
              <div class="lc-card-footer">
                <button
                  type="button"
                  class="crs-popup-link"
                  data-crs-dialog-open
                  aria-haspopup="dialog"
                  aria-controls="crs-lc-dialog-{{ section.id }}-{{ block.id }}"
                >
                  {%- comment -%}
                    Kein ↗ am Popup-Trigger: der Pfeil verspricht, die Seite zu verlassen,
                    tatsächlich öffnet sich ein Dialog auf derselben Seite. Er bleibt den
                    echten Fremdlinks vorbehalten.
                  {%- endcomment -%}
                  {{ block.settings.link_label | escape }}
                </button>
              </div>
              <dialog
                id="crs-lc-dialog-{{ section.id }}-{{ block.id }}"
                class="crs-micro-dialog"
                aria-modal="true"
                aria-labelledby="crs-lc-dlg-title-{{ section.id }}-{{ block.id }}"
              >
                <div class="crs-micro-dialog__inner">
                  <button
                    type="button"
                    class="crs-micro-dialog__close"
                    data-crs-dialog-close
                    aria-label="{{ 'general.accessibility_labels.close' | t }}"
                  >
                    <span aria-hidden="true">×</span>
                  </button>
                  {%- assign lc_dlg_title = block.settings.popup_title | default: block.settings.link_label -%}
                  <h2 id="crs-lc-dlg-title-{{ section.id }}-{{ block.id }}" class="crs-micro-dialog__title">
                    {{ lc_dlg_title | escape }}
                  </h2>
                  <div class="crs-micro-dialog__body rte">
                    {{ block.settings.popup_body }}
                  </div>
                </div>
              </dialog>
            {%- elsif block.settings.link_url != blank and block.settings.link_label != blank -%}
              {%- comment -%}
                Neuer Tab und ↗ nur bei echten Fremdzielen. Vorher bekam jeder Link
                target="_blank" plus Pfeil, auch ein interner /pages/-Link — der öffnet
                dann grundlos einen Tab und verspricht optisch, die Seite zu verlassen.
              {%- endcomment -%}
              {%- liquid
                assign lc_is_external = false
                if block.settings.link_url contains '://'
                  unless block.settings.link_url contains request.host
                    assign lc_is_external = true
                  endunless
                endif
              -%}
              <div class="lc-card-footer">
                <a
                  href="{{ block.settings.link_url }}"
                  class="lc-link"
                  {% if lc_is_external %}target="_blank" rel="noopener noreferrer"{% endif %}
                >{{ block.settings.link_label | escape }}{% if lc_is_external %}&nbsp;↗{% endif %}</a>
              </div>
            {%- endif -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% render 'crs-micro-dialog-init' %}

{% stylesheet %}
/* ===================================================
   Link Cards — crs-link-cards.liquid
   =================================================== */

.lc-section {
  background: var(--crs-bg, #f7f7f4);
}

.lc-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 var(--space-5);
}

@media (max-width: 749px) {
  .lc-container {
    padding: 0 var(--space-4);
  }
}

.lc-section-head {
  max-width: 42rem;
  margin-bottom: var(--space-7);
}

.lc-section-head.crs-heading-stack--align-center {
  margin-inline: auto;
}

/* Grid: auto-fit statt fixer 3 Spalten, damit 4 Karten als 4er-Reihe
   laufen statt eine verwaiste vierte Karte zu erzeugen. */
.lc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 10px;
  align-items: stretch;
}

/* Card */
.lc-card {
  box-sizing: border-box;
  background: var(--crs-card-bg, #f2f1ed);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.05));
  border-radius: var(--radius-sm);
  padding: 15px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.lc-card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lc-card-title {
  font-family: var(--font-heading) !important;
  font-size: var(--text-body-lg) !important;
  font-weight: var(--weight-regular) !important;
  line-height: var(--leading-tight) !important;
  letter-spacing: 0 !important;
  color: var(--crs-text, #26251e) !important;
  margin: 0 !important;
}

.lc-card-desc {
  font-size: var(--text-body);
  line-height: var(--leading-relaxed);
  color: var(--crs-text-sec, rgba(38,37,30,0.6));
  margin: 0;
}

/* Footer link */
.lc-card-footer {
  margin-top: 24px;
}

.lc-link {
  font-size: 14px;
  font-weight: 400;
  /* Text nie in Teal/Mint (BJ 26.10.2026), Linkfarbe = Textfarbe der Section */
  color: var(--crs-text, var(--color-ink));
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: var(--color-gray-400);
  transition: color 0.15s ease, text-decoration-color 0.15s ease, opacity 0.15s ease;
}

.lc-link:hover {
  text-decoration-color: currentColor;
  opacity: 0.8;
}

/* Foto-Karte: Bild als Fläche, Verlauf und Schrift wie .ltbk__karte auf der Startseite */
.lc-grid--foto { gap: var(--space-4); }
.lc-card.lc-card--foto {
  position: relative;
  display: block;
  height: auto;
  padding: 0;
  border: 0;
  border-radius: var(--radius-lg);
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: var(--color-dark);
  color: var(--color-paper);
  text-decoration: none;
}
.lc-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.lc-card--foto:hover .lc-foto { transform: scale(1.03); }
.lc-card--foto::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(38, 37, 30, 0.88) 0%, rgba(38, 37, 30, 0.5) 42%, rgba(38, 37, 30, 0) 70%);
}
.lc-foto-text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; display: block; padding: var(--space-4); }
.lc-foto-titel {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-section);
  font-weight: var(--weight-regular);
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--color-paper);
}
.lc-foto-satz {
  display: block;
  margin-top: var(--space-1);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: rgba(247, 247, 244, 0.85);
}
.lc-foto-link {
  display: inline-block;
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  color: var(--color-paper);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.lc-card--foto:focus-visible { outline: 2px solid var(--color-dark); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) {
  .lc-foto { transition: none; }
  .lc-card--foto:hover .lc-foto { transform: none; }
}

/* Tablet — 2 columns */
@media (max-width: 1024px) {
  .lc-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile — 1 column */
@media (max-width: 640px) {
  .lc-grid {
    grid-template-columns: 1fr;
  }
  /* Foto-Karten laufen seitlich wie die Bereichs-Karten der Startseite, sonst wären es vier Bildschirme. */
  .lc-grid.lc-grid--foto {
    display: flex;
    margin: 0 calc(var(--space-4) * -1);
    padding: 0 var(--space-4);
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--space-4);
    scrollbar-width: none;
  }
  .lc-grid.lc-grid--foto::-webkit-scrollbar { display: none; }
  .lc-grid--foto > .lc-card { flex: 0 0 78%; max-width: 320px; scroll-snap-align: start; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Link Cards",
  "tag": "section",
  "class": "crs-link-cards",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID",
      "info": "Ohne Wert bleibt die automatische ID."
    },
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titel",
      "default": "Link-Karten"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Kurzer erklärender Text über den Karten."
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung (Überschrift)",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (28px)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section",
      "info": "Zeilenumbruch: Enter in Titel/Untertitel."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor)"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f7f7f4"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Forum"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschreibung",
          "default": "Erhalte Antworten von unserem Team und der Community."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto (macht daraus eine Foto-Karte)",
          "info": "Hochformat. Braucht eine Link-URL, die ganze Karte ist dann der Link. Leer = Karte wie bisher."
        },
        {
          "type": "header",
          "content": "Popup statt externem Link"
        },
        {
          "type": "richtext",
          "id": "popup_body",
          "label": "Popup-Inhalt",
          "info": "Wenn ausgefüllt: Button öffnet dieses Fenster. Link-URL wird dann ignoriert."
        },
        {
          "type": "text",
          "id": "popup_title",
          "label": "Popup-Titel",
          "info": "Leer = gleich wie Link-Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link-URL",
          "info": "Nur wenn Popup-Inhalt leer ist"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link-Text",
          "default": "Forum besuchen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Link Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Forum",
            "description": "Erhalte Antworten von unserem Team und der Community.",
            "link_label": "Forum besuchen"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Discord",
            "description": "Lerne andere Nutzer kennen und entdecke, was sie bauen.",
            "link_label": "Discord besuchen"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Reddit",
            "description": "Bleib über die neuesten Updates auf dem Laufenden und sieh, was die Community erschafft.",
            "link_label": "Reddit besuchen"
          }
        }
      ]
    }
  ]
}
{% endschema %}
