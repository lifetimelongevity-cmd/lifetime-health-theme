{%- liquid
  assign cr_kicker = section.settings.kicker | strip
  assign cr_head   = section.settings.heading | strip
  assign cr_sub    = section.settings.subheading | strip
  if cr_kicker == '__none__'
    assign cr_kicker = ''
  endif
  if cr_head == '__none__'
    assign cr_head = ''
  endif
  if cr_sub == '__none__'
    assign cr_sub = ''
  endif
  assign cr_align     = section.settings.content_align | default: 'left'
  assign cr_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign cr_headline_lg = true
  endif
  assign cr_headline_md = false
  if section.settings.heading_size == 'feature'
    assign cr_headline_md = true
  endif
  assign cr_visible = section.settings.visible_count | default: 4

  # ── Loox-Quelle ───────────────────────────────────────────────────────────
  # Warum: Die Loox-App-Section rendert clientseitig. Im ausgelieferten HTML
  # stehen rund 580 Byte leerer Container und kein einziger Bewertungstext.
  # Fuer Suchmaschinen und Sprachmodelle ist jede Supplement-PDP damit
  # bewertungslos, obwohl echte Bewertungen vorliegen.
  #
  # Loox legt die Volltexte im Metafeld `loox.reviews` ab, genau zu diesem
  # Zweck, allerdings in einem `display:none`-Container. Versteckter Text ist
  # keine Loesung: er wird abgewertet und niemand liest ihn. Diese Section
  # rendert die Texte deshalb sichtbar und markenkonform in denselben Karten,
  # die auch manuell gepflegte Bewertungen benutzen.
  #
  # Bewusst NICHT gemacht: einzelne `Review`-Knoten im JSON-LD. Die Entscheidung
  # dagegen steht begruendet in snippets/microdata-schema.liquid und bleibt
  # bestehen. Der `aggregateRating`-Knoten dort ist davon unberuehrt.
  #
  # Keine Sterne je Karte: das Metafeld traegt keine Einzelbewertung. Ein
  # Fuenf-Sterne-Default oder der aufs Einzelurteil gemuenzte Produktschnitt
  # waere erfunden. Stattdessen steht der echte Schnitt einmal ueber dem Track.
  #
  # Kein Verifiziert-Badge: Loox sammelt zwar nur nach Kauf, aus dem Metafeld
  # selbst geht das aber nicht hervor. Was nicht in den Daten steht, wird nicht
  # behauptet.
  #
  # Angelegt 2026-07-29.
  assign cr_source = section.settings.review_source | default: 'blocks'
  assign cr_loox_max = section.settings.loox_max | default: 8
  assign cr_loox_min_chars = section.settings.loox_min_chars | default: 0
  assign cr_loox_rating = product.metafields.loox.avg_rating.value | default: 0 | plus: 0
  assign cr_loox_count = product.metafields.loox.num_reviews.value | default: 0 | plus: 0

  assign cr_loox_names = ''
  assign cr_loox_texts = ''
  assign cr_loox_used = 0

  if cr_source == 'loox'
    assign cr_loox_raw = product.metafields.loox.reviews | default: ''
    assign cr_loox_chunks = cr_loox_raw | split: '<div class="review">'
    for chunk in cr_loox_chunks offset: 1
      if cr_loox_used >= cr_loox_max
        break
      endif

      assign cr_t_parts = chunk | split: '<div class="review_text">'
      assign cr_t = ''
      if cr_t_parts.size > 1
        assign cr_t = cr_t_parts[1] | split: '</div>' | first | strip
      endif

      # Loox schreibt "Kein Kommentar" in jede Bewertung ohne Text. Auf einen
      # Bindestrich laeuft dasselbe hinaus. Beides ergibt keine Karte.
      assign cr_t_down = cr_t | downcase
      if cr_t == blank or cr_t_down == 'kein kommentar' or cr_t == '-'
        continue
      endif

      # Mindestlaenge, Default 0 gleich dem Verhalten bis 30.07.
      #
      # Der Filter oben faengt nur die leeren Bewertungen ab, nicht die
      # inhaltsleeren. "Vielen Dank!" ist ein echter Text und ergibt trotzdem
      # eine Karte, die nichts belegt. Eine Section aus solchen Karten kostet
      # mehr Vertrauen, als sie bringt: sie stellt eine Buehne auf und liefert
      # nichts darauf. Lieber drei tragende Zitate und der echte Schnitt
      # darueber als acht Karten, von denen fuenf Fuellmaterial sind.
      #
      # Bewusst eine Laengenschwelle und keine Wortliste: eine Blockliste
      # ("danke", "top", …) muesste gepflegt werden und trifft irgendwann eine
      # echte Bewertung. Die Schwelle ist grob, aber ehrlich begruendbar.
      if cr_loox_min_chars > 0
        assign cr_t_len = cr_t | size
        if cr_t_len < cr_loox_min_chars
          continue
        endif
      endif

      assign cr_n_parts = chunk | split: '<div class="name">'
      assign cr_n = ''
      if cr_n_parts.size > 1
        assign cr_n = cr_n_parts[1] | split: '</div>' | first | strip
      endif
      if cr_n == blank
        assign cr_n = 'Kundin oder Kunde'
      endif

      # Trennzeichen, die in keinem Namen und keinem Bewertungstext vorkommen.
      assign cr_loox_names = cr_loox_names | append: cr_n | append: '||'
      assign cr_loox_texts = cr_loox_texts | append: cr_t | append: '||'
      assign cr_loox_used = cr_loox_used | plus: 1
    endfor
  endif

  assign cr_loox_name_list = cr_loox_names | split: '||'
  assign cr_loox_text_list = cr_loox_texts | split: '||'

  # Kartenzahl je Quelle, einmal berechnet. Die Bedienleiste unter dem Track
  # (Zaehler plus zwei Pfeile) wird fuer beide Zweige aus derselben Zahl gebaut,
  # damit das Markup nur an einer Stelle steht.
  assign cr_block_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign cr_block_count = cr_block_count | plus: 1
    endif
  endfor
  if cr_source == 'loox'
    assign cr_total = cr_loox_used
  else
    assign cr_total = cr_block_count
  endif
-%}

{% style %}
  #section-{{ section.id }} {
    --cr-bg:       {{ section.settings.color_bg }};
    --cr-card-bg:  {{ section.settings.color_card_bg }};
    --cr-text:     {{ section.settings.color_text }};
    --cr-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --cr-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.66 }};
    --cr-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.08 }};
    --cr-visible:  {{ cr_visible }};
    {%- comment -%}
      Bewertungstext lief als einziger Fliesstext der PDP auf 14px, waehrend jeder
      andere Fliesstext 16px hat. Das Setting hebt ihn dort, wo die Bewertungen
      das Argument tragen sollen; Default bleibt 14px, damit die anderen
      Templates unveraendert rendern.
    {%- endcomment -%}
    {%- if section.settings.text_size == 'md' -%}
      --cr-text-size: var(--text-body);
    {%- else -%}
      --cr-text-size: var(--text-body-sm);
    {%- endif -%}
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
  }
{% endstyle %}

{%- comment -%}
  Bedienleiste unter dem Track. Vorher stand dort nur „1 von 5" als Text: keine
  Pfeile, keine Dots, `scrollbar-width: none`, und der angeschnittene Rand rechts
  war mit rund 24px genau so breit wie das Kartenpadding, konnte also nie ein
  Zeichen zeigen. Auf Zeigergeraeten gab es damit ueberhaupt keine Bedienung.
  Der Zaehler bleibt als aria-live-Label, die Pfeile kommen daneben.
{%- endcomment -%}
{%- capture cr_controls -%}
  {%- if cr_total > 1 -%}
    <div class="cr-controls">
      <p class="cr-progress" data-cr-progress aria-live="polite">
        <span data-cr-progress-current>1</span> von {{ cr_total }}
      </p>
      <div class="cr-nav">
        <button type="button" class="cr-nav-btn" data-cr-prev aria-label="Vorherige Bewertung">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3.5 5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="cr-nav-btn" data-cr-next aria-label="Nächste Bewertung">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

<div class="cr-section" id="section-{{ section.id }}">
  <div class="cr-container">

    {%- comment -%} ── Section header ─────────────────────────────── {%- endcomment -%}
    {%- if cr_kicker != blank or cr_head != blank or cr_sub != blank -%}
      <div class="cr-head crs-heading-stack crs-heading-stack--align-{{ cr_align }}{% if cr_headline_lg %} crs-heading-stack--headline-lg{% elsif cr_headline_md %} crs-heading-stack--headline-md{% endif %}">
        {%- if cr_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ cr_kicker | escape }}</p>
        {%- endif -%}
        {%- if cr_head != blank or cr_sub != blank -%}
          <div class="crs-heading-stack__pair">
            {%- if cr_head != blank -%}
              <h2 class="crs-heading-stack__title">{{ cr_head | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if cr_sub != blank -%}
              <p class="crs-heading-stack__subtitle">{{ cr_sub | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Consensus pill tags ────────────────────────── {%- endcomment -%}
    {%- assign cr_has_pills = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'pill' and block.settings.label != blank -%}
        {%- assign cr_has_pills = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if cr_has_pills -%}
      <div class="cr-pills" aria-label="Häufige Themen aus Kundenbewertungen">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pill' and block.settings.label != blank -%}
            <span class="cr-pill" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Review scroll track ────────────────────────── {%- endcomment -%}
    {%- assign cr_has_reviews = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        {%- assign cr_has_reviews = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%}
      Loox-Zweig. Steht vor dem Block-Zweig, damit `review_source: "loox"` die
      Quelle eindeutig festlegt und nicht beide Listen nebeneinander rendern.
      Ohne verwertbare Bewertung rendert der Zweig nichts, die Section faellt
      dann auf ihren Heading-Stack zusammen.
    {%- endcomment -%}
    {%- if cr_source == 'loox' -%}
      {%- if cr_loox_used > 0 -%}

        {%- if cr_loox_rating > 0 and cr_loox_count > 0 -%}
          {%- assign cr_loox_score = cr_loox_rating | round: 1 | replace: '.', ',' -%}
          {%- assign cr_loox_stars = cr_loox_rating | round: 0 -%}
          <p class="cr-aggregate">
            <span class="cr-stars" role="img" aria-label="{{ cr_loox_score }} von 5 Sternen">
              {%- for i in (1..5) -%}
                {%- if i <= cr_loox_stars -%}
                  <svg class="cr-star cr-star--filled" width="14" height="14" viewBox="0 0 14 13" fill="none" aria-hidden="true">
                    <path d="M7 0l1.572 4.837h5.085l-4.114 2.99 1.572 4.836L7 9.673l-4.114 2.99 1.571-4.837-4.114-2.99h5.085L7 0z" fill="currentColor"/>
                  </svg>
                {%- else -%}
                  <svg class="cr-star cr-star--empty" width="14" height="14" viewBox="0 0 14 13" fill="none" aria-hidden="true">
                    <path d="M7 0l1.572 4.837h5.085l-4.114 2.99 1.572 4.836L7 9.673l-4.114 2.99 1.571-4.837-4.114-2.99h5.085L7 0z" stroke="currentColor" stroke-width="0.9" fill="none"/>
                  </svg>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span class="cr-aggregate__value">{{ cr_loox_score }}</span>
            <span class="cr-aggregate__count">aus {{ cr_loox_count }} Bewertungen</span>
          </p>
        {%- endif -%}

        <ul class="cr-track" role="list" data-cr-track>
          {%- for cr_name in cr_loox_name_list -%}
            <li class="cr-card">
              <p class="cr-text">{{ cr_loox_text_list[forloop.index0] | escape | newline_to_br }}</p>
              <div class="cr-author">
                <div class="cr-author-top">
                  <span class="cr-name">{{ cr_name | escape }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {{ cr_controls }}

        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <div class="cr-cta-wrap">
            <a href="{{ section.settings.cta_url }}" class="cr-cta-link">
              {{ section.settings.cta_label | escape }}
            </a>
          </div>
        {%- endif -%}

      {%- endif -%}
    {%- elsif cr_has_reviews -%}
      <ul class="cr-track" role="list" data-cr-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            {%- assign cr_rating = block.settings.rating | default: 5 -%}
            <li class="cr-card" {{ block.shopify_attributes }}>

              {%- comment -%} Stars {%- endcomment -%}
              <div class="cr-stars" aria-label="{{ cr_rating }} von 5 Sternen">
                {%- for i in (1..5) -%}
                  {%- if i <= cr_rating -%}
                    <svg class="cr-star cr-star--filled" width="14" height="14" viewBox="0 0 14 13" fill="none" aria-hidden="true">
                      <path d="M7 0l1.572 4.837h5.085l-4.114 2.99 1.572 4.836L7 9.673l-4.114 2.99 1.571-4.837-4.114-2.99h5.085L7 0z" fill="currentColor"/>
                    </svg>
                  {%- else -%}
                    <svg class="cr-star cr-star--empty" width="14" height="14" viewBox="0 0 14 13" fill="none" aria-hidden="true">
                      <path d="M7 0l1.572 4.837h5.085l-4.114 2.99 1.572 4.836L7 9.673l-4.114 2.99 1.571-4.837-4.114-2.99h5.085L7 0z" stroke="currentColor" stroke-width="0.9" fill="none"/>
                    </svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- comment -%} Review text {%- endcomment -%}
              {%- if block.settings.text != blank -%}
                <p class="cr-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              {%- comment -%} Author row {%- endcomment -%}
              <div class="cr-author">
                <div class="cr-author-top">
                  {%- if block.settings.avatar != blank -%}
                    {%- assign cr_avatar_alt = block.settings.name | escape -%}
                    <div class="cr-avatar" aria-hidden="true">
                      {{
                        block.settings.avatar
                        | image_url: width: 80
                        | image_tag:
                          loading: 'lazy',
                          class: 'cr-avatar-img',
                          alt: cr_avatar_alt
                      }}
                    </div>
                  {%- endif -%}
                  <span class="cr-name">{{ block.settings.name | escape }}</span>
                </div>
                <div class="cr-author-bottom">
                  {%- if block.settings.verified -%}
                    <span class="cr-verified" aria-label="Verifizierter Kauf">
                      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                        <circle cx="5.5" cy="5.5" r="5.5" fill="var(--color-teal)"/>
                        <path d="M3 5.5l1.6 1.6 3.4-3.4" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Verifiziert
                    </span>
                  {%- endif -%}
                  {%- if block.settings.date != blank -%}
                    <time class="cr-date">{{ block.settings.date | escape }}</time>
                  {%- endif -%}
                </div>
              </div>

            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {{ cr_controls }}

      {%- comment -%} ── Optional CTA ───────────────────────────────── {%- endcomment -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <div class="cr-cta-wrap">
          <a href="{{ section.settings.cta_url }}" class="cr-cta-link">
            {{ section.settings.cta_label | escape }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{%- comment -%}
  ── Review-Knoten fuers JSON-LD ────────────────────────────────────────────
  BJ-Entscheid 2026-07-29: Die Bewertungstexte werden maschinenlesbar
  ausgezeichnet. Das ersetzt die frueher gegenteilige Notiz in
  snippets/microdata-schema.liquid, die dort nachgezogen ist.

  WARUM HIER UND NICHT IM LAYOUT-SNIPPET
  Google verlangt, dass ausgezeichnete Bewertungen auf derselben Seite sichtbar
  sind. `microdata-schema.liquid` laeuft auf jeder Produktseite, auch auf denen
  ohne Review-Section; von dort ausgezeichnete Bewertungen waeren unsichtbar
  ausgezeichnet und damit ein Richtlinienverstoss. Der Knoten haengt deshalb an
  der Section, die sie rendert, und wird ueber dieselbe `@id` an den
  Product-Knoten geheftet wie das `aggregateRating`.

  CLAIM-FILTER, NUR FUER DIE LOOX-QUELLE
  Sichtbar bleibt jede Bewertung, die heute schon sichtbar ist. Ausgezeichnet
  wird eine Teilmenge davon, und zwar ohne die mit Wirkbezug. Eine Teilmenge
  ist nach den Google-Richtlinien zulaessig (sichtbar ohne Markup ja, Markup
  ohne sichtbar nein). Der Grund ist VO (EG) 1924/2006 Art. 1 Abs. 2: eine
  ausgezeichnete Kundenaussage wird dem Anbieter als eigene kommerzielle
  Kommunikation zugerechnet. „Bin mit der Wirkung sehr zufrieden" (NAD⁺) oder
  „bin mit der Wirkung zufrieden" (Resveratrol) waeren damit Wirkaussagen von
  LIFETIME. Der Filter faellt bewusst konservativ aus; „wirkt hochwertig" faellt
  mit raus. Ein falsch aussortierter Treffer kostet Reichweite, ein falsch
  ausgezeichneter kostet mehr.

  Fuer die Block-Quelle greift der Filter nicht: die Bloecke sind von Hand
  kuratiert und tragen zusaetzlich eine echte Einzelbewertung, also auch
  `reviewRating`. Nur die sind damit ueberhaupt Rich-Snippet-faehig. Die
  Loox-Quelle liefert `author` und `reviewBody` ohne Rating, weil das Metafeld
  keine Einzelbewertung traegt. Ein erfundener Fuenf-Sterne-Default waere die
  Alternative gewesen und kommt nicht in Frage.
{%- endcomment -%}

{%- liquid
  assign cr_ld_ok = false
  if product != blank and product.url != blank
    assign cr_ld_ok = true
  endif
-%}

{%- if cr_ld_ok -%}
  {%- capture cr_ld_items -%}
    {%- if cr_source == 'loox' -%}
      {%- assign cr_claim_stems = 'wirkung,wirkt,wirksam,energie,fitter,spüre,spürbar,gespürt,schmerz,schlaf,blutdruck,cholesterin,falten,gelenk,abnehm,heilt,geheilt,krank,immunsystem,konzentration,biologisches alter,jünger,verjüng,libido,verdau' | split: ',' -%}
      {%- for cr_ld_name in cr_loox_name_list -%}
        {%- liquid
          assign cr_ld_body = cr_loox_text_list[forloop.index0] | strip
          assign cr_ld_probe = cr_ld_body | downcase
          assign cr_ld_blocked = false
          for stem in cr_claim_stems
            if cr_ld_probe contains stem
              assign cr_ld_blocked = true
              break
            endif
          endfor
        -%}
        {%- unless cr_ld_blocked -%}
          {"@type":"Review","author":{"@type":"Person","name":{{ cr_ld_name | json }}},"reviewBody":{{ cr_ld_body | json }}}@@LDITEM@@
        {%- endunless -%}
      {%- endfor -%}
    {%- elsif cr_has_reviews -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' and block.settings.text != blank -%}
          {%- assign cr_ld_rating = block.settings.rating | default: 5 -%}
          {"@type":"Review","author":{"@type":"Person","name":{{ block.settings.name | default: 'Kundin oder Kunde' | json }}},"reviewBody":{{ block.settings.text | strip | json }},"reviewRating":{"@type":"Rating","ratingValue":{{ cr_ld_rating }},"bestRating":5,"worstRating":1}}@@LDITEM@@
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%}
    Trennzeichen statt nachlaufender Kommas. Der naheliegende Weg, jedes Element
    mit einem Komma zu beenden und das letzte hinterher abzuschneiden, ist hier
    eine Falle: Liquids `split` verwirft das leere Endelement, `split: '},' |
    join: '},'` frisst deshalb die schliessende Klammer des letzten Objekts mit.
    Genau dieselbe Eigenschaft macht das Trennzeichen sauber: das leere Element
    hinter dem letzten `@@LDITEM@@` faellt weg, `join: ','` setzt die Kommas
    danach nur noch zwischen die Elemente.
  {%- endcomment -%}
  {%- assign cr_ld_items = cr_ld_items | split: '@@LDITEM@@' | join: ',' | strip -%}
  {%- if cr_ld_items != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@id": {{ product.url | append: '#product' | json }},
        "review": [{{ cr_ld_items }}]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
/* ============================================================
   Customer Reviews — crs-customer-reviews.liquid
   §12 Spec:
   - Surface:          --cr-bg (default --color-surface-secondary, warm)
   - Card surface:     --cr-card-bg (default white)
   - Dominant element: Section heading
   - Content pattern:  card-review horizontal scroll track
   - CTA:              none (trust signal section)
   - Quality move:     Pill consensus tags above track; avatar as
                       40px circle in author row (not top-of-card)
                       keeps card proportions identical with/without photo.
                       Horizontal snap-scroll with card peek communicates
                       more reviews exist without heavy pagination chrome.
   ============================================================ */

.cr-section {
  background: var(--cr-bg, var(--color-surface-secondary));
}

.cr-container {
  max-width: var(--lt-page-max, 1280px);
  margin: 0 auto;
  padding: 0 var(--lt-page-gutter, 16px);
}

/* ── Section header ───────────────────────────────────────── */
.cr-head {
  margin-bottom: var(--space-7);
}

/* ── Pill tags ────────────────────────────────────────────── */
.cr-pills {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-6);
}

/* Rahmen bleiben — als Reihe tragen die Chips die Sektionsbreite mit.
   Gegen die falsche Klick-Erwartung hilft die zurueckgenommene Flaeche,
   nicht das Entfernen der Form. */
.cr-pill {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-regular);
  line-height: var(--leading-tight);
  color: var(--cr-text-sec);
  background: transparent;
  border: 1px solid var(--cr-border);
  border-radius: var(--radius-full);
  padding: 5px var(--space-3);
  white-space: nowrap;
  cursor: default;
  user-select: none;
}

/* Zaehler unter dem Track. Bewusst Text und kein Dot-Cluster: bei acht Karten
   werden Dots zu Konfetti, "3 von 8" bleibt bei jeder Anzahl lesbar. */
.cr-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin-top: var(--space-3);
}

.cr-progress {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  color: var(--cr-text-sec);
  font-variant-numeric: tabular-nums;
}

.cr-nav {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

/* 44px: Tap-Ziel nach WCAG 2.2 SC 2.5.8 (Minimum 24px) mit Reserve, gleiche
   Groesse wie die uebrigen Icon-Buttons im Theme. Monochrom outline, damit die
   Bedienung nicht mit dem CTA der Section konkurriert. */
.cr-nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid var(--cr-border);
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--cr-text);
  cursor: pointer;
  transition: border-color var(--ease-default), background var(--ease-default), opacity var(--ease-default);
}

.cr-nav-btn:hover {
  border-color: var(--cr-text-sec);
}

.cr-nav-btn:focus-visible {
  outline: 2px solid var(--cr-text);
  outline-offset: 2px;
}

/* Am Anfang bzw. Ende des Tracks: sichtbar, aber erkennbar nicht bedienbar.
   Ausblenden waere ein Layoutsprung bei jedem Wisch. */
.cr-nav-btn[disabled] {
  opacity: 0.35;
  cursor: default;
}

/* ── Scroll track ─────────────────────────────────────────── */
/*
  Card width formula: show --cr-visible cards + a ~20px peek of the next.
  (container + gap) / n - gap - peek
  Using gap = var(--space-5) = 24px; peek ≈ 24px.
*/
.cr-track {
  display: flex;
  gap: var(--space-5);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  padding-bottom: var(--space-3); /* room for card shadow */
  /* Hide scrollbar — scrollability communicated via card peek */
  scrollbar-width: none;
  -ms-overflow-style: none;
  list-style: none;
  margin: 0;
  padding-left: 0;
}

.cr-track::-webkit-scrollbar {
  display: none;
}

/* ── Review card ──────────────────────────────────────────── */
.cr-card {
  flex: 0 0 calc(
    (100% + var(--space-5)) / var(--cr-visible, 4) - var(--space-5) - 24px
  );
  min-width: 220px; /* intentional: floor below which review text becomes illegible */
  scroll-snap-align: start;
  box-sizing: border-box;
  background: var(--cr-card-bg, var(--color-surface-primary));
  border: 1px solid var(--cr-border);
  border-radius: var(--radius-md);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

/* ── Stars ────────────────────────────────────────────────── */
.cr-stars {
  display: flex;
  align-items: center;
  gap: 3px; /* intentional: tighter than --space-1 (4px) — stars read as a unit */
  flex-shrink: 0;
}

/* Aggregat-Zeile ueber dem Track. Erscheint nur im Loox-Zweig, weil dort keine
   Einzelbewertung je Karte vorliegt und der Schnitt die einzige echte Zahl ist. */
.cr-aggregate {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: 0 0 var(--space-5);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-body);
  color: var(--cr-text-sec);
}

.cr-aggregate__value {
  font-weight: var(--weight-semibold);
  font-variant-numeric: tabular-nums;
  color: var(--cr-text);
}

.cr-star {
  display: block;
  flex-shrink: 0;
}

.cr-star--filled {
  color: var(--color-star, #F4B740);
}

.cr-star--empty {
  color: var(--cr-text-ter);
}

/* ── Review text ──────────────────────────────────────────── */
.cr-text {
  font-family: var(--font-body);
  font-size: var(--cr-text-size, var(--text-body-sm));
  line-height: var(--leading-body);
  color: var(--cr-text);
  margin: 0;
  flex: 1 1 auto; /* push author row to bottom */
}

/* ── Author row ───────────────────────────────────────────── */
.cr-author {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: auto;
  flex-shrink: 0;
}

.cr-author-top {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}

.cr-author-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

/* Avatar — 40px circle, only rendered when image set */
.cr-avatar {
  flex-shrink: 0;
  width: 40px;  /* intentional: fixed avatar size — no token equivalent; 40px is minimum legible face */
  height: 40px; /* intentional: fixed avatar size — matches width for 1:1 circle */
  border-radius: var(--radius-full);
  overflow: hidden;
  border: 1px solid var(--cr-border);
}

.cr-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.cr-name {
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-tight);
  color: var(--cr-text);
  min-width: 0;
}

.cr-verified {
  display: inline-flex;
  align-items: center;
  gap: 4px; /* intentional: between --space-1 (4px) — matches icon visual gap */
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-medium);
  line-height: var(--leading-tight);
  color: var(--color-teal-dark);
  white-space: nowrap;
}

/* ── CTA below track ──────────────────────────────────────── */
.cr-cta-wrap {
  margin-top: var(--space-6);
  display: flex;
  justify-content: center;
}

.cr-cta-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 14px var(--space-7);
  border-radius: var(--radius-full);
  border: 1px solid var(--cr-text);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-tight);
  color: var(--cr-text);
  text-decoration: none;
  transition: background var(--ease-default), color var(--ease-default);
}

.cr-cta-link:hover {
  background: var(--cr-text);
  color: var(--color-text-on-dark);
}

.cr-verified svg {
  flex-shrink: 0;
}

.cr-date {
  font-family: var(--font-body);
  font-size: var(--text-micro);
  line-height: var(--leading-tight);
  color: var(--cr-text-ter);
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 1024px) {
  .cr-card {
    /* Tablet: show ~2.3 cards */
    flex: 0 0 calc((100% + var(--space-5)) / 2.3 - var(--space-5));
  }
}

@media (max-width: 640px) {
  /*
    Mobil war der Faktor 1.15. Auf 390px Geraetebreite ergab das rund 294px
    Kartenbreite und einen sichtbaren Rest von rund 24px, also exakt die Breite
    des Kartenpaddings: der Peek konnte konstruktionsbedingt nie ein Zeichen
    zeigen und las als abgeschnittene leere Flaeche. 1.35 laesst rund 50px
    Textflaeche der naechsten Karte stehen, damit ist der Anschnitt als Satz
    erkennbar und nicht als Fehler.
  */
  .cr-card {
    flex: 0 0 calc((100% + var(--space-5)) / 1.35 - var(--space-5));
    min-width: 0;
  }

  .cr-head {
    margin-bottom: var(--space-6);
  }
}
{% endstylesheet %}

