{% javascript %}
(function () {
  function bind(root) {
    var track = root.querySelector('[data-cr-track]');
    var out = root.querySelector('[data-cr-progress-current]');
    if (!track || !out || track.__crBound) return;
    track.__crBound = true;

    var prev = root.querySelector('[data-cr-prev]');
    var next = root.querySelector('[data-cr-next]');

    // Schrittweite = eine Karte plus Gap. Aus dem DOM gelesen statt aus dem CSS
    // gespiegelt, damit die drei Breakpoints der Kartenformel nicht zweimal
    // gepflegt werden muessen.
    function step() {
      var cards = track.children;
      if (cards.length < 2) return track.clientWidth;
      return cards[1].offsetLeft - cards[0].offsetLeft;
    }

    var raf = null;
    function update() {
      raf = null;
      var cards = track.children;
      if (!cards.length) return;
      var mid = track.scrollLeft + track.clientWidth / 2;
      var idx = 0;
      for (var i = 0; i < cards.length; i++) {
        var c = cards[i];
        if (c.offsetLeft <= mid && c.offsetLeft + c.offsetWidth > mid) { idx = i; break; }
        if (c.offsetLeft <= mid) idx = i;
      }
      out.textContent = String(idx + 1);

      // 1px Toleranz: scrollLeft ist bei fraktionalen Kartenbreiten nicht ganzzahlig.
      var max = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 1;
      if (next) next.disabled = track.scrollLeft >= max - 1;
    }

    track.addEventListener('scroll', function () {
      if (raf === null) raf = requestAnimationFrame(update);
    }, { passive: true });

    if (prev) {
      prev.addEventListener('click', function () {
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
    }
    if (next) {
      next.addEventListener('click', function () {
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
    }

    update();
  }

  function init() {
    document.querySelectorAll('.cr-section, [id^="shopify-section"]').forEach(bind);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}
