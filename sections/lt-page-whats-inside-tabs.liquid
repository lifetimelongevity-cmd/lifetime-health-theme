{% comment %}
  LT Page — Whats Inside Tabs (/pages/was-ist-enthalten)

  Drei Tabs: Epigenetik, Genetik, AI Coach. Je Tab ein Heading-Stack auf
  --text-h2 (headline-md, wie die H2 auf /pages/science), der Erklaertext
  (`*_body`) steht als Fliesstext ausserhalb von crs-heading-stack__pair.

  Die 23 DNA-Kategorien stehen alle im Markup. Ab 980px sind alle sichtbar,
  darunter die ersten `dna_cards_per_page` plus Button „Alle … anzeigen".
  Bis 29.09.2026 gab es hier eine Seiten-Paginierung (8 je Seite), die 15
  der 23 Kategorien per `hidden` versteckte.
{% endcomment %}

{%- liquid
  assign epigenetic_blocks = section.blocks | where: 'type', 'epigenetic_item'
  assign dna_blocks = section.blocks | where: 'type', 'dna_category'
  assign ai_blocks = section.blocks | where: 'type', 'ai_question'
  assign dna_mobile_limit = section.settings.dna_cards_per_page | default: 8
  assign dna_first_extra_index = dna_mobile_limit | plus: 1

  assign epi_kicker = section.settings.epigenetics_kicker | strip
  if epi_kicker == '__none__'
    assign epi_kicker = ''
  endif
  assign dna_kicker = section.settings.dna_kicker | strip
  if dna_kicker == '__none__'
    assign dna_kicker = ''
  endif
  assign ai_kicker = section.settings.ai_kicker | strip
  if ai_kicker == '__none__'
    assign ai_kicker = ''
  endif
-%}

<section
  id="lt-page-whats-inside-tabs-{{ section.id }}"
  class="lt-page-whats-inside-tabs"
  style="--lt-wit-bg: {{ section.settings.color_bg }};"
  aria-labelledby="lt-page-whats-inside-tabs-heading-{{ section.id }}"
  data-inside-tabs-root
>
  <div class="container container--large remove-empty-space">
    <div class="lt-page-whats-inside-tabs__tablist" role="tablist" aria-label="Inhalte des Tests">
      <button
        type="button"
        class="lt-page-whats-inside-tabs__tab is-active"
        id="lt-page-whats-inside-tabs-tab-epi-{{ section.id }}"
        role="tab"
        aria-selected="true"
        aria-controls="lt-page-whats-inside-tabs-panel-epi-{{ section.id }}"
        tabindex="0"
        data-inside-tab
      >
        {{ section.settings.epigenetics_tab_label | escape }}
      </button>
      <button
        type="button"
        class="lt-page-whats-inside-tabs__tab"
        id="lt-page-whats-inside-tabs-tab-dna-{{ section.id }}"
        role="tab"
        aria-selected="false"
        aria-controls="lt-page-whats-inside-tabs-panel-dna-{{ section.id }}"
        tabindex="-1"
        data-inside-tab
      >
        {{ section.settings.dna_tab_label | escape }}
      </button>
      <button
        type="button"
        class="lt-page-whats-inside-tabs__tab"
        id="lt-page-whats-inside-tabs-tab-ai-{{ section.id }}"
        role="tab"
        aria-selected="false"
        aria-controls="lt-page-whats-inside-tabs-panel-ai-{{ section.id }}"
        tabindex="-1"
        data-inside-tab
      >
        {{ section.settings.ai_tab_label | escape }}
      </button>
    </div>

    <div class="lt-page-whats-inside-tabs__panels">
      <div
        class="lt-page-whats-inside-tabs__panel is-active"
        id="lt-page-whats-inside-tabs-panel-epi-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="lt-page-whats-inside-tabs-tab-epi-{{ section.id }}"
        data-inside-panel
        tabindex="0"
      >
        <div class="lt-page-whats-inside-tabs__split">
          <div class="lt-page-whats-inside-tabs__copy">
            <div class="crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-md">
              {%- if epi_kicker != blank -%}
                <p class="crs-heading-stack__kicker">{{ epi_kicker | escape }}</p>
              {%- endif -%}
              <div class="crs-heading-stack__pair">
                <h2 class="crs-heading-stack__title" id="lt-page-whats-inside-tabs-heading-{{ section.id }}">
                  {{- section.settings.epigenetics_heading | escape -}}
                </h2>
                {%- if section.settings.epigenetics_subheading != blank -%}
                  <p class="crs-heading-stack__subtitle">{{ section.settings.epigenetics_subheading | escape }}</p>
                {%- endif -%}
              </div>
            </div>
            {%- if section.settings.epigenetics_body != blank -%}
              <p class="lt-page-whats-inside-tabs__lede">{{ section.settings.epigenetics_body | escape }}</p>
            {%- endif -%}

            {%- if epigenetic_blocks.size > 0 -%}
              <ul class="lt-page-whats-inside-tabs__epi-list" role="list">
                {%- for block in epigenetic_blocks -%}
                  <li class="lt-page-whats-inside-tabs__card" {{ block.shopify_attributes }}>
                    <h3 class="lt-page-whats-inside-tabs__item-title">{{ block.settings.title | escape }}</h3>
                    {%- if block.settings.description != blank -%}
                      <p class="lt-page-whats-inside-tabs__item-body">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- render 'lt-whats-inside-tabs-media',
            image: section.settings.epigenetics_image,
            image_url: section.settings.epigenetics_image_url,
            alt: section.settings.epigenetics_image_alt,
            fallback_alt: section.settings.epigenetics_heading
          -%}
        </div>
      </div>

      <div
        class="lt-page-whats-inside-tabs__panel"
        id="lt-page-whats-inside-tabs-panel-dna-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="lt-page-whats-inside-tabs-tab-dna-{{ section.id }}"
        data-inside-panel
        tabindex="0"
        hidden
      >
        <div class="lt-page-whats-inside-tabs__split">
          <div class="lt-page-whats-inside-tabs__copy">
            <div class="crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-md">
              {%- if dna_kicker != blank -%}
                <p class="crs-heading-stack__kicker">{{ dna_kicker | escape }}</p>
              {%- endif -%}
              <div class="crs-heading-stack__pair">
                <h2 class="crs-heading-stack__title">{{ section.settings.dna_heading | escape }}</h2>
                {%- if section.settings.dna_subheading != blank -%}
                  <p class="crs-heading-stack__subtitle">{{ section.settings.dna_subheading | escape }}</p>
                {%- endif -%}
              </div>
            </div>
            {%- if section.settings.dna_body != blank -%}
              <p class="lt-page-whats-inside-tabs__lede">{{ section.settings.dna_body | escape }}</p>
            {%- endif -%}

            {%- if dna_blocks.size > 0 -%}
              <div
                class="lt-page-whats-inside-tabs__dna-stack{% if dna_blocks.size > dna_mobile_limit %} is-collapsible{% endif %}"
                data-dna-stack
              >
                <ul class="lt-page-whats-inside-tabs__dna-grid" role="list" id="lt-page-whats-inside-tabs-dna-grid-{{ section.id }}">
                  {%- for block in dna_blocks -%}
                    <li
                      class="lt-page-whats-inside-tabs__card{% if forloop.index > dna_mobile_limit %} is-extra{% endif %}"
                      {% if forloop.index == dna_first_extra_index %}tabindex="-1" data-dna-first-extra{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <h3 class="lt-page-whats-inside-tabs__item-title">{{ block.settings.title | escape }}</h3>
                      {%- if block.settings.examples != blank -%}
                        <p class="lt-page-whats-inside-tabs__item-body">{{ block.settings.examples | escape }}</p>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if dna_blocks.size > dna_mobile_limit -%}
                  <button
                    type="button"
                    class="lt-page-whats-inside-tabs__more"
                    aria-expanded="false"
                    aria-controls="lt-page-whats-inside-tabs-dna-grid-{{ section.id }}"
                    data-dna-more
                  >
                    Alle {{ dna_blocks.size }} Kategorien anzeigen
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {%- render 'lt-whats-inside-tabs-media',
            image: section.settings.dna_image,
            image_url: section.settings.dna_image_url,
            alt: section.settings.dna_image_alt,
            fallback_alt: section.settings.dna_heading
          -%}
        </div>
      </div>

      <div
        class="lt-page-whats-inside-tabs__panel"
        id="lt-page-whats-inside-tabs-panel-ai-{{ section.id }}"
        role="tabpanel"
        aria-labelledby="lt-page-whats-inside-tabs-tab-ai-{{ section.id }}"
        data-inside-panel
        tabindex="0"
        hidden
      >
        <div class="lt-page-whats-inside-tabs__split">
          <div class="lt-page-whats-inside-tabs__copy">
            <div class="crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-md">
              {%- if ai_kicker != blank -%}
                <p class="crs-heading-stack__kicker">{{ ai_kicker | escape }}</p>
              {%- endif -%}
              <div class="crs-heading-stack__pair">
                <h2 class="crs-heading-stack__title">{{ section.settings.ai_heading | escape }}</h2>
                {%- if section.settings.ai_subheading != blank -%}
                  <p class="crs-heading-stack__subtitle">{{ section.settings.ai_subheading | escape }}</p>
                {%- endif -%}
              </div>
            </div>
            {%- if section.settings.ai_body != blank -%}
              <p class="lt-page-whats-inside-tabs__lede">{{ section.settings.ai_body | escape }}</p>
            {%- endif -%}

            {%- if ai_blocks.size > 0 -%}
              <ul class="lt-page-whats-inside-tabs__ai-list" role="list" aria-label="Beispielfragen an den AI Health Coach">
                {%- for block in ai_blocks -%}
                  <li class="lt-page-whats-inside-tabs__card lt-page-whats-inside-tabs__ai-item" {{ block.shopify_attributes }}>
                    <svg class="lt-page-whats-inside-tabs__ai-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span>{{ block.settings.question | escape }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- render 'lt-whats-inside-tabs-media',
            image: section.settings.ai_image,
            image_url: section.settings.ai_image_url,
            alt: section.settings.ai_image_alt,
            fallback_alt: section.settings.ai_heading
          -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% javascript %}
  (function () {
    function initializeDnaMore(root) {
      var stacks = root.querySelectorAll('[data-dna-stack]');
      stacks.forEach(function (stack) {
        var button = stack.querySelector('[data-dna-more]');
        if (!button || button.dataset.dnaMoreReady === 'true') return;

        button.addEventListener('click', function () {
          stack.classList.add('is-expanded');
          button.setAttribute('aria-expanded', 'true');
          var firstExtra = stack.querySelector('[data-dna-first-extra]');
          if (firstExtra) firstExtra.focus({ preventScroll: true });
        });

        button.dataset.dnaMoreReady = 'true';
      });
    }

    function initializeInsideTabs(root) {
      if (!root || root.dataset.insideTabsReady === 'true') return;

      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-inside-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-inside-panel]'));
      if (!tabs.length || tabs.length !== panels.length) return;

      function activateTab(nextTab, shouldFocus) {
        if (!nextTab) return;

        tabs.forEach(function (tab, index) {
          var isActive = tab === nextTab;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
          panels[index].classList.toggle('is-active', isActive);
          panels[index].hidden = !isActive;
        });

        if (shouldFocus) nextTab.focus();
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
          activateTab(tab, false);
        });

        tab.addEventListener('keydown', function (event) {
          var targetIndex = null;

          if (event.key === 'ArrowRight') {
            targetIndex = (index + 1) % tabs.length;
          } else if (event.key === 'ArrowLeft') {
            targetIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === 'Home') {
            targetIndex = 0;
          } else if (event.key === 'End') {
            targetIndex = tabs.length - 1;
          }

          if (targetIndex === null) return;

          event.preventDefault();
          activateTab(tabs[targetIndex], true);
        });
      });

      initializeDnaMore(root);
      root.dataset.insideTabsReady = 'true';
    }

    function initializeAllInsideTabs(container) {
      var scope = container || document;
      var roots = scope.querySelectorAll('[data-inside-tabs-root]');
      roots.forEach(function (root) {
        initializeInsideTabs(root);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initializeAllInsideTabs(document);
      }, { once: true });
    } else {
      initializeAllInsideTabs(document);
    }

    document.addEventListener('shopify:section:load', function (event) {
      initializeAllInsideTabs(event.target);
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .lt-page-whats-inside-tabs {
    padding-block: var(--space-9);
    background: var(--lt-wit-bg, var(--color-surface-secondary));
  }

  .lt-page-whats-inside-tabs__tablist {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .lt-page-whats-inside-tabs__tablist::-webkit-scrollbar {
    display: none;
  }

  /* Inaktive Tabs brauchen eine eigene Flaeche: ohne sie lagen sie farbgleich
     auf dem Section-Grund und lasen sich als Fliesstext, nicht als Schalter. */
  .lt-page-whats-inside-tabs__tab {
    flex: 0 0 auto;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-full);
    background: var(--color-surface-primary);
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--ease-default), color var(--ease-default), border-color var(--ease-default);
    -webkit-tap-highlight-color: transparent;
  }

  .lt-page-whats-inside-tabs__tab:hover {
    border-color: var(--color-dark);
  }

  .lt-page-whats-inside-tabs__tab.is-active {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-text-on-dark);
    font-weight: var(--weight-semibold);
    cursor: default;
  }

  .lt-page-whats-inside-tabs__tab:focus-visible {
    outline: 2px solid var(--color-dark);
    outline-offset: 3px;
  }

  .lt-page-whats-inside-tabs__panel {
    display: block;
  }

  .lt-page-whats-inside-tabs__panel[hidden] {
    display: none !important;
  }

  .lt-page-whats-inside-tabs__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media screen and (min-width: 980px) {
    .lt-page-whats-inside-tabs__tablist {
      justify-content: center;
      flex-wrap: wrap;
      overflow-x: visible;
      gap: var(--space-3);
    }

    .lt-page-whats-inside-tabs__tab {
      padding: var(--space-4) var(--space-6);
      font-size: var(--text-body);
    }

    .lt-page-whats-inside-tabs__split {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
      gap: var(--space-8);
    }

    .lt-page-whats-inside-tabs__media {
      position: sticky;
      top: var(--space-7);
      align-self: start;
    }
  }

  .lt-page-whats-inside-tabs__copy,
  .lt-page-whats-inside-tabs__media {
    min-width: 0;
  }

  .lt-page-whats-inside-tabs__lede {
    margin: var(--space-4) 0 0;
    max-width: var(--lt-measure);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-secondary);
  }

  .lt-page-whats-inside-tabs__media-frame {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lt-page-whats-inside-tabs__image {
    display: block;
    width: 100%;
    max-width: 280px;
    height: auto;
  }

  .lt-page-whats-inside-tabs__epi-list,
  .lt-page-whats-inside-tabs__ai-list,
  .lt-page-whats-inside-tabs__dna-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .lt-page-whats-inside-tabs__card {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
  }

  .lt-page-whats-inside-tabs__card:focus {
    outline: none;
  }

  .lt-page-whats-inside-tabs__card:focus-visible {
    outline: 2px solid var(--color-dark);
    outline-offset: 2px;
  }

  @media screen and (min-width: 720px) {
    .lt-page-whats-inside-tabs__epi-list,
    .lt-page-whats-inside-tabs__ai-list,
    .lt-page-whats-inside-tabs__dna-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
  }

  @media screen and (min-width: 1280px) {
    .lt-page-whats-inside-tabs__dna-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lt-page-whats-inside-tabs__more {
    display: none;
  }

  @media screen and (max-width: 979px) {
    .lt-page-whats-inside-tabs__dna-stack.is-collapsible:not(.is-expanded) .is-extra {
      display: none;
    }

    .lt-page-whats-inside-tabs__dna-stack.is-collapsible:not(.is-expanded) .lt-page-whats-inside-tabs__more {
      display: block;
      width: 100%;
      margin-top: var(--space-4);
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-dark);
      border-radius: var(--radius-full);
      background: transparent;
      font-family: var(--font-body);
      font-size: var(--text-body);
      font-weight: var(--weight-medium);
      color: var(--color-dark);
      line-height: 1;
      cursor: pointer;
    }

    .lt-page-whats-inside-tabs__more:focus-visible {
      outline: 2px solid var(--color-dark);
      outline-offset: 3px;
    }
  }

  .lt-page-whats-inside-tabs__item-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-body);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    hyphens: auto;
  }

  .lt-page-whats-inside-tabs__item-body {
    margin: var(--space-2) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
  }

  .lt-page-whats-inside-tabs__ai-item {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-regular);
    color: var(--color-text-primary);
    line-height: var(--leading-body);
  }

  .lt-page-whats-inside-tabs__ai-icon {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--color-text-secondary);
  }

  @media screen and (max-width: 767px) {
    .lt-page-whats-inside-tabs {
      padding-block: var(--space-8);
    }

    .lt-page-whats-inside-tabs__tablist {
      margin-bottom: var(--space-6);
    }

    .lt-page-whats-inside-tabs__image {
      max-width: 220px;
    }
  }
{% endstylesheet %}

{% schema %}
