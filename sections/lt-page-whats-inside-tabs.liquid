      "label": "Bild"
    },
    {
      "type": "url",
      "id": "epigenetics_image_url",
      "label": "Bild-URL"
    },
    {
      "type": "text",
      "id": "epigenetics_image_alt",
      "label": "Bild Alt-Text"
    },
    {
      "type": "header",
      "content": "DNA"
    },
    {
      "type": "text",
      "id": "dna_kicker",
      "label": "Kicker",
      "default": "__none__",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "text",
