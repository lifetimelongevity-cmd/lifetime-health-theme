{% comment %}
  LIFETIME — LT Benefits (card-info × 3)
  ──────────────────────────────────────
  Port des approved Examples `_examples/sections/benefits.liquid`.
  Content-Pattern (Grid, card-info, Icon-Pocket) 1:1 übernommen.
  Abweichung zum Example: Section-Header läuft über das kanonische
  `section-heading-crs`-Snippet (docs/section-heading-stack.md) statt
  lokalem Header-CSS.

  §12 Build Spec:
  - Surface:          --color-surface-secondary (warm)
  - Section label:    kicker via heading-stack
  - Dominant element: Section-Headline (--text-h1 via headline_lg)
  - Content pattern:  card-info × 3 (Icon + Titel + Beschreibung)
  - CTA:              optional outline; Default: keiner
  - Removed:          Card-Bilder, Card-CTAs, Card-Borders auf warmem Grund,
                      Section-Description (Kicker + Headline reichen)
  - Quality move:     Icon in benefit-bg Pocket mit teal-dark Icon —
                      weicher Akzent ohne Farbflutung der Karte
{% endcomment %}

{{ 'section-lt-benefits.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ltb_headline_lg = true
  assign ltb_headline_md = false
  if section.settings.heading_size == 'section'
    assign ltb_headline_lg = false
  elsif section.settings.heading_size == 'feature'
    assign ltb_headline_lg = false
    assign ltb_headline_md = true
  endif

  comment
    __none__ = ausblenden, wie in den crs-Sections. Ohne diesen Strip müsste
    man das Feld im Template löschen, und dann greift der Schema-Default.
  endcomment
  assign ltb_kicker = section.settings.kicker | strip
  if ltb_kicker == '__none__'
    assign ltb_kicker = ''
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .lt-benefits {
    background-color: {{ section.settings.color_bg | default: '#f6f4f1' }};
  }
{% endstyle %}

<section class="lt-benefits{% if section.settings.card_style == 'motiv' %} lt-benefits--motif{% endif %}">
  <div class="lt-benefits__container">

    {% render 'section-heading-crs',
      heading: section.settings.title,
      subheading: section.settings.subheading,
      kicker: ltb_kicker,
      align: section.settings.content_align,
      headline_lg: ltb_headline_lg,
      headline_md: ltb_headline_md,
      heading_tag: 'h2',
      extra_class: 'lt-benefits__header'
    %}

    <ul class="lt-benefits__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="lt-benefits__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="lt-benefits__card-icon" aria-hidden="true">
              {{ block.settings.icon }}
            </div>
          {%- endif -%}
          <h3 class="lt-benefits__card-title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="lt-benefits__card-description">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="lt-benefits__cta">
        <a href="{{ section.settings.cta_url }}" class="lt-btn--outline">
          {{ section.settings.cta_label | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "LT Benefits",
  "tag": "section",
  "class": "lt-benefits-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (micro label)",
      "default": "Unsere Werte"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Was macht LIFETIME einzigartig?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (optional)",
      "info": "Bildet mit dem Heading einen Block. Leer = keine Subline."
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung Header",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (28px)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "product_title"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Kartenstil",
      "options": [
        { "value": "icon", "label": "Icon in Fläche (48px)" },
        { "value": "motiv", "label": "Motiv freistehend" }
      ],
      "default": "icon",
      "info": "„Motiv freistehend\" zeigt das SVG ohne Kachel in voller Breite, z. B. für Mini-Diagramme."
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#f6f4f1"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "info": "Leer lassen, wenn kein CTA gebraucht wird."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG)",
          "info": "Inline-SVG einfügen (lucide, 24×24, currentColor stroke)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wissenschaftlich fundiert"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Jede Empfehlung beruht auf soliden, evidenzbasierten Erkenntnissen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LT Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
