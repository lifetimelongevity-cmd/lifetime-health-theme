</style>

<script>
  (function () {
    if (customElements.get('lt-bf-bundle')) return;

    var SPEICHER = 'lt_bfb_auswahl';
    var MAX_JE_PRODUKT = 9;

    function stufe(n) { return n >= 3 ? 40 : n === 2 ? 30 : n === 1 ? 20 : 0; }
    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function kurz(titel) { return titel.replace(/\s+(Kapseln|Pulver)$/i, '').replace(/\s*\([^)]*\)/g, ''); }

    class LtBfBundle extends HTMLElement {
      connectedCallback() {
        if (this.bereit) return;
        this.bereit = true;
        var self = this;

        this.symbol = this.dataset.symbol || '€';
        this.versandKosten = Number(this.dataset.versandKosten) || 0;
        this.versandFrei = Number(this.dataset.versandFrei) || 0;
        this.wurzel = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        this.truck = (this.querySelector('[data-icon-truck]') || {}).innerHTML || '';

        this.rabattIds = {};
        try {
          JSON.parse(this.querySelector('[data-rabatt-ids]').textContent).forEach(function (id) { self.rabattIds[id] = true; });
        } catch (e) {}

        // Produkte aus den Kacheln lesen
        this.produkte = [];
        this.nachVariante = {};
        this.nachHandle = {};
        this.querySelectorAll('[data-karte]').forEach(function (karte) {
          var varianten = [];
          try { varianten = JSON.parse(karte.querySelector('[data-varianten]').textContent); } catch (e) {}
          if (!varianten.length) { karte.hidden = true; return; }
          var bild = karte.querySelector('[data-bild]');
          var p = {
            id: Number(karte.dataset.pid),
            handle: karte.dataset.handle,
            titel: karte.dataset.titel,
            bild: bild ? bild.currentSrc || bild.src : '',
            varianten: varianten,
            karte: karte
          };
          varianten.forEach(function (v) { v.produkt = p; self.nachVariante[v.id] = v; });
          self.nachHandle[p.handle] = p;
          self.produkte.push(p);
        });

        this.menge = {};     // Varianten-ID -> Stück
        this.aktiv = {};     // Produkt-ID -> gezeigte Variante
        this.beruehrt = {};  // Varianten, die diese Seite im Warenkorb führt
        this.korb = [];      // Zeilen des Warenkorbs beim Laden
        this.letztePct = null;

        // Fertige Stapel auflösen
        this.stapel = [];
        this.querySelectorAll('[data-stapel]').forEach(function (knopf) {
          var teile = [];
          var ok = true;
          knopf.dataset.stapel.split(',').forEach(function (roh) {
            var s = roh.trim();
            if (!s) return;
            var handle = s.split(':')[0].trim();
            var groesse = (s.split(':')[1] || '').trim().toLowerCase();
            var p = self.nachHandle[handle];
            if (!p) { ok = false; return; }
            var v = p.varianten[0];
            if (groesse) {
              v = p.varianten.filter(function (x) { return x.titel.toLowerCase() === groesse; })[0];
              if (!v) { ok = false; return; }
            }
            teile.push(v);
          });
          if (!ok || !teile.length) return;
          knopf.hidden = false;
          self.stapel.push({ knopf: knopf, teile: teile });
        });

        // Gezeigte Größe je Produkt: die aus dem ersten Stapel, sonst die erste
        this.produkte.forEach(function (p) { self.aktiv[p.id] = p.varianten[0].id; });
        for (var i = this.stapel.length - 1; i >= 0; i--) {
          this.stapel[i].teile.forEach(function (v) { self.aktiv[v.produkt.id] = v.id; });
        }

        this.addEventListener('click', this.klick.bind(this));
        this.chatPlatz();

        var gemerkt = this.lesen();
        if (gemerkt) this.zeichne();
        this.korbLaden().then(function (zeilen) {
          self.korb = zeilen;
          self.korbUebernehmen(!gemerkt);
          self.zeichne();
        });
      }

      // ---------- Zustand ----------
      lesen() {
        try {
          var roh = JSON.parse(sessionStorage.getItem(SPEICHER) || 'null');
          if (!roh || !roh.a) return false;
          var self = this;
          Object.keys(roh.a).forEach(function (pid) {
            var v = self.nachVariante[roh.a[pid]];
            if (v && v.produkt.id === Number(pid)) self.aktiv[pid] = v.id;
          });
          Object.keys(roh.m || {}).forEach(function (vid) {
            var v = self.nachVariante[vid];
            var q = Number(roh.m[vid]) || 0;
            if (v && q > 0 && self.aktiv[v.produkt.id] === v.id) self.menge[v.id] = Math.min(q, MAX_JE_PRODUKT);
          });
          return true;
        } catch (e) { return false; }
      }
      merken() {
        try { sessionStorage.setItem(SPEICHER, JSON.stringify({ a: this.aktiv, m: this.menge })); } catch (e) {}
      }
      korbLaden() {
        return fetch(this.wurzel + 'cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (c) { return (c && c.items) || []; })
          .catch(function () { return []; });
      }
      // Einmalkauf-Zeilen der Produkte dieser Seite gehören der Seite: je Produkt eine Größe.
      // Alles andere (Abo-Zeilen, zweite Größe, fremde Produkte) bleibt im Warenkorb, wie es ist.
      korbUebernehmen(alsAuswahl) {
        var self = this;
        var jeProdukt = {};
        this.korb.forEach(function (z) {
          if (z.selling_plan_allocation) return;
          var v = self.nachVariante[z.variant_id];
          if (!v) return;
          var pid = v.produkt.id;
          if (alsAuswahl) {
            // bei gleicher Menge gewinnt die teurere Größe (ein geschenktes 30-g-NMN soll nicht die Auswahl werden)
            var alt = jeProdukt[pid];
            if (!alt || z.quantity > alt.quantity || (z.quantity === alt.quantity && v.preis > self.nachVariante[alt.variant_id].preis)) jeProdukt[pid] = z;
          } else if (self.aktiv[pid] === v.id && !jeProdukt[pid]) {
            jeProdukt[pid] = z;
          }
        });
        var treffer = Object.keys(jeProdukt);
        treffer.forEach(function (pid) {
          var z = jeProdukt[pid];
          self.beruehrt[z.variant_id] = true;
          if (alsAuswahl) {
            self.aktiv[pid] = z.variant_id;
            self.menge[z.variant_id] = Math.min(z.quantity, MAX_JE_PRODUKT);
          }
        });
        if (alsAuswahl && !treffer.length && this.dataset.vorauswahl === 'true' && this.stapel.length) {
          this.stapelSetzen(this.stapel[0]);
        }
      }
      fremd() {
        var self = this;
        var f = { stueck: 0, summe: 0, abo: false };
        this.korb.forEach(function (z) {
          var abo = !!z.selling_plan_allocation;
          if (!abo && self.beruehrt[z.variant_id]) return;
          if (abo) f.abo = true;
          f.summe += Number(z.final_line_price) || 0;
          if (self.rabattIds[z.product_id]) f.stueck += Number(z.quantity) || 0;
        });
        return f;
      }
      rechne() {
        var self = this;
        var zeilen = [];
        var n = 0;
        this.produkte.forEach(function (p) {
          var v = self.nachVariante[self.aktiv[p.id]];
          var q = (v && self.menge[v.id]) || 0;
          if (q > 0) { zeilen.push({ v: v, q: q }); n += q; }
        });
        var f = this.fremd();
        var pct = stufe(n + f.stueck);
        var normal = 0;
        var summe = 0;
        zeilen.forEach(function (z) {
          z.normal = z.v.preis * z.q;
          // wie Shopify: Rabatt je Zeile, kaufmännisch gerundet
          z.summe = z.normal - Math.round(z.normal * pct / 100);
          normal += z.normal;
          summe += z.summe;
        });
        var frei = f.abo || this.versandFrei <= 0 || summe + f.summe >= this.versandFrei;
        return {
          zeilen: zeilen, n: n, nGesamt: n + f.stueck, pct: pct, normal: normal, summe: summe,
          frei: frei, fehlt: Math.max(0, this.versandFrei - summe - f.summe), fremd: f
        };
      }
      geld(cent) {
        var s = (Math.round(cent) / 100).toFixed(2).replace('.', ',');
        return s.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' ' + this.symbol;
      }
      stapelSetzen(st) {
        var self = this;
        this.menge = {};
        st.teile.forEach(function (v) {
          self.aktiv[v.produkt.id] = v.id;
          self.menge[v.id] = (self.menge[v.id] || 0) + 1;
        });
      }
      stapelAktiv(st, r) {
        if (r.zeilen.length !== st.teile.length) return false;
        var self = this;
        return st.teile.every(function (v) { return self.aktiv[v.produkt.id] === v.id && self.menge[v.id] === 1; });
      }

      // ---------- Bedienung ----------
      klick(e) {
        var ziel = e.target.closest('[data-waehlen],[data-plus],[data-minus],[data-variante],[data-stapel],[data-kaufen]');
        if (!ziel || !this.contains(ziel)) return;
        if (ziel.hasAttribute('data-kaufen')) { this.kaufen(); return; }
        if (ziel.hasAttribute('data-stapel')) {
          var st = this.stapel.filter(function (s) { return s.knopf === ziel; })[0];
          if (st) { this.stapelSetzen(st); this.merken(); this.zeichne(); }
          return;
        }
        var karte = ziel.closest('[data-karte]');
        if (!karte) return;
        var pid = Number(karte.dataset.pid);
        var vid = this.aktiv[pid];
        var q = this.menge[vid] || 0;
        if (ziel.hasAttribute('data-variante')) {
          var neu = Number(ziel.dataset.variante);
          if (neu === vid || !this.nachVariante[neu]) return;
          delete this.menge[vid];
          this.aktiv[pid] = neu;
          if (q > 0) this.menge[neu] = q;
        } else if (ziel.hasAttribute('data-waehlen')) {
          if (q > 0) return;
          this.menge[vid] = 1;
        } else if (ziel.hasAttribute('data-plus')) {
          this.menge[vid] = Math.min(q + 1, MAX_JE_PRODUKT);
        } else if (ziel.hasAttribute('data-minus')) {
          if (q <= 1) delete this.menge[vid]; else this.menge[vid] = q - 1;
        }
        this.merken();
        this.zeichne();
      }

      // ---------- Anzeige ----------
      zeichne() {
        var self = this;
        var r = this.rechne();
        var pctKarte = stufe(Math.max(r.nGesamt, 1));

        this.produkte.forEach(function (p) {
          var v = self.nachVariante[self.aktiv[p.id]];
          var q = self.menge[v.id] || 0;
          var k = p.karte;
          k.classList.toggle('is-gewaehlt', q > 0);
          k.querySelector('[data-anzahl]').textContent = q;
          k.querySelector('[data-preis]').textContent = self.geld(v.preis - Math.round(v.preis * pctKarte / 100));
          k.querySelector('[data-alt]').textContent = self.geld(v.preis);
          k.querySelector('[data-grund]').textContent = v.grund > 0 && v.bezug
            ? self.geld(v.grund - Math.round(v.grund * pctKarte / 100)) + ' / ' + v.bezug
            : '';
          k.querySelectorAll('[data-variante]').forEach(function (b) {
            b.setAttribute('aria-checked', Number(b.dataset.variante) === v.id ? 'true' : 'false');
          });
        });

        this.querySelectorAll('[data-stufe]').forEach(function (el) {
          var ab = Number(el.dataset.stufe);
          var erreicht = r.nGesamt >= ab;
          // Mint trägt nur die Stufe, die gerade gilt (BJ 26.11.2026: weniger Grün)
          el.classList.toggle('is-an', ab === Math.min(r.nGesamt, 3));
          el.classList.toggle('is-naechste', ab === r.nGesamt + 1);
          var noch = el.querySelector('[data-noch]');
          if (noch) noch.textContent = erreicht ? '' : 'noch ' + (ab - r.nGesamt);
        });

        this.stapel.forEach(function (st) {
          var normal = 0;
          var pct = stufe(st.teile.length);
          var summe = 0;
          st.teile.forEach(function (v) { normal += v.preis; summe += v.preis - Math.round(v.preis * pct / 100); });
          if (!st.gebaut) {
            st.gebaut = true;
            st.knopf.innerHTML =
              '<span class="lt-bfb__stapel-bilder">' + st.teile.map(function (v) {
                return v.produkt.bild ? '<img src="' + esc(v.produkt.bild) + '" alt="" width="46" height="46" loading="lazy">' : '';
              }).join('') + '</span>' +
              '<span class="lt-bfb__stapel-preis"><b>' + self.geld(summe) + '</b><s>' + self.geld(normal) + '</s></span>' +
              '<span class="lt-bfb__stapel-namen">' + st.teile.map(function (v) {
                return esc(kurz(v.produkt.titel) + (v.produkt.varianten.length > 1 ? ' ' + v.titel : ''));
              }).join(' + ') + '</span>';
          }
          st.knopf.setAttribute('aria-pressed', self.stapelAktiv(st, r) ? 'true' : 'false');
        });

        var kasse = this.querySelector('[data-kasse]');
        kasse.classList.toggle('is-leer', r.n === 0);
        this.querySelector('[data-gesamt]').textContent = this.geld(r.summe);
        this.querySelector('[data-gesamt-alt]').textContent = r.normal > r.summe ? this.geld(r.normal) : '';
        this.querySelector('[data-spar]').textContent = r.normal > r.summe ? 'Du sparst ' + this.geld(r.normal - r.summe) : '';
        this.querySelector('[data-versand]').innerHTML = this.truck + '<span>' +
          (r.frei ? 'Versandfrei' : 'Noch ' + this.geld(r.fehlt) + ' bis versandfrei') + '</span>';
        var extra = this.querySelector('[data-extra]');
        extra.hidden = r.fremd.stueck === 0;
        extra.textContent = r.fremd.stueck === 0 ? '' : 'Plus ' + r.fremd.stueck + (r.fremd.stueck === 1 ? ' Produkt' : ' Produkte') + ' aus deinem Warenkorb';
        this.querySelector('[data-liste]').innerHTML = r.zeilen.map(function (z) {
          var p = z.v.produkt;
          return '<li>' + (p.bild ? '<img src="' + esc(p.bild) + '" alt="" width="44" height="44" loading="lazy">' : '<i></i>') +
            '<span>' + (z.q > 1 ? z.q + ' × ' : '') + esc(p.titel) + (p.varianten.length > 1 ? ' ' + esc(z.v.titel) : '') + '</span>' +
            '<b>' + self.geld(z.summe) + '</b></li>';
        }).join('');
        var knopf = this.querySelector('[data-kaufen]');
        if (!knopf.classList.contains('is-laedt')) knopf.disabled = r.n === 0;

        if (this.letztePct !== null && this.letztePct !== r.pct) {
          this.classList.remove('is-blitz');
          void this.offsetWidth;
          this.classList.add('is-blitz');
          window.clearTimeout(this.blitzT);
          this.blitzT = window.setTimeout(function () { self.classList.remove('is-blitz'); }, 500);
        }
        this.letztePct = r.pct;
      }

      // Chat-Blase (Shopify Inbox) mobil über die Leiste heben, solange die Leiste im Bild ist.
      // Nutzt die Variable aus snippets/lt-chat-guard.liquid.
      chatPlatz() {
        var kasse = this.querySelector('[data-kasse]');
        if (!kasse || !('IntersectionObserver' in window)) return;
        var mq = window.matchMedia('(max-width: 749px)');
        var root = document.documentElement;
        var imBild = false;
        function setze() {
          var hoch = imBild && mq.matches && kasse.offsetHeight > 0 ? kasse.offsetHeight - 8 : 0;
          root.style.setProperty('--lt-chat-lift', hoch + 'px');
        }
        new IntersectionObserver(function (es) {
          es.forEach(function (en) { imBild = en.isIntersecting; });
          setze();
        }).observe(kasse);
        window.addEventListener('resize', setze);
      }

      // ---------- Kauf ----------
      senden(pfad, daten) {
        return fetch(this.wurzel + pfad, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(daten)
        }).then(function (res) {
          return res.json().catch(function () { return {}; }).then(function (j) {
            if (!res.ok) throw new Error(j.description || j.message || 'Fehler');
            return j;
          });
        });
      }
      kaufen() {
        var self = this;
        var bw = window.LTBlackWeek;
        if (!bw || !bw.on || !bw.p2) return;
        var r = this.rechne();
        var knopf = this.querySelector('[data-kaufen]');
        if (!r.n || knopf.classList.contains('is-laedt')) return;
        var fehler = this.querySelector('[data-fehler]');
        fehler.hidden = true;
        knopf.classList.add('is-laedt');
        knopf.disabled = true;
        r.zeilen.forEach(function (z) { self.beruehrt[z.v.id] = true; });

        this.korbLaden().then(function (zeilen) {
          var updates = {};
          var aendern = false;
          var gefunden = {};
          zeilen.forEach(function (z) {
            if (z.selling_plan_allocation || !self.beruehrt[z.variant_id] || gefunden[z.variant_id]) return;
            var v = self.nachVariante[z.variant_id];
            if (!v) return;
            gefunden[z.variant_id] = true;
            var soll = self.aktiv[v.produkt.id] === v.id ? (self.menge[v.id] || 0) : 0;
            if (z.quantity !== soll) { updates[z.key] = soll; aendern = true; }
          });
          var neu = r.zeilen
            .filter(function (z) { return !gefunden[z.v.id]; })
            .map(function (z) { return { id: z.v.id, quantity: z.q }; });
          var kette = Promise.resolve();
          if (aendern) kette = kette.then(function () { return self.senden('cart/update.js', { updates: updates }); });
          if (neu.length) kette = kette.then(function () { return self.senden('cart/add.js', { items: neu }); });
          return kette;
        }).then(function () {
          try { sessionStorage.removeItem(SPEICHER); } catch (e) {}
          window.location.href = self.wurzel + 'checkout';
        }).catch(function (err) {
          knopf.classList.remove('is-laedt');
          knopf.disabled = false;
          fehler.textContent = (err && err.message && err.message !== 'Fehler') ? err.message : 'Das hat nicht geklappt. Bitte versuch es noch einmal.';
          fehler.hidden = false;
        });
      }
    }

    customElements.define('lt-bf-bundle', LtBfBundle);
  })();
</script>

