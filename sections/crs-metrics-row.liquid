{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign crs_mg_kicker = section.settings.kicker | strip
  assign crs_mg_head = section.settings.heading | strip
  assign crs_mg_sub = section.settings.subheading | strip
  if crs_mg_kicker == '__none__'
    assign crs_mg_kicker = ''
  endif
  if crs_mg_head == '__none__'
    assign crs_mg_head = ''
  endif
  if crs_mg_sub == '__none__'
    assign crs_mg_sub = ''
  endif
  # Fliesstext gehoert NICHT in crs-heading-stack__pair (docs/section-heading-stack.md).
  # Laengere Einordnungen laufen ueber `intro` unterhalb des Heading-Stacks.
  assign crs_mg_intro = section.settings.intro | strip
  if crs_mg_intro == '__none__'
    assign crs_mg_intro = ''
  endif
  assign crs_h_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  endif
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:       {{ section.settings.color_bg }};
    --crs-card-bg:  {{ section.settings.color_card_bg }};
    --crs-text:     {{ section.settings.color_text }};
    --crs-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.6 }};
    --crs-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.4 }};
    --crs-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.05 }};
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="mg-section" id="section-{{ section.id }}">
  <div class="mg-container">

    {%- if crs_mg_kicker != blank or crs_mg_head != blank or crs_mg_sub != blank -%}
      <div class="mg-header{% if crs_mg_intro != blank %} mg-header--with-intro{% endif %} crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
        {%- if crs_mg_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ crs_mg_kicker | escape }}</p>
        {%- endif -%}
        {%- if crs_mg_head != blank or crs_mg_sub != blank -%}
          <div class="crs-heading-stack__pair">
            {%- if crs_mg_head != blank -%}
              <h2 class="crs-heading-stack__title">{{ crs_mg_head | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if crs_mg_sub != blank -%}
              <p class="crs-heading-stack__subtitle">{{ crs_mg_sub | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if crs_mg_intro != blank -%}
      <p class="mg-intro">{{ crs_mg_intro | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mg-grid">
        {%- for block in section.blocks -%}
          <div class="mg-card{% if block.settings.source != blank %} mg-card--with-source{% endif %}" {{ block.shopify_attributes }}>
            <div class="mg-number">{{ block.settings.number | escape }}</div>
            {%- if block.settings.description != blank or block.settings.source != blank -%}
              <div class="mg-text">
                {%- if block.settings.description != blank -%}
                  <div class="mg-desc">{{ block.settings.description | escape }}</div>
                {%- endif -%}
                {%- if block.settings.source != blank -%}
                  <div class="mg-source">{{ block.settings.source | escape }}</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="mg-note">{{ section.settings.note }}</p>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* ===================================================
   Metrics Row — crs-metrics-row.liquid
   =================================================== */

.mg-section {
  background: var(--crs-bg, #f7f7f4);
}

.mg-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
.mg-header {
  margin-bottom: var(--space-7);
}

.mg-header--with-intro {
  margin-bottom: var(--space-4);
}

/* Section-Description: bewusst ausserhalb des Heading-Stacks, damit Titel und
   Subline ein Block bleiben und Fliesstext nicht auf Headline-Groesse laeuft. */
.mg-intro {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-regular);
  line-height: var(--leading-relaxed);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.6));
  max-width: 62ch;
  margin: 0 0 var(--space-7);
}

/* Grid */
.mg-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

/* Card */
.mg-card {
  box-sizing: border-box;
  background: var(--crs-card-bg, #f2f1ed);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.05));
  border-radius: 4px;
  padding: 12.5px 15px 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  aspect-ratio: 16 / 9;
}

/* Big number */
.mg-number {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  font-size: 52px;
  font-weight: 400;
  line-height: 59.8px;
  letter-spacing: -1.3px;
  color: var(--crs-text, #26251e);
}

/* Text block (pushed to the bottom of the card) */
.mg-text {
  margin-top: auto;
}

/* Description */
.mg-desc {
  font-size: 16px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--crs-text, #26251e);
}

/* Source / method line */
.mg-source {
  font-size: 13px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.6));
  margin-top: var(--space-2);
}

/* Cards carrying a source line need room to breathe */
.mg-card--with-source {
  aspect-ratio: auto;
  min-height: 220px;
}

/* Note below the grid */
.mg-note {
  font-size: 14px;
  line-height: 1.5;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.6));
  margin: var(--space-5) 0 0;
}

.mg-note a {
  color: var(--color-teal);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: var(--color-gray-400);
  transition: color 0.15s ease, text-decoration-color 0.15s ease;
}

.mg-note a:hover {
  color: var(--color-teal-dark);
  text-decoration-color: var(--color-teal-dark);
}

/* Tablet — 2 columns */
@media (max-width: 1024px) {
  .mg-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .mg-card {
    aspect-ratio: auto;
    min-height: 140px;
  }
}

/* Mobile — 1 column */
@media (max-width: 640px) {
  .mg-grid {
    grid-template-columns: 1fr;
  }

  .mg-number {
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: -1px;
  }

  .mg-card {
    min-height: 120px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Metrics Row",
  "tag": "section",
  "class": "crs-metrics-row",
  "settings": [
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f7f7f4"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung (Überschrift)",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (Section-Headline)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section",
      "info": "Zeilenumbruch: Enter in Überschrift/Unterüberschrift."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor)"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor). Kurz halten, läuft auf Headline-Größe."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitungstext (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden. Für längere Einordnungen statt Unterüberschrift."
    },
    {
      "type": "inline_richtext",
      "id": "note",
      "label": "Fußnote unter den Kennzahlen (optional)",
      "info": "Für Quellenangabe oder fachliche Zeichnung. Leer lassen = ausblenden."
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Kennzahl",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Zahl / Wert",
          "default": ">99,9%"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschreibung",
          "default": "bestätigte NMN-Reinheit"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Quelle / Methode (optional)",
          "info": "Kleine Zeile unter der Beschreibung, z. B. Labor und Messmethode."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Metrics Row",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "number": "NAD⁺ ×2",
            "description": "Verdopplung der NAD⁺-Werte im Blut nach 12 Wochen – belegt durch Humanstudien"
          }
        },
        {
          "type": "metric",
          "settings": {
            "number": "+11 %",
            "description": "mehr körperliche Leistung im 6-Minuten-Gehtest nach 60 Tagen – randomisierte Placebostudie"
          }
        },
        {
          "type": "metric",
          "settings": {
            "number": "– 50 %",
            "description": "so stark sinken NAD⁺-Werte zwischen 20 und 60 Jahren – der Mechanismus hinter NMN"
          }
        }
      ]
    }
  ]
}
{% endschema %}
