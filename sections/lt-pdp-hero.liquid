{%- liquid
  assign lt_landing_default_product_handle = ''
  if template.name == 'page' and template.suffix == 'age-dna-landing'
    assign lt_landing_default_product_handle = 'lifetime-age-dna'
  endif
  if section.settings.product != blank
    assign product = all_products[section.settings.product]
  elsif product == blank and lt_landing_default_product_handle != blank
    assign product = all_products[lt_landing_default_product_handle]
  endif
  assign current_variant = product.selected_or_first_available_variant
  # GMC/Deep-Link: ?variant= kann auf eine ausverkaufte Variante zeigen → für Pill-Vorauswahl + ATC erste VERFÜGBARE bevorzugen.
  # NUR bei aktiver Größen-Auswahl; sonst bleibt der Legacy-Pfad (current_variant / lt_variant_1) unverändert.
  assign lt_preselect_variant = current_variant
  if section.settings.show_size_selector and product.variants.size > 1
    unless current_variant.available
      for v in product.variants
        if v.available
          assign lt_preselect_variant = v
          break
        endif
      endfor
    endunless
  endif
  assign default_to_first_variant = true
  assign gallery_layout = 'one-col slider'
  assign gallery_mobile_width = 100

  # Galerie-Format. Quadrat war hier hart verdrahtet und ist der teuerste
  # Einzelposten oberhalb des Falzes: 378px Slide-Hoehe auf 390px Viewport, in
  # denen die freigestellte Dose rund ein Drittel belegt, also rund 126px Dose
  # auf 378px Flaeche.
  #
  # Wichtig, weil es beim ersten Anlauf falsch herum lief: Hochformat 4:5 macht
  # den Rahmen **hoeher**, nicht flacher. Gemessen auf 390px ging der erste
  # Preis dadurch von 776px auf 866px, also in die falsche Richtung. Das Format
  # allein loest nichts, es kommt auf die Kombination an:
  #
  #   Asset 4:5 und eng beschnitten  ->  Dose gross bei wenig Rahmenhoehe
  #   Rahmen mobil flacher (4:3)     ->  Kaufzone rueckt hoch
  #
  # `object-fit: contain` (theme.css setzt es per !important auf
  # `lazy-image--fit`) skaliert das 4:5-Asset im flacheren Rahmen auf dessen
  # Hoehe und zentriert es. Die seitlichen Raender sind kein Letterbox-Fehler,
  # weil die Slide-Flaeche `--lt-surface` traegt und die Assets exakt auf
  # diesem Ton liegen. Wer Assets mit abweichendem Hintergrund einsetzt,
  # bekommt hier eine sichtbare Kante.
  #
  # Deshalb Select statt globalem Wechsel, Default bleibt das Quadrat: die
  # anderen 15 PDPs fahren quadratische Katalogfotos, die im Hochformat nur
  # kleiner wuerden.
  #
  # Ganzzahlige 1 im Default-Zweig ist Absicht: das Snippet rechnet
  # `100 | divided_by: aspect_ratio`, und 1.0 wuerde "100.0%" statt "100%"
  # schreiben. Render-identisch, aber ein unnoetiger Diff auf 15 PDPs.
  assign gallery_ratio = 1
  if section.settings.gallery_ratio == 'portrait_4_5' or section.settings.gallery_ratio == 'portrait_compact'
    assign gallery_ratio = 0.8
  endif
  assign lt_variant_1 = current_variant
  assign lt_variant_3 = blank
  assign lt_variant_6 = blank
  for variant in product.variants
    assign lt_variant_options = variant.options | join: ' ' | downcase
    if lt_variant_1 == blank and lt_variant_options contains '1'
      assign lt_variant_1 = variant
    endif
    if lt_variant_3 == blank and lt_variant_options contains '3'
      assign lt_variant_3 = variant
    endif
    if lt_variant_6 == blank and lt_variant_options contains '6'
      assign lt_variant_6 = variant
    endif
  endfor
  if lt_variant_1 == blank
    assign lt_variant_1 = current_variant
  endif
  assign lt_has_pack_variants = false
  if lt_variant_3 != blank and lt_variant_6 != blank
    if lt_variant_3.id != lt_variant_1.id and lt_variant_6.id != lt_variant_1.id
      assign lt_has_pack_variants = true
    endif
  endif
  assign lt_base_price = lt_variant_1.price
  assign lt_compare_price = lt_variant_1.compare_at_price | default: 0
  assign lt_sub_1 = lt_base_price | times: 0.85 | round
  assign lt_sub_3 = lt_base_price | times: 3 | times: 0.85 | round
  assign lt_sub_6 = lt_base_price | times: 6 | times: 0.85 | round
  if settings.show_currency_codes
    assign iso_code = localization.country.currency.iso_code | prepend: ' '
  endif
-%}

{% style %}
  #lt-pdp-hero-{{ section.id }} {
    /* Cursor design tokens — override lt-* vars at section scope */
    --lt-bg:           {{ section.settings.color_bg }};
    --lt-surface:      {{ section.settings.color_card_bg }};
    /* Bewusste Weiss-Flaechen (Auswahl-Signal) und Text auf dunklem Grund,
       zentral statt verstreuter #fff-Literale */
    --lt-surface-raised: #ffffff;
    --lt-on-dark:        #ffffff;
    --lt-border:       {{ section.settings.color_text | color_modify: 'alpha', 0.1 }};
    --lt-text:         {{ section.settings.color_text }};
    --lt-muted:        {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --lt-cta-bg:       var(--color-dark);
    --lt-cta-hover:    var(--color-dark);
    --lt-primary:      {{ section.settings.color_text }};
    --lt-primary-dark: {{ section.settings.color_text }};
    --lt-success-bg:   {{ section.settings.color_text | color_modify: 'alpha', 0.06 }};
    --lt-success-text: {{ section.settings.color_text }};
    --lt-gallery-fill: {{ section.settings.gallery_fill | default: 100 | times: 0.01 }};
    --lt-radius-sm:    4px;
    --lt-radius-md:    4px;
    --lt-radius-lg:    4px;
    --lt-shadow:       none;
  }
{% endstyle %}

{%- liquid
  # Sticky: kein Streichpreis auf product.14_1_test (Template-Suffix), Editor-sicher
  assign lt_sticky_show_compare_price = true
  if template.suffix == '14_1_test'
    assign lt_sticky_show_compare_price = false
  elsif section.settings.sticky_show_compare_price == false
    assign lt_sticky_show_compare_price = false
  endif
-%}

<section
  id="lt-pdp-hero-{{ section.id }}"
  class="lt-pdp-hero-section"
  data-lt-sticky-show-compare="{% if lt_sticky_show_compare_price %}1{% else %}0{% endif %}"
>
  <div class="lt-pdp-hero__container">
    <product-page
      id="product-{{ section.id }}"
      class="lt-pdp-hero{% if section.settings.gallery_ratio == 'portrait_compact' %} lt-pdp-hero--gallery-compact{% endif %}"
      data-collection="{{ collection.handle }}"
      data-id="{{ product.id }}"
      data-availability="{{ product.available }}"
      data-js-product-component
    >
      <div class="lt-pdp-hero__gallery-wrap element--is-sticky">
        {%- comment -%}
          Preload fuer das LCP-Bild (erstes Galeriebild). imagesrcset/imagesizes spiegeln
          exakt die no_crop-Leiter aus snippets/lazy-image.liquid inkl. Breiten-Gates,
          damit Preload und img-Element denselben Kandidaten waehlen (kein Doppel-Download).
          Ohne das haengt fetchpriority=high nur am Shopify-Chat-Drittscript.
        {%- endcomment -%}
        {%- assign lt_lcp = product.media.first.preview_image -%}
        {%- if lt_lcp != blank -%}
          <link
            rel="preload"
            as="image"
            fetchpriority="high"
            href="{{ lt_lcp | image_url: width: 480 }}"
            imagesrcset="{% if lt_lcp.width >= 240 %}{{ lt_lcp | image_url: width: 240 }} 240w{% endif %}{% if lt_lcp.width >= 360 %},{{ lt_lcp | image_url: width: 360 }} 360w{% endif %}{% if lt_lcp.width >= 420 %},{{ lt_lcp | image_url: width: 420 }} 420w{% endif %}{% if lt_lcp.width >= 480 %},{{ lt_lcp | image_url: width: 480 }} 480w{% endif %}{% if lt_lcp.width >= 640 %},{{ lt_lcp | image_url: width: 640 }} 640w{% endif %}{% if lt_lcp.width >= 840 %},{{ lt_lcp | image_url: width: 840 }} 840w{% endif %}{% if lt_lcp.width >= 1080 %},{{ lt_lcp | image_url: width: 1080 }} 1080w{% endif %}{% if lt_lcp.width >= 1280 %},{{ lt_lcp | image_url: width: 1280 }} 1280w{% endif %}{% if lt_lcp.width >= 1540 %},{{ lt_lcp | image_url: width: 1540 }} 1540w{% endif %}{% if lt_lcp.width >= 1860 %},{{ lt_lcp | image_url: width: 1860 }} 1860w{% endif %}{% if lt_lcp.width >= 2100 %},{{ lt_lcp | image_url: width: 2100 }} 2100w{% endif %}{% if lt_lcp.width >= 2460 %},{{ lt_lcp | image_url: width: 2460 }} 2460w{% endif %}{% if lt_lcp.width >= 2820 %},{{ lt_lcp | image_url: width: 2820 }} 2820w{% endif %}{% if lt_lcp.width >= 3360 %},{{ lt_lcp | image_url: width: 3360 }} 3360w{% endif %}{% if lt_lcp.width >= 3820 %},{{ lt_lcp | image_url: width: 3820 }} 3820w{% endif %}"
            imagesizes="(max-width: 767px) 100vw, (max-width: 1360px) 50vw, 680px"
          >
        {%- endif -%}
        <div class="lt-pdp-hero__gallery-frame">
          {%- if section.settings.show_badge -%}
            <span class="lt-pdp-hero__badge lt-badge">{{ section.settings.badge_text | default: 'Bestseller' | escape }}</span>
          {%- endif -%}

          <div class="product-gallery product-gallery--slider lap--grid--slider-container" data-js-product-gallery>
            {%- if product.media.size > 1 -%}
              <css-slider
                data-options='
                  {
                    "selector": ".product-gallery-item",
                    "autoHeight": false,
                    "navigationDOM": "<span class=\"css-slider-button css-slider-prev\" style=\"display:none\"><svg fill=\"none\" height=\"11\" viewBox=\"0 0 6 11\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"m4.32845 10.0708-4.18198-4.18194c-.195261-.19526-.195261-.51185 0-.70711l4.18198-4.181979c.19527-.195262.51185-.195262.70711 0 .19526.195259.19526.511849 0 .707109l-3.32843 3.32842s-.70713.4647-.00002 1l3.32845 3.32843c.19526.19526.19526.51185 0 .70707-.19526.1953-.51185.1953-.70711 0z\" fill=\"#000\" fill-rule=\"evenodd\"/></svg></span><span class=\"css-slider-button css-slider-next\" style=\"display:none\"><svg fill=\"none\" height=\"11\" viewBox=\"0 0 6 11\" width=\"6\" xmlns=\"http://www.w3.org/2000/svg\"><path clip-rule=\"evenodd\" d=\"m.853555.999962 4.181985 4.181978c.19526.19526.19526.51185 0 .70711l-4.181983 4.18195c-.195263.1953-.511845.1953-.707108 0-.1952631-.19523-.1952632-.51181 0-.70708l3.328431-3.32842s.70713-.4647.00002-1l-3.328453-3.32843c-.1952626-.19526-.1952627-.51185 0-.707108.195263-.195262.511845-.195262.707108 0z\" fill=\"#000\" fill-rule=\"evenodd\"/></svg></span>",
                    "thumbnailsDOM": "<div class=\"css-slider-dot-navigation\" style=\"display:none;--size:{{ product.media.size }}\"></div>",
                    "listenScroll": false
                  }
                '
                class="css-slider--bottom-navigation element--border-radius"
                style="display:block"
              >
            {%- endif -%}

            <div class="grid grid--slider grid-1 lap--grid--slider grid--gap-small" style="--mobile-media-width: {{ gallery_mobile_width }}%">
              {%- if product.media.size == 0 -%}
                {%- unless settings.product_card_fallback_image == blank -%}
                  {%- render 'product-media',
                    fallback: true,
                    aspect_ratio: gallery_ratio,
                    fit: true,
                    layout: gallery_layout,
                    desktop_width: 'one-half',
                    mobile_width: gallery_mobile_width,
                    enable_zoom: false,
                    index: 0
                  -%}
                {%- else -%}
                  <div class="product-gallery-item" style="padding-top: 100%">
                    {%- render 'lazy-svg', image: 'product-1', ratio: 1, class: 'svg-placeholder svg-placeholder--background' -%}
                  </div>
                {%- endunless -%}
              {%- else -%}
                {%- for media in product.media -%}
                  {%- render 'product-media',
                    media: media,
                    enable_zoom: false,
                    loop: false,
                    index: forloop.index0,
                    aspect_ratio: gallery_ratio,
                    fit: true,
                    layout: gallery_layout,
                    desktop_width: 'one-half',
                    mobile_width: gallery_mobile_width,
                    autoplay: false,
                    video_fit: true
                  -%}
                  {%- if media.media_type == 'external_video' or media.media_type == 'video' -%}
                    {%- assign video_script = true -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- if product.media.size > 1 -%}</css-slider>{%- endif -%}

            {%- if product.media.size > 1 -%}
              {%- comment -%}
                aria-hidden + tabindex="-1": Die Thumbnails sind reine Maus-Navigation.
                Tastatur/Screenreader nutzen die benannten Slider-Dots ("Zeige Folie n");
                fokussierbare Elemente in aria-hidden waeren ein WCAG-4.1.2-Verstoss.
              {%- endcomment -%}
              <div class="product-gallery__thumbnails" aria-hidden="true">
                <div class="product-gallery__thumbnails-holder">
                  {%- for media in product.media -%}
                    <button class="thumbnail element--border-radius" data-index="{{ forloop.index0 }}" tabindex="-1">
                      {%- render 'lazy-image-small',
                        image: media.preview_image,
                        aspect_ratio: settings.cart_image_ratio,
                        fit: settings.cart_image_fit,
                        class: 'thumbnail__image'
                      -%}
                      {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                        <span class="thumbnail__badge">{%- render 'theme-symbols', icon: 'badge-video-thumbnail' -%}</span>
                      {%- elsif media.media_type == 'model' -%}
                        <span class="thumbnail__badge">{%- render 'theme-symbols', icon: 'badge-model-thumbnail' -%}</span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.show_benefits_icons -%}
          <div class="lt-benefits-icons lt-benefits-icons--desktop" aria-label="Produktvorteile">
            <div class="lt-benefit-item">
              <span class="lt-benefit-icon" aria-hidden="true">
                {%- if section.settings.benefit_1_icon != blank -%}
                  {{
                    section.settings.benefit_1_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'lt-benefit-icon__img', alt: ''
                  }}
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.2" opacity="0.35"></circle>
                    <path d="M6.5 9.2l1.8 1.8 3.3-3.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                {%- endif -%}
              </span>
              <p>{{ section.settings.benefit_1_text }}</p>
            </div>
            <div class="lt-benefit-item">
              <span class="lt-benefit-icon" aria-hidden="true">
                {%- if section.settings.benefit_2_icon != blank -%}
                  {{
                    section.settings.benefit_2_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'lt-benefit-icon__img', alt: ''
                  }}
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.2" opacity="0.35"></circle>
                    <path d="M6.5 9.2l1.8 1.8 3.3-3.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                {%- endif -%}
              </span>
              <p>{{ section.settings.benefit_2_text }}</p>
            </div>
            <div class="lt-benefit-item">
              <span class="lt-benefit-icon" aria-hidden="true">
                {%- if section.settings.benefit_3_icon != blank -%}
                  {{
                    section.settings.benefit_3_icon
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', class: 'lt-benefit-icon__img', alt: ''
                  }}
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.2" opacity="0.35"></circle>
                    <path d="M6.5 9.2l1.8 1.8 3.3-3.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                {%- endif -%}
              </span>
              <p>{{ section.settings.benefit_3_text }}</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="lt-pdp-hero__content lt-hero-text element--is-sticky">
        {%- comment -%}
          Kein `| default:` — der Filter greift auch beim Leerstring. Solange er drin
          stand, holte ein bewusst geleertes Trust-Feld den Alt-Text zurück, statt die
          Zeile zu entfernen. Templates ohne diese Settings bekommen weiterhin den
          Schema-Default; leer heißt jetzt: Zeile fällt weg (Gate unten).
        {%- endcomment -%}
        {%- assign lt_trust_1 = section.settings.trust_1 | strip -%}
        {%- assign lt_trust_2 = section.settings.trust_2 | strip -%}
        {%- assign lt_trust_3 = section.settings.trust_3 | strip -%}
        {%- comment -%}trust_4 (optional, conditional render) — added 2026-04-27{%- endcomment -%}
        {%- assign lt_trust_4 = section.settings.trust_4 | strip -%}
        {%- assign lt_trust_1_icon_name = section.settings.trust_1_icon_name | default: 'delivery' -%}
        {%- assign lt_trust_2_icon_name = section.settings.trust_2_icon_name | default: 'clock' -%}
        {%- assign lt_trust_3_icon_name = section.settings.trust_3_icon_name | default: 'leaf' -%}
        {%- assign lt_trust_4_icon_name = section.settings.trust_4_icon_name | default: 'lab' -%}
        {%- assign lt_pill_1_label = section.settings.pill_1_label | default: '1 Monat' -%}
        {%- assign lt_pill_1_qty = section.settings.pill_1_quantity | default: 1 -%}
        {%- comment -%} Preis IMMER dynamisch aus der echten Variante (kein Hardcode) — 2026-07-18 {%- endcomment -%}
        {%- assign lt_pill_1_once = lt_variant_1.price -%}
        {%- assign lt_pill_1_sub = lt_variant_1.price | times: 0.90 | round -%}
        {%- assign lt_rating = product.metafields.loox.avg_rating | default: 0 | plus: 0 -%}
        {%- assign lt_count = product.metafields.loox.num_reviews | default: 0 | plus: 0 -%}
        {%- assign lt_show_sub = section.settings.show_subscription_toggle -%}
        {%- assign lt_tagline_text = product.metafields.custom.tagline | default: section.settings.tagline -%}
        {%- assign hb1 = section.settings.hero_bullet_1 | strip -%}
        {%- assign hb2 = section.settings.hero_bullet_2 | strip -%}
        {%- assign hb3 = section.settings.hero_bullet_3 | strip -%}
        {%- assign lt_show_hero_bullets = false -%}
        {%- if hb1 != blank or hb2 != blank or hb3 != blank -%}
          {%- assign lt_show_hero_bullets = true -%}
        {%- endif -%}
        {%- assign lt_primary_cta_label = section.settings.cta_label | default: 'Jetzt kaufen →' -%}
        {%- assign lt_primary_cta_aria = lt_primary_cta_label | replace: '→', '' | strip -%}
        {%- comment -%}
          Bis 2026-07-30 lasen beide Labels aus `cta_label`, das es im Schema gar nicht gab.
          Der Verweis lief also immer ins Leere und beide Beschriftungen waren faktisch
          hartcodiert. Jetzt zwei eigene Settings, damit der Haupt-Button benennbar wird,
          ohne den Sticky-Button auf allen anderen PDPs mitzuziehen.
        {%- endcomment -%}
        {%- assign lt_sticky_cta_label = section.settings.sticky_cta_label | default: 'In den Warenkorb' -%}

        {%- comment -%}Reusable blocks — captured early so they can be placed before or after CTA depending on lt_show_sub{%- endcomment -%}
        {%- capture lt_trust_block -%}
          {%- if lt_trust_1 != blank or lt_trust_2 != blank or lt_trust_3 != blank or lt_trust_4 != blank -%}
          <div class="lt-pdp-hero__trust lt-trust">
            {%- if lt_trust_1 != blank -%}
              <div class="lt-pdp-hero__trust-item">
                {%- if section.settings.trust_1_icon != blank -%}
                  {{
                    section.settings.trust_1_icon
                    | image_url: width: 72
                    | image_tag: loading: 'lazy', class: 'lt-trust-icon-img', alt: ''
                  }}
                {%- else -%}
                  {% render 'lt-trust-icon', name: lt_trust_1_icon_name %}
                {%- endif -%}
                <span>{{ lt_trust_1 }}</span>
              </div>
            {%- endif -%}
            {%- if lt_trust_2 != blank -%}
              <div class="lt-pdp-hero__trust-item">
                {%- if section.settings.trust_2_icon != blank -%}
                  {{
                    section.settings.trust_2_icon
                    | image_url: width: 64
                    | image_tag: loading: 'lazy', class: 'lt-trust-icon-img', alt: ''
                  }}
                {%- else -%}
                  {% render 'lt-trust-icon', name: lt_trust_2_icon_name %}
                {%- endif -%}
                <span>{{ lt_trust_2 }}</span>
              </div>
            {%- endif -%}
            {%- if lt_trust_3 != blank -%}
              <div class="lt-pdp-hero__trust-item">
                {%- if section.settings.trust_3_icon != blank -%}
                  {{
                    section.settings.trust_3_icon
                    | image_url: width: 72
                    | image_tag: loading: 'lazy', class: 'lt-trust-icon-img', alt: ''
                  }}
                {%- else -%}
                  {% render 'lt-trust-icon', name: lt_trust_3_icon_name %}
                {%- endif -%}
                <span>{{ lt_trust_3 }}</span>
              </div>
            {%- endif -%}
            {%- comment -%}
              Slot 4 traegt auf NMN die Novel-Food-Einordnung: als Fussnote
              abgesetzt, damit sie nicht als vierter Vorteil gelesen wird.
              Auf PDPs, wo Zeile 4 ein gleichrangiger Vorteil ist (AGE&DNA:
              DSGVO), laeuft sie per trust_4_as_note=false im Block mit —
              die Extra-Haarlinie waere dort nur Tufte-Rauschen.
            {%- endcomment -%}
            {%- if lt_trust_4 != blank -%}
              <div class="lt-pdp-hero__trust-item{% if section.settings.trust_4_as_note %} lt-pdp-hero__trust-item--note{% endif %}">
                {%- if section.settings.trust_4_icon != blank -%}
                  {{
                    section.settings.trust_4_icon
                    | image_url: width: 72
                    | image_tag: loading: 'lazy', class: 'lt-trust-icon-img', alt: ''
                  }}
                {%- else -%}
                  {% render 'lt-trust-icon', name: lt_trust_4_icon_name %}
                {%- endif -%}
                {%- if section.settings.trust_4_popup_body != blank -%}
                  <button type="button" class="lt-pdp-hero__trust-link" data-crs-dialog-open aria-haspopup="dialog" aria-controls="crs-lt-hero-trust4-{{ section.id }}">{{ lt_trust_4 }}</button>
                {%- else -%}
                  <span>{{ lt_trust_4 }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
          {%- endif -%}
          {%- if section.settings.trust_4_popup_body != blank -%}
            <dialog id="crs-lt-hero-trust4-{{ section.id }}" class="crs-micro-dialog" aria-modal="true" aria-labelledby="crs-lt-hero-trust4-title-{{ section.id }}">
              <div class="crs-micro-dialog__inner">
                <button type="button" class="crs-micro-dialog__close" data-crs-dialog-close aria-label="{{ 'general.accessibility_labels.close' | t }}"><span aria-hidden="true">×</span></button>
