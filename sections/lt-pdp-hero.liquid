{% render 'crs-micro-dialog-init' %}

<script src="{{ 'section-main-product.js' | asset_url }}" defer></script>
{%- if video_script -%}
  <script>
    KrownAssetLoader.loadScript('{{ "component-video.js" | asset_url }}');
  </script>
{%- endif -%}
<script>
  (function() {
    const section = document.getElementById('lt-pdp-hero-{{ section.id }}');
    if (!section) return;

    const ltStickyShowCompare = section.dataset.ltStickyShowCompare !== '0';

    const reviewButton = section.querySelector('[data-lt-reviews-scroll]');

    function markLooxSection() {
      const looxRoot = document.querySelector(
        '#looxReviews, .loox-dynamic-section, [class*="loox-dynamic-section"], .loox-v2-widget-container'
      );
      if (!looxRoot) return false;

      const looxSection = looxRoot.closest('[id^="shopify-section-"]') || looxRoot.closest('.shopify-section') || looxRoot;
      looxSection.classList.add('lt-loox-section');

      if (!document.getElementById('lt-reviews') && !looxRoot.id) {
        looxRoot.id = 'lt-reviews';
      }

      return true;
    }

    if (!markLooxSection()) {
      const looxObserver = new MutationObserver(function() {
        if (markLooxSection()) looxObserver.disconnect();
      });
      looxObserver.observe(document.body, { childList: true, subtree: true });
      window.setTimeout(function() {
        looxObserver.disconnect();
      }, 12000);
    }

    if (reviewButton) {
      reviewButton.addEventListener('click', function() {
        const target = document.getElementById('lt-reviews')
          || document.querySelector('.lt-loox-section');
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    const buyBox = section.querySelector('[data-lt-buy-box]');
    const plansData = section.querySelector('#lt-selling-plans-data');
    const ltPlans = plansData ? JSON.parse(plansData.textContent).plans : [];


    const planInput = section.querySelector('#lt-selling-plan-input');
    const quantityInput = section.querySelector('[data-lt-quantity-input]');
    const mainPrice = section.querySelector('.lt-price-main');
    const priceCompare = section.querySelector('[data-js-product-price-compare]');
    const priceSaving = section.querySelector('[data-js-product-price-saving]');
    const baseComparePrice = {{ lt_compare_price | default: 0 }};
    // Vor dem Paket-Block deklariert: applyPkg ruft syncStickyAtcPrice schon beim
    // Init auf — stuende die const nach dem buyBox-Early-Return, waere das eine
    // TDZ-ReferenceError im Standalone-Pfad.
    const productPageId = 'product-{{ section.id }}';

    // --- Paket-Auswahl (Standalone-Pfad, kein Abo/keine Größen) -----------
    // MUSS vor dem buyBox-Early-Return stehen: der Standalone-Pfad hat keine
    // [data-lt-buy-box], das Skript würde sonst nie hierher kommen.
    const pkgGroup = section.querySelector('[data-lt-pkg-group]');
    if (pkgGroup) {
      const pkgVariantInput = section.querySelector('[data-lt-variant-input]');
      const pkgAmountEl = section.querySelector('[data-lt-direct-amount]');
      const pkgCompareEl = section.querySelector('[data-lt-direct-compare]');
      const pkgSavingsEl = section.querySelector('[data-lt-direct-savings]');
      const pkgCtaBase = {{ lt_primary_cta_label | json }};
      const pkgBaseShort = (function () {
        const first = pkgGroup.querySelector('.lt-pkg__input');
        return first ? (first.dataset.sizeShort || '') : '';
      })();
      function formatPkgPrice(cents) {
        const v = cents / 100;
        return (v % 1 === 0 ? String(v) : v.toFixed(2).replace('.', ',')) + ' €';
      }
      function applyPkg(inp) {
        if (!inp) return;
        if (pkgVariantInput && inp.dataset.variantId) pkgVariantInput.value = inp.dataset.variantId;
        const once = parseInt(inp.dataset.oncePrice, 10) || 0;
        const cmp = parseInt(inp.dataset.comparePrice, 10) || 0;
        const hasCmp = cmp > once;
        if (pkgAmountEl && once > 0) pkgAmountEl.textContent = formatPkgPrice(once);
        // Streichpreis + Ersparnis gelten je Paket; ohne gueltigen Compare beides aus,
        // sonst stuende der 399er-Streichpreis der Basis unter dem 429er-Paket.
        if (pkgCompareEl) {
          pkgCompareEl.hidden = !hasCmp;
          pkgCompareEl.textContent = hasCmp ? formatPkgPrice(cmp) : '';
        }
        if (pkgSavingsEl) {
          pkgSavingsEl.hidden = !hasCmp;
          pkgSavingsEl.textContent = hasCmp ? 'Du sparst ' + formatPkgPrice(cmp - once) : '';
        }
        // CTA-Echo wie im Abo-Pfad: Button traegt Label + Preis der Auswahl
        const pkgAtcText = section.querySelector('[data-js-product-add-to-cart-text]');
        const pkgAtcBtn = section.querySelector('#lt-hero-atc');
        const pkgSoldOut = pkgAtcBtn ? pkgAtcBtn.hasAttribute('data-lt-sold-out') : false;
        if (once > 0 && !pkgSoldOut) {
          const pkgLabel = pkgCtaBase + ', ' + formatPkgPrice(once);
          if (pkgAtcText) pkgAtcText.textContent = pkgLabel;
          if (pkgAtcBtn) pkgAtcBtn.setAttribute('aria-label', pkgLabel.replace(' →', ''));
        }
        // Sticky-Bar synchron: Preis + Paket-Chip (nur der Zusatz, "Test" allein
        // traegt neben dem Produkttitel keine Information)
        syncStickyAtcPrice(false, 1, once, 0, once, cmp);
        const short = inp.dataset.sizeShort || '';
        let chip = '';
        if (short && short !== pkgBaseShort) {
          chip = pkgBaseShort && short.indexOf(pkgBaseShort) === 0
            ? short.slice(pkgBaseShort.length).trim()
            : short;
        }
        updateStickySubline(chip);
        pkgGroup.querySelectorAll('[data-lt-pkg]').forEach(card => {
          const cardInput = card.querySelector('.lt-pkg__input');
          const on = cardInput === inp;
          card.classList.toggle('is-selected', on);
          if (cardInput) cardInput.checked = on;
        });
      }
      pkgGroup.querySelectorAll('.lt-pkg__input').forEach(inp => {
        inp.addEventListener('change', function () {
          if (this.checked) applyPkg(this);
        });
      });
      const basePkg = pkgGroup.querySelector('.lt-pkg__input:checked:not(:disabled)')
        || pkgGroup.querySelector('.lt-pkg__input:not(:disabled)');
      if (basePkg) {
        basePkg.checked = true;
        applyPkg(basePkg);
      }
    }
    // ----------------------------------------------------------------------

    if (!buyBox) return;

    const supplyDays = Math.max(1, parseFloat(buyBox.dataset.supplyDays) || 30);
    const badgeDiscountPct = Math.max(0, parseInt(buyBox.dataset.discountPct, 10) || 0);

    function formatPrice(cents) {
      return (cents / 100).toFixed(2).replace('.', ',') + ' €';
    }

    // grams>0 → €/100 g (PAngV-Grundpreis, keine Verzehr-/Dosis-/Dauer-Aussage); sonst Legacy €/Tag
    function formatUnit(cents, grams, qty) {
      if (grams > 0) {
        const per100 = ((cents / 100) / grams) * 100;
        return per100.toFixed(2).replace('.', ',') + ' €/100 g';
      }
      const totalDays = Math.max(1, supplyDays * Math.max(1, qty || 1));
      const perDay = (cents / 100) / totalDays;
      return perDay.toFixed(2).replace('.', ',') + ' €/Tag';
    }

    function escapeLtHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    /** Vergleichspreis für Sticky (wie Buy-Box / updatePriceMeta) */
    function stickyCompareCents(isSub, qty, onceCents, subCents, currentCents, perSizeCompare) {
      if (isSub) {
        return onceCents > subCents ? onceCents : 0;
      }
      var fallback = baseComparePrice > 0 ? baseComparePrice * qty : 0;
      var shopCompare = (!isNaN(perSizeCompare) && perSizeCompare > 0) ? perSizeCompare : fallback;
      return shopCompare > onceCents ? shopCompare : 0;
    }

    function buildStickyPriceInner(currentCents, compareCents) {
      var main = formatPrice(currentCents);
      var h =
        '<span class="sticky-add-to-cart__price-original text-weight--bold">' +
        escapeLtHtml(main) +
        '</span>';
      if (ltStickyShowCompare && compareCents > currentCents) {
        h +=
          '<del class="sticky-add-to-cart__price-compare">' +
          escapeLtHtml(formatPrice(compareCents)) +
          '</del>';
      }
      return h;
    }

    function syncStickyAtcPrice(isSub, qty, onceCents, subCents, currentCents, perSizeCompare) {
      var cmp = stickyCompareCents(isSub, qty, onceCents, subCents, currentCents, perSizeCompare);
      var inner = buildStickyPriceInner(currentCents, cmp);
      var wrapped =
        '<span class="show-block-if-variant-selected">' + inner + '</span>';

      var stickyRoot = document.querySelector('#lt-sticky-atc [data-js-atc-price]');
      if (stickyRoot) stickyRoot.innerHTML = inner;

      var hidden = document.querySelector('#' + productPageId + ' [data-update-block="price-sticky-main"]');
      if (hidden) hidden.innerHTML = wrapped;
    }

    // Sticky-Größenchip: zeigt NUR das Label der aktiven Auswahl (z.B. "30 g"),
    // damit die Leiste einzeilig bleibt. Sticky liegt nach Upgrade an <body>
    // → document-weit suchen.
    function updateStickySubline(short) {
      const el = document.querySelector('#lt-sticky-atc [data-lt-sticky-atc-subline]');
      if (!el) return;
      if (short) {
        el.textContent = short;
        el.hidden = false;
      } else {
        el.textContent = '';
        el.hidden = true;
      }
    }

    function savingsPct(onceC, subC) {
      if (!onceC || onceC <= subC) return 0;
      return Math.round((1 - subC / onceC) * 100);
    }

    function getRadio(card) {
      return card.querySelector('.lt-bb-card__input');
    }

    function updatePriceMeta(isSub, qty, onceCents, currentCents, perSizeCompare) {
      const fallback = baseComparePrice > 0 ? baseComparePrice * qty : 0;
      const onceCompare = (!isNaN(perSizeCompare) && perSizeCompare > 0) ? perSizeCompare : fallback;
      const compareCents = isSub ? onceCents : onceCompare;
      const savingCents = compareCents > currentCents ? compareCents - currentCents : 0;

      if (priceCompare) {
        priceCompare.textContent = compareCents > currentCents ? formatPrice(compareCents) : '';
      }
      if (priceSaving) {
        priceSaving.textContent = savingCents > 0 ? 'Du sparst ' + formatPrice(savingCents) : '';
      }
    }

    function updateCardFacades() {
      const cards = section.querySelectorAll('[data-lt-bb-card]');
      const subCards = [];

      cards.forEach(card => {
        const input = getRadio(card);
        if (!input) return;

        const kind = card.dataset.bbKind;
        const qty = Math.max(1, parseInt(input.dataset.quantity, 10) || 1);
        const grams = parseInt(input.dataset.grams, 10) || 0;
        const onceC = parseInt(input.dataset.oncePrice, 10) || 0;
        const subC = parseInt(input.dataset.subPrice, 10) || 0;
        const compareEl = card.querySelector('[data-lt-bb-compare]');
        const currentEl = card.querySelector('[data-lt-bb-current]');
        const unitEl = card.querySelector('[data-lt-bb-unit]');
        const badgeEl = card.querySelector('[data-lt-bb-badge]');

        if (kind === 'sub') {
          // Bei aktivem Sale (compare-at gesetzt) bezieht sich das Abo auf den Normalpreis
          // → zeigt den echten Doppelrabatt (Sale + Abo). Sonst: klassisch Abo-Ersparnis vs. Einmalkauf.
          const subRegular = baseComparePrice > 0 ? baseComparePrice : 0;
          // Gegen den EINMALPREIS pruefen, nicht gegen den Abo-Preis: der liegt konstruktiv
          // 10 % darunter, damit war die Bedingung bei compare_at == price immer wahr und der
          // Chip kippte ohne echten Rabatt von gruen auf rot. 2026-07-29
          const subSaleActive = subRegular > onceC;
          // Ohne Sale: echter Abo-Vorteil gegen den Einmalpreis derselben Größe (self-correcting,
          // sobald Appstle feste Preise liefert). badgeDiscountPct nur als Fallback, falls onceC fehlt.
          const pct = subSaleActive
            ? savingsPct(subRegular, subC)
            : (savingsPct(onceC, subC) || badgeDiscountPct);
          const subCmp = subSaleActive ? subRegular : onceC;
          subCards.push({ card, badgeEl, pct });

          if (badgeEl) {
            // Bei aktivem Sale trägt das Abo-Badge den Sale-Ton (coral), sonst den Abo-Ton (grün).
            badgeEl.classList.toggle('lt-bb-card__badge--sale', subSaleActive);
            badgeEl.classList.toggle('lt-bb-card__badge--strong', !subSaleActive);
            if (pct > 0) {
              badgeEl.textContent = 'SPARE ' + pct + '%';
              badgeEl.hidden = false;
            } else {
              badgeEl.textContent = '';
              badgeEl.hidden = true;
            }
          }
          if (compareEl) {
            if (subCmp > subC) {
              compareEl.textContent = formatPrice(subCmp);
              compareEl.hidden = false;
            } else {
              compareEl.textContent = '';
              compareEl.hidden = true;
            }
          }
          if (currentEl) currentEl.textContent = formatPrice(subC);
          if (unitEl) {
            unitEl.textContent = formatUnit(subC, grams, qty);
          }
        } else {
          // Per-size compare (from size selector) takes precedence over the section-level compare
          const perSizeCompare = parseInt(input.dataset.comparePrice, 10);
          const shopCompare = (!isNaN(perSizeCompare) && perSizeCompare > 0)
            ? perSizeCompare
            : (baseComparePrice > 0 ? baseComparePrice * qty : 0);
          if (compareEl) {
            if (shopCompare > onceC) {
              compareEl.textContent = formatPrice(shopCompare);
              compareEl.hidden = false;
            } else {
              compareEl.textContent = '';
              compareEl.hidden = true;
            }
          }
          if (currentEl) currentEl.textContent = formatPrice(onceC);
          if (unitEl) {
            unitEl.textContent = formatUnit(onceC, grams, qty);
          }
          const saleBadgeEl = card.querySelector('[data-lt-bb-sale-badge]');
          if (saleBadgeEl) {
            const salePct = shopCompare > onceC ? savingsPct(shopCompare, onceC) : 0;
            if (salePct > 0) {
              saleBadgeEl.textContent = 'SPARE ' + salePct + '%';
              saleBadgeEl.hidden = false;
            } else {
              saleBadgeEl.textContent = '';
              saleBadgeEl.hidden = true;
            }
          }
        }
      });

      if (subCards.length === 2) {
        const a = subCards[0].pct;
        const b = subCards[1].pct;
        const firstStrong = a >= b;
        [subCards[0], subCards[1]].forEach((entry, i) => {
          const el = entry.badgeEl;
          if (!el || el.hidden) return;
          const strong = i === 0 ? firstStrong : !firstStrong;
          el.classList.toggle('lt-bb-card__badge--strong', strong);
          el.classList.toggle('lt-bb-card__badge--muted', !strong);
        });
      }
    }

    function syncFromCard(card) {
      const input = getRadio(card);
      if (!input) return;

      const kind = card.dataset.bbKind;
      const qty = Math.max(1, parseInt(input.dataset.quantity, 10) || 1);
      const onceCents = parseInt(input.dataset.oncePrice, 10) || 0;
      const subCents = parseInt(input.dataset.subPrice, 10) || 0;
      const perSizeCompare = parseInt(input.dataset.comparePrice, 10);
      const isSub = kind === 'sub';
      const currentCents = isSub ? subCents : onceCents;

      if (variantInput && input.dataset.variantId) variantInput.value = input.dataset.variantId;
      if (quantityInput) quantityInput.value = String(qty);
      if (planInput) {
        // Plan je Größe kommt aus der Varianten-Allocation (data-plan-id, größenspezifische
        // Appstle-Gruppen mit Takt 2/4/6 Monate); ohne Größen-Selector Fallback ltPlans[0].
        planInput.value = isSub
          ? (input.dataset.planId || (ltPlans.length ? String(ltPlans[0].id) : ''))
          : '';
      }
      if (mainPrice) mainPrice.textContent = formatPrice(currentCents);

      updateCardFacades();
      updatePriceMeta(isSub, qty, onceCents, currentCents, perSizeCompare);

      syncStickyAtcPrice(isSub, qty, onceCents, subCents, currentCents, perSizeCompare);
      updateStickySubline(input.dataset.sizeShort);

      section.querySelectorAll('[data-lt-sub-only]').forEach(el => {
        el.hidden = !isSub;
      });

      var atcTextEl = section.querySelector('[data-js-product-add-to-cart-text]');
      var atcBtn = section.querySelector('#lt-hero-atc');
      // Bei ausverkaufter Variante bleibt das SSR-Label "Ausverkauft" stehen. Ohne diesen
      // Guard schreibt der Sync sofort wieder ein Kauf-Label darueber. 2026-07-29
      var atcSoldOut = atcBtn ? atcBtn.hasAttribute('data-lt-sold-out') : false;
      var atcLabel =
        (isSub ? 'Abo starten' : 'Einmalig kaufen') + ', ' + formatPrice(currentCents);
      if (atcTextEl && !atcSoldOut) {
        atcTextEl.textContent = atcLabel;
      }
      if (atcBtn && !atcSoldOut) {
        atcBtn.setAttribute('aria-label', atcLabel.replace(' →', ''));
      }
    }

    function selectCard(card) {
      if (!card) return;
      section.querySelectorAll('[data-lt-bb-card]').forEach(c => {
        c.classList.toggle('is-selected', c === card);
        const inp = getRadio(c);
        if (inp) inp.checked = c === card;
      });
      syncFromCard(card);
    }

    section.querySelectorAll('[data-lt-bb-card]').forEach(card => {
      const input = getRadio(card);
      if (!input) return;
      input.addEventListener('change', function() {
        if (this.checked) selectCard(card);
      });
    });

    // No selling plans → hide subscription card and or-divider, pre-select once card
    if (ltPlans.length === 0) {
      const noSubCard = section.querySelector('.lt-bb-card--sub');
      const noOrDiv  = section.querySelector('.lt-bb__or');
      if (noSubCard) {
        noSubCard.hidden = true;
        const noSubRadio = noSubCard.querySelector('.lt-bb-card__input');
        if (noSubRadio) noSubRadio.checked = false;
      }
      if (noOrDiv) noOrDiv.hidden = true;
      const noOnceCard = section.querySelector('.lt-bb-card--once');
      if (noOnceCard) {
        noOnceCard.classList.add('is-selected');
        const noOnceRadio = noOnceCard.querySelector('.lt-bb-card__input');
        if (noOnceRadio) noOnceRadio.checked = true;
      }
    }

    // --- Größen-Auswahl (Varianten) -------------------------------------
    // Eine Kachel pro Variante, als eigene Zone VOR den Kaufoption-Karten.
    // Die gewählte Größe wird auf BEIDE Karten geschrieben (Einmalkauf UND
    // Abo, je mit eigenem Preis aus data-once-/data-sub-price), danach synct
    // die aktuell gewählte Karte neu — Größenwahl wechselt den Modus nicht.
    // Wenn keine Größen-Gruppe da ist, bleibt das Verhalten unverändert.
    const sizeGroup = section.querySelector('[data-lt-size-group]');
    const variantInput = section.querySelector('[data-lt-variant-input]');
    const appstleWidget = section.querySelector('#lt-appstle-widget');

    function applySize(sizeInput) {
      if (!sizeInput) return;
      const onceCard = section.querySelector('.lt-bb-card--once');
      const subCard = section.querySelector('.lt-bb-card--sub');
      const onceRadio = onceCard ? getRadio(onceCard) : null;
      const subRadio = subCard ? getRadio(subCard) : null;
      [onceRadio, subRadio].forEach(radio => {
        if (!radio) return;
        radio.dataset.variantId = sizeInput.dataset.variantId || '';
        radio.dataset.oncePrice = sizeInput.dataset.oncePrice || '0';
        radio.dataset.grams = sizeInput.dataset.grams || '0';
        radio.dataset.sizeShort = sizeInput.dataset.sizeShort || '';
        radio.dataset.quantity = '1';
      });
      // compare-at nur auf den Einmalkauf; die Abo-Karte rechnet gegen den Einmalpreis derselben Größe
      if (onceRadio) onceRadio.dataset.comparePrice = sizeInput.dataset.comparePrice || '0';
      if (subRadio) {
        subRadio.dataset.subPrice = sizeInput.dataset.subPrice || '0';
        subRadio.dataset.planId = sizeInput.dataset.planId || '';
      }
      if (appstleWidget && sizeInput.dataset.variantId) {
        appstleWidget.setAttribute('data-variant-id', sizeInput.dataset.variantId);
      }
      // Sublines je Größe: Abo-Karte = Liefertakt (Plan-Name), Einmal-Karte = Versandstatus
      // (DE-Schwelle 49 €/4,90 €, siehe SSR-Kommentar an data-lt-once-subline)
      const subSublineEl = section.querySelector('[data-lt-sub-subline]');
      if (subSublineEl) {
        const plan = ltPlans.find(p => String(p.id) === (sizeInput.dataset.planId || ''));
        if (plan && plan.name) subSublineEl.textContent = plan.name;
      }
      const onceSublineEl = section.querySelector('[data-lt-once-subline]');
      if (onceSublineEl) {
        const oncePriceCents = parseInt(sizeInput.dataset.oncePrice, 10) || 0;
        onceSublineEl.textContent = oncePriceCents >= 4900 ? 'Versandkostenfrei' : 'zzgl. 4,90 € Versand';
      }
      section.querySelectorAll('[data-lt-size]').forEach(pill => {
        const inp = pill.querySelector('.lt-size__input');
        const on = inp === sizeInput;
        pill.classList.toggle('is-selected', on);
        if (inp) inp.checked = on;
      });
      // Ausverkaufte Groessen sind als Radio disabled, eine waehlbare Groesse ist also
      // lieferbar: ATC wieder freigeben, falls die SSR-Groesse ausverkauft war. 2026-07-29
      const atcBtnSize = section.querySelector('#lt-hero-atc');
      if (atcBtnSize && atcBtnSize.hasAttribute('data-lt-sold-out')) {
        atcBtnSize.removeAttribute('data-lt-sold-out');
        atcBtnSize.removeAttribute('disabled');
        atcBtnSize.classList.remove('disabled');
      }
      const activeCard = section.querySelector('.lt-bb-card__input:checked')?.closest('[data-lt-bb-card]');
      if (activeCard) {
        syncFromCard(activeCard);
      } else {
        updateCardFacades();
      }
    }

    // Einmal-Karte ist ein <div> (kein <label>, historisch wegen der Größen-Radios darin;
    // bleibt so für alle Sub-Toggle-PDPs) → Klick-Auswahl per JS.
    const onceCardEl = section.querySelector('.lt-bb-card--once');
    if (onceCardEl) {
      onceCardEl.addEventListener('click', function() {
        selectCard(onceCardEl);
      });
    }

    if (sizeGroup) {
      sizeGroup.querySelectorAll('.lt-size__input').forEach(inp => {
        inp.addEventListener('change', function() {
          if (this.checked) applySize(this);
        });
      });
      // Init: Basis-Größe (30 g bzw. Deep-Link) auf beide Karten schreiben — die
      // Modus-Auswahl (Abo default) kommt aus dem SSR-checked-State.
      const baseSize = sizeGroup.querySelector('.lt-size__input:checked:not(:disabled)')
        || sizeGroup.querySelector('.lt-size__input:not(:disabled)');
      if (baseSize) {
        baseSize.checked = true;
        applySize(baseSize);
      }
    }
    // --------------------------------------------------------------------

    const initialCard = section.querySelector('.lt-bb-card__input:checked')?.closest('[data-lt-bb-card]');
    if (initialCard) {
      selectCard(initialCard);
    } else {
      updateCardFacades();
    }

    /* Nach deferred section-main-product.js: StickyAddToCart kann Initial-HTML setzen — Buy-Box erneut anwenden */
    if (typeof customElements !== 'undefined' && customElements.whenDefined) {
      customElements.whenDefined('sticky-add-to-cart').then(function () {
        var inp = section.querySelector('.lt-bb-card__input:checked');
        if (inp) inp.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }
  })();
</script>

{% stylesheet %}
/* ===================================================
   LT PDP Hero — Cursor-Style Overrides
   lt-pdp.css tokens are remapped via the style block above.
   This block handles structural overrides that need
   CSS (not just token swaps).
   =================================================== */

/* Section background */
.lt-pdp-hero-section {
  background: var(--lt-bg, #f7f7f4);
}

/* Heading stack — Abstand zu den Bullets darunter */
.lt-pdp-hero__heading {
  margin-bottom: var(--space-5);
}

/* Gallery frame — sharp corners */
.lt-pdp-hero__gallery-frame {
  border-radius: 4px !important;
}

.lt-pdp-hero .product-gallery-item,
.lt-pdp-hero .product-gallery-item img {
  border-radius: 4px !important;
}

/* Bildfläche der Galerie. Die Katalogfotos tragen ihren Hintergrund im JPEG.
   Wo der nicht exakt der Sectionfläche entspricht (Spermidin läuft von
   #f4f3ef oben nach #ffffff unten, die Section ist #f7f7f4), entsteht sonst
   eine sichtbare Kante um das Bild. Eine eigene Fläche macht den Bildblock
   zu einem gewollten Objekt statt zu einem Fehler. */
.lt-pdp-hero .product-gallery-item {
  background: var(--lt-surface);
}

/* Rahmenfüllung, gesteuert über das Setting `gallery_fill`. Der Slide hat
   overflow:hidden, der Zoom verändert also nur den Bildausschnitt, nicht das
   Layout. Default 1 = Originalzuschnitt, damit sich ohne gesetztes Setting
   auf keiner PDP etwas ändert. */
.lt-pdp-hero .product-gallery-item img {
  transform: scale(var(--lt-gallery-fill, 1));
}

/* Galerie-Format `portrait_compact`: der Rahmen laeuft auf Desktop im
   Assetformat 4:5 und wird mobil auf 4:3 gedrueckt.

   Warum mobil flacher und nicht ueberall: auf Desktop steht die Galerie neben
   der Buy-Box, Hoehe kostet dort nichts und traegt das Produkt. Mobil steht
   sie ueber allem, jeder Pixel Rahmenhoehe schiebt Preis und Button nach
   unten. Gemessen auf 390px: erster Preis 866px zu 666px, Button 1109px zu
   909px.

   Das Motiv bleibt dabei gross, weil das Asset eng beschnitten ist: die Dose
   fuellt rund 85 Prozent der Assethoehe, gerendert also rund 265px gegen rund
   126px im alten quadratischen Katalogfoto.

   `!important` ist hier kein Spezifitaetstrick, sondern Pflicht: die Hoehe
   steht als Inline-`padding-top` am Element (snippets/product-media.liquid),
   und ein Inline-Style ist ohne !important nicht ueberschreibbar. */
@media (max-width: 767px) {
  .lt-pdp-hero--gallery-compact .product-gallery-item {
    padding-top: 75% !important;
  }
}

/* Purchase block — handled below (white surface + border) */

/* Direct price display — no-subscription mode */
.lt-price-direct {
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  margin-top: var(--space-5);
}
.lt-price-direct__row {
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.lt-price-direct__compare {
  font-size: 14px;
  opacity: 0.66; /* Sekundaer-AA-Alpha (WCAG-Basisbild 2026-07-29), 0.5 lag unter 4.5:1 */
  text-decoration: line-through;
  color: var(--lt-text, #26251e);
  line-height: 1.2;
}
.lt-price-direct__compare[hidden],
.lt-price-direct__savings[hidden] {
  display: none;
}
.lt-price-direct__amount {
  font-size: 36px;
  font-weight: 600;
  letter-spacing: -0.5px;
  line-height: 1;
  color: var(--lt-text, #26251e);
}
.lt-price-direct__savings {
  display: inline-block;
  font-size: 12px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(38, 37, 30, 0.06);
  color: var(--lt-text, #26251e);
  margin-top: 6px;
}
.lt-price-direct__note {
  font-size: 13px;
  opacity: 0.7;
  color: var(--lt-text, #26251e);
  margin-top: 8px;
  line-height: 1.4;
}
.lt-price-direct__payment {
  font-size: 13px;
  opacity: 0.7;
  color: var(--lt-text, #26251e);
  line-height: 1.4;
}

/* Paket-Auswahl (Standalone-Pfad): Karten-Optik wie die Kaufoption-Karten (lt-bb-card),
   aber ohne Modus-Logik. Radio-Punkt + Name + Preis in einer Zeile, Notiz darunter. */
.lt-pkg {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: var(--space-5);
}
.lt-pkg__card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px var(--space-4);
  border: 1px solid var(--lt-border, rgba(38,37,30,0.1));
  border-radius: 6px;
  background: transparent;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
}
/* Nicht gewaehlt heisst "andere Option", nicht "deaktiviert": kein Ganzflaechen-Dimmen.
   Die kompoundierte Opacity (0.72 Karte x 0.72 Notiz ≈ 0.52) drueckte die Beschreibung
   des Aufpreis-Pakets unter AA. Zuruecknahme nur ueber den Namen, Auswahl-Signal
   liegt in Border + weisser Flaeche + Radio. */
.lt-pkg__card:not(.is-selected) .lt-pkg__name { opacity: 0.85; }
.no-touchevents .lt-pkg__card:not(.is-selected):hover { border-color: rgba(38, 37, 30, 0.3); }
.lt-pkg__card.is-selected {
  background: var(--lt-surface-raised);
  border-color: var(--lt-text, #26251e);
  border-width: 1.5px;
  opacity: 1;
}
.lt-pkg__input {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: 0;
  opacity: 0;
  pointer-events: none;
}
.lt-pkg__input:focus-visible ~ .lt-pkg__head {
  outline: 2px solid var(--lt-text, #26251e);
  outline-offset: 3px;
  border-radius: 2px;
}
.lt-pkg__head {
  display: flex;
  align-items: center;
  gap: 10px;
}
.lt-pkg__radio {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  border: 1.5px solid rgba(38, 37, 30, 0.45); /* Affordance: als waehlbar erkennbar, nicht Deko-Haarlinie */
  border-radius: 50%;
  background: var(--lt-surface-raised);
}
.lt-pkg__card.is-selected .lt-pkg__radio {
  border-color: var(--lt-text, #26251e);
  box-shadow: inset 0 0 0 3.5px #fff;
  background: var(--lt-text, #26251e);
}
.lt-pkg__name {
  flex: 1 1 auto;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
  color: var(--lt-text, #26251e);
}
.lt-pkg__price {
  flex: 0 0 auto;
  font-size: 15px;
  font-weight: 600;
  color: var(--lt-text, #26251e);
}
.lt-pkg__note {
  font-size: 13px;
  line-height: 1.4;
  color: var(--lt-text, #26251e);
  opacity: 0.72; /* AA nur, weil die Karte selbst nicht mehr gedimmt wird */
  padding-left: 26px;
}

/* Kontakt-Fallback unter der Buy-Box: bewusst leise, Text + verlinkter Begriff */
.lt-pdp-hero__precheck {
  margin-top: var(--space-4);
  font-size: 13px;
  line-height: 1.4;
  color: var(--lt-text, #26251e);
}
.lt-pdp-hero__precheck-text { opacity: 0.72; }
.lt-pdp-hero__precheck-link {
  color: var(--lt-text, #26251e);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Inline-Dialog-Trigger (Trust-4) — wirkt wie verlinkter Text, nicht wie Button */
/* Compliance-Fussnote: abgesetzt von den drei Vorteils-Zeilen darueber, damit
   sie nicht als vierter Vorteil gelesen wird. Trennung ueber Weissraum und
   eine neutrale Haarlinie, nicht ueber Farbe. */
.lt-pdp-hero__trust-item--note {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1px solid var(--lt-border, rgba(38, 37, 30, 0.1));
  font-size: var(--text-body-sm);
}

.lt-pdp-hero__trust-link {
  appearance: none;
  -webkit-appearance: none;
  background: none;
  border: 0;
  padding: 0;
  font: inherit;
  color: inherit;
  text-align: left;
  cursor: pointer;
  text-decoration: underline dotted;
  text-underline-offset: 0.125em;
}

/* Größen-Hinweis unter der Buy-Box */
.lt-bb__size-hint {
  display: block;
  appearance: none;
  -webkit-appearance: none;
  background: none;
  border: 0;
  padding: 0;
  margin-top: var(--space-4);
  font-size: 0.8125rem;
  color: var(--lt-muted);
  cursor: pointer;
  text-decoration: underline dotted;
  text-underline-offset: 0.125em;
}

.lt-pdp-hero__post-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  margin-top: var(--space-2);
}

.lt-pdp-hero__post-cta .lt-pdp-hero__guarantee {
  margin-top: 0;
}

.lt-pdp-hero__guarantee--cancel[hidden] {
  display: none;
}

/* Sichtbarer Tastatur-Fokus für die neuen Text-Trigger (a11y) */
.lt-pdp-hero__trust-link:focus-visible,
.lt-bb__size-hint:focus-visible {
  outline: 0.125rem solid var(--lt-text);
  outline-offset: 0.125rem;
}

/* Buy-box cards — flat cursor style */
.lt-bb-card {
  background: var(--lt-bg, #f7f7f4) !important;
  border: 1px solid var(--lt-border, rgba(38,37,30,0.1)) !important;
  border-radius: 4px !important;
  box-shadow: none !important;
}

.lt-bb-card.is-selected {
  background: var(--lt-surface-raised) !important;
  border-color: var(--lt-text, #26251e) !important;
  border-width: 1.5px !important;
  box-shadow: none !important;
}

.lt-bb-card__perks {
  background: transparent !important;
  border-radius: 0 0 4px 4px !important;
}

.lt-bb-card__radio {
  border-color: var(--lt-border, rgba(38,37,30,0.2)) !important;
}

.lt-bb-card.is-selected .lt-bb-card__radio {
  border-color: var(--lt-text, #26251e) !important;
}

.lt-bb-card.is-selected .lt-bb-card__radio::after {
  background: var(--lt-text, #26251e) !important;
}

/* Card title — weight 400 */
.lt-bb-card__title {
  font-weight: 400 !important;
}

/* ATC — Spacing zum Preis-Stack reduzieren + Solid-Button-Theme erzwingen */
.lt-pdp-hero__content product-form,
.lt-pdp-hero__content product-form form,
.lt-pdp-hero__content .product-form,
.lt-pdp-hero__content .product__cart-functions,
.lt-pdp-hero__content .product__cart-functions .flex-buttons {
  margin: 0 !important;
  padding: 0 !important;
}
.lt-pdp-hero__content #lt-hero-atc {
  margin-top: var(--space-4) !important;
}
.lt-pdp-hero__atc.button,
#lt-hero-atc {
  border-radius: 999px !important;
  font-weight: 500 !important;
  font-size: 15px !important;
  background: var(--color-dark) !important;
  border-color: var(--color-dark) !important;
  color: var(--color-text-on-dark) !important;
  white-space: normal;
}

.lt-pdp-hero__atc.button .button__text,
