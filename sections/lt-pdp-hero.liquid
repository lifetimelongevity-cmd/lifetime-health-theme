  }
}

@media screen and (max-width: 767px) {
  .lt-pdp-hero .css-slider-navigation-container {
    display: flex !important;
    justify-content: center;
    margin-top: 12px;
  }

  .lt-pdp-hero .css-slider-dot-navigation {
    display: block !important;
  }
}

/* Once card — remove focus outline (shows as double border) */
.lt-bb-card:focus-within {
  outline: none !important;
}

/* Trust bar — adjust border color */
.lt-pdp-hero__trust {
  border-top-color: var(--lt-border, rgba(38,37,30,0.1)) !important;
  border-bottom-color: var(--lt-border, rgba(38,37,30,0.1)) !important;
}

/* Buy-Box — flat, no container styling */
.lt-purchase-block {
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
}

/* Savings badge — muted cursor tone */
.lt-price-row__saving {
  border-radius: 4px !important;
}

.lt-bb-card__badge {
  border-radius: 4px !important;
}

/* Value stack */
.lt-value-stack {
  border: 1px solid var(--lt-border, rgba(38,37,30,0.1));
  border-radius: 4px;
  padding: 16px;
  display: flex;
  flex-direction: column;
}

.lt-value-stack__header {
  font-size: 11px !important;
  font-weight: 500 !important;
  letter-spacing: 0.07em !important;
  text-transform: uppercase !important;
  color: var(--lt-muted, rgba(38,37,30,0.55)) !important;
  margin: 0 0 8px !important;
}

.lt-value-stack__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--lt-border, rgba(38,37,30,0.08));
  gap: 12px;
}

.lt-value-stack__item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.lt-value-stack__item-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--lt-text, #26251e);
}

.lt-value-stack__item-sub {
  font-size: 12px;
  color: var(--lt-muted, rgba(38,37,30,0.55));
}

.lt-value-stack__item-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1px;
  flex-shrink: 0;
}

.lt-value-stack__item-was {
  font-size: 11px;
  color: var(--lt-muted, rgba(38,37,30,0.4));
  text-decoration: line-through;
}

.lt-value-stack__item-label {
  font-size: 13px;
  font-weight: 500;
  color: var(--lt-text, #26251e);
}

.lt-value-stack__item-label--free {
  color: var(--lt-text, #26251e);
}

.lt-value-stack__total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid color-mix(in srgb, var(--lt-text, #26251e) 12%, transparent);
  opacity: 0.5;
}

.lt-value-stack__total-label {
  font-size: var(--font-size-sm, 12px);
  font-weight: 400;
  color: var(--lt-text, #26251e);
}

.lt-value-stack__total-value {
  font-size: var(--font-size-sm, 12px);
  font-weight: 500;
  color: var(--lt-text, #26251e);
  text-decoration: line-through;
}

.lt-value-stack__pay-today {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  margin-top: 4px;
}

.lt-value-stack__pay-label {
  font-size: var(--font-size-lg, 17px);
  font-weight: 700;
  color: var(--lt-text, #26251e);
}

.lt-value-stack__pay-price {
  font-size: var(--font-size-lg, 17px);
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--lt-text, #26251e);
}

/* Kaufoptionen — Zustand ueber Typografie und Farbe, nicht ueber Deckkraft.
   Vorher lag auf der abgewaehlten Karte `opacity: 0.6`. Das nahm sie zwar
   zurueck, riss aber den Kontrast mit: der Titel (15px/600, Textfarbe) fiel auf
   3.8:1, die Subline (--lt-muted, Alpha 0.72) auf 2.5:1, beides unter AA. Und
   der Preis blieb in beiden Karten 20px/700 — der gewaehlte Preis war optisch
   nicht der gewaehlte.
   Jetzt traegt der Preis die Zustandsinformation: gewaehlt gross und in
   Textfarbe, abgewaehlt kleiner, leichter und gedeckt. Rahmen und gefuellter
   Radio bleiben die zweite und dritte Ebene. Alle Textfarben bleiben AA. */
.lt-bb-card.is-selected .lt-bb-card__current {
  font-size: 22px;
}

.lt-bb-card:not(.is-selected) .lt-bb-card__current {
  font-size: 16px;
  font-weight: 600;
  color: var(--lt-muted, #525252);
}

.lt-bb-card__current {
  transition: color 0.15s ease;
}

.lt-bb-card:not(.is-selected) .lt-bb-card__title {
  font-weight: 500;
}

.lt-bb-card:not(.is-selected) .lt-bb-card__compare {
  font-size: 12px;
}

/* Der Streichpreis erbt aus der Theme-Basis `del { opacity: 0.54 }`. Zusammen
   mit --lt-muted (Alpha 0.72) landet er bei 2.3:1 und ist damit genau die
   Zahl, an der die Ersparnis haengt, kaum lesbar. Die Zuruecknahme leisten
   Schriftgrad (13px gegen 20px) und Durchstreichung bereits.
   Die Basisregel gilt theme-weit fuer jedes <del> und ist hier bewusst nur
   fuer die Buybox aufgehoben, nicht global. */
.lt-bb-card__compare {
  opacity: 1;
}

/* Hover-Affordanz ohne Deckkraft: die Kante zieht an, der Text bleibt lesbar. */
.no-touchevents .lt-bb-card:not(.is-selected):hover {
  border-color: color-mix(in srgb, var(--lt-primary-dark, #364f56) 45%, transparent);
}

/* Mobil bleibt der gewaehlte Preis auf 20px: die Preisspalte teilt sich die
   Zeile mit Titel, Spar-Badge und Subline, 22px draengen das Meta zu stark. */
@media (max-width: 767px) {
  .lt-bb-card.is-selected .lt-bb-card__current {
    font-size: 20px;
  }
}

/* Payment icons.
   gap: 4px statt 6px, damit die neun Zahlarten auf einer 390px-Breite in EINE
   Zeile passen (9 × 35px + 8 × 4px = 347px bei 358px Spaltenbreite). Mit 6px
   bricht das letzte Icon um und steht als einzelne Waise in Zeile zwei.
   Linksbündig, damit die Zone unter dem CTA dieselbe Kante hat wie die
   Trust-Zeilen darunter statt drei verschiedene Ausrichtungen zu mischen. */
.lt-payment-icons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  align-items: center;
  justify-content: flex-start;
  margin-top: var(--space-3);
}

/* Entsättigt. Die Shopify-Logos bringen sonst sechs Fremdfarben (AMEX-Blau,
   Klarna-Pink, Mastercard-Orange, PayPal-Blau, Shop-Lila, UnionPay-Rot) auf
   eine Seite, die sonst nur Petrol, Mint und Neutraltöne führt. Als Graustufe
   erfüllen sie ihre Aufgabe (Zahlarten belegen) ohne die lauteste Fläche der
   PDP zu sein. */
.lt-payment-icon {
  height: 22px;
  width: auto;
  border-radius: 3px;
  filter: grayscale(1);
  opacity: 0.5;
}

/* Benennt die eine Zahlart, die das Zögern beim hohen Einmalbetrag adressiert
   (Rechnungskauf), statt sie nur als graues Logo anzudeuten. Gleiche Größe und
   Farbe wie der Größen-Hinweis, damit die Zone unter dem CTA eine Stimme hat. */
.lt-payment-note {
  margin: var(--space-1) 0 0;
  font-size: 0.8125rem;
  line-height: 1.4;
  color: var(--lt-muted);
}

/* Größen-Auswahl — segmentierte Pills (flat, wie Buy-Box-Karten), als eigene Zone
   VOR den Kaufoption-Karten: immer sichtbar, unabhängig vom gewählten Modus */
.lt-size {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: var(--space-5);
  margin-bottom: var(--space-4);
}
.lt-bb-card--once { cursor: pointer; }
.lt-size__pill {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  min-height: 48px;
  padding: 8px 6px;
  border: 1px solid var(--lt-border, rgba(38,37,30,0.1));
  border-radius: 4px;
  background: var(--lt-bg, #f7f7f4);
  cursor: pointer;
  text-align: center;
  transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
}
.lt-size__pill:not(.is-selected) { opacity: 0.6; }
.no-touchevents .lt-size__pill:not(.is-selected):hover { opacity: 0.85; }
/* Der EINE Störer der Buybox: sitzt auf der Abo-Karte (Fokus 30-g-Abo, keine konkurrierende
   Lenkung auf den Pills). Badge-Sprache wie .lt-bb-card__badge--strong, auf der Oberkante links */
.lt-bb-card--sub { position: relative; }
.lt-bb-card__flag {
  position: absolute;
  top: -10px;
  left: var(--space-4);
  white-space: nowrap;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1;
  padding: 4px 8px;
  border-radius: 4px;
  background: var(--lt-success-text, #3b6d11);
  color: var(--lt-on-dark);
}
.lt-size__pill.is-selected {
  background: var(--lt-surface-raised);
  border-color: var(--lt-text, #26251e);
  border-width: 1.5px;
  opacity: 1;
}
/* Fokus-Ring nur per Tastatur (focus-visible) → kein Doppelrahmen beim Klick. Sibling-Pattern statt
   :has() → Indikator hängt nicht an :has-Support (WCAG 2.4.7 auch auf alten Browsern gewährleistet). */
.lt-size__input:focus-visible ~ .lt-size__name {
  outline: 2px solid var(--lt-text, #26251e);
  outline-offset: 3px;
  border-radius: 2px;
}
.lt-size__input {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: 0;
  opacity: 0;
  pointer-events: none;
}
.lt-size__name {
  font-size: 15px;
  font-weight: 500;
  line-height: 1.1;
  color: var(--lt-text, #26251e);
}
.lt-size__input:disabled ~ .lt-size__name {
  opacity: 0.4;
  text-decoration: line-through;
}

/* Verifiable purity proof — batch COA link */
.lt-pdp-hero__coa {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3, 0.5rem);
  margin-top: var(--space-4, 0.75rem);
}
.lt-pdp-hero__coa-icon {
  flex: 0 0 auto;
  margin-top: 2px;
  color: var(--lt-text, #26251e);
}
.lt-pdp-hero__coa-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 0.875rem;
  line-height: 1.3;
}
.lt-pdp-hero__coa-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 var(--space-3, 0.5rem);
}
.lt-pdp-hero__coa-purity {
  font-weight: 600;
  color: var(--lt-text, #26251e);
}
.lt-pdp-hero__coa-link {
  color: var(--lt-text, #26251e);
  text-decoration: underline dotted;
  text-underline-offset: 2px;
}
.lt-pdp-hero__coa-caption {
  font-size: 0.75rem;
  color: var(--lt-muted, rgba(38, 37, 30, 0.55));
}

