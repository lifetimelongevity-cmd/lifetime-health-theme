        {%- if lt_show_sub or section.settings.show_price_standalone -%}
          <div class="lt-purchase-block">
            {%- comment -%}
              Quiz-Vorteil: startet mit [hidden] und wird nur eingeblendet, wenn der Besucher
              ueber die Quiz-Ergebnisseite kam (?qz=1, danach in localStorage gemerkt).
              Der Rabatt selbst haengt am Code in ?discount=, den Shopify in den Warenkorb legt.
              Laeuft die Frist ab, verschwindet das Banner und die Merkung wird geloescht.
            {%- endcomment -%}
            {%- if section.settings.quiz_promo_enable and section.settings.quiz_promo_title != blank -%}
              <div class="lt-promo-banner lt-promo-banner--quiz" role="note" data-lt-quiz-promo hidden>
                <span class="lt-promo-banner__tag">{{ section.settings.quiz_promo_tag | default: 'Quiz-Vorteil' | escape }}</span>
                <span class="lt-promo-banner__text">
                  <span class="lt-promo-banner__title">{{ section.settings.quiz_promo_title | escape }}</span>
                  {%- if section.settings.quiz_promo_note != blank -%}
                    <span class="lt-promo-banner__note">{{ section.settings.quiz_promo_note | escape }}</span>
                  {%- endif -%}
                  {%- if section.settings.quiz_promo_deadline != blank -%}
                    <span class="lt-promo-banner__timer" data-lt-quiz-deadline="{{ section.settings.quiz_promo_deadline | escape }}">
                      {{ section.settings.quiz_promo_timer_label | default: 'Endet in' | escape }} <strong data-lt-quiz-countdown>–</strong>
                    </span>
                  {%- endif -%}
                </span>
              </div>
              <script>
                (function () {
                  var banner = document.currentScript.previousElementSibling;
                  if (!banner) return;
                  var KEY = 'lt_quiz_promo';
                  var timer = banner.querySelector('[data-lt-quiz-deadline]');
                  var out = timer ? timer.querySelector('[data-lt-quiz-countdown]') : null;
                  var deadline = timer ? new Date(timer.getAttribute('data-lt-quiz-deadline')).getTime() : NaN;

                  function forget() { try { localStorage.removeItem(KEY); } catch (e) {} }

                  function cameFromQuiz() {
                    try {
                      if (new URLSearchParams(window.location.search).get('qz') === '1') {
                        localStorage.setItem(KEY, '1');
                        return true;
                      }
                      return localStorage.getItem(KEY) === '1';
                    } catch (e) { return false; }
                  }

                  var over = !isNaN(deadline) && deadline - Date.now() <= 0;
                  if (over) { forget(); return; }
                  if (!cameFromQuiz()) return;

                  banner.hidden = false;
                  if (isNaN(deadline) || !out) return;

                  function pad(n) { return n < 10 ? '0' + n : '' + n; }
                  var iv = setInterval(tick, 1000);
                  function tick() {
                    var diff = deadline - Date.now();
                    if (diff <= 0) {
                      banner.hidden = true;
                      forget();
                      clearInterval(iv);
                      return;
                    }
                    var d = Math.floor(diff / 86400000);
                    var h = Math.floor((diff % 86400000) / 3600000);
                    var m = Math.floor((diff % 3600000) / 60000);
                    var s = Math.floor((diff % 60000) / 1000);
                    out.textContent = (d > 0 ? d + ' T ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
                  }
                  tick();
                })();
              </script>
            {%- endif -%}
            {%- if section.settings.show_promo_banner and section.settings.promo_banner_title != blank -%}
              <div class="lt-promo-banner" role="note">
                <span class="lt-promo-banner__tag">{{ section.settings.promo_banner_tag | default: 'Aktion' | escape }}</span>
                <span class="lt-promo-banner__text">
                  <span class="lt-promo-banner__title">{{ section.settings.promo_banner_title | escape }}</span>
                  {%- if section.settings.promo_banner_note != blank -%}
                    <span class="lt-promo-banner__note">{{ section.settings.promo_banner_note | escape }}</span>
                  {%- endif -%}
                  {%- if section.settings.promo_banner_deadline != blank -%}
                    <span class="lt-promo-banner__timer" data-lt-promo-deadline="{{ section.settings.promo_banner_deadline | escape }}" hidden>
                      {{ section.settings.promo_banner_timer_label | default: 'Endet in' | escape }} <strong data-lt-promo-countdown>–</strong>
                    </span>
                  {%- endif -%}
                </span>
              </div>
              <script>
                (function () {
                  var banner = document.currentScript.previousElementSibling;
                  var el = banner && banner.querySelector('[data-lt-promo-deadline]');
                  if (!el) return;
                  var out = el.querySelector('[data-lt-promo-countdown]');
                  var deadline = new Date(el.getAttribute('data-lt-promo-deadline')).getTime();
                  if (isNaN(deadline)) return;
                  function pad(n) { return n < 10 ? '0' + n : '' + n; }
                  function tick() {
                    var diff = deadline - Date.now();
                    if (diff <= 0) { el.hidden = true; return; }
                    var d = Math.floor(diff / 86400000);
                    var h = Math.floor((diff % 86400000) / 3600000);
                    var m = Math.floor((diff % 3600000) / 60000);
                    var s = Math.floor((diff % 60000) / 1000);
                    var txt = (d > 0 ? d + ' T ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
                    if (out) { out.textContent = txt; } else { el.textContent = txt; }
                    el.hidden = false;
                  }
                  tick();
                  setInterval(tick, 1000);
                })();
              </script>
            {%- endif -%}
            {%- liquid
              assign lt_show_sizes = false
              if section.settings.show_size_selector and product.variants.size > 1
                assign lt_show_sizes = true
              endif
              assign lt_disc = section.settings.sub_discount_percent | default: 10
              assign lt_sub_mult = 100 | minus: lt_disc
              # Default-Größe = kleinste Gramm-Variante (nicht stur variants.first → robust gegen Umsortierung)
              assign lt_abo_variant = product.variants.first
              assign lt_abo_min = 9999999
              for v in product.variants
                assign vg = v.title | replace: ' ', '' | replace: 'g', '' | replace: 'G', '' | times: 1
                if vg > 0 and vg < lt_abo_min
                  assign lt_abo_min = vg
                  assign lt_abo_variant = v
                endif
              endfor
              # Deep-Link (?variant=, z. B. GMC-Shopping-Klick) → Größe vorwählen, Abo bleibt Default;
              # der Einmalpreis der Größe (= Feed-Preis) bleibt auf der Einmal-Karte sichtbar.
              # Nur bei aktiver Größen-Auswahl; sonst bleibt das Verhalten anderer PDPs unverändert.
              assign lt_deeplinked = false
              if lt_show_sizes and product.selected_variant != blank
                assign lt_deeplinked = true
              endif
              # SSR-aktive Variante für hidden id, ATC-Disabled und beide Karten: Deep-Link-Größe, sonst kleinste
              assign lt_active_variant = lt_abo_variant
              if lt_deeplinked
                assign lt_active_variant = lt_preselect_variant
              endif
              assign lt_abo_grams = lt_active_variant.title | replace: ' ', '' | replace: 'g', '' | replace: 'G', '' | times: 1
              # Abo-Preis + Plan aus der Allocation mit FESTER Preis-Policy (größenspezifische
              # Appstle-Gruppen „NMN 30/60/90 g", je Variante genau eine). Solange die alte
              # 10-%-Gruppe „Spar-Abo" zusätzlich auf dem Produkt liegt, wäre .first mehrdeutig.
              # Fallback: erste Allocation, sonst price × (100 − Rabatt).
              assign lt_abo_alloc = lt_active_variant.selling_plan_allocations.first
              for alloc in lt_active_variant.selling_plan_allocations
                if alloc.selling_plan.price_adjustments.first.value_type == 'price'
                  assign lt_abo_alloc = alloc
                  break
                endif
              endfor
              if lt_abo_alloc
                assign lt_abo_sub = lt_abo_alloc.price
              else
                assign lt_abo_sub = lt_active_variant.price | times: lt_sub_mult | divided_by: 100
              endif
            -%}
            {%- if lt_show_sub -%}
            {%- if lt_show_sizes -%}
              {%- comment -%} Größe VOR Modus (Zone B vor Zone C, nmn-angebotsarchitektur §6): der Selector
                  steht über beiden Kaufoption-Karten und schreibt die gewählte Größe auf BEIDE. {%- endcomment -%}
              <div class="lt-size" data-lt-size-group role="radiogroup" aria-label="Größe wählen">
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign v_compare = variant.compare_at_price | default: 0
                    assign v_grams = variant.title | replace: ' ', '' | replace: 'g', '' | replace: 'G', '' | times: 1
                    # Abo-Preis + Plan je Größe aus der Allocation mit FESTER Preis-Policy
                    # (siehe Kommentar oben bei lt_abo_alloc), Fallback price × (100 − Rabatt)
                    assign v_alloc = variant.selling_plan_allocations.first
                    for alloc in variant.selling_plan_allocations
                      if alloc.selling_plan.price_adjustments.first.value_type == 'price'
                        assign v_alloc = alloc
                        break
                      endif
                    endfor
                    if v_alloc
                      assign v_sub = v_alloc.price
                    else
                      assign v_sub = variant.price | times: lt_sub_mult | divided_by: 100
                    endif
                  -%}
                  <label class="lt-size__pill{% if variant.id == lt_active_variant.id %} is-selected{% endif %}" data-lt-size>
                    <input
                      type="radio"
                      class="lt-size__input"
                      name="lt-size-{{ section.id }}"
                      value="{{ variant.id }}"
                      {% if variant.id == lt_active_variant.id %}checked{% endif %}
                      data-variant-id="{{ variant.id }}"
                      data-once-price="{{ variant.price }}"
                      data-sub-price="{{ v_sub }}"
                      data-plan-id="{% if v_alloc %}{{ v_alloc.selling_plan.id }}{% endif %}"
                      data-compare-price="{{ v_compare }}"
                      data-grams="{{ v_grams }}"
                      data-size-short="{{ variant.title | escape }}"
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    {%- comment -%} Nur die Menge, keine Preise: Grundpreis/Ersparnis hängen am Modus (Abo vs. einmalig)
                        und stehen deshalb ausschließlich in den Karten, die beim Größenwechsel live mitgehen.
                        Zwei Grundpreis-Basen gleichzeitig (Pill einmalig, Karte Abo) wirkten widersprüchlich. {%- endcomment -%}
                    <span class="lt-size__name">{{ variant.title | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div
              class="lt-bb{% if bb_or_label == blank %} lt-bb--no-or{% endif %}"
              data-lt-buy-box
              data-supply-days="{{ bb_supply_days | plus: 0 }}"
              data-discount-pct="{{ section.settings.sub_discount_percent | default: 10 }}"
              role="radiogroup"
              aria-label="Kaufoption wählen"
            >
              <label
                class="lt-bb-card lt-bb-card--sub is-selected"
                data-lt-bb-card
                data-bb-kind="sub"
              >
                {%- if bb_sub_flag != blank -%}
                  <span class="lt-bb-card__flag">{{ bb_sub_flag | escape }}</span>
                {%- endif -%}
                <input
                  type="radio"
                  class="lt-bb-card__input"
                  name="lt-bb-{{ section.id }}"
                  value="sub-1"
                  checked
                  data-quantity="{{ lt_pill_1_qty }}"
                  {%- if lt_show_sizes -%}
                  data-once-price="{{ lt_active_variant.price }}"
                  data-sub-price="{{ lt_abo_sub }}"
                  data-plan-id="{% if lt_abo_alloc %}{{ lt_abo_alloc.selling_plan.id }}{% endif %}"
                  data-variant-id="{{ lt_active_variant.id }}"
                  data-grams="{{ lt_abo_grams }}"
                  data-size-short="{{ lt_active_variant.title | escape }}"
                  {%- else -%}
                  data-once-price="{{ lt_pill_1_once }}"
                  data-sub-price="{{ lt_pill_1_sub }}"
                  {%- endif -%}
                >
                <span class="lt-bb-card__body">
                  <span class="lt-bb-card__head">
                    <span class="lt-bb-card__radio" aria-hidden="true"></span>
                    <span class="lt-bb-card__row">
                      <span class="lt-bb-card__meta">
                        <span class="lt-bb-card__title-row">
                          <span class="lt-bb-card__title">{{ bb_sub1_title | escape }}</span>
                          <span class="lt-bb-card__badge lt-bb-card__badge--strong" data-lt-bb-badge>SPARE {{ section.settings.sub_discount_percent | default: 10 }}%</span>
                        </span>
                        {%- if lt_show_sizes and lt_abo_alloc -%}
                          {%- comment -%} Subline = echter Liefertakt der gewählten Größe (Plan-Name, z. B. „Alle 2 Monate");
                              JS zieht sie beim Größenwechsel nach. Der Takt ist je Größe fix vorbelegt, nicht frei wählbar. {%- endcomment -%}
                          <span class="lt-bb-card__sub" data-lt-sub-subline>{{ lt_abo_alloc.selling_plan.name | escape }}</span>
                        {%- else -%}
                          <span class="lt-bb-card__sub">{{ bb_sub1_sub | escape }}</span>
                        {%- endif -%}
                      </span>
                      <span class="lt-bb-card__prices">
                        <del class="lt-bb-card__compare" data-lt-bb-compare></del>
                        <span class="lt-bb-card__current" data-lt-bb-current></span>
                        <span class="lt-bb-card__unit" data-lt-bb-unit></span>
                      </span>
                    </span>
                  </span>
                  <span class="lt-bb-card__perks">
                    {%- if bb_b1 != blank -%}
                      <span class="lt-bb-card__perk">
                        {%- if section.settings.bb_perk_1_icon != blank -%}
                          {{
                            section.settings.bb_perk_1_icon
                            | image_url: width: 56
                            | image_tag: loading: 'lazy', class: 'lt-bb-card__perk-icon', alt: ''
                          }}
                        {%- else -%}
                          {% render 'lt-trust-icon', name: bb_perk_1_icon_name, size: 14 %}
                        {%- endif -%}
                        <span>{{ bb_b1 | escape }}</span>
                      </span>
                    {%- endif -%}
                    {%- if bb_b2 != blank -%}
                      <span class="lt-bb-card__perk">
                        {%- if section.settings.bb_perk_2_icon != blank -%}
                          {{
                            section.settings.bb_perk_2_icon
                            | image_url: width: 56
                            | image_tag: loading: 'lazy', class: 'lt-bb-card__perk-icon', alt: ''
                          }}
                        {%- else -%}
                          {% render 'lt-trust-icon', name: bb_perk_2_icon_name, size: 14 %}
                        {%- endif -%}
                        <span>{{ bb_b2 | escape }}</span>
                      </span>
                    {%- endif -%}
                    {%- if bb_b3 != blank -%}
                      <span class="lt-bb-card__perk">
                        {%- if section.settings.bb_perk_3_icon != blank -%}
                          {{
                            section.settings.bb_perk_3_icon
                            | image_url: width: 56
                            | image_tag: loading: 'lazy', class: 'lt-bb-card__perk-icon', alt: ''
                          }}
                        {%- else -%}
                          {% render 'lt-trust-icon', name: bb_perk_3_icon_name, size: 14 %}
                        {%- endif -%}
                        <span>{{ bb_b3 | escape }}</span>
                      </span>
                    {%- endif -%}
                    {%- if bb_b4 != blank -%}
                      <span class="lt-bb-card__perk">
                        {%- if section.settings.bb_perk_4_icon != blank -%}
                          {{
                            section.settings.bb_perk_4_icon
                            | image_url: width: 56
                            | image_tag: loading: 'lazy', class: 'lt-bb-card__perk-icon', alt: ''
                          }}
                        {%- else -%}
                          {% render 'lt-trust-icon', name: bb_perk_4_icon_name, size: 14 %}
                        {%- endif -%}
                        <span>{{ bb_b4 | escape }}</span>
                      </span>
                    {%- endif -%}
                  </span>
                </span>
              </label>

              {%- if bb_or_label != blank -%}
                <div class="lt-bb__or" role="presentation">
                  <span class="lt-bb__or-line" aria-hidden="true"></span>
                  <span class="lt-bb__or-text">{{ bb_or_label | escape }}</span>
                  <span class="lt-bb__or-line" aria-hidden="true"></span>
                </div>
              {%- endif -%}

              <div class="lt-bb-card lt-bb-card--once" data-lt-bb-card data-bb-kind="once">
                <input
                  type="radio"
                  class="lt-bb-card__input"
                  name="lt-bb-{{ section.id }}"
                  value="once"
                  aria-label="{{ bb_once_title | escape }}"
                  data-quantity="{{ lt_pill_1_qty }}"
                  data-once-price="{{ lt_pill_1_once }}"
                  data-sub-price="{{ lt_pill_1_sub }}"
                >
                <span class="lt-bb-card__body">
                  <span class="lt-bb-card__head lt-bb-card__head--once">
                    <span class="lt-bb-card__radio" aria-hidden="true"></span>
                    <span class="lt-bb-card__row lt-bb-card__row--once">
                      <span class="lt-bb-card__meta">
                        <span class="lt-bb-card__title-row">
                          <span class="lt-bb-card__title">{{ bb_once_title | escape }}</span>
                          <span class="lt-bb-card__badge lt-bb-card__badge--sale" data-lt-bb-sale-badge hidden></span>
                        </span>
                        {%- if lt_show_sizes -%}
                          {%- comment -%} Versandstatus je gewählter Größe statt statischem „ab 49 €": über der DE-Schwelle
                              positiv „Versandkostenfrei", darunter der Fakt. Schwelle/Kosten: §7 nmn-angebotsarchitektur;
                              bei Versandänderung hier UND im JS (applySize) mitziehen. {%- endcomment -%}
                          <span class="lt-bb-card__sub" data-lt-once-subline>{% if lt_active_variant.price >= 4900 %}Versandkostenfrei{% else %}zzgl. 4,90 € Versand{% endif %}</span>
                        {%- else -%}
                          <span class="lt-bb-card__sub">{{ bb_once_sub | escape }}</span>
                        {%- endif -%}
                      </span>
                      <span class="lt-bb-card__prices">
                        <del class="lt-bb-card__compare" data-lt-bb-compare></del>
                        <span class="lt-bb-card__current" data-lt-bb-current></span>
                        <span class="lt-bb-card__unit" data-lt-bb-unit></span>
                      </span>
                    </span>
                  </span>
                </span>
              </div>
            </div>
            {%- else -%}
            {%- liquid
              # Paket-Auswahl (Standalone-Pfad, z. B. Test vs. Test + Ergebnisgespräch):
              # bewusst getrennt vom Größen-Selector, der Gramm-Titel parst und am
              # Abo-Pfad hängt. Preise kommen dynamisch aus der Variante, die Karte
              # trägt nur eine beschreibende Notiz aus den Settings.
              assign lt_show_packages = false
              if section.settings.show_package_selector and product.variants.size > 1
                assign lt_show_packages = true
              endif
            -%}
            {%- if lt_show_packages -%}
              <div class="lt-pkg" data-lt-pkg-group role="radiogroup" aria-label="Paket wählen">
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign pkg_note = ''
                    if forloop.index == 1
                      assign pkg_note = section.settings.pkg_note_1
                    elsif forloop.index == 2
                      assign pkg_note = section.settings.pkg_note_2
                    endif
                  -%}
                  <label class="lt-pkg__card{% if variant.id == lt_variant_1.id %} is-selected{% endif %}" data-lt-pkg>
                    <input
                      type="radio"
                      class="lt-pkg__input"
                      name="lt-pkg-{{ section.id }}"
                      value="{{ variant.id }}"
                      {% if variant.id == lt_variant_1.id %}checked{% endif %}
                      data-variant-id="{{ variant.id }}"
                      data-once-price="{{ variant.price }}"
                      data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                      data-size-short="{{ variant.title | escape }}"
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <span class="lt-pkg__head">
                      <span class="lt-pkg__radio" aria-hidden="true"></span>
                      <span class="lt-pkg__name">{{ variant.title | escape }}</span>
                      {%- liquid
                        # Aufpreis-Framing ab Karte 2: die Kauffrage ist "was kostet mich das
                        # Extra?", nicht der zweite Gesamtpreis neben dem 349-Anker. Der
                        # Gesamtpreis bleibt fuer Screenreader in der Karte und steht nach
                        # Auswahl gross im Preisblock (PAngV: dort ist der Gesamtpreis).
                        assign pkg_delta = variant.price | minus: product.variants.first.price
                      -%}
                      {%- if forloop.first == false and pkg_delta > 0 -%}
                        <span class="lt-pkg__price">+ {{ pkg_delta | money_without_trailing_zeros }}<span class="visually-hidden"> (gesamt {{ variant.price | money_without_trailing_zeros }})</span></span>
                      {%- else -%}
                        <span class="lt-pkg__price">{{ variant.price | money_without_trailing_zeros }}</span>
                      {%- endif -%}
                    </span>
                    {%- if pkg_note != blank -%}
                      <span class="lt-pkg__note">{{ pkg_note | escape }}</span>
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="lt-price-direct">
              {%- comment -%} Streichpreis + Ersparnis immer im DOM (hidden-gated), damit applyPkg
                  sie je Paket nachziehen kann. Vorher SSR-konditional: beim Paketwechsel blieben
                  399-€-Streichpreis und "Du sparst 50 €" der Basis unter dem 429-€-Paket stehen. {%- endcomment -%}
              <div class="lt-price-direct__row">
                <span class="lt-price-direct__amount" data-lt-direct-amount>{{ lt_pill_1_once | money_without_trailing_zeros }}</span>
                <span class="lt-price-direct__compare" data-lt-direct-compare {% unless lt_compare_price > lt_pill_1_once %}hidden{% endunless %}>{% if lt_compare_price > lt_pill_1_once %}{{ lt_compare_price | money_without_trailing_zeros }}{% endif %}</span>
              </div>
              <span class="lt-price-direct__savings" data-lt-direct-savings {% unless lt_compare_price > lt_pill_1_once %}hidden{% endunless %}>{% if lt_compare_price > lt_pill_1_once %}Du sparst {{ lt_compare_price | minus: lt_pill_1_once | money_without_trailing_zeros }}{% endif %}</span>
              {%- if section.settings.bb_once_subline != blank -%}
                <span class="lt-price-direct__note">{{ section.settings.bb_once_subline | escape }}</span>
              {%- endif -%}
              {%- comment -%} Zahlungs-Entlastung an den Preisanker statt ans Spaltenende:
                  bei High-Ticket gehoert der Klarna-Hinweis in den Moment der Preisentscheidung. {%- endcomment -%}
              {%- assign lt_payment_note = section.settings.payment_note | strip -%}
              {%- if lt_payment_note != blank -%}
                <span class="lt-price-direct__payment">{{ lt_payment_note | escape }}</span>
                {%- assign lt_payment_note_rendered = true -%}
              {%- endif -%}
            </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if lt_show_sub -%}
          <div
            id="lt-appstle-widget"
            data-product-id="{{ product.id }}"
            data-variant-id="{{ lt_variant_1.id }}"
            style="display:none"
          >
            <div class="appstle_subscription_widget" data-product-id="{{ product.id }}"></div>
          </div>
        {%- endif -%}

        {%- if lt_show_sub and section.settings.cancel_popup_body != blank -%}
          <dialog id="crs-lt-hero-cancel-{{ section.id }}" class="crs-micro-dialog" aria-modal="true" aria-labelledby="crs-lt-hero-cancel-title-{{ section.id }}">
            <div class="crs-micro-dialog__inner">
              <button type="button" class="crs-micro-dialog__close" data-crs-dialog-close aria-label="{{ 'general.accessibility_labels.close' | t }}"><span aria-hidden="true">×</span></button>
              <h2 id="crs-lt-hero-cancel-title-{{ section.id }}" class="crs-micro-dialog__title">{{ section.settings.cancel_popup_title | default: 'Abo jederzeit kündbar' | escape }}</h2>
              <div class="crs-micro-dialog__body rte">{{ section.settings.cancel_popup_body }}</div>
            </div>
          </dialog>
        {%- endif -%}

        {%- unless lt_show_sub -%}
          {{ lt_value_stack_block }}
        {%- endunless -%}

        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        <product-form
          id="add-to-cart-{{ section.id }}"
          class="product-form"
          {% if settings.cart_action == 'overlay' %}
            data-ajax-cart
            data-js-product-form
          {% endif %}
        >
          {%- form 'product',
            product,
            id: product_form_id,
            class: 'form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input type="hidden" name="id" value="{% if lt_show_sizes %}{{ lt_active_variant.id }}{% else %}{{ lt_variant_1.id }}{% endif %}" data-lt-variant-input>
            <input type="hidden" name="quantity" value="1" data-lt-quantity-input>
            <input type="hidden" id="lt-selling-plan-input" name="selling_plan" value="">
            {%- liquid
              # Ausverkauft muss am Button ankommen, nicht nur als CSS-Klasse. Vorher trug der Hero
              # bei Bestand 0 weiter das Kauf-Label und blieb absendbar, waehrend der Combine-Button
              # darunter korrekt "Ausverkauft" zeigte (live auf /products/astaxanthin-kapseln).
              # Der Groessenpfad ist unkritisch: ausverkaufte Groessen sind als Radio disabled,
              # eine waehlbare Groesse ist damit immer lieferbar. 2026-07-29
              assign lt_atc_available = current_variant.available
              if lt_show_sizes
                assign lt_atc_available = lt_active_variant.available
              endif
              assign lt_atc_label = lt_primary_cta_label
              assign lt_atc_aria = lt_primary_cta_aria
              # Paket-Pfad: CTA traegt die konsolidierte Auswahl (Label + Preis), wie es
              # der Abo-Pfad per JS tut. SSR nur fuer den Erst-Render, applyPkg zieht nach.
              if lt_show_packages and lt_atc_available
                assign lt_atc_price_txt = lt_pill_1_once | money_without_trailing_zeros
                assign lt_atc_label = lt_atc_label | append: ', ' | append: lt_atc_price_txt
                assign lt_atc_aria = lt_atc_label | replace: '→', '' | strip
              endif
              unless lt_atc_available
                assign lt_atc_label = 'Ausverkauft'
                assign lt_atc_aria = 'Ausverkauft'
              endunless
            -%}
            <div class="product__cart-functions">
              <div class="flex-buttons">
                <button
                  id="lt-hero-atc"
                  type="submit"
                  name="add"
                  class="add-to-cart button button--solid button--product button--loader button--move lt-pdp-hero__atc{% unless lt_atc_available %} disabled{% endunless %}"
                  {% unless lt_atc_available %}disabled data-lt-sold-out{% endunless %}
                  data-js-product-add-to-cart
                  data-main-product-add-to-cart
                  aria-label="{{ lt_atc_aria | escape }}"
                >
                  {%- comment -%} aria-live: der CTA-Text trägt die konsolidierte Auswahl (Modus + Preis)
                      und sagt Screenreadern damit jeden Größen-/Moduswechsel genau einmal an {%- endcomment -%}
                  <span class="button__text" data-js-product-add-to-cart-text aria-live="polite">
                    {{ lt_atc_label | escape }}
                  </span>
                  <span class="button__preloader">
                    <svg class="button__preloader-element" viewBox="25 25 50 50">
                      <circle cx="50" cy="50" r="20" fill="none" stroke-width="4"></circle>
                    </svg>
                  </span>
                </button>
              </div>
            </div>
          {%- endform -%}
        </product-form>

        {%- assign lt_show_cancel_after_cta = false -%}
        {%- if lt_show_sub and section.settings.cancel_popup_body != blank -%}
          {%- assign lt_show_cancel_after_cta = true -%}
        {%- endif -%}
        {%- assign lt_guarantee_line = section.settings.guarantee_text | default: 'Das 30-Tage-Zell-Versprechen, kein Formular, kein Aufwand' -%}
        {%- assign lt_guarantee_popup_plain = section.settings.guarantee_popup_body | default: '' | strip_html | strip -%}
        {%- if lt_show_cancel_after_cta or section.settings.show_guarantee_badge -%}
          <div class="lt-pdp-hero__post-cta">
            {%- if lt_show_cancel_after_cta -%}
              {%- assign lt_cancel_hidden_initially = false -%}
              {%- if product.selling_plan_groups.size == 0 -%}
                {%- assign lt_cancel_hidden_initially = true -%}
              {%- endif -%}
              <div class="lt-pdp-hero__guarantee lt-pdp-hero__guarantee--cancel" data-lt-sub-only{% if lt_cancel_hidden_initially %} hidden{% endif %}>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.25 7a4.75 4.75 0 1 0 1.4-3.36L2.25 5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M2.25 2.5V5h2.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <button
                  type="button"
                  class="lt-pdp-hero__guarantee-btn"
                  data-crs-dialog-open
                  aria-haspopup="dialog"
                  aria-controls="crs-lt-hero-cancel-{{ section.id }}"
                >
                  {{ section.settings.cancel_popup_title | default: 'Abo jederzeit kündbar' | escape }}
                </button>
              </div>
            {%- endif -%}

            {%- if section.settings.show_guarantee_badge -%}
              <div class="lt-pdp-hero__guarantee">
                {%- if section.settings.guarantee_badge_icon != blank -%}
                  {{
                    section.settings.guarantee_badge_icon
                    | image_url: width: 48
                    | image_tag: loading: 'lazy', class: 'lt-pdp-hero__guarantee-icon-img', alt: ''
