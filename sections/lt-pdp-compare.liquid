          "id": "other",
          "label": "Andere Tests",
          "default": "Höchstens eine Zahl"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Vergleich kurz",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "label": "Genetische Anlage", "ours": "23 DNA-Kategorien", "other": "Nur bei reinen DNA-Tests, dann ohne Alter" } },
        { "type": "row", "settings": { "label": "Danach", "ours": "App mit AI Health Coach", "other": "PDF-Report oder Laborbefund" } }
      ]
    }
  ]
}
{% endschema %}
