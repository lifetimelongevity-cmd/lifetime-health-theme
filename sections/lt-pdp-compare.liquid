{%- comment -%}
  Kurze Gegenueberstellung LIFETIME gegen andere Tests (AGE&DNA-PDP, 16.10.2026).

  Ersetzt dort lt-comparison-table: vier Spalten, die auf dem Handy zu 16
  Zeilen untereinander wurden (1678 px auf 375 px), die meisten Felder der
  anderen Tests nur "Nein" oder "Keine". Hier zwei Spalten, eine Zeile je
  Unterschied, Haarlinien statt Karten. Die drei
  Spalten der Wettbewerber sind zu "andere Tests" zusammengefasst, ihre Texte
  stammen aus der alten Tabelle.

  Ueberarbeitet 16.10.2026 nach BJ-Feedback (Pille mit Schatten zu schwer,
  rechte Spalte verloren): die LIFETIME-Spalte liegt jetzt auf einem
  durchgehenden weissen Blatt, Kopf ohne Pille, Merkmal mobil im Blatt statt
  als Versalzeile, das Kreuz als Kontur-Gegenstueck zum Haekchen.

  lt-comparison-table bleibt unveraendert, sie laeuft auf Spermidin und NMN.

  Beruhigt 16.10.2026 nach BJ-Feedback (zu viele Unterschiede): beide
  Spalten gleich breit, Werte links und rechts in derselben Schrift und
  Groesse, Haekchen und Kreuz gleich gross und beide gefuellt. Was die
  Seiten unterscheidet, sind nur noch das weisse Blatt und die Tonwerte.
  Die Scroll-Animation der Haekchen ist raus, das Bild steht.
  Desktop: Ueberschrift links, Tabelle rechts. Unter 980px untereinander.
{%- endcomment -%}
{%- liquid
  assign cp_head = section.settings.heading | strip
  assign cp_sub = section.settings.subheading | strip
  if cp_head == '__none__'
    assign cp_head = ''
  endif
  if cp_sub == '__none__'
    assign cp_sub = ''
  endif
  assign cp_md = false
  assign cp_lg = false
  if section.settings.heading_size == 'feature'
    assign cp_md = true
  elsif section.settings.heading_size == 'product_title'
    assign cp_lg = true
  endif
-%}
{% style %}
  #lt-cmp-{{ section.id }} {
    --cp-bg: {{ section.settings.color_bg }};
    padding-top: min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
  }
{% endstyle %}

<div class="lt-cmp" id="lt-cmp-{{ section.id }}">
  <div class="lt-cmp__container">
    <div class="lt-cmp__layout">
      <div class="lt-cmp__copy">
        {%- if cp_head != blank or cp_sub != blank -%}
          {% render 'section-heading-crs',
            heading: cp_head,
            subheading: cp_sub,
            align: 'left',
            headline_md: cp_md,
            headline_lg: cp_lg,
            extra_class: 'lt-cmp__head'
          %}
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="lt-cmp__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="lt-cmp__table" role="table" aria-label="{{ section.settings.label_ours | escape }} / {{ section.settings.label_other | escape }}">
          <span class="lt-cmp__sheet" aria-hidden="true"></span>
          <div class="lt-cmp__cols" role="row">
            <span class="lt-cmp__corner" role="columnheader"><span class="visually-hidden">{{ section.settings.label_row | escape }}</span></span>
            <span class="lt-cmp__col lt-cmp__col--ours" role="columnheader">{{ section.settings.label_ours | escape }}</span>
            <span class="lt-cmp__col lt-cmp__col--other" role="columnheader">{{ section.settings.label_other | escape }}</span>
          </div>
          <div class="lt-cmp__rows" role="rowgroup">
            {%- for block in section.blocks -%}
              <div class="lt-cmp__row" role="row" {{ block.shopify_attributes }}>
                <span class="lt-cmp__label" role="rowheader">{{ block.settings.label | escape }}</span>
                <span class="lt-cmp__cell lt-cmp__cell--ours" role="cell">
                  <span class="lt-cmp__mark lt-cmp__mark--yes" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 10.5l3 3 6-6.5"/></svg>
                  </span>
                  <span class="lt-cmp__text">{{ block.settings.ours | escape }}</span>
                </span>
                <span class="lt-cmp__cell lt-cmp__cell--other" role="cell">
                  <span class="lt-cmp__mark lt-cmp__mark--no" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6.5 6.5l7 7M13.5 6.5l-7 7"/></svg>
                  </span>
                  <span class="lt-cmp__text">{{ block.settings.other | escape }}</span>
                </span>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.note != blank -%}
            <p class="lt-cmp__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
/* ===================================================
   Kurzer Vergleich — lt-pdp-compare.liquid
   =================================================== */

.lt-cmp {
  --cp-ink: var(--color-ink, #26251e);
  --cp-muted: rgba(38, 37, 30, 0.72);
  --cp-hair: rgba(38, 37, 30, 0.12);
  --cp-on: var(--color-teal-dark, #4a8c85);
  --cp-paper: var(--color-white, #fff);
  --cp-inset: var(--space-4);
  background: var(--cp-bg, #f2f1ed);
}

.lt-cmp__container {
  max-width: var(--lt-page-max, 1280px);
  margin: 0 auto;
  padding: 0 var(--lt-page-gutter, 16px);
}

.lt-cmp__layout {
  display: grid;
  gap: var(--space-6);
  align-items: start;
}

@media (min-width: 980px) {
  .lt-cmp__layout {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
  }
}

.lt-cmp__head {
  margin-bottom: var(--space-4);
}

.lt-cmp__body {
  max-width: var(--lt-measure, 32rem);
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-body, 16px);
  line-height: 1.55;
  color: var(--cp-muted);
}

/* Tabelle: ein Raster fuer Kopf und Zeilen (Subgrid), damit die Spalten
   ueber alle Zeilen buendig bleiben. Die LIFETIME-Spalte liegt auf einem
   weissen Blatt, das vom Kopf bis zur letzten Zeile durchlaeuft; die
   Spalte der anderen bleibt auf dem Grund. Das Blatt ist das einzige
   Element mit Schatten (Papier-Regel aus DESIGN.md).
   Desktop drei Spalten (Merkmal, wir, andere). Handy zwei: das Merkmal
   steht im Blatt ueber dem eigenen Wert, die andere Spalte fluchtet mit
   dem Wert. */
.lt-cmp__table {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1fr);
  column-gap: var(--space-5);
}

.lt-cmp__sheet {
  grid-column: 2;
  grid-row: 1 / 3;
  border-radius: var(--radius-md, 12px);
  background: var(--cp-paper);
  box-shadow: var(--shadow-sm), var(--shadow-md);
}

.lt-cmp__cols,
.lt-cmp__rows,
.lt-cmp__row {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: subgrid;
}

.lt-cmp__cols,
.lt-cmp__rows {
  position: relative;
}

.lt-cmp__cols {
  grid-row: 1;
  align-items: end;
  padding: var(--space-5) 0 var(--space-4);
}

.lt-cmp__rows {
  grid-row: 2;
}

.lt-cmp__col {
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  line-height: 1.3;
}

.lt-cmp__col {
  font-weight: 700;
}

.lt-cmp__col--ours {
  padding: 0 var(--cp-inset);
  color: var(--cp-ink);
}

.lt-cmp__col--other {
  color: var(--cp-muted);
}

.lt-cmp__row {
  align-items: start;
  padding: var(--space-5) 0;
  border-top: 1px solid var(--cp-hair);
}

.lt-cmp__label {
  font-family: var(--font-body);
  font-size: var(--text-body, 16px);
  line-height: 1.35;
  color: var(--cp-muted);
  padding-top: 1px;
}

.lt-cmp__cell {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: var(--space-3);
  align-items: start;
}

.lt-cmp__cell--ours {
  padding: 0 var(--cp-inset);
}

.lt-cmp__text {
  font-family: var(--font-body);
  font-size: var(--text-body, 16px);
  line-height: 1.4;
  text-wrap: pretty;
}

.lt-cmp__cell--ours .lt-cmp__text {
  color: var(--cp-ink);
}

.lt-cmp__cell--other .lt-cmp__text {
  color: var(--cp-muted);
}

.lt-cmp__mark {
  display: grid;
  place-items: center;
  width: 20px;
  height: 20px;
  margin-top: 1px;
  border-radius: var(--radius-full, 999px);
}

.lt-cmp__mark svg {
  width: 12px;
  height: 12px;
}

/* Zeichen als Kontur (BJ 16.10.2026): duenner Ring in halber Deckkraft,
   Haekchen voll in Gruen. Dasselbe Bild in lt-pdp-compare,
   lt-pdp-app-switch, lt-pdp-ideal-candidate und crs-risk-free-close. */
.lt-cmp__mark svg {
  stroke-width: 1.75;
}

.lt-cmp__mark--yes {
  box-shadow: inset 0 0 0 1.25px rgba(74, 140, 133, 0.5);
  color: var(--cp-on);
}

/* Gegenstueck zum Haekchen: gleiche Groesse, gleiche Kontur, im Grauton. */
.lt-cmp__mark--no {
  box-shadow: inset 0 0 0 1.25px rgba(38, 37, 30, 0.3);
  color: var(--cp-muted);
}

.lt-cmp__note {
  grid-column: 1 / -1;
  grid-row: 3;
  margin: var(--space-4) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  line-height: 1.45;
  color: var(--cp-muted);
}

@media (max-width: 749px) {
  .lt-cmp__layout {
    gap: var(--space-5);
  }

  .lt-cmp {
    --cp-inset: var(--space-3);
  }

  .lt-cmp__table {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--space-3);
  }

  .lt-cmp__sheet {
    grid-column: 1;
  }

  .lt-cmp__corner {
    display: none;
  }

  .lt-cmp__cols {
    padding: var(--space-4) 0 var(--space-3);
  }

  .lt-cmp__row {
    padding: var(--space-4) 0;
    row-gap: var(--space-1);
  }

  .lt-cmp__label {
    grid-column: 1;
    grid-row: 1;
    padding: 0 var(--cp-inset);
    font-size: var(--text-body-sm, 14px);
  }

  .lt-cmp__cell--ours {
    grid-column: 1;
    grid-row: 2;
  }

  .lt-cmp__cell--other {
    grid-column: 2;
    grid-row: 2;
  }

  .lt-cmp__cell {
    gap: var(--space-2);
  }

  .lt-cmp__text {
    font-size: var(--text-body-sm, 14px);
  }

  .lt-cmp__mark {
    width: 18px;
    height: 18px;
    margin-top: 0;
  }

  .lt-cmp__mark svg {
    width: 11px;
    height: 11px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Vergleich kurz",
  "tag": "section",
  "class": "section-lt-pdp-compare",
  "settings": [
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift-Größe",
      "options": [
        { "value": "section", "label": "Section (20)" },
        { "value": "feature", "label": "Feature (28)" },
        { "value": "product_title", "label": "Produkttitel (36)" }
      ],
      "default": "feature"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Andere Tests messen dein Alter oder deine Gene."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subline",
      "info": "__none__ blendet sie aus.",
      "default": "LIFETIME misst beides."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "info": "Optional, steht am Desktop unter der Überschrift."
    },
    {
      "type": "text",
      "id": "label_ours",
      "label": "Spalte: wir",
      "default": "LIFETIME"
    },
    {
      "type": "text",
      "id": "label_other",
      "label": "Spalte: andere",
      "default": "Andere Tests"
    },
    {
      "type": "text",
      "id": "label_row",
      "label": "Spalte: Merkmal",
      "info": "Nur für Screenreader.",
      "default": "Merkmal"
    },
    {
      "type": "text",
      "id": "note",
