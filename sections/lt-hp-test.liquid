{% comment %}
  lt-hp-test — Der AGE & DNA-Test als Hero-Produkt der Startseite (Startseite v2, Oktober 2026).
  Verwischtes Naturbild unter dunklem Teal, Kit freigestellt in der Mitte, links die
  Epigenetik-, rechts die DNA-Begriffe, darunter Preis, Knopf, Link und Siegel.
  Kein Kicker: „Der AGE & DNA-Test.“ steht im Heading-Paar.
  Ersetzt auf der Startseite lt-hp-product-hero (bleibt auf Quiz-Seiten im Einsatz).
  Vorlage: docs/startseite-v2/startseite.html#test
{% endcomment %}

{%- liquid
  assign p = section.settings.product
  if p != blank
    assign preis = p.price | money_without_trailing_zeros
    assign ziel = p.url
  else
    assign preis = section.settings.price_fallback
    assign ziel = section.settings.button_url | default: '/products/lifetime-age-dna'
  endif
  assign epi = section.settings.col1_items | newline_to_br | split: '<br />'
  assign dna = section.settings.col2_items | newline_to_br | split: '<br />'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --lttb-pt: {{ section.settings.padding_top }}px;
    --lttb-pb: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.background != blank %}
    --lttb-grund: url({{ section.settings.background | image_url: width: 1600 }});
    {%- endif %}
  }
{% endstyle %}

<div class="lttb">
  <div class="lttb__wrap">
    {% render 'section-heading-crs',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'center',
      on_dark: true,
      headline_xl: true,
      extra_class: 'lttb__kopf'
    %}
    {%- if section.settings.lead != blank -%}
      <p class="lttb__sub">{{ section.settings.lead | escape }}</p>
    {%- endif -%}

    <div class="lttb__buehne">
      {%- if section.settings.kit_image != blank -%}
        {{
          section.settings.kit_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '420, 680, 900',
            sizes: '(min-width: 769px) 420px, 86vw',
            class: 'lttb__kit',
            alt: section.settings.kit_image.alt
        }}
      {%- endif -%}
      <div class="lttb__spalten">
        <div class="lttb__spalte lttb__spalte--epi">
          <p class="lttb__kopfzeile">{{ section.settings.col1_label | escape }}</p>
          {%- for item in epi -%}
            {%- assign t = item | strip -%}
            {%- assign erstes = t | slice: 0 -%}
            {%- if t != blank -%}<p{% if erstes == '+' %} class="lttb__mehr"{% endif %}>{{ t | escape }}</p>{%- endif -%}
          {%- endfor -%}
        </div>
        <div class="lttb__spalte lttb__spalte--dna">
          <p class="lttb__kopfzeile">{{ section.settings.col2_label | escape }}</p>
          {%- for item in dna -%}
            {%- assign t = item | strip -%}
            {%- assign erstes = t | slice: 0 -%}
            {%- if t != blank -%}<p{% if erstes == '+' %} class="lttb__mehr"{% endif %}>{{ t | escape }}</p>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.app_line != blank -%}
      <p class="lttb__app">{{ section.settings.app_line | escape }}</p>
    {%- endif -%}
    <div class="lttb__kauf">
      <span class="lttb__preis">{{ preis }}{% if section.settings.price_note != blank %}<small>{{ section.settings.price_note | escape }}</small>{% endif %}</span>
      <a class="lttb__btn" href="{{ ziel }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="lttb__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.seal != blank -%}
      <span class="lttb__siegel">{{ section.settings.seal | escape }}</span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.lttb {
  --color-text-on-dark: var(--color-paper);
  --color-text-on-dark-muted: rgba(247, 247, 244, 0.72);
  position: relative;
  overflow: hidden;
  background: var(--color-dark);
  color: var(--color-paper);
  padding: var(--lttb-pt, 104px) 0 var(--lttb-pb, 96px);
}
/* Naturbild stark verwischt, darüber Teal, damit Schrift und Kit tragen */
.lttb::before {
  content: "";
  position: absolute;
  inset: -60px;
  background: var(--lttb-grund, none) center 40% / cover;
  filter: blur(28px) saturate(1.15);
  opacity: 0.9;
  pointer-events: none;
}
.lttb::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(54, 79, 86, 0.8) 0%, rgba(54, 79, 86, 0.6) 45%, rgba(54, 79, 86, 0.86) 100%);
  pointer-events: none;
}
.lttb__wrap {
  position: relative;
  z-index: 1;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  text-align: center;
}
.lttb__kopf { max-width: 1000px; margin: 0 auto; }
.lttb__sub {
  margin: 18px auto 0;
  max-width: 620px;
  font-family: var(--font-body);
  font-size: var(--text-body-lg);
  line-height: var(--leading-relaxed);
  letter-spacing: 0.005em;
  color: var(--color-text-on-dark-muted);
}
.lttb__buehne { position: relative; height: 500px; max-width: 1000px; margin: var(--space-5) auto 0; }
.lttb__kit {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 420px;
  height: auto;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.35));
}
.lttb__spalte { position: absolute; top: 50%; width: 230px; transform: translateY(-50%); text-align: left; }
.lttb__spalte p {
  margin: 0 0 var(--space-3);
  font-family: var(--font-heading);
  font-size: var(--text-h3);
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: var(--color-paper);
}
.lttb__spalte .lttb__kopfzeile {
  margin-bottom: 18px;
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-on-dark-muted);
}
.lttb__spalte .lttb__mehr {
  font-family: var(--font-body);
  font-size: var(--text-body);
  letter-spacing: 0;
  color: var(--color-text-on-dark-muted);
}
.lttb__spalte--epi { right: calc(50% + 250px); text-align: right; }
.lttb__spalte--dna { left: calc(50% + 250px); }
.lttb__app {
  margin: var(--space-1) 0 28px;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  color: var(--color-text-on-dark-muted);
}
.lttb__kauf { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 20px; }
.lttb__preis {
  font-family: var(--font-heading);
  font-size: var(--text-h2);
  font-weight: var(--weight-bold);
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}
.lttb__preis small {
  margin-left: 6px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-regular);
  letter-spacing: 0;
  color: var(--color-text-on-dark-muted);
}
.lttb__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 15px 26px;
  border-radius: var(--radius-full);
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-body);
  text-decoration: none;
}
.lttb__btn:focus-visible,
.lttb__link:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 4px; }
.lttb__link {
  display: block;
  margin-top: 18px;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  color: var(--color-text-on-dark-muted);
}
.lttb__siegel {
  display: block;
  margin-top: 6px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: var(--color-text-on-dark-muted);
}
@media (max-width: 1024px) { .lttb__wrap { padding: 0 24px; } }
@media (max-width: 860px) { .lttb { --text-display: 32px; } }
@media (max-width: 768px) {
  .lttb { padding: 72px 0 var(--space-8); }
  .lttb__sub { font-size: var(--text-body); }
  .lttb__buehne { height: auto; margin-top: var(--space-4); }
  .lttb__kit { position: static; display: block; width: 86%; max-width: 340px; margin: 0 auto 20px; transform: none; }
  .lttb__spalten { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); text-align: left; }
  .lttb__spalte { position: static; width: auto; transform: none; }
  .lttb__spalte--epi { text-align: left; }
  .lttb__spalte p { margin-bottom: var(--space-2); font-size: var(--text-body-lg); }
  .lttb__spalte .lttb__mehr { font-size: var(--text-body-sm); }
  .lttb__spalte .lttb__kopfzeile { margin-bottom: var(--space-3); }
  .lttb__app { margin: 20px 0 var(--space-5); }
  .lttb__kauf { flex-direction: column; gap: 14px; }
}
@media (max-width: 640px) { .lttb__wrap { padding: 0 20px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "HP Test-Block",
  "tag": "section",
  "class": "section lt-hp-test",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Der AGE & DNA-Test." },
    { "type": "text", "id": "subheading", "label": "Unterzeile (gleich groß, nur heller)", "default": "Epigenetik und DNA aus einer Speichelprobe." },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Biologisches Alter, sechs epigenetische Bereiche und 23 DNA-Kategorien. Alles in der App, erklärt vom AI Health Coach." },
    { "type": "image_picker", "id": "background", "label": "Hintergrundbild (wird stark verwischt)" },
    { "type": "image_picker", "id": "kit_image", "label": "Kit freigestellt" },
    { "type": "header", "content": "Spalten" },
    { "type": "text", "id": "col1_label", "label": "Links: Beschriftung", "default": "Epigenetik" },
    { "type": "textarea", "id": "col1_items", "label": "Links: Begriffe (eine Zeile je Begriff)", "default": "Biologisches Alter\nMethylPace\nEntzündung\nImmunscore" },
    { "type": "text", "id": "col2_label", "label": "Rechts: Beschriftung", "default": "DNA" },
    { "type": "textarea", "id": "col2_items", "label": "Rechts: Begriffe (eine Zeile je Begriff)", "default": "Vitamine\nSchlaf\nHerz\nHaut" },
    { "type": "text", "id": "app_line", "label": "Zeile unter dem Kit", "default": "Dazu in der App: AI Health Coach und Face-Scan" },
    { "type": "header", "content": "Kauf" },
    { "type": "product", "id": "product", "label": "Produkt (Preis und Link)" },
    { "type": "text", "id": "price_fallback", "label": "Preis, falls kein Produkt gewählt", "default": "349 €" },
    { "type": "text", "id": "price_note", "label": "Zusatz neben dem Preis", "default": "einmalig" },
    { "type": "text", "id": "button_label", "label": "Knopf", "default": "AGE & DNA-Test bestellen" },
    { "type": "url", "id": "button_url", "label": "Knopf-Link, falls kein Produkt gewählt" },
    { "type": "text", "id": "link_label", "label": "Link unter dem Knopf", "default": "Was genau enthalten ist →" },
    { "type": "url", "id": "link_url", "label": "Ziel des Links" },
    { "type": "text", "id": "seal", "label": "Siegel", "default": "Analyse bei Eurofins Genomics · ISO 17025" },
    { "type": "header", "content": "Abstände Desktop" },
    { "type": "range", "id": "padding_top", "label": "Oben", "min": 0, "max": 160, "step": 8, "default": 104, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Unten", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "presets": [{ "name": "HP Test-Block" }]
}
{% endschema %}
