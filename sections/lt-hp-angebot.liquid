{% comment %}
  lt-hp-angebot — Angebotsblock nach AG1-Muster (Startseite, 26.10.2026).
  Links das Kit auf hellem Grund, rechts Überschrift, Inhaltsliste, ein Preis, Knopf und
  drei Vertrauenszeilen; darunter der Ablauf in vier Schritten. Preis dynamisch aus dem
  Produkt (Fallback-Setting), keine Streichpreise, kein Wert-Stack, keine erfundene Knappheit
  (Memory project_compare_at_bereinigung, Copy-Linie UWG Nr. 7).
  Drei Block-Typen: „inhalt“ (Zeile der Inhaltsliste), „vertrauen“ (Zeile unter dem Knopf),
  „schritt“ (Ablauf). Anker #bestellen liegt auf dem inneren Wrapper.
  Ersetzt auf der Startseite lt-hp-test und lt-hp-ablauf (Dateien und Template-Keys bleiben).
  Vorlage: docs/entwurf-startseite-ag1-2026-10-26.html#bestellen
{% endcomment %}

{%- liquid
  assign p = section.settings.product
  if p != blank
    assign preis = p.price | money_without_trailing_zeros
    assign ziel = p.url
  else
    assign preis = section.settings.price_fallback
    assign ziel = section.settings.button_url | default: '/products/lifetime-age-dna'
  endif
  assign inhalt = section.blocks | where: 'type', 'inhalt'
  assign vertrauen = section.blocks | where: 'type', 'vertrauen'
  assign schritte = section.blocks | where: 'type', 'schritt'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ltag-pt: {{ section.settings.padding_top }}px;
    --ltag-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="ltag"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  <div class="ltag__wrap">
    <div class="ltag__grid">
      <div class="ltag__bild">
        {%- if section.settings.kit_image != blank -%}
          {{
            section.settings.kit_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 769px) 360px, 80vw',
              alt: section.settings.kit_image.alt
          }}
        {%- endif -%}
      </div>
      <div class="ltag__angebot">
        {% render 'section-heading-crs',
          heading: section.settings.heading,
          headline_md: true,
          modifier: 'homepage-truth'
        %}
        {%- if inhalt.size > 0 -%}
          <ul class="ltag__inhalt" role="list">
            {%- for block in inhalt -%}
              <li {{ block.shopify_attributes }}><b>{{ block.settings.title | escape }}</b>{% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="ltag__preis">
          <span class="ltag__zahl">{{ preis }}</span>
          {%- if section.settings.price_note != blank -%}<span class="ltag__preisnote">{{ section.settings.price_note | escape }}</span>{%- endif -%}
        </p>
        <a class="ltag__knopf" href="{{ ziel }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
        {%- if vertrauen.size > 0 -%}
          <ul class="ltag__vertrauen" role="list">
            {%- for block in vertrauen -%}
              <li {{ block.shopify_attributes }}>
                {%- comment -%} ph:check-thin {%- endcomment -%}
                <svg viewBox="0 0 256 256" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M226.83 74.83l-128 128a4 4 0 0 1-5.66 0l-56-56a4 4 0 0 1 5.66-5.66L96 194.34L221.17 69.17a4 4 0 1 1 5.66 5.66"/></svg>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if schritte.size > 0 -%}
      <ol class="ltag__ablauf" role="list">
        {%- for block in schritte -%}
          <li class="ltag__schritt" {{ block.shopify_attributes }}>
            <span class="ltag__nr">{{ block.settings.nummer | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="ltag__schritt-titel">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="ltag__schritt-text">{{ block.settings.text | escape }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ltag {
  /* Kapitel-Stufe der AG1-Seite: 36 px Desktop, 28 px Handy (Entwurf 26.10.) */
  --text-h2: 36px;
  --ltag-rand: 40px;
  --ltag-linie: rgba(38, 37, 30, 0.12);
  background: var(--color-surface-secondary);
  border-top: 1px solid var(--ltag-linie);
  padding: var(--ltag-pt, 96px) 0 var(--ltag-pb, 96px);
  scroll-margin-top: var(--space-8);
}
.ltag__wrap { max-width: 1280px; margin: 0 auto; padding: 0 var(--ltag-rand); }
.ltag__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-10);
  align-items: center;
}
.ltag__bild {
  display: grid;
  place-items: center;
  padding: var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--color-paper);
}
.ltag__bild img { display: block; width: 100%; max-width: 360px; height: auto; }
.ltag__inhalt {
  list-style: none;
  margin: var(--space-5) 0 0;
  padding: 0;
  border-top: 1px solid var(--ltag-linie);
}
.ltag__inhalt li {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--ltag-linie);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  color: var(--color-ink);
}
.ltag__inhalt li b { font-weight: var(--weight-bold); }
.ltag__inhalt li span { color: var(--color-ink-muted); white-space: nowrap; text-align: right; }
.ltag__preis {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin: var(--space-5) 0 0;
}
.ltag__zahl {
  font-family: var(--font-heading);
  font-size: 40px;
  font-weight: var(--weight-regular);
  line-height: 1;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
}
.ltag__preisnote {
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.4;
  color: var(--color-ink-muted);
}
.ltag__knopf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
  min-height: 48px;
  padding: 15px 26px;
  border-radius: var(--radius-full);
  background: var(--color-dark);
  color: var(--color-paper);
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-medium);
  line-height: 1.25;
  text-decoration: none;
  transition: filter var(--ease-default);
}
.ltag__knopf:hover { filter: brightness(1.12); }
.ltag__knopf:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
.ltag__vertrauen {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-5);
  margin: var(--space-4) 0 0;
  padding: 0;
}
.ltag__vertrauen li {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: var(--color-ink-muted);
}
.ltag__vertrauen svg { flex: 0 0 16px; width: 16px; height: 16px; color: var(--color-dark); }
.ltag__ablauf {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
  margin: var(--space-8) 0 0;
  padding: var(--space-6) 0 0;
  border-top: 1px solid var(--ltag-linie);
}
.ltag__nr {
  display: block;
  font-family: var(--font-heading);
  font-size: var(--text-h2);
  font-weight: var(--weight-regular);
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--color-ink-muted);
}
.ltag__schritt-titel {
  margin: var(--space-2) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  line-height: 1.4;
  color: var(--color-ink);
}
.ltag__schritt-text {
  margin: var(--space-1) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.5;
  color: var(--color-ink-muted);
}
@media (max-width: 1024px) { .ltag { --ltag-rand: 24px; } .ltag__grid { gap: var(--space-8); } }
@media (max-width: 768px) {
  .ltag { --text-h2: 28px; padding: var(--space-8) 0; }
  .ltag__grid { grid-template-columns: 1fr; gap: var(--space-6); }
  .ltag__knopf { width: 100%; }
  .ltag__ablauf { grid-template-columns: 1fr; gap: var(--space-4); margin-top: var(--space-7); }
  .ltag__nr { font-size: 28px; }
}
@media (max-width: 640px) { .ltag { --ltag-rand: 20px; } }
@media (prefers-reduced-motion: reduce) { .ltag__knopf { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "HP Angebot",
  "tag": "section",
  "class": "section lt-hp-angebot",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "bestellen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Starte mit dem AGE & DNA-Test." },
    { "type": "image_picker", "id": "kit_image", "label": "Kit freigestellt" },
    { "type": "header", "content": "Kauf" },
    { "type": "product", "id": "product", "label": "Produkt (Preis und Link)" },
    { "type": "text", "id": "price_fallback", "label": "Preis, falls kein Produkt gewählt", "default": "395 €" },
    { "type": "text", "id": "price_note", "label": "Zusatz neben dem Preis", "default": "einmalig, kein Abo" },
    { "type": "text", "id": "button_label", "label": "Knopf", "default": "Test bestellen" },
    { "type": "url", "id": "button_url", "label": "Knopf-Link, falls kein Produkt gewählt" },
    { "type": "header", "content": "Abstände Desktop" },
    { "type": "range", "id": "padding_top", "label": "Oben", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Unten", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "inhalt",
      "name": "Inhaltszeile",
      "settings": [
        { "type": "text", "id": "title", "label": "Was", "default": "Speichel-Kit" },
        { "type": "text", "id": "detail", "label": "Detail (rechts, grau)", "default": "mit frankiertem Rückumschlag" }
      ]
    },
    {
      "type": "vertrauen",
      "name": "Vertrauenszeile",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Versandkostenfrei" }
      ]
    },
    {
      "type": "schritt",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "nummer", "label": "Nummer (leer = fortlaufend)" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Schritt" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Was in diesem Schritt passiert." }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP Angebot",
      "blocks": [
        { "type": "inhalt" }, { "type": "inhalt" }, { "type": "inhalt" }, { "type": "inhalt" }, { "type": "inhalt" },
        { "type": "vertrauen" }, { "type": "vertrauen" }, { "type": "vertrauen" },
        { "type": "schritt" }, { "type": "schritt" }, { "type": "schritt" }, { "type": "schritt" }
      ]
    }
  ]
}
{% endschema %}
