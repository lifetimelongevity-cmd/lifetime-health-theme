{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign ps_kicker = section.settings.kicker | strip
  assign ps_head   = section.settings.heading | strip
  assign ps_sub    = section.settings.subheading | strip
  if ps_kicker == '__none__'
    assign ps_kicker = ''
  endif
  if ps_sub == '__none__'
    assign ps_sub = ''
  endif
  assign crs_h_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  endif
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif
  assign ps_has_header = false
  if ps_kicker != blank or ps_head != blank or ps_sub != blank
    assign ps_has_header = true
  endif
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:        {{ section.settings.color_bg }};
    --crs-card-bg:   {{ section.settings.color_card_bg }};
    --crs-text:      {{ section.settings.color_text }};
    --crs-text-sec:  {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --ps-text-ter:   {{ section.settings.color_text | color_modify: 'alpha', 0.55 }};
    --ps-num:        {{ section.settings.color_text | color_modify: 'alpha', 0.40 }};
    --ps-line:       {{ section.settings.color_text | color_modify: 'alpha', 0.08 }};
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
    background:     var(--crs-bg);
  }
{% endstyle %}

{%- comment -%} Sitelink-Alias: kurzes #ablauf statt #shopify-section-template--...__process_steps {%- endcomment -%}
<a id="ablauf" aria-hidden="true" tabindex="-1" style="display:block;scroll-margin-top:100px;"></a>

<div class="ps-section" id="section-{{ section.id }}">
  <div class="ps-container">

    {%- if ps_has_header -%}
      <div class="ps-head ps-head--align-{{ crs_h_align }}">
        <div class="ps-header crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
          {%- if ps_kicker != blank -%}
            <p class="crs-heading-stack__kicker">{{ ps_kicker | escape }}</p>
          {%- endif -%}
          {%- if ps_head != blank or ps_sub != blank -%}
            <div class="crs-heading-stack__pair">
              {%- if ps_head != blank -%}
                <h2 class="crs-heading-stack__title">{{ ps_head | escape | newline_to_br }}</h2>
              {%- endif -%}
              {%- if ps_sub != blank -%}
                <p class="crs-heading-stack__subtitle">{{ ps_sub | escape | newline_to_br }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ps-cards ps-cards--{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          {%- liquid
            comment
              Fokus: die Sache führt (Titel), die Zeit ist eine ruhige Zeile am Fuß.
              Zeit bevorzugt aus step_time; Fallback für Altbestand (Quiz-Templates)
              aus prefix + timeframe + unit, optional die Herkunft (callout_text).
            endcomment
            assign b_time = block.settings.step_time | strip
            if b_time == blank
              assign _pre = block.settings.step_value_prefix | strip
              assign _tf  = block.settings.step_timeframe | strip
              assign _un  = block.settings.step_unit | strip
              assign _src = block.settings.callout_text | strip
              capture b_time
                if _pre != blank
                  echo _pre
                  echo ' '
                endif
                echo _tf
                if _un != blank
                  echo ' '
                  echo _un
                endif
                if _src != blank
                  echo ' · '
                  echo _src
                endif
              endcapture
              assign b_time = b_time | strip
            endif
          -%}
          <li class="ps-card" {{ block.shopify_attributes }}>
            {%- if block.settings.step_number != blank -%}
              <p class="ps-card__num">{{ block.settings.step_number | escape }}</p>
            {%- endif -%}

            {%- if block.settings.step_title != blank -%}
              <h3 class="ps-card__title">{{ block.settings.step_title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.step_body != blank -%}
              <p class="ps-card__body">{{ block.settings.step_body | escape }}</p>
            {%- endif -%}

            {%- if b_time != blank -%}
              <p class="ps-card__time">{{ b_time | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.footer_callout != blank -%}
      <p class="ps-note">{{ section.settings.footer_callout | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="ps-actions">
        <a href="{{ section.settings.cta_url }}" class="ps-cta">
          <span>{{ section.settings.cta_label | escape }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="13 6 19 12 13 18"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* ===================================================
   Process Steps — lt-pdp-process-steps.liquid
   Vier gleichwertige Karten. Die Sache (Titel) führt,
   die Zeit ist eine ruhige Zeile am Fuß. Einfarbig,
   keine Hervorhebung einzelner Karten, minimale
   Größen- und Gewichtsabstufung.
   =================================================== */

.ps-section {
  background: var(--crs-bg, #f2f1ed);
}

.ps-container {
  /* 1280 / 20px Gutter: identisch zu den CRS-Sections, damit die Section
     nicht schmaler startet als ihre Nachbarn. */
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ---------- Kopfband ---------- */

.ps-head {
  margin-bottom: var(--space-7, 48px);
}

.ps-head--align-center {
  text-align: center;
}

.ps-head--align-right {
  text-align: right;
}

/* ---------- Kartenreihe ---------- */

.ps-cards {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-4, 16px);
  list-style: none;
  margin: 0;
  padding: 0;
}

.ps-cards--3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ps-cards--2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.ps-cards--1 {
  grid-template-columns: minmax(0, 1fr);
}

.ps-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: var(--space-6, 32px);
  background: var(--crs-card-bg, #ffffff);
  border-radius: var(--radius-md, 12px);
  /* Kante wie alle anderen PDP-Karten (Feature-Grid, Reviews): 1px Haarlinie,
     kein Schatten. */
  border: 1px solid var(--ps-line, rgba(38, 37, 30, 0.08));
}

/* Ordnungszahl: leise, blass. Trägt die Reihenfolge, dominiert nicht. */
.ps-card__num {
  margin: 0 0 var(--space-3, 12px);
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-regular, 400);
  line-height: 1;
  color: var(--ps-num, rgba(38, 37, 30, 0.4));
  font-variant-numeric: tabular-nums;
}

/* Die Sache: das einzige hervorgehobene Element der Karte. */
/* (0,2,0) — schlägt die h3-Elementregeln aus theme.css ohne !important */
.ps-section .ps-card__title {
  margin: 0 0 var(--space-2, 8px);
  font-family: var(--font-body);
  font-size: var(--text-body-lg, 18px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.3;
  letter-spacing: 0;
  color: var(--crs-text, #26251e);
  text-wrap: balance;
}

.ps-card__body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-regular, 400);
  line-height: var(--leading-relaxed, 1.6);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

/* Zeit: ruhige Zeile, sitzt am Kartenfuß. Getrennt durch Weißraum, nicht
   durch eine Linie. auto schiebt sie auf den Fuß, padding sichert den
   Mindestabstand; auf der höchsten Karte wird auto zu null. */
.ps-card__time {
  margin: var(--space-5, 24px) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-regular, 400);
  line-height: 1.45;
  color: var(--ps-text-ter, rgba(38, 37, 30, 0.55));
}

.ps-card__body + .ps-card__time {
  margin-top: auto;
  padding-top: var(--space-5, 24px);
}

/* ---------- Schlussnotiz + CTA ---------- */

.ps-note {
  max-width: var(--lt-measure, 34rem);
  margin: var(--space-6, 32px) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  line-height: var(--leading-relaxed, 1.6);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-actions {
  margin-top: var(--space-6, 32px);
}

.ps-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2, 8px);
  min-height: 44px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.2;
  color: var(--crs-text, #26251e);
  text-decoration: none;
  transition: opacity var(--ease-default, 0.2s ease);
}

.ps-cta svg {
  flex-shrink: 0;
  transition: transform var(--ease-default, 0.2s ease);
}

.ps-cta:hover,
.ps-cta:focus-visible {
  opacity: 0.7;
}

.ps-cta:hover svg,
.ps-cta:focus-visible svg {
  transform: translateX(3px);
}

.ps-cta:focus-visible {
  outline: 2px solid var(--crs-text, #26251e);
  outline-offset: 3px;
  border-radius: var(--radius-sm, 8px);
}

@media (prefers-reduced-motion: reduce) {
  .ps-cta,
  .ps-cta svg {
    transition: none;
  }

  .ps-cta:hover svg,
  .ps-cta:focus-visible svg {
    transform: none;
  }
}

/* ---------- Responsive ---------- */

@media screen and (max-width: 1024px) {
  .ps-cards,
  .ps-cards--3,
  .ps-cards--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media screen and (max-width: 767px) {
  .ps-head {
    margin-bottom: var(--space-6, 32px);
  }

  .ps-cards,
  .ps-cards--3,
  .ps-cards--2 {
    grid-template-columns: minmax(0, 1fr);
  }

  .ps-card {
    padding: var(--space-5, 24px);
  }

  /* Auf schmalen Karten braucht die Zeitzeile den Fuß-Schub nicht. */
  .ps-card__body + .ps-card__time {
    margin-top: var(--space-4, 16px);
    padding-top: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Process Steps",
  "tag": "section",
  "class": "lt-pdp-process-steps",
  "settings": [
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e",
      "info": "Nummer, Zeit und Kartenkante werden daraus abgeleitet."
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (Section-Headline)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section",
      "info": "Zeilenumbruch: Enter in Überschrift/Unterüberschrift."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "In 4 Schritten zum Ergebnis."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift (optional)",
      "default": "Ohne Arztbesuch.",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "header",
      "content": "Abschluss"
    },
    {
      "type": "textarea",
      "id": "footer_callout",
      "label": "Schlussnotiz",
      "info": "Produktspezifisch, bewusst ohne Vorgabe. Ein geerbter Labor- oder Dauer-Satz wäre auf einer anderen PDP eine falsche Aussage."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Schritt-Nummer",
          "default": "01"
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Titel (die Sache)",
          "default": "Testkit bestellen",
          "info": "Das führende Element der Karte. Kurz und konkret."
        },
        {
          "type": "textarea",
          "id": "step_body",
          "label": "Beschreibung",
          "info": "Ein Satz. Was in diesem Schritt passiert."
        },
        {
          "type": "text",
          "id": "step_time",
          "label": "Zeit-Zeile",
          "info": "Ruhige Zeile am Fuß, z. B. „2–3 Werktage bis zur Lieferung“. Leer = wird aus den Fallback-Feldern unten zusammengesetzt."
        },
        {
          "type": "header",
          "content": "Zeit (Fallback)"
        },
        {
          "type": "paragraph",
          "content": "Nur genutzt, wenn „Zeit-Zeile“ leer ist. Reihenfolge: Präfix + Wert + Einheit, danach optional die Herkunft."
        },
        {
          "type": "text",
          "id": "step_value_prefix",
          "label": "Präfix",
          "info": "z. B. unter, ca., ab."
        },
        {
          "type": "text",
          "id": "step_timeframe",
          "label": "Wert",
          "info": "z. B. 2–3, 6, Lebenslang."
        },
        {
          "type": "text",
          "id": "step_unit",
          "label": "Einheit",
          "info": "z. B. Werktage, Minuten, Wochen."
        },
        {
          "type": "text",
          "id": "callout_text",
          "label": "Herkunft (optional)",
          "info": "z. B. Eurofins Genomics · ISO 17025. Wird an die Zeit-Zeile angehängt."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Process Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "step_title": "Testkit bestellen & erhalten",
            "step_body": "Röhrchen, Anleitung und frankierter Rückumschlag sind drin.",
            "step_time": "2–3 Werktage bis zur Lieferung"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "step_title": "Registrieren und Probe abgeben",
            "step_body": "Speichelprobe zuhause. Kein Blut, keine Nadel.",
            "step_time": "Unter 5 Minuten"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "step_title": "Probe geht ins Labor",
            "step_body": "Eines der führenden Genomik-Labore Europas wertet sie aus.",
            "step_time": "6 Wochen · Eurofins Genomics, ISO 17025"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "step_title": "Ergebnisse in der App",
            "step_body": "Dein biologisches Alter, deine Reports und der AI Health Coach, der sie erklärt.",
            "step_time": "Lebenslang verfügbar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
