{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign ps_kicker = section.settings.kicker | strip
  assign ps_head   = section.settings.heading | strip
  assign ps_sub    = section.settings.subheading | strip
  if ps_kicker == '__none__'
    assign ps_kicker = ''
  endif
  if ps_sub == '__none__'
    assign ps_sub = ''
  endif
  assign crs_h_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  endif
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif
  assign ps_has_header = false
  if ps_kicker != blank or ps_head != blank or ps_sub != blank
    assign ps_has_header = true
  endif

  assign ps_led_1 = section.settings.ledger_value_1 | strip
  assign ps_led_2 = section.settings.ledger_value_2 | strip
  assign ps_has_ledger = false
  if section.settings.ledger_enable
    if ps_led_1 != blank or ps_led_2 != blank
      assign ps_has_ledger = true
    endif
  endif
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:        {{ section.settings.color_bg }};
    --crs-card-bg:   {{ section.settings.color_card_bg }};
    --crs-text:      {{ section.settings.color_text }};
    --crs-text-sec:  {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --ps-card-dark:  {{ section.settings.color_card_dark }};
    --ps-on-dark:    {{ section.settings.color_text_on_dark }};
    --ps-on-dark-sec:{{ section.settings.color_text_on_dark | color_modify: 'alpha', 0.72 }};
    --ps-measure:    {{ section.settings.color_measure }};
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
    background:     var(--crs-bg);
  }
{% endstyle %}

{%- comment -%} Sitelink-Alias: kurzes #ablauf statt #shopify-section-template--...__process_steps {%- endcomment -%}
<a id="ablauf" aria-hidden="true" tabindex="-1" style="display:block;scroll-margin-top:100px;"></a>

<div class="ps-section" id="section-{{ section.id }}">
  <div class="ps-container">

    {%- if ps_has_header or ps_has_ledger -%}
      <div class="ps-head ps-head--align-{{ crs_h_align }}{% if ps_has_header and ps_has_ledger %} ps-head--split{% endif %}">
        {%- if ps_has_header -%}
          <div class="ps-header crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
            {%- if ps_kicker != blank -%}
              <p class="crs-heading-stack__kicker">{{ ps_kicker | escape }}</p>
            {%- endif -%}
            {%- if ps_head != blank or ps_sub != blank -%}
              <div class="crs-heading-stack__pair">
                {%- if ps_head != blank -%}
                  <h2 class="crs-heading-stack__title">{{ ps_head | escape | newline_to_br }}</h2>
                {%- endif -%}
                {%- if ps_sub != blank -%}
                  <p class="crs-heading-stack__subtitle">{{ ps_sub | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if ps_has_ledger -%}
          <dl class="ps-ledger">
            {%- if ps_led_1 != blank -%}
              <div class="ps-ledger__item">
                <dt class="ps-ledger__label">{{ section.settings.ledger_label_1 | escape }}</dt>
                <dd class="ps-ledger__value">{{ ps_led_1 | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if ps_led_2 != blank -%}
              <div class="ps-ledger__item">
                <dt class="ps-ledger__label">{{ section.settings.ledger_label_2 | escape }}</dt>
                <dd class="ps-ledger__value">{{ ps_led_2 | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ps-cards ps-cards--{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b_value  = block.settings.step_timeframe | strip
            assign b_prefix = block.settings.step_value_prefix | strip
            assign b_unit   = block.settings.step_unit | strip
            assign b_dark   = false
            if block.settings.card_style == 'dark'
              assign b_dark = true
            endif
            comment
              Wortwerte (z. B. "Lebenslang") tragen viel mehr Fläche als eine
              Ziffer und würden die Reihe kippen. Sie kommen eine Stufe kleiner.
            endcomment
            assign b_value_word = false
            if b_value.size > 4
              assign b_value_word = true
            endif
          -%}
          <li class="ps-card{% if b_dark %} ps-card--dark{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.step_number != blank -%}
              <p class="ps-card__step">Schritt {{ block.settings.step_number | escape }}</p>
            {%- endif -%}

            {%- if b_value != blank -%}
              <p class="ps-card__figure">
                {%- comment -%}
                  &#32; überlebt die Liquid-Trimmung. Ohne sie steht im Textbaum
                  "unter5Minuten", auch wenn das Flex-Gap optisch trennt.
                {%- endcomment -%}
                {%- if b_prefix != blank -%}
                  <span class="ps-card__affix">{{ b_prefix | escape }}</span>&#32;
                {%- endif -%}
                <span class="ps-card__value{% if b_value_word %} ps-card__value--word{% endif %}">{{ b_value | escape }}</span>
                {%- if b_unit != blank -%}
                  &#32;<span class="ps-card__affix">{{ b_unit | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}

            {%- if block.settings.step_title != blank -%}
              <h3 class="ps-card__title">{{ block.settings.step_title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.step_body != blank -%}
              <p class="ps-card__body">{{ block.settings.step_body | escape }}</p>
            {%- endif -%}

            {%- if block.settings.show_callout and block.settings.callout_text != blank -%}
              {%- comment -%}
                Jedes Glied bleibt zusammen, der Trenner hängt am Glied davor.
                So bricht die Zeile nur zwischen den Angaben, nie mitten im Namen.
              {%- endcomment -%}
              {%- assign src_parts = block.settings.callout_text | split: ' · ' -%}
              <p class="ps-card__source">
                {%- for part in src_parts -%}
                  <span class="ps-card__source-part">{{ part | escape }}{% unless forloop.last %} ·{% endunless %}</span>
                  {%- unless forloop.last -%}&#32;{%- endunless -%}
                {%- endfor -%}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.footer_callout != blank -%}
      <p class="ps-note">{{ section.settings.footer_callout | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="ps-actions">
        <a href="{{ section.settings.cta_url }}" class="ps-cta">
          <span>{{ section.settings.cta_label | escape }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="13 6 19 12 13 18"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* ===================================================
   Process Steps — lt-pdp-process-steps.liquid
   Vier Karten als Zeitbilanz. Die Zeitmarke ist die
   Hauptfigur, die Ordnungszahl das Label. Eine Karte
   (das Labor) ist dunkel: der lange Teil ist nicht
   der Aufwand des Kunden.
   =================================================== */

.ps-section {
  background: var(--crs-bg, #f2f1ed);
}

.ps-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-5, 20px);
}

/* ---------- Kopfband: Headline links, Zeitbilanz rechts ---------- */

.ps-head {
  margin-bottom: var(--space-7, 48px);
}

.ps-head--split {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-5, 24px);
  align-items: end;
}

.ps-head--align-center {
  text-align: center;
}

.ps-head--align-right {
  text-align: right;
}

.ps-ledger {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-5, 24px) var(--space-7, 48px);
  margin: 0;
  padding: 0;
}

.ps-head--align-center .ps-ledger {
  justify-content: center;
}

.ps-head--align-right .ps-ledger {
  justify-content: flex-end;
}

.ps-ledger__item {
  min-width: 0;
}

.ps-ledger__label {
  margin: 0 0 var(--space-2, 8px);
  font-family: var(--font-body);
  font-size: var(--text-micro, 12px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-ledger__value {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-h3, 24px);
  font-weight: var(--weight-bold, 700);
  /* Gleiche Durchschusslogik wie die Überschrift, sonst sitzt die Zeitbilanz
     im Kopfband sichtbar tiefer als die Headline daneben. */
  line-height: var(--leading-tight, 1.25);
  color: var(--ps-measure, #4a8c85);
  font-variant-numeric: tabular-nums;
}

/* ---------- Kartenreihe ---------- */

.ps-cards {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-4, 16px);
  list-style: none;
  margin: 0;
  padding: 0;
}

.ps-cards--3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.ps-cards--2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.ps-cards--1 {
  grid-template-columns: minmax(0, 1fr);
}

.ps-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: var(--space-6, 32px);
  background: var(--crs-card-bg, #ffffff);
  border-radius: var(--radius-md, 12px);
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
}

/* Die Laborkarte: dunkle Fläche, keine Elevation. */
.ps-card--dark {
  background: var(--ps-card-dark, #364f56);
  box-shadow: none;
}

.ps-card__step {
  margin: 0 0 var(--space-5, 24px);
  font-family: var(--font-body);
  font-size: var(--text-micro, 12px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-card--dark .ps-card__step {
  color: var(--ps-on-dark-sec, rgba(247, 247, 244, 0.72));
}

/* Zeitwert: die Hauptfigur der Karte. */
.ps-card__figure {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-2, 8px);
  margin: 0 0 var(--space-4, 16px);
}

.ps-card__value {
  font-family: var(--font-heading);
  font-size: var(--text-h2, 28px);
  font-weight: var(--weight-bold, 700);
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--crs-text, #26251e);
  font-variant-numeric: tabular-nums;
}

.ps-card--dark .ps-card__value {
  color: var(--ps-on-dark, #f7f7f4);
}

/* Wortwert statt Ziffer: eine Stufe kleiner, sonst kippt die Reihe.
   Nicht kleiner als h3, sonst verliert der Wert gegen den Kartentitel. */
.ps-card__value--word {
  font-size: var(--text-h3, 24px);
  letter-spacing: 0;
}

.ps-card__affix {
  font-family: var(--font-body);
  font-size: var(--text-micro, 12px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.2;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-card--dark .ps-card__affix {
  color: var(--ps-on-dark-sec, rgba(247, 247, 244, 0.72));
}

/* (0,2,0) — schlägt die h3-Elementregeln aus theme.css ohne !important */
.ps-section .ps-card__title {
  margin: 0 0 var(--space-2, 8px);
  font-family: var(--font-body);
  font-size: var(--text-body, 16px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.4;
  letter-spacing: 0;
  color: var(--crs-text, #26251e);
  text-wrap: balance;
}

.ps-section .ps-card--dark .ps-card__title {
  color: var(--ps-on-dark, #f7f7f4);
}

.ps-card__body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-regular, 400);
  line-height: var(--leading-relaxed, 1.6);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-card--dark .ps-card__body {
  color: var(--ps-on-dark-sec, rgba(247, 247, 244, 0.72));
}

/* Herkunftszeile, sitzt am Kartenfuß. Getrennt durch Weißraum, nicht durch
   eine Linie: die Karte ist hier das trennende Element. */
.ps-card__source {
  margin: var(--space-5, 24px) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-micro, 12px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.4;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-card__source-part {
  white-space: nowrap;
}

/* auto schiebt die Zeile auf den Kartenfuß, padding sichert den Mindestabstand:
   auf der höchsten Karte gibt es keinen freien Raum, dort wird auto zu null. */
.ps-card__body + .ps-card__source {
  margin-top: auto;
  padding-top: var(--space-4, 16px);
}

.ps-card--dark .ps-card__source {
  color: var(--ps-on-dark-sec, rgba(247, 247, 244, 0.72));
}

/* ---------- Schlussnotiz + CTA ---------- */

.ps-note {
  max-width: var(--lt-measure, 32rem);
  margin: var(--space-6, 32px) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  line-height: var(--leading-relaxed, 1.6);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

.ps-actions {
  margin-top: var(--space-6, 32px);
}

.ps-cta {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2, 8px);
  min-height: 44px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm, 14px);
  font-weight: var(--weight-semibold, 600);
  line-height: 1.2;
  color: var(--crs-text, #26251e);
  text-decoration: none;
  transition: color var(--ease-default, 0.2s ease);
}

.ps-cta svg {
  flex-shrink: 0;
  transition: transform var(--ease-default, 0.2s ease);
}

.ps-cta:hover,
.ps-cta:focus-visible {
  color: var(--ps-measure, #4a8c85);
}

.ps-cta:hover svg,
.ps-cta:focus-visible svg {
  transform: translateX(3px);
}

.ps-cta:focus-visible {
  outline: 2px solid var(--ps-measure, #4a8c85);
  outline-offset: 3px;
  border-radius: var(--radius-sm, 8px);
}

@media (prefers-reduced-motion: reduce) {
  .ps-cta,
  .ps-cta svg {
    transition: none;
  }

  .ps-cta:hover svg,
  .ps-cta:focus-visible svg {
    transform: none;
  }
}

/* ---------- Responsive ---------- */

@media screen and (min-width: 1025px) {
  .ps-head--split {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-7, 48px);
  }
}

@media screen and (max-width: 1024px) {
  .ps-cards,
  .ps-cards--3,
  .ps-cards--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media screen and (max-width: 767px) {
  .ps-head {
    margin-bottom: var(--space-6, 32px);
  }

  /* Aufwand und Laborzeit bleiben nebeneinander, der Vergleich ist die Aussage. */
  .ps-ledger {
    gap: var(--space-4, 16px) var(--space-5, 24px);
  }

  .ps-cards,
  .ps-cards--3,
  .ps-cards--2 {
    grid-template-columns: minmax(0, 1fr);
  }

  .ps-card {
    padding: var(--space-5, 24px);
  }

  .ps-card__step {
    margin-bottom: var(--space-4, 16px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Process Steps",
  "tag": "section",
  "class": "lt-pdp-process-steps",
  "settings": [
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card_dark",
      "label": "Hintergrund hervorgehobene Karte",
      "default": "#364f56"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e"
    },
    {
      "type": "color",
      "id": "color_text_on_dark",
      "label": "Textfarbe auf dunkler Karte",
      "default": "#f7f7f4"
    },
    {
      "type": "color",
      "id": "color_measure",
      "label": "Farbe Messwert",
      "default": "#4a8c85",
      "info": "Nur für die Zeitbilanz. Sparsam halten."
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (Section-Headline)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section",
      "info": "Zeilenumbruch: Enter in Überschrift/Unterüberschrift."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "In 4 Schritten zum Ergebnis."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift (optional)",
      "default": "Ohne Arztbesuch.",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "header",
      "content": "Zeitbilanz"
    },
    {
      "type": "checkbox",
      "id": "ledger_enable",
      "label": "Zeitbilanz anzeigen",
      "default": true,
      "info": "Steht neben der Überschrift und fasst Eigenaufwand und Wartezeit zusammen."
    },
    {
      "type": "text",
      "id": "ledger_label_1",
      "label": "Label 1",
      "default": "Dein Aufwand"
    },
    {
      "type": "text",
      "id": "ledger_value_1",
      "label": "Wert 1",
      "info": "Produktspezifisch, bewusst ohne Vorgabe. Leer blendet die Zeile aus."
    },
    {
      "type": "text",
      "id": "ledger_label_2",
      "label": "Label 2",
      "default": "Laborzeit"
    },
    {
      "type": "text",
      "id": "ledger_value_2",
      "label": "Wert 2",
      "info": "Produktspezifisch, bewusst ohne Vorgabe. Leer blendet die Zeile aus."
    },
    {
      "type": "header",
      "content": "Abschluss"
    },
    {
      "type": "textarea",
      "id": "footer_callout",
      "label": "Schlussnotiz",
      "info": "Produktspezifisch, bewusst ohne Vorgabe. Ein geerbter Labor- oder Dauer-Satz wäre auf einer anderen PDP eine falsche Aussage."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Schritt-Nummer",
          "default": "01"
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Kartenstil",
          "options": [
            { "value": "standard", "label": "Standard (hell)" },
            { "value": "dark", "label": "Hervorgehoben (dunkel)" }
