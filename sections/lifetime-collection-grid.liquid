{%- comment -%}
  Collection Grid — kuratierte Produktbänder.

  Rendert die gemeinsame Karte aus snippets/lt-product-card.liquid in einer von
  drei Varianten. Die Section entscheidet nur die Kaufpolitik (PDP oder Warenkorb)
  und das Bandlayout, die Karte entscheidet die Darstellung.

  Blocktypen:
  - product_card: ein Produkt
  - group_label: eine Gruppenmarke im laufenden Band, ohne eigene Section

  Spec: docs/collection-all-spec.md §2, §3
{%- endcomment -%}

{{ 'lt-product-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cg_variant = section.settings.card_variant | default: 'tile'

  comment
    Kaufpolitik: link_behavior == 'cart' legt die erste Variante direkt in den
    Warenkorb, der Drawer öffnet, der Besucher bleibt auf der Seite. Die
    Handle-Liste in pdp_exception_handles führt trotzdem zur Produktseite, weil
    dort die Größen- oder Variantenwahl der eigentliche nächste Schritt ist.
    Der href bleibt in beiden Fällen die PDP, damit der Klick ohne JavaScript
    nicht ins Leere geht.
  endcomment
  assign cg_pdp_raw = section.settings.pdp_exception_handles | default: 'lifetime-age-dna,lifetime-nmn,nmn-pulver,age-dna-test'
  assign cg_pdp_list = cg_pdp_raw | replace: ' ', '' | split: ','
-%}

<div
  class="container--large container--vertical-space section-{{ section.id }}-cg"
  style="background-color: {{ section.settings.section_bg_color }};"
>

  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="cg-header crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-md">
      <div class="crs-heading-stack__pair">
        {%- if section.settings.heading != blank -%}
          <h2 class="cg-heading crs-heading-stack__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- comment -%}
          Die Unterzeile gehört in den Pair-Block, nicht über die Überschrift.
          Titel und Unterzeile sind ein Block, unterschieden nur durch Farbe.
          Vorher rendert sie als Kicker und erzeugte damit eine zweite
          Hierarchieebene, die das System nicht kennt.
        {%- endcomment -%}
        {%- if section.settings.subheading != blank -%}
          <p class="crs-heading-stack__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="cg-list cg-list--{{ cg_variant }}">

    {%- for block in section.blocks -%}

      {%- if block.type == 'group_label' -%}
        {%- if block.settings.label != blank -%}
          <p class="cg-group" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</p>
        {%- endif -%}

      {%- else -%}
        {%- liquid
          assign cg_product = blank
          assign cg_handle = blank

          if block.settings.product != blank
            assign cg_handle = block.settings.product.handle | default: block.settings.product
            comment
              Über all_products rehydrieren, sonst fehlen die App-Metafelder
              (Loox) so wie in den PDP-Sections auch.
            endcomment
            assign cg_hydrated = all_products[cg_handle]
            if cg_hydrated != blank
              assign cg_product = cg_hydrated
            else
              assign cg_product = block.settings.product
            endif
          endif
        -%}

        {%- if cg_product != blank -%}
          {%- liquid
            assign cg_block_variant = block.settings.card_variant
            if cg_block_variant == blank or cg_block_variant == 'inherit'
              assign cg_block_variant = cg_variant
            endif

            assign cg_is_pdp_exception = false
            if cg_handle != blank and cg_pdp_list contains cg_handle
              assign cg_is_pdp_exception = true
            endif

            assign cg_atc_id = blank
            if section.settings.link_behavior == 'cart' and block.settings.force_product_link != true and cg_is_pdp_exception == false and cg_product.available
              assign cg_first_variant = cg_product.variants.first.id
              if cg_first_variant
                assign cg_atc_id = cg_first_variant
              endif
            endif

            assign cg_cta = block.settings.button_label
            if cg_cta == blank
              if cg_atc_id != blank
                assign cg_cta = section.settings.atc_label | default: 'In den Warenkorb'
              else
                assign cg_cta = section.settings.cta_label | default: 'Zum Produkt'
              endif
            endif
          -%}

          <div class="cg-item cg-item--{{ cg_block_variant }}" {{ block.shopify_attributes }}>
            {%- render 'lt-product-card',
              product: cg_product,
              variant: cg_block_variant,
              href: cg_product.url,
              atc_variant_id: cg_atc_id,
              cta_label: cg_cta,
              title_override: block.settings.custom_title,
              subline_override: block.settings.subline,
              kicker: block.settings.kicker,
              image_override: block.settings.custom_image,
              price_from: block.settings.price_from,
              price_note: block.settings.price_note,
              show_rating: block.settings.show_rating,
              soldout_label: section.settings.soldout_label
            -%}
          </div>
        {%- endif -%}
      {%- endif -%}

    {%- endfor -%}

  </div>

</div>

<style>
  /* Die Theme-Klasse container--vertical-space bringt 50px Aussenabstand mit.
     Zwei aufeinanderfolgende Baender ergaben damit 100px, die kein Setting
     erklaert; gemessen standen 213px zwischen der letzten Zeile und der
     naechsten Ueberschrift. Der Abstand gehoert in die Paddings der Section,
     nicht in eine geerbte Klasse. */
  .section-{{ section.id }}-cg.container--vertical-space {
    margin-top: 0;
    margin-bottom: 0;
  }

  .section-{{ section.id }}-cg {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 749px) {
    .section-{{ section.id }}-cg {
      padding-top: calc({{ section.settings.padding_top }}px * 0.8);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.8);
    }
  }

  /*  Header  */
  .section-{{ section.id }}-cg .cg-header {
    border-top: 1px solid var(--color-border-default);
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  @media (max-width: 749px) {
    .section-{{ section.id }}-cg .cg-header {
      padding-top: var(--space-5);
      margin-bottom: var(--space-5);
    }
  }

  .section-{{ section.id }}-cg .cg-heading {
    margin: 0;
  }

  /*  Band: Blätter
     Zwei Blätter nebeneinander. Eine Zeile im selben Band spannt über
     beide Spalten, damit der Anschlusskauf unter den Protagonisten
     stehen kann, ohne eine eigene Section zu brauchen. */
  .section-{{ section.id }}-cg .cg-list--sheet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: stretch;
  }

  .section-{{ section.id }}-cg .cg-list--sheet > .cg-item--row {
    grid-column: 1 / -1;
  }

  .section-{{ section.id }}-cg .cg-list--sheet > .cg-item {
    display: flex;
  }

  .section-{{ section.id }}-cg .cg-list--sheet > .cg-item > .ltc {
    flex: 1 1 auto;
  }

  @media (max-width: 767px) {
    .section-{{ section.id }}-cg .cg-list--sheet {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  /*  Band: Register
     Zeilen tragen ihre Hairline selbst, das Band braucht keine. */
  .section-{{ section.id }}-cg .cg-list--row {
    display: block;
  }

  /*  Band: Kacheln
     Eigenes Raster statt der Theme-Klasse .grid--layout. Deren
     Mobilregeln machen aus jedem Band eine horizontale Scrollfläche,
     und verstecktes Inventar ist auf einer Katalogseite der teuerste
     Fehler. Hier bricht das Raster stattdessen um. */
  .section-{{ section.id }}-cg .cg-list--tile {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: stretch;
  }

  .section-{{ section.id }}-cg .cg-list--tile > .cg-item {
    display: flex;
  }

  .section-{{ section.id }}-cg .cg-list--tile > .cg-item > .ltc {
    flex: 1 1 auto;
  }

  @media (max-width: 989px) {
    .section-{{ section.id }}-cg .cg-list--tile {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .section-{{ section.id }}-cg .cg-list--tile {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /*  Gruppenmarke
     Die 12px-Versalienstimme des Systems. Sie trägt die Hairline, die
     sonst die erste Zeile der Gruppe trüge; deshalb nimmt die Zeile
     direkt darunter ihre eigene zurück. */
  .section-{{ section.id }}-cg .cg-group {
    grid-column: 1 / -1;
    margin: var(--space-7) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-default);
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  .section-{{ section.id }}-cg .cg-list > .cg-group:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .section-{{ section.id }}-cg .cg-group + .cg-item--row > .ltc--row {
    border-top: 0;
  }

  @media (max-width: 749px) {
    .section-{{ section.id }}-cg .cg-group {
      margin-top: var(--space-6);
    }
  }

  /* Ladezustand der Warenkorb-Karten */
  .section-{{ section.id }}-cg .ltc.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }
</style>

<script>
  (function() {
    var scope = document.querySelector('.section-{{ section.id }}-cg');
    if (!scope) return;

    function handleClick(e) {
      var card = e.currentTarget;
      var id = card.getAttribute('data-lt-card-atc');
      if (!id) return;
      e.preventDefault();
      if (card.classList.contains('is-loading')) return;
      card.classList.add('is-loading');

      var payload = JSON.stringify({
        items: [{ id: parseInt(id, 10), quantity: 1 }]
      });
      var headers = { 'Content-Type': 'application/json' };

      function done() { card.classList.remove('is-loading'); }

      // Theme-Helper bevorzugt — übernimmt Drawer-Open + Cart-Refresh
      if (typeof window.handleAddToCart === 'function') {
        try {
          window.handleAddToCart(payload, 1, headers, done);
        } catch (err) {
          done();
        }
      } else {
        // Vanilla-Fallback
        fetch('/cart/add.js', { method: 'POST', headers: headers, body: payload })
          .then(function() {
            document.dispatchEvent(new CustomEvent('cart:refresh'));
          })
          .finally(done);
      }
    }

    scope.querySelectorAll('[data-lt-card-atc]').forEach(function(card) {
      card.addEventListener('click', handleClick);
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "class": "container--remove-margin-before",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterzeile",
      "info": "Steht als zweite Zeile im Überschriften-Block, gleiche Größe, nur heller."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_variant",
      "label": "Kartenvariante",
      "options": [
        { "value": "sheet", "label": "Blatt (Protagonisten)" },
        { "value": "row", "label": "Registerzeile" },
        { "value": "tile", "label": "Kachel" }
      ],
      "default": "tile"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Spalten (nur Kachel)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Hintergrund",
      "default": "#f7f7f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 80
    },
    {
      "type": "header",
      "content": "Kaufweg"
    },
    {
      "type": "select",
      "id": "link_behavior",
      "label": "Klick auf die Karte",
      "options": [
        { "value": "product", "label": "Zur Produktseite" },
        { "value": "cart", "label": "In den Warenkorb" }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "pdp_exception_handles",
      "label": "Handles, die immer zur Produktseite führen",
      "default": "lifetime-age-dna,lifetime-nmn,nmn-pulver,age-dna-test",
      "info": "Komma-getrennt. Für Produkte, bei denen die Variantenwahl der nächste Schritt ist."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA (Produktseite)",
      "default": "Zum Produkt"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "CTA (Warenkorb)",
      "default": "In den Warenkorb"
    },
    {
      "type": "text",
      "id": "soldout_label",
      "label": "Hinweis bei nicht verfügbar",
      "default": "Nicht verfügbar"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Produkt",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt"
        },
        {
          "type": "select",
          "id": "card_variant",
          "label": "Kartenvariante",
          "options": [
            { "value": "inherit", "label": "Wie die Section" },
            { "value": "sheet", "label": "Blatt" },
            { "value": "row", "label": "Registerzeile" },
            { "value": "tile", "label": "Kachel" }
          ],
          "default": "inherit"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Kurztitel",
          "info": "Gewinnt über den Produkttitel."
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Nutzenzeile"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "info": "Nur setzen, wenn er etwas sagt, das sonst nirgends steht."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Bild"
        },
        {
          "type": "checkbox",
          "id": "price_from",
          "label": "Preis mit \"ab\"",
          "default": true,
          "info": "Aus, wenn ein \"ab\" neben einem Streichpreis widersprüchlich läse."
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Preisnotiz",
          "info": "Eine kurze Zeile unter dem Preis, etwa für eine zweite Variante."
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Bewertung zeigen",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "force_product_link",
          "label": "Immer zur Produktseite",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "CTA-Text",
          "info": "Leer lassen für den Standardtext der Section."
        }
      ]
    },
    {
      "type": "group_label",
      "name": "Gruppenmarke",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Marke",
          "default": "Gruppe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
