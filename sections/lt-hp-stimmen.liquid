{% comment %}
  lt-hp-stimmen — Kundenstimmen als Karussell (Startseite v2, Oktober 2026).
  Erste Karte mit Foto, alle weiteren im dunklen Teal-Verlauf. Wortlaut aus Loox
  (Metafeld loox.reviews des AGE&DNA-Tests), von BJ am 08.10.2026 als echt bestätigt.
  Sterne und Anzahl live aus product.metafields.loox (avg_rating, num_reviews).
  Bewusst ohne 124er-Befragung, Retest-Verläufe und Begleitprogramm-Hinweis.
  Ersetzt auf der Startseite lt-hp-social-proof (die Datei bleibt liegen).
  Seit 26.10.2026 (AG1-Umbau) zwei Layouts: „raster“ = drei Foto-Karten nebeneinander
  (mobil untereinander), Sterne-Zeile rechts neben der Überschrift, Zahl 40 px, Zitat in Lato;
  „karussell“ = das Live-Layout vom 09.10. mit Pfeilen. Jede Karte darf jetzt ein Foto tragen.
  Vorlage: docs/entwurf-startseite-ag1-2026-10-26.html#stimmen (Raster), startseite-v2/startseite.html#stimmen (Karussell)
{% endcomment %}

{%- liquid
  assign p = section.settings.product
  assign schnitt = section.settings.rating_fallback
  assign anzahl = section.settings.count_fallback
  if p != blank
    if p.metafields.loox.avg_rating != blank
      assign schnitt = p.metafields.loox.avg_rating.value | append: '' | replace: '.', ','
    endif
    if p.metafields.loox.num_reviews != blank
      assign anzahl = p.metafields.loox.num_reviews.value | append: ''
    endif
  endif
  assign schnitt_zahl = schnitt | replace: ',', '.' | plus: 0.0
  assign raster = false
  if section.settings.layout == 'raster'
    assign raster = true
  endif
  assign bewertung_url = section.settings.link_url | default: '/products/lifetime-age-dna#reviews'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ltk-pt: {{ section.settings.padding_top }}px;
    --ltk-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="ltk{% if raster %} ltk--raster{% endif %}" data-ltk>
  <div class="ltk__kopf">
    <div>
      {% render 'section-heading-crs',
        heading: section.settings.heading,
        headline_md: true,
        modifier: 'homepage-truth'
      %}
      {%- unless raster -%}
        <p class="ltk__sterne"><b>{{ schnitt }} von 5</b> · {{ anzahl }} Bewertungen zum Test</p>
      {%- endunless -%}
    </div>
    {%- if raster -%}
    {%- comment -%} Fünf Sterne, der letzte anteilig gefüllt (Muster crs-hero-typewriter 22.10.), Link zu den Bewertungen {%- endcomment -%}
    <a class="ltk__bewertung" href="{{ bewertung_url }}" aria-label="{{ schnitt }} von 5 Sternen, {{ anzahl }} Bewertungen zum Test">
      <span class="ltk__sterne-reihe" aria-hidden="true">
        {%- for i in (1..5) -%}
          {%- assign anteil = schnitt_zahl | minus: i | plus: 1 | times: 100 | round | at_least: 0 | at_most: 100 -%}
          {%- if anteil >= 100 -%}
            <svg viewBox="0 0 20 20" class="ltk__stern"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>
          {%- elsif anteil <= 0 -%}
            <svg viewBox="0 0 20 20" class="ltk__stern ltk__stern--leer"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>
          {%- else -%}
            <svg viewBox="0 0 20 20" class="ltk__stern"><defs><linearGradient id="ltk-stern-{{ section.id }}-{{ i }}"><stop offset="{{ anteil }}%" stop-color="currentColor"/><stop offset="{{ anteil }}%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#ltk-stern-{{ section.id }}-{{ i }})" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z"/></svg>
          {%- endif -%}
        {%- endfor -%}
      </span>
      <span class="ltk__bewertung-text">{{ schnitt }} von 5 · {{ anzahl }} Bewertungen zum Test</span>
    </a>
    {%- else -%}
    <div class="ltk__pfeile">
      <button type="button" data-r="-1" aria-label="Zurück">
        {%- comment -%} ph:arrow-left-thin {%- endcomment -%}
        <svg width="20" height="20" viewBox="0 0 256 256" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M220 128a4 4 0 0 1-4 4H49.66l65.17 65.17a4 4 0 0 1-5.66 5.66l-72-72a4 4 0 0 1 0-5.66l72-72a4 4 0 0 1 5.66 5.66L49.66 124H216a4 4 0 0 1 4 4"/></svg>
      </button>
      <button type="button" data-r="1" aria-label="Weiter">
        {%- comment -%} ph:arrow-right-thin {%- endcomment -%}
        <svg width="20" height="20" viewBox="0 0 256 256" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="m218.83 130.83l-72 72a4 4 0 0 1-5.66-5.66L206.34 132H40a4 4 0 0 1 0-8h166.34l-65.17-65.17a4 4 0 0 1 5.66-5.66l72 72a4 4 0 0 1 0 5.66"/></svg>
      </button>
    </div>
    {%- endif -%}
  </div>

  <ul class="ltk__spur" role="list">
    {%- for block in section.blocks -%}
      {%- assign foto = false -%}
      {%- if block.settings.stil == 'foto' and block.settings.image != blank -%}{%- assign foto = true -%}{%- endif -%}
      <li class="ltk__karte {% if foto %}ltk__karte--foto{% else %}ltk__karte--verlauf{% endif %}{% if block.settings.zahl != blank %} ltk__karte--zahl{% endif %}" {{ block.shopify_attributes }}>
        {%- if foto -%}
          {{
            block.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '400, 800', sizes: '380px', class: 'ltk__foto', alt: ''
          }}
        {%- endif -%}
        {%- if block.settings.zahl != blank -%}
          <p class="ltk__zahl">{{ block.settings.zahl | escape }}</p>
          {%- if block.settings.zahl_label != blank -%}<p class="ltk__zl">{{ block.settings.zahl_label | escape }}</p>{%- endif -%}
        {%- else -%}
          <p class="ltk__anf" aria-hidden="true">„</p>
        {%- endif -%}
        <p class="ltk__txt">{% if raster %}„{% endif %}{{ block.settings.text | escape }}{% if raster %}“{% endif %}</p>
        <p class="ltk__name">{{ block.settings.name | escape }}{% if block.settings.source != blank %}<span>{% if raster %} · {% endif %}{{ block.settings.source | escape }}</span>{% endif %}</p>
      </li>
    {%- endfor -%}
  </ul>

  {%- if section.settings.link_label != blank -%}
    <div class="ltk__fuss">
      <a href="{{ section.settings.link_url | default: '/products/lifetime-age-dna#reviews' }}">{{ section.settings.link_label | replace: '[anzahl]', anzahl | escape }}</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.ltk {
  --ltk-rand: max(40px, calc((100vw - 1200px) / 2));
  /* Kapitel-Stufe der AG1-Seite: 36 px Desktop, 28 px Handy (Entwurf 26.10.) */
  --text-h2: 36px;
  background: var(--color-paper);
  padding: var(--ltk-pt, 96px) 0 var(--ltk-pb, 96px);
}
.ltk__kopf {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-5);
  max-width: 1280px;
  margin: 0 auto var(--space-6);
  padding: 0 40px;
}
.ltk__sterne {
  margin: 10px 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  color: var(--color-ink-muted);
}
.ltk__sterne b { font-weight: var(--weight-regular); color: var(--color-ink); font-variant-numeric: tabular-nums; }
.ltk__pfeile { display: flex; gap: var(--space-2); }
.ltk__pfeile button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  border: 1px solid #dcdad3;
  background: var(--color-white);
  color: var(--color-ink);
  cursor: pointer;
}
.ltk__pfeile button:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
.ltk__spur {
  list-style: none;
  margin: 0;
  padding: 0 var(--ltk-rand);
  display: flex;
  gap: var(--space-4);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding: 0 var(--ltk-rand);
  scrollbar-width: none;
}
.ltk__spur::-webkit-scrollbar { display: none; }
.ltk__karte {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 0 0 380px;
  height: 440px;
  padding: var(--space-6);
  border-radius: var(--radius-lg);
  overflow: hidden;
  scroll-snap-align: start;
  color: var(--color-paper);
}
.ltk__karte--verlauf {
  background:
    radial-gradient(circle at 85% 0%, rgba(101, 192, 182, 0.16), rgba(101, 192, 182, 0) 55%),
    linear-gradient(165deg, #34494f 0%, #1f2e33 100%);
}
.ltk__karte--foto { background-color: #3a3833; color: var(--color-white); }
.ltk__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.ltk__karte--foto::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(20, 19, 17, 0.45) 0%, rgba(20, 19, 17, 0.08) 34%, rgba(20, 19, 17, 0.25) 55%, rgba(20, 19, 17, 0.82) 100%);
}
.ltk__karte--foto > p { position: relative; z-index: 2; }
.ltk__zahl {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-stat);
  font-weight: var(--weight-bold);
  line-height: var(--leading-stat);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}
.ltk__zl {
  margin: 10px 0 0;
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.72;
}
.ltk__anf {
  height: 40px;
  margin: 0;
  font-family: var(--font-heading);
  font-size: 96px;
  line-height: 0.6;
  opacity: 0.35;
}
.ltk__txt {
  margin: auto 0 0;
  font-family: var(--font-heading);
  font-size: var(--text-section);
  line-height: 1.35;
  letter-spacing: -0.005em;
}
.ltk__karte--zahl .ltk__txt { font-size: var(--text-body-lg); line-height: 1.4; }
.ltk__name {
  margin: var(--space-5) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
}
.ltk__name span { display: block; margin-top: 2px; font-size: var(--text-body-sm); line-height: 1.45; opacity: 0.72; }
.ltk__fuss { max-width: 1280px; margin: var(--space-5) auto 0; padding: 0 40px; }
.ltk__fuss a {
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  color: var(--color-ink);
  text-decoration: none;
  text-underline-offset: 3px;
}
.ltk__fuss a:hover, .ltk__fuss a:focus-visible { text-decoration: underline; }
/* Raster (AG1-Umbau 26.10.2026): drei Foto-Karten, Sterne rechts neben der Überschrift */
.ltk__bewertung {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  flex: 0 0 auto;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.3;
  color: var(--color-ink-muted);
  text-decoration: none;
}
.ltk__bewertung:hover .ltk__bewertung-text, .ltk__bewertung:focus-visible .ltk__bewertung-text { text-decoration: underline; text-underline-offset: 3px; }
.ltk__bewertung:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
.ltk__sterne-reihe { display: inline-flex; gap: 2px; color: var(--color-dark); }
.ltk__stern { display: block; width: 16px; height: 16px; fill: currentColor; }
.ltk__stern--leer { opacity: 0.25; }
.ltk__bewertung-text { font-variant-numeric: tabular-nums; }
.ltk--raster .ltk__kopf { margin-bottom: var(--space-6); }
.ltk--raster .ltk__spur {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  overflow: visible;
  scroll-snap-type: none;
}
.ltk--raster .ltk__karte {
  flex: none;
  height: auto;
  min-height: 440px;
  padding: var(--space-6);
  justify-content: flex-end;
}
.ltk--raster .ltk__karte--foto::before {
  background: linear-gradient(to top, rgba(38, 37, 30, 0.9) 0%, rgba(38, 37, 30, 0.45) 50%, rgba(38, 37, 30, 0.1) 100%);
}
.ltk--raster .ltk__zahl { font-size: 40px; font-weight: var(--weight-regular); letter-spacing: -0.01em; }
.ltk--raster .ltk__zl { margin-top: var(--space-1); font-size: 11px; font-weight: var(--weight-regular); }
.ltk--raster .ltk__txt, .ltk--raster .ltk__karte--zahl .ltk__txt {
  margin-top: var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  letter-spacing: 0;
}
.ltk--raster .ltk__anf { display: none; }
.ltk--raster .ltk__name { margin-top: var(--space-3); font-size: 13px; opacity: 0.72; }
.ltk--raster .ltk__name span { display: inline; margin: 0; font-size: inherit; opacity: 1; }
/* Kapitel-Stufe mobil 28 px (AG1-Seite, vorher 24) */
@media (max-width: 860px) { .ltk { --text-h2: 28px; } }
@media (max-width: 1024px) { .ltk--raster .ltk__spur { padding: 0 24px; } }
@media (max-width: 768px) {
  .ltk--raster .ltk__kopf { flex-direction: column; align-items: flex-start; gap: var(--space-2); margin-bottom: var(--space-5); }
  .ltk--raster .ltk__spur { grid-template-columns: 1fr; gap: var(--space-3); }
  .ltk--raster .ltk__karte { min-height: 360px; padding: var(--space-5); }
  .ltk--raster .ltk__zahl { font-size: 40px; }
  .ltk--raster .ltk__txt { font-size: var(--text-body); }
}
@media (max-width: 640px) { .ltk--raster .ltk__spur { padding: 0 20px; } }
@media (max-width: 1024px) {
  .ltk { --ltk-rand: 24px; }
  .ltk__kopf, .ltk__fuss { padding: 0 24px; }
}
@media (max-width: 768px) {
  .ltk { padding: var(--space-8) 0; }
  .ltk__pfeile { display: none; }
  .ltk__karte { flex-basis: 82vw; height: 400px; padding: var(--space-5); }
  .ltk__txt { font-size: var(--text-body-lg); }
  .ltk__zahl { font-size: var(--text-display); }
}
@media (max-width: 640px) {
  .ltk { --ltk-rand: 20px; }
  .ltk__kopf, .ltk__fuss { padding: 0 20px; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.__ltStimmenBound) return;
  window.__ltStimmenBound = true;
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.ltk__pfeile button');
    if (!b) return;
    var root = b.closest('[data-ltk]');
    var spur = root && root.querySelector('.ltk__spur');
    var karte = spur && spur.querySelector('.ltk__karte');
    if (!karte) return;
    var schritt = karte.getBoundingClientRect().width + 16;
    var ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    spur.scrollBy({ left: (+b.dataset.r) * schritt, behavior: ruhig ? 'auto' : 'smooth' });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "HP Kundenstimmen",
  "tag": "section",
  "class": "section lt-hp-stimmen",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was sich nach dem Ergebnis geändert hat" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "karussell", "options": [
      { "value": "raster", "label": "Raster: drei Foto-Karten, Sterne oben (26.10.)" },
      { "value": "karussell", "label": "Karussell mit Pfeilen (Stand 09.10.)" }
    ] },
    { "type": "product", "id": "product", "label": "Produkt für Sterne und Anzahl (Loox)" },
    { "type": "text", "id": "rating_fallback", "label": "Schnitt, falls kein Produkt", "default": "4,7" },
    { "type": "text", "id": "count_fallback", "label": "Anzahl, falls kein Produkt", "default": "121" },
    { "type": "text", "id": "link_label", "label": "Link unter dem Karussell", "default": "Alle [anzahl] Bewertungen lesen →", "info": "[anzahl] wird durch die Loox-Anzahl ersetzt. Im Raster leer lassen, dort führt die Sterne-Zeile zu den Bewertungen." },
    { "type": "url", "id": "link_url", "label": "Ziel des Links und der Sterne-Zeile" },
    { "type": "header", "content": "Abstände Desktop" },
    { "type": "range", "id": "padding_top", "label": "Oben", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Unten", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "stimme",
      "name": "Stimme",
      "settings": [
        { "type": "select", "id": "stil", "label": "Karte", "default": "verlauf", "options": [
          { "value": "foto", "label": "Foto" },
          { "value": "verlauf", "label": "Teal-Verlauf" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "zahl", "label": "Zahl (optional, z. B. 46 → 38)" },
        { "type": "text", "id": "zahl_label", "label": "Beschriftung der Zahl", "default": "chronologisch → biologisch" },
        { "type": "textarea", "id": "text", "label": "Zitat (Loox-Wortlaut)", "default": "Zitat" },
        { "type": "text", "id": "name", "label": "Name", "default": "Vorname N." },
        { "type": "text", "id": "source", "label": "Quelle", "default": "Bewertung auf Loox" }
      ]
    }
  ],
  "presets": [{ "name": "HP Kundenstimmen" }]
}
{% endschema %}
