{% comment %}
  lt-hp-fragen — Fragen zur Startseite (Startseite v2, Oktober 2026).
  Links Überschrift und Link zur Beratung, rechts acht Fragen als <details>.
  Die Beratung ist eine Antwort, keine eigene Section mehr (BJ 08.10.2026).
  Gibt FAQPage-JSON-LD aus, gespiegelt aus dem sichtbaren Text.
  Vorlage: docs/startseite-v2/startseite.html#fragen
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    --ltf-pt: {{ section.settings.padding_top }}px;
    --ltf-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div class="ltf">
  <div class="ltf__wrap"><div class="ltf__grid">
    <div>
      {% render 'section-heading-crs',
        heading: section.settings.heading,
        headline_md: true,
        modifier: 'homepage-truth'
      %}
      {%- if section.settings.link_label != blank -%}
        <a class="ltf__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div>
      {%- for block in section.blocks -%}
        <details class="ltf__frage"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary>
          <div class="ltf__antwort">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div></div>
</div>

{%- capture faq_items -%}
  {%- assign begonnen = false -%}
  {%- for block in section.blocks -%}
    {%- assign q = block.settings.question | strip -%}
    {%- assign a = block.settings.answer | strip_html | strip_newlines | strip -%}
    {%- if q != blank and a != blank -%}
      {%- if begonnen -%},{%- endif -%}
      {%- assign begonnen = true -%}
      {"@type":"Question","name":{{ q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | json }}}}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign faq_items = faq_items | strip -%}
{%- unless faq_items == blank -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_items }}]}</script>
{%- endunless -%}

{% stylesheet %}
.ltf {
  background: var(--color-paper);
  padding: var(--ltf-pt, 40px) 0 var(--ltf-pb, 112px);
}
.ltf__wrap { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
.ltf__grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: var(--space-7);
  padding-top: 56px;
  border-top: 1px solid #dcdad3;
}
.ltf__link {
  display: inline-block;
  margin-top: 18px;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  color: var(--color-ink);
  text-decoration: none;
  text-underline-offset: 3px;
}
.ltf__link:hover, .ltf__link:focus-visible { text-decoration: underline; }
.ltf__frage { border-bottom: 1px solid #e4e2db; }
.ltf__frage:first-child { border-top: 1px solid #e4e2db; }
.ltf__frage summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5);
  padding: 22px 0;
  list-style: none;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: var(--text-body-lg);
  line-height: 1.4;
  color: var(--color-ink);
}
.ltf__frage summary::-webkit-details-marker { display: none; }
.ltf__frage summary:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 4px; }
.ltf__frage summary span { position: relative; flex: 0 0 14px; height: 14px; }
.ltf__frage summary span::before,
.ltf__frage summary span::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 6px;
  height: 1.5px;
  background: var(--color-ink);
  transition: transform var(--ease-default);
}
.ltf__frage summary span::after { transform: rotate(90deg); }
.ltf__frage[open] summary span::after { transform: rotate(0); }
.ltf__antwort { max-width: 640px; margin: -6px 0 22px; }
.ltf__antwort p {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--leading-relaxed);
  color: var(--color-ink-muted);
}
.ltf__antwort p + p { margin-top: var(--space-3); }
.ltf__antwort a { color: var(--color-ink); text-decoration: none; text-underline-offset: 3px; }
.ltf__antwort a:hover, .ltf__antwort a:focus-visible { text-decoration: underline; }
@media (max-width: 1024px) { .ltf__wrap { padding: 0 24px; } }
/* Kapitel-Stufe mobil 24 px (Typo-System Startseite v2) */
@media (max-width: 860px) { .ltf { --text-h2: 24px; } }
@media (max-width: 900px) {
  .ltf { padding: var(--space-5) 0 72px; }
  .ltf__grid { grid-template-columns: 1fr; gap: var(--space-5); padding-top: 40px; }
  .ltf__frage summary { padding: 18px 0; }
}
@media (max-width: 640px) { .ltf__wrap { padding: 0 20px; } }
@media (prefers-reduced-motion: reduce) {
  .ltf__frage summary span::before, .ltf__frage summary span::after { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "HP Fragen",
  "tag": "section",
  "class": "section lt-hp-fragen",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Fragen" },
    { "type": "text", "id": "link_label", "label": "Link unter der Überschrift", "default": "Mit einem Experten sprechen →" },
    { "type": "url", "id": "link_url", "label": "Ziel des Links" },
    { "type": "header", "content": "Abstände Desktop" },
    { "type": "range", "id": "padding_top", "label": "Oben", "min": 0, "max": 160, "step": 8, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Unten", "min": 0, "max": 160, "step": 8, "default": 112, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "frage",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort</p>" },
        { "type": "checkbox", "id": "open", "label": "Anfangs geöffnet", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "HP Fragen" }]
}
{% endschema %}
