{% comment %}
  lt-hp-bekannt — Presse-Zeile „Bekannt aus“ direkt unter dem Vollbild-Hero (Startseite, neu 26.10.2026).
  Erster Beweis nach dem Hero (AG1-Analyse, Regel 9): ein warmer Papier-Streifen, links die
  Beschriftung, rechts die fünf Medienmarken in einer Zeile, monochrom in Tinte mit Deckkraft.
  Keine Kacheln, keine Linien: der Flächenwechsel (dunkles Foto → warmes Papier → helles Papier)
  trennt die Section von ihren Nachbarn. Höhe je Logo ist ein Block-Setting, weil die Bildmarken
  optisch verschieden schwer sind; mobil skaliert dieselbe Höhe auf 78 %.
  Bewegung: einmaliges, versetztes Einblenden beim ersten Sichtbarwerden (IntersectionObserver),
  ohne JS oder bei prefers-reduced-motion stehen die Logos sofort. Ein Logo kann auf den
  Beitrag verlinken (Block-Setting „Link“), nur dann gibt es einen Hover-Zustand.
  Vorgänger (fünf graue Kacheln, Stand 09.10.) liegt in Git vor Commit „Bekannt aus 26.10.“.
{% endcomment %}

{%- liquid
  assign flaeche = 'var(--color-surface-secondary)'
  if section.settings.surface == 'paper'
    assign flaeche = 'var(--color-paper)'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ltl-pt: {{ section.settings.padding_top }}px;
    --ltl-pb: {{ section.settings.padding_bottom }}px;
    --ltl-flaeche: {{ flaeche }};
  }
{% endstyle %}

<div class="ltl" data-ltl>
  <div class="ltl__wrap">
    {%- if section.settings.heading != blank -%}
      <p class="ltl__titel" style="--ltl-i:0">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    <ul class="ltl__zeile" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image == blank -%}{%- continue -%}{%- endif -%}
        {%- capture logo_style -%}--ltl-h:{{ block.settings.height }}px{%- endcapture -%}
        {%- capture logo -%}
          {{
            block.settings.image
            | image_url: width: 480
            | image_tag:
              loading: 'lazy',
              widths: '240, 480',
              sizes: '200px',
              alt: block.settings.alt
          }}
        {%- endcapture -%}
        <li class="ltl__logo" style="--ltl-i:{{ forloop.index }};{{ logo_style }}" {{ block.shopify_attributes }}>
          {%- if block.settings.url != blank -%}
            <a class="ltl__link" href="{{ block.settings.url }}" aria-label="{{ block.settings.alt | escape }}: zum Beitrag">{{ logo }}</a>
          {%- else -%}
            {{ logo }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
.ltl {
  --ltl-deck: 0.62;
  --ltl-skala: 0.78;
  --ltl-kurve: cubic-bezier(0.16, 1, 0.3, 1);
  background: var(--ltl-flaeche, var(--color-surface-secondary));
  padding: var(--ltl-pt, 40px) 0 var(--ltl-pb, 40px);
}
/* Kante wie die Nachbarn: 1280 mit 40 / 24 / 20 px Rand */
.ltl__wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: flex;
  align-items: center;
  gap: var(--space-7);
}
.ltl__titel {
  flex: 0 0 auto;
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-ink-muted);
}
.ltl__zeile {
  flex: 1 1 auto;
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-5) var(--space-6);
}
.ltl__logo { display: flex; align-items: center; }
.ltl__logo img,
.ltl__link {
  display: block;
  height: var(--ltl-h, 30px);
  width: auto;
}
.ltl__logo img {
  /* Bildmarke in Tinte mit Deckkraft: Graustufen-PNG auf Tinte abdunkeln, dann mit der Fläche mischen */
  filter: brightness(0);
  opacity: var(--ltl-deck);
  transition: opacity var(--ease-smooth);
}
.ltl__link:hover img,
.ltl__link:focus-visible img { opacity: 1; }
.ltl__link:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 6px; }

/* Einmaliges Einblenden wie ein Satz: erst „Bekannt aus“, dann die Marken von links nach rechts.
   Greift nur, wenn JS die Klasse setzt und Bewegung erlaubt ist; sonst steht alles sofort. */
.ltl--bereit .ltl__titel,
.ltl--bereit .ltl__logo {
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.8s var(--ltl-kurve), transform 0.8s var(--ltl-kurve);
  transition-delay: calc(var(--ltl-i, 0) * 90ms);
}
.ltl--bereit.ltl--sichtbar .ltl__titel,
.ltl--bereit.ltl--sichtbar .ltl__logo { opacity: 1; transform: none; }

@media (max-width: 1024px) { .ltl__wrap { padding: 0 24px; gap: var(--space-6); } }
@media (max-width: 768px) {
  .ltl { padding: var(--space-6) 0; }
  .ltl__wrap { flex-direction: column; gap: var(--space-4); }
  .ltl__zeile { justify-content: center; flex-wrap: wrap; gap: var(--space-4) var(--space-6); }
  .ltl__logo img, .ltl__link { height: calc(var(--ltl-h, 30px) * var(--ltl-skala)); }
}
@media (max-width: 640px) { .ltl__wrap { padding: 0 20px; } }
@media (prefers-reduced-motion: reduce) {
  .ltl--bereit .ltl__titel, .ltl--bereit .ltl__logo { opacity: 1; transform: none; transition: none; }
  .ltl__logo img { transition: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.ltlInit) return;
    root.dataset.ltlInit = '1';
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var r = root.getBoundingClientRect();
    /* Schon im Blick (z. B. nach Reload mitten auf der Seite): nicht verstecken, nichts animieren */
    if (r.top < window.innerHeight && r.bottom > 0) return;
    root.classList.add('ltl--bereit');
    var io = new IntersectionObserver(function (eintraege) {
      eintraege.forEach(function (e) {
        if (!e.isIntersecting) return;
        root.classList.add('ltl--sichtbar');
        io.disconnect();
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }
  function alle() { document.querySelectorAll('[data-ltl]').forEach(init); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', alle); else alle();
  document.addEventListener('shopify:section:load', function (e) {
    var r = e.target && e.target.querySelector && e.target.querySelector('[data-ltl]');
    if (r) { delete r.dataset.ltlInit; r.classList.remove('ltl--bereit', 'ltl--sichtbar'); init(r); }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "HP Bekannt aus",
  "tag": "section",
  "class": "section lt-hp-bekannt",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Beschriftung", "default": "Bekannt aus" },
    {
      "type": "select",
      "id": "surface",
      "label": "Fläche",
      "default": "warm",
      "options": [
        { "value": "warm", "label": "Warmes Papier (Streifen)" },
        { "value": "paper", "label": "Helles Papier (wie Seite)" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Abstand oben (Desktop)", "min": 0, "max": 160, "step": 8, "default": 40, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten (Desktop)", "min": 0, "max": 160, "step": 8, "default": 40, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo (einfarbig, freigestellt)", "info": "Wird in Tinte mit Deckkraft gerendert, Farbe der Datei spielt keine Rolle." },
        { "type": "text", "id": "alt", "label": "Alt-Text", "default": "Logo" },
        { "type": "range", "id": "height", "label": "Höhe Desktop", "min": 16, "max": 60, "step": 1, "default": 30, "unit": "px", "info": "Optischer Ausgleich zwischen Bildmarken. Mobil 78 % davon." },
        { "type": "url", "id": "url", "label": "Link zum Beitrag", "info": "Optional. Nur verlinkte Logos bekommen einen Hover-Zustand." }
      ]
    }
  ],
  "presets": [{ "name": "HP Bekannt aus" }]
}
{% endschema %}
