{%- comment -%}
  Katalog Index — die Register-Leiste am Fuß des Katalogs.

  Wege aus der Seite heraus, nicht Sprungmarken innerhalb. Sie steht unten:
  bei einem überschaubaren Bestand sieht der Besucher alles durch Scrollen,
  Navigation davor verzögert nur. Unten fängt sie die auf, die nichts
  Passendes gefunden haben.

  Zugleich die einzige dunkle Fläche der Seite und damit das Gegenstück zum
  Slate-Rücken des Registers auf den Kollektionsseiten.

  Spec: docs/collection-all-spec.md §2, §4.4
{%- endcomment -%}

{% style %}
  {%- if section.settings.footer_nahtlos %}
  body .main-footer { margin-top: 0; border-top: 0; } /* wie lt-leiste: section-footer.css lädt später */
  {%- endif %}
  #section-{{ section.id }} {
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background:     {{ section.settings.bg_color }};
  }

  @media (max-width: 767px) {
    #section-{{ section.id }} {
      padding-top:    {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }
{% endstyle %}

{%- comment -%}
  Mit Foto (16.11.2026) wird der Index zur Schluss-Leiste des Katalogs: dasselbe verwischte
  Foto wie in lt-leiste, rechts im Teal auslaufend, die Liste rückt in zwei Spalten nach links.
  Ohne Foto bleibt der Block, wie er war.
{%- endcomment -%}
<section id="section-{{ section.id }}" class="lki{% if section.settings.image != blank %} lki--bild{% endif %}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1120
      | image_tag: loading: 'lazy', widths: '560, 1120', sizes: '(min-width: 901px) 60vw, 100vw', class: 'lki__foto', alt: ''
    }}
  {%- endif -%}
  <div class="lki__inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="lki__head crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-md crs-heading-stack--on-dark">
        <div class="crs-heading-stack__pair">
          {%- if section.settings.heading != blank -%}
            <h2 class="crs-heading-stack__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="crs-heading-stack__subtitle">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="lki__nav" aria-label="{{ section.settings.nav_aria | escape }}">
        <ul class="lki__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              # Ein collection-Setting liefert das Kollektionsobjekt selbst,
              # nicht den Handle. Ein Lookup ueber collections[...] laeuft ins Leere.
              assign lki_col = block.settings.collection
              assign lki_label = block.settings.label
              if lki_label == blank
                assign lki_label = lki_col.title
              endif
            -%}
            {%- comment -%}
              Eine Kollektion, die es nicht mehr gibt, wird übersprungen statt
              als leere Zeile gerendert. Dieselbe Regel wie im Register-Index.
            {%- endcomment -%}
            {%- if lki_col != blank and lki_col.handle != blank -%}
              <li class="lki__item" {{ block.shopify_attributes }}>
                <a class="lki__link" href="{{ lki_col.url }}">
                  <span class="lki__name">{{ lki_label | escape }}</span>
                  <span class="lki__count" aria-hidden="true">{{ lki_col.products_count }}</span>
                  <span class="visually-hidden">
                    {{- lki_col.products_count }}
                    {% if lki_col.products_count == 1 %}Produkt{% else %}Produkte{% endif -%}
                  </span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
/*
   lt-katalog-index — Register-Leiste auf Clinical Slate
*/

.lki {
  /* On-dark-Rampe aus DESIGN.md. Das Live-Theme legt dafür keine
     CSS-Variablen an (geprüft gegen assets/theme.css), deshalb hier
     deklariert statt auf Tokens zu zeigen, die es nicht gibt.
     Deep Teal trägt auf Slate nur 2,10:1 und ist hier deshalb weder
     Hover- noch Fokusfarbe; beides geht auf die volle On-Dark-Stufe. */
  --lki-on-dark: #f7f7f4;
  --lki-on-dark-muted: rgba(247, 247, 244, 0.72);
  --lki-hairline: rgba(247, 247, 244, 0.2);

  color: var(--lki-on-dark);
}

.lki__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-5);
}

.lki__head {
  margin-bottom: var(--space-6);
}

.lki__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: var(--space-7);
}

.lki__link {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  min-height: 52px;
  padding: var(--space-3) 0;
  border-top: 1px solid var(--lki-hairline);
  text-decoration: none;
  color: var(--lki-on-dark-muted);
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.4;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.lki__link:hover,
.lki__link:focus-visible {
  color: var(--lki-on-dark);
  border-top-color: var(--lki-on-dark);
}

.lki__link:focus-visible {
  outline: 2px solid var(--lki-on-dark);
  outline-offset: 2px;
}

.lki__name {
  min-width: 0;
}

.lki__count {
  font-family: var(--font-heading);
  font-size: var(--text-body-sm);
  font-variant-numeric: tabular-nums;
  color: var(--lki-on-dark-muted);
  flex-shrink: 0;
}

/* Mit Foto: Verlauf und Unschärfe wie .ltl2 in lt-leiste, damit beide Schlussblöcke gleich aussehen. */
.lki--bild {
  position: relative;
  overflow: hidden;
}

.lki__foto {
  position: absolute;
  top: -8%;
  right: -6%;
  width: 62%;
  height: 116%;
  object-fit: cover;
  filter: blur(26px) brightness(0.9) saturate(1.05);
}

.lki--bild::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, var(--color-dark) 46%, rgba(54, 79, 86, 0.86) 56%, rgba(54, 79, 86, 0.35) 72%, rgba(54, 79, 86, 0) 88%),
    linear-gradient(180deg, rgba(54, 79, 86, 0) 60%, var(--color-dark) 100%);
}

.lki--bild .lki__inner {
  position: relative;
  z-index: 1;
}

.lki--bild .lki__nav {
  max-width: 58%;
}

.lki--bild .lki__list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 989px) {
  .lki__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }
}

@media (max-width: 767px) {
  .lki__inner {
    padding: 0 var(--space-4);
  }

  .lki__list {
    grid-template-columns: minmax(0, 1fr);
  }

  .lki__head {
    margin-bottom: var(--space-5);
  }
}

@media (max-width: 900px) {
  .lki__foto { top: -6%; right: -8%; width: 116%; height: 240px; }
  .lki--bild::after { background: linear-gradient(180deg, rgba(54, 79, 86, 0) 0, rgba(54, 79, 86, 0.6) 110px, var(--color-dark) 200px); }
  .lki--bild .lki__inner { padding-top: 150px; }
  .lki--bild .lki__nav { max-width: none; }
}

@media (max-width: 767px) {
  .lki--bild .lki__list { grid-template-columns: minmax(0, 1fr); }
}

@media (prefers-reduced-motion: reduce) {
  .lki__link {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Katalog Index",
  "tag": "section",
  "class": "lt-katalog-index",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Wonach suchst du?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Unterzeile",
      "default": "Dieselben Produkte, nach Ziel sortiert."
    },
    {
      "type": "text",
      "id": "nav_aria",
      "label": "Aria-Label der Navigation",
      "default": "Kollektionen"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Hintergrund",
      "default": "#364f56"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto (wird verwischt)",
      "info": "Macht den Index zur Schluss-Leiste: Foto rechts, Liste in zwei Spalten links. Leer = wie bisher."
    },
    {
      "type": "checkbox",
      "id": "footer_nahtlos",
      "label": "Nahtlos in den Footer",
      "default": false,
      "info": "Footer ohne Abstand und ohne Linie. Nur einschalten, wenn der Index die letzte Section der Seite ist."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "index_link",
      "name": "Kollektion",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Abweichende Beschriftung",
          "info": "Leer lassen, solange der Kollektionstitel passt. Sonst driftet die Leiste bei jeder Umbenennung."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Katalog Index"
    }
  ]
}
{% endschema %}
