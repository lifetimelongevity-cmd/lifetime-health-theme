{% comment %}
  LT Page — Report Intro
  Warm split hero for the What's Inside page.

  Seiten-H1 auf --text-h1 (headline-lg), wie /pages/science. Titel + Subline
  bleiben ein Block (section-heading-stack.md); der Einleitungstext steht als
  `intro` ausserhalb des Paars in Fliesstextgroesse.
{% endcomment %}

{%- liquid
  assign lt_ri_kicker = section.settings.kicker | strip
  if lt_ri_kicker == '__none__'
    assign lt_ri_kicker = ''
  endif
  assign lt_ri_intro = section.settings.intro | strip
  if lt_ri_intro == '__none__'
    assign lt_ri_intro = ''
  endif
  assign lt_ri_has_image = false
  if section.settings.app_image != blank or section.settings.app_image_url != blank
    assign lt_ri_has_image = true
  endif
-%}

<section
  id="lt-page-report-intro-{{ section.id }}"
  class="lt-page-report-intro"
  aria-labelledby="lt-page-report-intro-heading-{{ section.id }}"
>
  <div class="container container--large remove-empty-space">
    <div class="lt-page-report-intro__split{% if lt_ri_has_image %} lt-page-report-intro__split--has-image{% endif %}">
      <div class="lt-page-report-intro__content">
        <div class="crs-heading-stack crs-heading-stack--align-left crs-heading-stack--on-dark crs-heading-stack--headline-lg">
          {%- if lt_ri_kicker != blank -%}
            <p class="crs-heading-stack__kicker">{{ lt_ri_kicker | escape }}</p>
          {%- endif -%}
          <div class="crs-heading-stack__pair">
            <h1 class="crs-heading-stack__title" id="lt-page-report-intro-heading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h1>
            {%- if section.settings.subheading != blank -%}
              <p class="crs-heading-stack__subtitle">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
        </div>
        {%- if lt_ri_intro != blank -%}
          <p class="lt-page-report-intro__intro">{{ lt_ri_intro | escape }}</p>
        {%- endif -%}
      </div>

      {%- if lt_ri_has_image -%}
        <div class="lt-page-report-intro__media">
          {%- if section.settings.app_image != blank -%}
            {{
              section.settings.app_image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 980px) 480px, calc(100vw - 32px)',
                class: 'lt-page-report-intro__app-img',
                alt: section.settings.app_image_alt | default: 'LIFETIME App'
            }}
          {%- elsif section.settings.app_image_url != blank -%}
            <img
              src="{{ section.settings.app_image_url | escape }}"
              alt="{{ section.settings.app_image_alt | default: 'LIFETIME App' | escape }}"
              class="lt-page-report-intro__app-img"
              width="420"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .lt-page-report-intro {
    padding-block: var(--space-9);
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark);
  }

  .lt-page-report-intro__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  @media screen and (min-width: 980px) {
    .lt-page-report-intro__split--has-image {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .lt-page-report-intro__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .lt-page-report-intro__intro {
    margin: 0;
    max-width: 32rem;
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
    color: var(--color-text-on-dark-muted);
  }

  .lt-page-report-intro__media {
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }

  .lt-page-report-intro__app-img {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: var(--radius-lg);
  }

  @media screen and (max-width: 979px) {
    .lt-page-report-intro__media {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 767px) {
    .lt-page-report-intro {
      padding-block: var(--space-8);
    }

    .lt-page-report-intro__split {
      gap: var(--space-6);
    }

    .lt-page-report-intro__intro {
      font-size: var(--text-body);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LT Page Report Intro",
  "tag": "section",
  "class": "section-lt-page-report-intro",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "AGE & DNA-Test",
      "info": "__none__ = ausblenden"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift (H1)",
      "default": "Was der Test alles misst."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterzeile (gleiche Größe wie H1, kurz halten)"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitungstext",
      "info": "Fließtext unter der Überschrift. __none__ = ausblenden"
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "app_image",
      "label": "Bild (Upload)"
    },
    {
      "type": "url",
      "id": "app_image_url",
      "label": "Bild (URL)"
    },
    {
      "type": "text",
      "id": "app_image_alt",
      "label": "Alt-Text Bild"
    }
  ],
  "presets": [
    {
      "name": "LT Page Report Intro"
    }
  ]
}
{% endschema %}
