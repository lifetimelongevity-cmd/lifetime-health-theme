{% comment %}
  lt-hp-bereiche — „Wo willst du ansetzen?“ (Startseite v2, Oktober 2026).
  Oben mit Abstand eine breite NMN-Karte (BJ 08.10.2026), darunter Heading-Paar,
  Reiter je Ziel-Kollektion und eine Bildkarte mit Reitername, Produktzeile und Knopf.

  NMN steht bewusst AUSSERHALB des Heading-Paars „Nährstoffe nach Ziel …“ und trägt
  den Live-Wortlaut der früheren Bestseller-Karte inkl. „Forschungs-/Analysezwecke ·
  Nicht zum Verzehr“ (VSW-Vergleich, NMN nicht als Nahrungsergänzung bewerben).
  NMN nie als Reiter einfügen.

  Reiter: Tastatur (Pfeile, Pos1, Ende), Deep-Link ?bereich=<collection-handle>.
  Produktzeile: Kurznamen aus dem Block, sonst die ersten Produkttitel der Kollektion.
  Ersetzt auf der Startseite die Bestseller-Reihe (lifetime-collection-grid).
  Vorlage: docs/startseite-v2/startseite.html#bereiche
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    --ltb-pt: {{ section.settings.padding_top }}px;
    --ltb-pb: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- assign nmn = section.settings.nmn_product -%}
<div class="ltb" id="bereiche" data-ltb>
  <div class="ltb__wrap">

    {%- if nmn != blank -%}
      <div class="ltb__nmn">
        <div class="ltb__nmn-bild">
          {%- if section.settings.nmn_image != blank -%}
            {{
              section.settings.nmn_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 769px) 40vw, 90vw', alt: section.settings.nmn_title
            }}
          {%- elsif nmn.featured_image != blank -%}
            {{ nmn.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.nmn_title }}
          {%- endif -%}
        </div>
        <div class="ltb__nmn-text">
          <h3 class="ltb__nmn-titel">{{ section.settings.nmn_title | default: nmn.title | escape }}</h3>
          {%- if section.settings.nmn_text != blank -%}
            <p class="ltb__nmn-zeile">{{ section.settings.nmn_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.nmn_label != blank -%}
            <p class="ltb__nmn-label">{{ section.settings.nmn_label | escape }}</p>
          {%- endif -%}
          <div class="ltb__nmn-kauf">
            <span class="ltb__nmn-preis">{% if nmn.price_varies %}ab {% endif %}{{ nmn.price_min | money }}</span>
            <a class="ltb__nmn-btn" href="{{ nmn.url }}">{{ section.settings.nmn_button | escape }}</a>
          </div>
        </div>
      </div>
    {%- endif -%}

    {% render 'section-heading-crs',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'center',
      headline_md: true,
      modifier: 'homepage-truth',
      extra_class: 'ltb__kopf'
    %}

    {%- if section.blocks.size > 0 -%}
      <div class="ltb__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          <button
            type="button"
            class="ltb__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            id="ltb-{{ section.id }}-t{{ forloop.index }}"
            aria-controls="ltb-{{ section.id }}-p{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-handle="{{ c.handle }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.tab_label | escape }}</button>
        {%- endfor -%}
      </div>

      <div class="ltb__card">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {%- capture pos -%}object-position:{{ block.settings.position | default: '50% 45%' }}{%- endcapture -%}
            {%- assign img_class = 'ltb__img' -%}
            {%- if forloop.first -%}{%- assign img_class = 'ltb__img is-active' -%}{%- endif -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1122',
                sizes: '(min-width: 1280px) 1200px, 100vw',
                class: img_class,
                alt: '',
                style: pos
            }}
          {%- else -%}
            <span class="ltb__img{% if forloop.first %} is-active{% endif %}"></span>
          {%- endif -%}
        {%- endfor -%}
        <div class="ltb__inner">
          {%- for block in section.blocks -%}
            {%- assign c = block.settings.collection -%}
            <div
              class="ltb__panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              id="ltb-{{ section.id }}-p{{ forloop.index }}"
              aria-labelledby="ltb-{{ section.id }}-t{{ forloop.index }}"
            >
              <p class="ltb__titel">{{ block.settings.title | default: c.title | escape }}</p>
              <p class="ltb__zeile">
                {%- if block.settings.produkte != blank -%}
                  {%- assign namen = block.settings.produkte | split: ',' -%}
                {%- else -%}
                  {%- assign namen = c.products | map: 'title' -%}
                {%- endif -%}
                {%- for n in namen limit: 5 -%}
                  {%- unless forloop.first %} · {% endunless -%}
                  <span>{{ n | strip | escape }}</span>
                {%- endfor -%}
              </p>
              <a class="ltb__btn" href="{{ c.url | default: '/collections/all' }}">{{ section.settings.button_label | escape }}</a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ltb {
  background: var(--color-paper);
  padding: var(--ltb-pt, 96px) 0 var(--ltb-pb, 96px);
}
.ltb__wrap { max-width: 1280px; margin: 0 auto; padding: 0 40px; }

/* NMN-Karte, steht vor dem Heading-Paar */
.ltb__nmn {
  display: grid;
  grid-template-columns: 5fr 7fr;
  margin-bottom: var(--space-8);
  background: var(--color-white);
  border: 1px solid #e4e2db;
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.ltb__nmn-bild {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  padding: var(--space-6);
  background: #f2f1ed;
}
.ltb__nmn-bild img { display: block; width: auto; max-width: 100%; max-height: 260px; height: auto; object-fit: contain; }
.ltb__nmn-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--space-7);
}
.ltb__nmn-titel {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-h2);
  font-weight: var(--weight-regular);
  line-height: var(--leading-heading);
  letter-spacing: -0.01em;
  color: var(--color-ink);
}
.ltb__nmn-zeile {
  margin: var(--space-3) 0 0;
  max-width: var(--lt-measure);
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--leading-relaxed);
  color: var(--color-ink-muted);
}
.ltb__nmn-label {
  margin: var(--space-4) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-ink-muted);
}
.ltb__nmn-kauf { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: var(--space-5); }
.ltb__nmn-preis {
  font-family: var(--font-heading);
  font-size: var(--text-section);
  font-weight: var(--weight-bold);
  font-variant-numeric: tabular-nums;
  color: var(--color-ink);
}
.ltb__nmn-btn {
  display: inline-block;
  padding: 13px 24px;
  border-radius: var(--radius-full);
  background: var(--color-button-primary-bg);
  color: var(--color-button-primary-text);
  font-family: var(--font-body);
  font-size: var(--text-body);
  text-decoration: none;
}

/* Umschalter */
.ltb__kopf { margin: 0 auto 28px; }
.ltb__tabs {
  display: flex;
  gap: var(--space-1);
  justify-content: center;
  width: max-content;
  max-width: 100%;
  margin: 0 auto var(--space-5);
  padding: var(--space-1);
  background: #ecebe6;
  border-radius: var(--radius-full);
  overflow-x: auto;
  scrollbar-width: none;
}
.ltb__tabs::-webkit-scrollbar { display: none; }
.ltb__tab {
  flex: 0 0 auto;
  padding: 10px var(--space-4);
  border: 0;
  border-radius: var(--radius-full);
  background: transparent;
  color: var(--color-ink-muted);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1;
  cursor: pointer;
  transition: background var(--ease-default), color var(--ease-default);
}
.ltb__tab:hover { color: var(--color-ink); }
.ltb__tab.is-active { background: var(--color-white); color: var(--color-ink); box-shadow: 0 1px 2px rgba(38, 37, 30, 0.08); }
.ltb__tab:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }

.ltb__card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 8;
  border-radius: var(--radius-lg);
  background: var(--color-ink);
}
.ltb__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transform: scale(1.03);
  transition: opacity 0.6s ease, transform 1.2s ease;
}
.ltb__img.is-active { opacity: 1; transform: scale(1); }
.ltb__card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(38, 37, 30, 0.05) 30%, rgba(38, 37, 30, 0.45) 100%);
  pointer-events: none;
}
.ltb__inner {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: grid;
  place-items: center;
  padding: var(--space-5);
  text-align: center;
  color: var(--color-white);
}
.ltb__panel {
  grid-area: 1 / 1;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0s linear 0.3s;
}
.ltb__panel.is-active { opacity: 1; visibility: visible; transition: opacity 0.3s ease 0.15s, visibility 0s; }
.ltb__titel {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-stat);
  font-weight: var(--weight-regular);
  line-height: 1.05;
  letter-spacing: -0.02em;
}
.ltb__zeile {
  margin: 14px 0 22px;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: 1.5;
  opacity: 0.9;
}
.ltb__zeile span { white-space: nowrap; }
.ltb__btn {
  display: inline-block;
  padding: 11px 20px;
  border-radius: var(--radius-full);
  background: var(--color-white);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  text-decoration: none;
}
.ltb__btn:focus-visible,
.ltb__nmn-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

@media (max-width: 1024px) { .ltb__wrap { padding: 0 24px; } }
/* Kapitel-Stufe mobil 24 px (Typo-System Startseite v2) */
@media (max-width: 860px) { .ltb { --text-h2: 24px; } }
@media (max-width: 768px) {
  .ltb { padding: var(--space-8) 0; }
  .ltb__nmn { grid-template-columns: 1fr; margin-bottom: var(--space-7); }
  .ltb__nmn-bild { min-height: 0; aspect-ratio: 16 / 10; padding: var(--space-5); }
  .ltb__nmn-bild img { max-height: 200px; }
  .ltb__nmn-text { padding: var(--space-5) 20px 28px; }
  .ltb__nmn-titel { font-size: var(--text-h3); }
  .ltb__tabs { justify-content: flex-start; margin-bottom: var(--space-4); }
  .ltb__card { aspect-ratio: 4 / 5; border-radius: var(--radius-md); }
  .ltb__titel { font-size: var(--text-h1); }
}
@media (max-width: 640px) { .ltb__wrap { padding: 0 20px; } }
@media (prefers-reduced-motion: reduce) {
  .ltb__img, .ltb__panel, .ltb__panel.is-active, .ltb__tab { transition: none; }
  .ltb__img { transform: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.__ltBereicheBound) return;
  window.__ltBereicheBound = true;

  function waehle(root, i, merken) {
    var tabs = root.querySelectorAll('.ltb__tab');
    if (!tabs[i]) return;
    tabs.forEach(function (t, k) {
      var an = k === i;
      t.classList.toggle('is-active', an);
      t.setAttribute('aria-selected', an ? 'true' : 'false');
      t.setAttribute('tabindex', an ? '0' : '-1');
    });
    root.querySelectorAll('.ltb__img').forEach(function (img, k) {
      img.classList.toggle('is-active', k === i);
    });
    root.querySelectorAll('.ltb__panel').forEach(function (p, k) {
      p.classList.toggle('is-active', k === i);
    });
    if (merken && tabs[i].dataset.handle && window.history && history.replaceState) {
      var u = new URL(window.location.href);
      u.searchParams.set('bereich', tabs[i].dataset.handle);
      u.hash = 'bereiche';
      history.replaceState(null, '', u);
    }
  }

  function start(root) {
    if (!root || root.__ltbStart) return;
    root.__ltbStart = true;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('.ltb__tab'));
    var wunsch = new URLSearchParams(window.location.search).get('bereich');
    if (wunsch) {
      tabs.forEach(function (t, k) { if (t.dataset.handle === wunsch) waehle(root, k, false); });
    }
    root.addEventListener('click', function (e) {
      var t = e.target.closest('.ltb__tab');
      if (t) waehle(root, tabs.indexOf(t), true);
    });
    root.addEventListener('keydown', function (e) {
      var t = e.target.closest('.ltb__tab');
      if (!t) return;
      var i = tabs.indexOf(t), n = tabs.length, ziel = null;
      if (e.key === 'ArrowRight') ziel = (i + 1) % n;
      else if (e.key === 'ArrowLeft') ziel = (i - 1 + n) % n;
      else if (e.key === 'Home') ziel = 0;
      else if (e.key === 'End') ziel = n - 1;
      if (ziel === null) return;
      e.preventDefault();
      waehle(root, ziel, true);
      tabs[ziel].focus();
    });
  }

  function alle() { document.querySelectorAll('[data-ltb]').forEach(start); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', alle);
  else alle();
  document.addEventListener('shopify:section:load', function (e) { start(e.target.querySelector('[data-ltb]')); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "HP Bereiche",
  "tag": "section",
  "class": "section lt-hp-bereiche",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "NMN-Karte (vor dem Umschalter)" },
    { "type": "product", "id": "nmn_product", "label": "Produkt", "info": "Leer lassen blendet die Karte aus." },
    { "type": "image_picker", "id": "nmn_image", "label": "Produktbild (freigestellt)" },
    { "type": "text", "id": "nmn_title", "label": "Titel", "default": "NMN Pulver" },
    { "type": "text", "id": "nmn_text", "label": "Zeile", "default": "Reines NMN-Pulver, Reinheit je Charge im Labor geprüft. Drei Größen." },
    { "type": "text", "id": "nmn_label", "label": "Hinweis", "default": "Forschungs-/Analysezwecke · Nicht zum Verzehr", "info": "VSW-Vergleich: NMN nicht als Nahrungsergänzung bewerben." },
    { "type": "text", "id": "nmn_button", "label": "Knopf", "default": "Größe wählen" },
    { "type": "header", "content": "Umschalter" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wo willst du ansetzen?" },
    { "type": "text", "id": "subheading", "label": "Unterzeile (gleich groß, nur heller)", "default": "Nährstoffe nach Ziel, jede Charge im Labor geprüft." },
    { "type": "text", "id": "button_label", "label": "Knopf in der Bildkarte", "default": "Produkte ansehen" },
    { "type": "header", "content": "Abstände Desktop" },
    { "type": "range", "id": "padding_top", "label": "Oben", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Unten", "min": 0, "max": 160, "step": 8, "default": 96, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "bereich",
      "name": "Bereich",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "tab_label", "label": "Reiter", "default": "Bereich" },
        { "type": "text", "id": "title", "label": "Titel in der Karte", "info": "Leer = Name der Kollektion" },
        { "type": "text", "id": "produkte", "label": "Produktzeile (Kurznamen, mit Komma getrennt)", "info": "Leer = erste Produkttitel der Kollektion" },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "position", "label": "Bildausschnitt (CSS object-position)", "default": "50% 45%" }
      ]
    }
  ],
  "presets": [{ "name": "HP Bereiche" }]
}
{% endschema %}
