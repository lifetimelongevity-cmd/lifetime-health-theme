    { "type": "checkbox", "id": "read_marker", "label": "Ereignis lt_read, wenn diese Section sichtbar wird", "default": false }
  ],
  "blocks": [
    {
      "type": "zeile",
      "name": "Zeile",
      "settings": [
        { "type": "text", "id": "lead", "label": "Fetter Anfang", "info": "Bei Stufen-Kacheln: die große Zahl." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Text der Zeile." },
