{% comment %}
  LIFETIME — Age Test Guide
  ─────────────────────────
  Zitierfähiger Antwortkern für /pages/biologisches-alter-testen.

  §12 Build Spec:
  - Surface:          A → B → A → dunkel → B, Flächen kommen aus den Settings
                      (vorher weiß/#f6f4f1 im Wechsel, ein 1,10:1-Schritt und
                      damit unsichtbar; Haus-Paar ist #f7f7f4/#f2f1ed wie auf
                      /pages/science)
  - Dominant element: direkte Antwort im ersten Abschnitt, eine Stufe unter dem
                      Abschnittstitel (--text-h3 gegen --text-h2)
  - Heading size:     --text-h2 für die vier Kapitel, --text-section für die
                      Quellen (Service-Rang), alles über section-heading-crs
  - Content pattern:  redaktionelles Methoden-Ledger statt Kartenraster
  - Karten:           weiß, und nur dort wo Text führt (Antwort, Kriterien).
                      Ledger- und Quellenzeilen bleiben Haarlinien ohne Fläche.
  - Turn:             der fit-Block trägt die dunkle Fläche, weil dort die Seite
                      von neutraler Information auf das eigene Angebot umschaltet
  - CTA:              Quiz primär, PDP als untergeordneter Textlink
  - Removed:          Wettbewerberpreise, Empfehlungs-Badge, dekorative Icons
  - Quality move:     nummerierte Methoden-Zeilen mit expliziter Aussagegrenze
{% endcomment %}

{{ 'section-lt-age-test-guide.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign atg_methods = section.blocks | where: 'type', 'method'
  assign atg_criteria = section.blocks | where: 'type', 'criterion'
  assign atg_sources = section.blocks | where: 'type', 'source'
-%}

{% style %}
  #section-{{ section.id }} {
    --atg-surface-a:    {{ section.settings.color_bg }};
    --atg-surface-b:    {{ section.settings.color_bg_alt }};
    --atg-surface-turn: {{ section.settings.color_bg_turn }};
    --atg-card-bg:      {{ section.settings.color_card_bg }};
    --atg-turn-text:    {{ section.settings.color_turn_text }};
    --atg-turn-text-sec:{{ section.settings.color_turn_text | color_modify: 'alpha', 0.72 }};
    --atg-turn-border:  {{ section.settings.color_turn_text | color_modify: 'alpha', 0.18 }};
  }
{% endstyle %}

<div class="atg" id="section-{{ section.id }}">
  <section class="atg__answer">
    <div class="atg__container atg__answer-grid">
      {% render 'section-heading-crs',
        heading: section.settings.answer_heading,
        subheading: section.settings.answer_subheading,
        kicker: section.settings.answer_kicker,
        align: 'left',
        headline_md: true,
        heading_tag: 'h2',
        extra_class: 'atg__answer-heading'
      %}

      <div class="atg__answer-copy">
        <p class="atg__eyebrow">{{ section.settings.answer_label | escape }}</p>
        <p class="atg__lead" id="atg-answer-{{ section.id }}">{{ section.settings.direct_answer | escape }}</p>
        {%- if section.settings.answer_note != blank -%}
          <p class="atg__note">{{ section.settings.answer_note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if atg_methods.size > 0 -%}
    <section class="atg__methods" id="methoden">
      <div class="atg__container">
        {% render 'section-heading-crs',
          heading: section.settings.methods_heading,
          subheading: section.settings.methods_subheading,
          kicker: section.settings.methods_kicker,
          align: 'left',
          headline_md: true,
          heading_tag: 'h2',
          extra_class: 'atg__section-heading'
        %}

        <ol class="atg__method-list">
          {%- for block in atg_methods -%}
            <li class="atg__method" {{ block.shopify_attributes }}>
              <span class="atg__method-number" aria-hidden="true">0{{ forloop.index }}</span>
              <div class="atg__method-title-wrap">
                <h3 class="atg__method-title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.sample != blank -%}
                  <p class="atg__method-sample">{{ block.settings.sample | escape }}</p>
                {%- endif -%}
              </div>
              <dl class="atg__method-facts">
                <div class="atg__method-fact">
                  <dt>Was wird ausgewertet?</dt>
                  <dd>{{ block.settings.measurement | escape }}</dd>
                </div>
                <div class="atg__method-fact">
                  <dt>Was ist die Grenze?</dt>
                  <dd>{{ block.settings.limitation | escape }}</dd>
                </div>
              </dl>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- if atg_criteria.size > 0 -%}
    <section class="atg__criteria">
      <div class="atg__container atg__criteria-grid">
        {% render 'section-heading-crs',
          heading: section.settings.criteria_heading,
          subheading: section.settings.criteria_subheading,
          kicker: section.settings.criteria_kicker,
          align: 'left',
          headline_md: true,
          heading_tag: 'h2',
          extra_class: 'atg__criteria-heading'
        %}

        <ol class="atg__criteria-list">
          {%- for block in atg_criteria -%}
            <li class="atg__criterion" {{ block.shopify_attributes }}>
              <span class="atg__criterion-number" aria-hidden="true">{{ forloop.index }}</span>
              <div>
                <h3 class="atg__criterion-title">{{ block.settings.title | escape }}</h3>
                <p class="atg__criterion-text">{{ block.settings.text | escape }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  <section class="atg__fit atg__fit--turn">
    <div class="atg__container atg__fit-grid">
      {% render 'section-heading-crs',
        heading: section.settings.fit_heading,
        subheading: section.settings.fit_subheading,
        kicker: section.settings.fit_kicker,
        align: 'left',
        headline_md: true,
        on_dark: true,
        heading_tag: 'h2',
        extra_class: 'atg__fit-heading'
      %}

      <div class="atg__fit-copy">
        <div class="atg__fit-body rte">{{ section.settings.fit_body }}</div>
        {%- if section.settings.disclosure != blank -%}
          <p class="atg__disclosure">{{ section.settings.disclosure | escape }}</p>
        {%- endif -%}
        <div class="atg__actions">
          {%- if section.settings.primary_cta_label != blank and section.settings.primary_cta_url != blank -%}
            <a class="atg__primary-cta" href="{{ section.settings.primary_cta_url }}">
              {{ section.settings.primary_cta_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_cta_label != blank and section.settings.secondary_cta_url != blank -%}
            <a class="atg__secondary-cta" href="{{ section.settings.secondary_cta_url }}">
              {{ section.settings.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- if atg_sources.size > 0 -%}
    <section class="atg__sources" aria-label="{{ section.settings.sources_heading | escape }}">
      <div class="atg__container atg__sources-grid">
        <div>
          {% render 'section-heading-crs',
            heading: section.settings.sources_heading,
            align: 'left',
            heading_tag: 'h2',
            extra_class: 'atg__sources-heading'
          %}
          {%- if section.settings.sources_intro != blank -%}
            <p class="atg__sources-intro">{{ section.settings.sources_intro | escape }}</p>
          {%- endif -%}
          {%- if section.settings.review_date != blank -%}
            <p class="atg__review-date">{{ section.settings.review_date | escape }}</p>
          {%- endif -%}
        </div>

        <ol class="atg__source-list">
          {%- for block in atg_sources -%}
            <li class="atg__source" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener">
                {{ block.settings.citation | escape }}
              </a>
              {%- if block.settings.supports != blank -%}
                <span>{{ block.settings.supports | escape }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "LT Age Test Guide",
  "tag": "section",
  "class": "lt-age-test-guide",
  "settings": [
    { "type": "header", "content": "Flächen" },
    { "type": "color", "id": "color_bg", "label": "Fläche A (Antwort, Kriterien)", "default": "#f2f1ed" },
    { "type": "color", "id": "color_bg_alt", "label": "Fläche B (Methoden, Quellen)", "default": "#f7f7f4" },
    { "type": "color", "id": "color_card_bg", "label": "Kartenfläche", "default": "#ffffff" },
    { "type": "color", "id": "color_bg_turn", "label": "Fläche Einordnung (dunkel)", "default": "#364f56" },
    { "type": "color", "id": "color_turn_text", "label": "Text auf dunkler Fläche", "default": "#ffffff" },

    { "type": "header", "content": "Direkte Antwort" },
    { "type": "text", "id": "answer_kicker", "label": "Kicker", "default": "Kurz erklärt" },
    { "type": "textarea", "id": "answer_heading", "label": "Überschrift", "default": "Was misst ein Test zum biologischen Alter?" },
    { "type": "textarea", "id": "answer_subheading", "label": "Subline", "default": "Der Begriff bezeichnet mehrere unterschiedliche Messverfahren." },
    { "type": "text", "id": "answer_label", "label": "Antwort-Label", "default": "Direkte Antwort" },
    { "type": "textarea", "id": "direct_answer", "label": "Direkte Antwort", "default": "Ein Test zum biologischen Alter schätzt, wie stark ausgewählte biologische Merkmale von typischen Altersmustern abweichen. Je nach Verfahren werden DNA-Methylierung, Blutmarker, Glykane oder Proteine ausgewertet. Die Ergebnisse verschiedener Methoden sind nicht direkt austauschbar." },
    { "type": "textarea", "id": "answer_note", "label": "Aussagegrenze", "default": "Kein einzelner Wert beschreibt den gesamten Körper und kein Alterstest ersetzt eine medizinische Diagnose." },

    { "type": "header", "content": "Messmethoden" },
    { "type": "text", "id": "methods_kicker", "label": "Kicker", "default": "Methoden" },
    { "type": "textarea", "id": "methods_heading", "label": "Überschrift", "default": "Vier Ansätze, vier unterschiedliche Antworten" },
    { "type": "textarea", "id": "methods_subheading", "label": "Subline", "default": "Vergleiche zuerst die Messmethode, erst danach einzelne Angebote." },

    { "type": "header", "content": "Auswahlkriterien" },
    { "type": "text", "id": "criteria_kicker", "label": "Kicker", "default": "Auswahl" },
    { "type": "textarea", "id": "criteria_heading", "label": "Überschrift", "default": "Woran du einen transparenten Test erkennst" },
    { "type": "textarea", "id": "criteria_subheading", "label": "Subline", "default": "Ein verständlicher Bericht ist wichtiger als eine möglichst große Zahl von Markern." },

    { "type": "header", "content": "LIFETIME Einordnung" },
    { "type": "text", "id": "fit_kicker", "label": "Kicker", "default": "Einordnung" },
    { "type": "textarea", "id": "fit_heading", "label": "Überschrift", "default": "Wann der LIFETIME AGE & DNA-Test passt" },
    { "type": "textarea", "id": "fit_subheading", "label": "Subline", "default": "Wenn du genetische Anlagen und eine epigenetische Standortbestimmung gemeinsam betrachten möchtest." },
    { "type": "richtext", "id": "fit_body", "label": "Text", "default": "<p>LIFETIME verbindet eine genetische Analyse mit einer epigenetischen Auswertung aus einer Speichelprobe für zuhause. Du erhältst DNA-Ergebnisse in 23 Kategorien sowie sechs epigenetische Bereiche in der App.</p><p>Der Test dient der persönlichen Standortbestimmung. Er stellt keine medizinische Diagnose und ersetzt keine ärztliche Beratung.</p>" },
    { "type": "textarea", "id": "disclosure", "label": "Transparenzhinweis", "default": "Transparenz: Diese Ratgeberseite wird von LIFETIME Health veröffentlicht. LIFETIME verkauft den hier beschriebenen AGE & DNA-Test." },
    { "type": "text", "id": "primary_cta_label", "label": "Primärer CTA", "default": "Passt der Test zu mir?" },
    { "type": "url", "id": "primary_cta_url", "label": "Primärer CTA Link" },
    { "type": "text", "id": "secondary_cta_label", "label": "Sekundärer Link", "default": "AGE & DNA-Test ansehen" },
    { "type": "url", "id": "secondary_cta_url", "label": "Sekundärer Link URL" },

    { "type": "header", "content": "Quellen" },
    { "type": "text", "id": "sources_heading", "label": "Überschrift", "default": "Primärquellen zur Einordnung" },
    { "type": "textarea", "id": "sources_intro", "label": "Einleitung", "default": "Die Quellen erklären die wissenschaftlichen Messansätze. Sie sind keine produktspezifische Validierung des LIFETIME-Tests." },
    { "type": "text", "id": "review_date", "label": "Stand", "default": "Stand: 30.07.2026" }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Messmethode",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "DNA-Methylierung" },
        { "type": "text", "id": "sample", "label": "Typische Probe", "default": "Typische Probe: Blut oder Speichel" },
        { "type": "textarea", "id": "measurement", "label": "Auswertung", "default": "Methylierungsmuster an ausgewählten Stellen der DNA. Ein Algorithmus schätzt daraus ein Alter oder ein Alterungstempo." },
        { "type": "textarea", "id": "limitation", "label": "Grenze", "default": "Ergebnis und Bedeutung hängen von Uhr, Referenzdaten, Gewebe und Laborprozess ab." }
      ]
    },
    {
      "type": "criterion",
      "name": "Auswahlkriterium",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Methode klar benannt" },
        { "type": "textarea", "id": "text", "label": "Erklärung", "default": "Der Anbieter erklärt, welche Probe und welches Messverfahren verwendet werden." }
      ]
    },
    {
      "type": "source",
      "name": "Quelle",
      "settings": [
        { "type": "text", "id": "citation", "label": "Kurzzitat", "default": "Horvath S. Genome Biology. 2013." },
        { "type": "url", "id": "url", "label": "Direkter Quellenlink" },
        { "type": "textarea", "id": "supports", "label": "Unterstützte Aussage", "default": "Grundlage epigenetischer Uhren auf Basis der DNA-Methylierung." }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "LT Age Test Guide",
      "blocks": [
        { "type": "method" },
        { "type": "method" },
        { "type": "method" },
        { "type": "method" },
        { "type": "criterion" },
        { "type": "criterion" },
        { "type": "criterion" },
        { "type": "criterion" },
        { "type": "source" },
        { "type": "source" },
        { "type": "source" }
      ]
    }
  ]
}
{% endschema %}
