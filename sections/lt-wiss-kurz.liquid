{% comment %}
  LIFETIME — Wissenschaft · Die Messlatte
  ─────────────────────────────────────────
  Vier Pruefkriterien als typografische Liste: Titel plus kurzer Absatz je
  Kriterium, getrennt durch Haarlinien statt Karten. Die fruehere card-info-
  Variante (Icon in getoenter Kachel) war das einzige Karten-Icon-Raster der
  Seite und ist entfallen; die ungenutzte Dublette lt-wiss-messlatte.liquid
  wurde dabei geloescht. Die Section bleibt bewusst rubriklos und liest wie
  die Statement-Section als Zwischenstueck zwischen den Kapiteln.

  §12 Build Spec:
  - Surface:         Paper B, warm
  - Dominant:        die 2×2-Kriterienliste
  - Heading size:    --text-h2, wie die Content-Sections auf /pages/science
  - Content pattern: typografische Haarlinien-Liste links, Microarray rechts
  - CTA:             keine
  - Entfernt:        Karten, Icon-Kacheln und rund ein Drittel der Copy
  - Quality move:    der Abbinder steht ueber einer Haarlinie in Dossierbreite
                     und macht die Liste zum Massstab, an dem sich auch der
                     eigene Test messen lassen muss
{% endcomment %}

{%- liquid
  assign wk_anchor = section.settings.anchor_id
  if wk_anchor == blank
    assign wk_anchor = 'section-' | append: section.id
  endif

  assign wk_text = section.settings.color_text | default: '#26251e'
  assign wk_pad_t = section.settings.padding_top | default: 80
  assign wk_pad_b = section.settings.padding_bottom | default: 80
  assign wk_pad_t_m = wk_pad_t | times: 0.8 | round
  assign wk_pad_b_m = wk_pad_b | times: 0.8 | round
-%}

{{ 'lt-wissenschaft.css' | asset_url | stylesheet_tag }}

{% style %}
  #{{ wk_anchor }} {
    --ltw-bg:       {{ section.settings.color_bg | default: '#ffffff' }};
    --ltw-text:     {{ wk_text }};
    --ltw-text-sec: {{ wk_text | color_modify: 'alpha', 0.72 }};
    --ltw-text-ter: {{ wk_text | color_modify: 'alpha', 0.66 }};
    --ltw-hairline: {{ wk_text | color_modify: 'alpha', 0.12 }};
    --crs-text:     {{ wk_text }};
    --crs-text-sec: {{ wk_text | color_modify: 'alpha', 0.72 }};
    --crs-text-ter: {{ wk_text | color_modify: 'alpha', 0.66 }};
    padding-top:    {{ wk_pad_t }}px;
    padding-bottom: {{ wk_pad_b }}px;
    scroll-margin-top: 96px;
  }

  @media screen and (max-width: 767px) {
    #{{ wk_anchor }} {
      padding-top:    {{ wk_pad_t_m }}px;
      padding-bottom: {{ wk_pad_b_m }}px;
    }
  }
{% endstyle %}

<section id="{{ wk_anchor }}" class="ltw ltw-kurz">
  <div class="ltw__container">
    {% render 'section-heading-crs',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'left',
      heading_tag: 'h2',
      headline_md: true,
      extra_class: 'ltw-heading ltw-kurz__heading'
    %}

    <div class="ltw-kurz__grid{% if section.settings.image == blank %} ltw-kurz__grid--single{% endif %}">
      <div class="ltw-kurz__copy">
        {%- if section.blocks.size > 0 -%}
          <ul class="ltw-crit" role="list">
            {%- for block in section.blocks -%}
              <li class="ltw-crit__item" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="ltw-crit__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="ltw-crit__body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <figure class="ltw-kurz__figure">
          {{ section.settings.image
             | image_url: width: 1086
             | image_tag:
               loading: 'lazy',
               widths: '460, 700, 1086',
               sizes: '(min-width: 961px) 34vw, 90vw',
               alt: section.settings.image_alt }}
          {%- if section.settings.caption != blank -%}
            <figcaption class="ltw-caption">{{ section.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>

    {%- if section.settings.closer != blank -%}
      <div class="ltw-kurz__closer">
        <p>{{ section.settings.closer | escape }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wissenschaft Messlatte",
  "tag": "section",
  "class": "lt-wiss-kurz",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anker-ID", "info": "Ohne Wert bleibt die automatische ID." },

    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Die Messlatte" },
    { "type": "textarea", "id": "subheading", "label": "Subline", "info": "Gleiche Größe wie die Überschrift, nur zurückgenommen." },
    { "type": "textarea", "id": "closer", "label": "Abbinder", "info": "Steht über einer Haarlinie am Ende der Section.", "default": "Diese vier Punkte kannst du an jeden Alterstest anlegen, auch an unseren." },

    { "type": "header", "content": "Bild (rechte Spalte)" },
    { "type": "image_picker", "id": "image", "label": "Bild", "info": "Wird auf 4:5 beschnitten. Ohne Bild läuft die Section einspaltig." },
    { "type": "text", "id": "image_alt", "label": "Alt-Text", "default": "Microarray-Chip unter blauem Licht" },
    { "type": "textarea", "id": "caption", "label": "Bildunterschrift (optional)" },

    { "type": "header", "content": "Farben und Abstände" },
    { "type": "color", "id": "color_bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Kriterium",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Wiederholbarkeit" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Kurzer erklärender Absatz." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Wissenschaft Messlatte" }]
}
{% endschema %}
