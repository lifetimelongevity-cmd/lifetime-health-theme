{% comment %}
  LIFETIME — Wissenschaft · Kapitel 2 (Das Wichtigste in Kürze)
  ─────────────────────────────────────────────────────────────
  Vier Kernaussagen, die die ganze Seite zusammenfassen, bevor die Kapitel sie
  auffalten. Bild links, Text rechts.

  Abweichung vom Preview (docs/science-preview.html §2, BJ 27.08.): dort stand
  der Text als getoente Karte ueber die volle Breite und lief dadurch zu hoch
  und zu breit. Zwei Spalten halbieren die Bauhoehe, und die schmalere Spalte
  nimmt der Liste optisch das Gewicht. Die Karte faellt damit weg: auf der
  weissen Flaeche, zwischen zwei Paper-A-Kapiteln, ist die Section ohnehin
  schon abgesetzt, ein zweiter Rahmen darin waere doppelt gemoppelt und
  widerspraeche der Haarlinien-Regel aus DESIGN.md.

  §12 Build Spec:
  - Surface:         Weiss (Blattwechsel nach dem Deckblatt)
  - Dominant:        das Bild, die Liste ist die Beschriftung dazu
  - Heading size:    --text-section (der Zusammenfassung steht keine
                     Kapitel-Headline zu, die haben die Kapitel selbst)
  - Content pattern: Zweispalter 0.85/1.15 auf 60rem, Bild 4:5, Slate-Punkte
  - CTA:             keine
  - Entfernt:        Rubrik, Kicker und die getoente Karte
  - Quality move:    Punkte in Slate statt Teal, damit Teal Messfarbe bleibt
{% endcomment %}

{%- liquid
  assign wk_anchor = section.settings.anchor_id
  if wk_anchor == blank
    assign wk_anchor = 'section-' | append: section.id
  endif

  assign wk_text = section.settings.color_text | default: '#26251e'
  assign wk_pad_t = section.settings.padding_top | default: 80
  assign wk_pad_b = section.settings.padding_bottom | default: 80
  assign wk_pad_t_m = wk_pad_t | times: 0.8 | round
  assign wk_pad_b_m = wk_pad_b | times: 0.8 | round
-%}

{{ 'lt-wissenschaft.css' | asset_url | stylesheet_tag }}

{% style %}
  #{{ wk_anchor }} {
    --ltw-bg:       {{ section.settings.color_bg | default: '#ffffff' }};
    --ltw-text:     {{ wk_text }};
    --ltw-text-sec: {{ wk_text | color_modify: 'alpha', 0.72 }};
    --ltw-text-ter: {{ wk_text | color_modify: 'alpha', 0.66 }};
    --ltw-hairline: {{ wk_text | color_modify: 'alpha', 0.12 }};
    --crs-text:     {{ wk_text }};
    --crs-text-sec: {{ wk_text | color_modify: 'alpha', 0.72 }};
    --crs-text-ter: {{ wk_text | color_modify: 'alpha', 0.66 }};
    padding-top:    {{ wk_pad_t }}px;
    padding-bottom: {{ wk_pad_b }}px;
    scroll-margin-top: 96px;
  }

  @media screen and (max-width: 767px) {
    #{{ wk_anchor }} {
      padding-top:    {{ wk_pad_t_m }}px;
      padding-bottom: {{ wk_pad_b_m }}px;
    }
  }
{% endstyle %}

<section id="{{ wk_anchor }}" class="ltw ltw-kurz">
  <div class="ltw__container">
    <div class="ltw-kurz__grid{% if section.settings.image == blank %} ltw-kurz__grid--single{% endif %}">
      {%- if section.settings.image != blank -%}
        <figure class="ltw-kurz__figure">
          {{ section.settings.image
             | image_url: width: 1086
             | image_tag:
               loading: 'lazy',
               widths: '460, 700, 1086',
               sizes: '(min-width: 961px) 40vw, 90vw',
               alt: section.settings.image_alt }}
          {%- if section.settings.caption != blank -%}
            <figcaption class="ltw-caption">{{ section.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}

      <div class="ltw-kurz__copy">
        {% render 'section-heading-crs',
          heading: section.settings.heading,
          align: 'left',
          heading_tag: 'h2',
          extra_class: 'ltw-heading'
        %}

        {%- if section.blocks.size > 0 -%}
          <ul class="ltw-tldr__list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wissenschaft Kürze",
  "tag": "section",
  "class": "lt-wiss-kurz",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anker-ID", "info": "Ohne Wert bleibt die automatische ID." },

    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Das Wichtigste in Kürze" },

    { "type": "header", "content": "Bild (linke Spalte)" },
    { "type": "image_picker", "id": "image", "label": "Bild", "info": "Wird auf 4:5 beschnitten. Ohne Bild läuft die Zusammenfassung einspaltig." },
    { "type": "text", "id": "image_alt", "label": "Alt-Text", "default": "Microarray-Chip unter blauem Licht" },
    { "type": "textarea", "id": "caption", "label": "Bildunterschrift (optional)" },

    { "type": "header", "content": "Farben und Abstände" },
    { "type": "color", "id": "color_bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Kernaussage",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Kurze Kernaussage in einem Satz." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Wissenschaft Kürze" }]
}
{% endschema %}
