{% comment %}
  lt-hp-problem-v2 — Der blinde Fleck
  Zwei Listen ueber dieselbe Person: was der Check-up zeigt (links, flach und
  gedaempft) und was er nicht zeigt (rechts, als Karte). Die Zeilen sind
  bewusst nicht 1:1 gepaart, deshalb keine Nummerierung.

  Die rechte Spalte traegt beide Produktebenen und nennt echte Reportinhalte
  statt Kategorien: Zeile 1 und 2 Epigenetik (biologisches Alter, Koerperalter
  mit Hoer- und Gedaechtnisalter), Zeile 3 und 4 Genetik (Koffein & Fokus,
  Vitamin D). Belegt in docs/age-dna-product-fact-sheet.md und
  ../lifetime-produktdetails/produktdetails-age-dna-test.md.

  Bewusst NICHT verwendet, obwohl im Reportumfang enthalten: Adipositas-Risiko,
  Typ-2-Diabetes, Makuladegeneration, Katarakt, Glaukom, Muskelschwund. Das sind
  praediktive Krankheitsaussagen und damit GenDG-Fläche.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if section.settings.color_bg != blank -%}
    background: {{ section.settings.color_bg }};
    {%- endif -%}
    {%- if section.settings.color_text != blank -%}
    color: {{ section.settings.color_text }};
    --prob2-text: {{ section.settings.color_text }};
    --prob2-text-muted: {{ section.settings.color_text | color_modify: 'alpha', 0.66 }};
    --prob2-divider: {{ section.settings.color_text | color_modify: 'alpha', 0.12 }};
    {%- endif -%}
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }
{% endstyle %}

<section id="shopify-section-{{ section.id }}" class="prob2">
  <div class="prob2__outer">

    <div class="prob2__header">
      {%- if section.settings.kicker != blank -%}
        <p class="prob2__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <div class="prob2__title-block">
        {%- if section.settings.headline != blank -%}
          <h2 class="prob2__title-head">{{ section.settings.headline | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheadline != blank -%}
          <p class="prob2__title-sub">{{ section.settings.subheadline | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- assign image_ratio = section.settings.image_ratio | default: '4:5' -%}
      {%- assign image_ratio_class = 'prob2__pane-image--ratio-' | append: image_ratio | replace: ':', 'x' -%}

      <div class="prob2__panes">

        {%- comment -%} LEFT COLUMN: Krankheitsmedizin Pane + optional Image {%- endcomment -%}
        <div class="prob2__col">
          <div class="prob2__pane prob2__pane--system">
            <div class="prob2__pane-hd">
              <span class="prob2__pane-name">{{ section.settings.col_system_label | escape }}</span>
              {%- if section.settings.system_tag != blank -%}
                <span class="prob2__pane-tag">{{ section.settings.system_tag | escape }}</span>
              {%- endif -%}
            </div>
            <ul class="prob2__pane-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'comparison_row' -%}
                  <li class="prob2__pane-item" {{ block.shopify_attributes }}>
                    <span class="prob2__item-line">{{ block.settings.system_text | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          {%- if section.settings.image_system != blank -%}
            <div class="prob2__pane-image {{ image_ratio_class }}">
              {{
                section.settings.image_system
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image_system_alt | default: section.settings.col_system_label
              }}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} RIGHT COLUMN: Longevity Pane + optional Image {%- endcomment -%}
        <div class="prob2__col">
          <div class="prob2__pane prob2__pane--longevity">
            <div class="prob2__pane-hd">
              <span class="prob2__pane-name">{{ section.settings.col_longevity_label | escape }}</span>
              {%- if section.settings.longevity_tag != blank -%}
                <span class="prob2__pane-tag">{{ section.settings.longevity_tag | escape }}</span>
              {%- endif -%}
            </div>
            <ul class="prob2__pane-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'comparison_row' -%}
                  <li class="prob2__pane-item" {{ block.shopify_attributes }}>
                    <span class="prob2__item-line">{{ block.settings.longevity_text | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          {%- if section.settings.image_longevity != blank -%}
            <div class="prob2__pane-image {{ image_ratio_class }}">
              {{
                section.settings.image_longevity
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image_longevity_alt | default: section.settings.col_longevity_label
              }}
            </div>
          {%- endif -%}
        </div>

      </div>
    {%- endif -%}

    {%- if section.settings.closing_note != blank -%}
      <p class="prob2__closing">{{ section.settings.closing_note | escape }}</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.prob2__outer {
  max-width: 840px;
  margin: 0 auto;
  padding: 0 var(--space-5);
}

.prob2__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-4);
  margin-bottom: var(--space-7);
}

.prob2__kicker {
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--text-micro);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--prob2-text-muted, var(--color-text-muted));
  margin: 0;
}

/* Lesemass in rem, nicht in ch: in Lato ist 1ch deutlich schmaler als ein
   mittleres Zeichen (Faktor ~1,29), 32ch brachen die Subline mitten im Satz. */
.prob2__title-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 28rem;
  text-wrap: balance;
}

.prob2__title-head,
.prob2__title-sub {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: var(--text-section);
  line-height: 1.15;
  letter-spacing: -0.015em;
  color: var(--prob2-text, var(--color-text-primary));
  margin: 0;
}

.prob2__title-sub {
  opacity: 0.72;
}

/* Panes */
.prob2__panes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-5);
}

/* Each column wraps a pane + optional image, so on mobile pane and its
   image stay paired when the grid collapses to one column. */
.prob2__col {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.prob2__pane {
  padding: var(--space-6);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

/* Pane image (atmospheric closing per side) */
.prob2__pane-image {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 4/5;
  background: var(--color-surface-secondary, #f2f1ed);
}

.prob2__pane-image--ratio-1x1 { aspect-ratio: 1/1; }
.prob2__pane-image--ratio-4x5 { aspect-ratio: 4/5; }
.prob2__pane-image--ratio-3x2 { aspect-ratio: 3/2; }

.prob2__pane-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Links tritt zurueck: kein Rahmen, keine Flaeche, buendig zum Textrand.
   Rechts ist die Karte. Der frueher genutzte Fuellton allein trug nicht,
   #F6F4F1 auf #FFFFFF sind unter 15 Werte pro Kanal und damit unsichtbar. */
.prob2__pane--system {
  background: transparent;
  border: 0;
  padding-left: 0;
  padding-right: var(--space-5);
  color: var(--color-text-muted);
}

.prob2__pane--longevity {
  background: var(--color-surface-secondary);
  border: 1px solid var(--color-border-default);
  box-shadow: var(--shadow-sm);
  color: var(--prob2-text, var(--color-text-primary));
}

.prob2__pane-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--prob2-divider, var(--color-border-default));
}

.prob2__pane-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: var(--text-micro);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.prob2__pane--system .prob2__pane-name {
  color: var(--color-text-muted);
}

.prob2__pane--longevity .prob2__pane-name {
  color: var(--prob2-text, var(--color-text-primary));
}

.prob2__pane-tag {
  font-family: var(--font-heading);
  font-weight: 500;
  font-size: var(--text-micro);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0.8;
}

.prob2__pane--system .prob2__pane-tag {
  color: var(--color-text-muted);
}

/* Kein Teal als Textfarbe, siehe .cursor/rules/section-heading-stack.mdc. */
.prob2__pane--longevity .prob2__pane-tag {
  color: var(--prob2-text, var(--color-text-primary));
  opacity: 1;
}

.prob2__pane-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Haarlinien statt Nummern: geben den Zeilen Rhythmus, ohne eine
   Zeile-fuer-Zeile-Entsprechung zwischen den Spalten zu behaupten. */
.prob2__pane-item {
  padding: 14px 0;
}

.prob2__pane-item:first-child {
  padding-top: 0;
}

.prob2__pane-item:last-child {
  padding-bottom: 0;
}

.prob2__pane-item + .prob2__pane-item {
  border-top: 1px solid var(--prob2-divider, var(--color-border-default));
}

.prob2__item-line {
  display: block;
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: var(--text-body);
  line-height: 1.3;
  letter-spacing: -0.005em;
}

.prob2__pane--system .prob2__item-line {
  color: var(--color-text-muted);
}

.prob2__pane--longevity .prob2__item-line {
  color: var(--prob2-text, var(--color-text-primary));
}

.prob2__closing {
  margin: var(--space-6) auto 0;
  max-width: 52ch;
  text-align: center;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-relaxed);
  color: var(--prob2-text-muted, var(--color-text-muted));
}

@media screen and (max-width: 820px) {
  .prob2__outer {
    padding: 0 var(--space-4);
  }

  .prob2__header {
    margin-bottom: var(--space-6);
  }

  .prob2__panes {
    grid-template-columns: 1fr;
  }

  /* Einspaltig gibt es keine Nachbarspalte mehr, gegen die abgesetzt wird.
     Ohne das enden die Linien links kuerzer als die Karte darunter. */
  .prob2__pane--system {
    padding-right: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "HP Problem v2",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 200, "step": 8, "default": 80, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 200, "step": 8, "default": 80, "unit": "px" },

    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_bg", "label": "Hintergrundfarbe", "default": "#f7f7f4" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },

    { "type": "header", "content": "Kopf" },
    { "type": "text", "id": "kicker", "label": "Kicker", "info": "Nur setzen, wenn er Information trägt, die die Headline nicht hat." },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Alles im Normbereich." },
    { "type": "textarea", "id": "subheadline", "label": "Subheadline", "default": "Nur nicht, wie schnell du alterst und warum." },

    { "type": "header", "content": "Panes" },
    { "type": "text", "id": "col_system_label", "label": "Linke Spalte – Name", "default": "Was dein Check-up zeigt" },
    { "type": "text", "id": "system_tag", "label": "Linke Spalte – Tag" },
    { "type": "text", "id": "col_longevity_label", "label": "Rechte Spalte – Name", "default": "Was er nicht zeigt" },
    { "type": "text", "id": "longevity_tag", "label": "Rechte Spalte – Tag" },

    { "type": "header", "content": "Bilder unter den Panes (optional)" },
    { "type": "paragraph", "content": "Atmosphärische Bilder, die unter dem jeweiligen Pane erscheinen. Wenn keines hochgeladen ist, rendert die Section ohne Bild. Empfehlung: ähnliche Lichtsetzung und Tonalität für beide Bilder, damit die Section visuell zusammenhängt." },
    { "type": "image_picker", "id": "image_system", "label": "Bild links (Krankheitsmedizin)" },
    { "type": "text", "id": "image_system_alt", "label": "Alt-Text Bild links", "info": "Für Barrierefreiheit. Beschreibt, was im Bild zu sehen ist." },
    { "type": "image_picker", "id": "image_longevity", "label": "Bild rechts (Longevity)" },
    { "type": "text", "id": "image_longevity_alt", "label": "Alt-Text Bild rechts" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildverhältnis",
      "default": "4:5",
      "options": [
        { "value": "1:1", "label": "1:1 quadratisch" },
        { "value": "4:5", "label": "4:5 portrait (empfohlen)" },
        { "value": "3:2", "label": "3:2 landscape" }
      ]
    },

    { "type": "header", "content": "Schluss-Note" },
    { "type": "textarea", "id": "closing_note", "label": "Note", "default": "Ergänzt deinen Check-up. Ersetzt ihn nicht." }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Vergleichs-Zeile",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "system_text", "label": "Links (bekannt)", "default": "Blutdruck, Cholesterin, Blutzucker" },
        { "type": "text", "id": "longevity_text", "label": "Rechts (offen)", "default": "Ob dein Körper älter ist als dein Pass", "info": "Konkrete Reportinhalte nennen, keine Kategorien. Keine Krankheitsbilder, siehe Kommentar oben im File." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Der blinde Fleck",
      "blocks": [
        { "type": "comparison_row", "settings": { "system_text": "Blutdruck, Cholesterin, Blutzucker", "longevity_text": "Ob dein Körper älter ist als dein Pass" } },
        { "type": "comparison_row", "settings": { "system_text": "Ob heute etwas aus dem Rahmen fällt", "longevity_text": "Wie alt Gehör und Gedächtnis sind" } },
        { "type": "comparison_row", "settings": { "system_text": "Wie du dich gerade fühlst", "longevity_text": "Ob Kaffee dich wach oder nervös macht" } },
        { "type": "comparison_row", "settings": { "system_text": "Was im Schnitt für alle gilt", "longevity_text": "Ob du mehr Vitamin D brauchst" } }
      ]
    }
  ]
}
{% endschema %}
