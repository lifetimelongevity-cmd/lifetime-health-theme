{% comment %}
  LIFETIME — Science Scope
  ───────────────────────
  Abschnitt „Was du bekommst" auf der Seite Wissenschaft.
  Briefing: `docs/briefing-science-hub.md` §Struktur 4.

  Warum eine eigene Section und kein `lt-stat-callout`:
  Das Stat-Callout ist laut eigener Build-Spec fest auf die dunkle Fläche
  gesetzt und bewusst ohne CTA gebaut. Hier braucht es beides andersherum,
  hell und mit Link auf die Reports-Seite. Und die Zahl allein beantwortet
  „was du bekommst" nicht, deshalb machen die Beispiel-Reports sie konkret.
  Ein Bento wäre laut Briefing Recycling, kein Design.

  §12 Build Spec:
  - Surface:          hell (#f2f1ed), Rhythmus-Gegenstück zum Hero
  - Dominant element: die Zahl (--text-stat, auf Desktop --text-display+)
  - Content pattern:  Zahl + Beispielliste + ein CTA
  - Removed:          Kacheln, Icons, Trennlinien
{% endcomment %}

{%- liquid
  assign scope_anchor = section.settings.anchor_id
  if scope_anchor == blank
    assign scope_anchor = 'section-' | append: section.id
  endif

  assign scope_has_cta = false
  if section.settings.cta_label != blank
    assign scope_has_cta = true
  endif
-%}

{% style %}
  #{{ scope_anchor }} {
    --scp-bg:    {{ section.settings.color_bg | default: '#f2f1ed' }};
    --scp-text:  {{ section.settings.color_text | default: '#26251e' }};
    --scp-chip:  {{ section.settings.color_chip_bg | default: '#f7f7f4' }};
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    scroll-margin-top: 96px;
  }
{% endstyle %}

<section id="{{ scope_anchor }}" class="scp">
  <div class="scp__container">
    {% render 'section-heading-crs',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      kicker: section.settings.kicker,
      align: 'left',
      headline_md: true,
      extra_class: 'scp__intro'
    %}

    <div class="scp__body">
      <div class="scp__figure">
        <p class="scp__number">{{ section.settings.number | escape }}</p>
        {%- if section.settings.number_label != blank -%}
          <p class="scp__number-label">{{ section.settings.number_label | escape }}</p>
        {%- endif -%}
      </div>

      <div class="scp__detail">
        {%- liquid
          assign scp_has_epi = false
          assign scp_has_dna = false
          for block in section.blocks
            if block.settings.label == blank
              continue
            endif
            if block.settings.gruppe == 'epi'
              assign scp_has_epi = true
            else
              assign scp_has_dna = true
            endif
          endfor
        -%}

        {%- if scp_has_dna -%}
          <div class="scp__group">
            {%- if section.settings.dna_label != blank -%}
              <p class="scp__group-label">{{ section.settings.dna_label | escape }}</p>
            {%- endif -%}
            <ul class="scp__examples" role="list">
              {%- for block in section.blocks -%}
                {%- if block.settings.label != blank and block.settings.gruppe != 'epi' -%}
                  <li class="scp__example" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
              {%- if section.settings.more_label != blank and section.settings.more_url != blank -%}
                <li class="scp__example-more-item">
                  <a class="scp__example scp__example--more" href="{{ section.settings.more_url | escape }}">{{ section.settings.more_label | escape }}</a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if scp_has_epi -%}
          <div class="scp__group">
            {%- if section.settings.epi_label != blank -%}
              <p class="scp__group-label">{{ section.settings.epi_label | escape }}</p>
            {%- endif -%}
            <ul class="scp__examples" role="list">
              {%- for block in section.blocks -%}
                {%- if block.settings.label != blank and block.settings.gruppe == 'epi' -%}
                  <li class="scp__example scp__example--epi" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="scp__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}

        {%- if scope_has_cta -%}
          <div class="scp__actions">
            <a
              href="{{ section.settings.cta_url | default: '#' | escape }}"
              class="button button--solid button--icon"
            >
              <span aria-hidden="true" class="button__icon">
                {%- render 'theme-symbols', icon: 'arrow-right' -%}
              </span>
              <span>{{ section.settings.cta_label | escape }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* ================================================================
   lt-science-scope — „Was du bekommst"
   §3 Tokens, §6 Typografie. Die Zahl ist das schwerste Element.
   ================================================================ */

.scp {
  background: var(--scp-bg, #f2f1ed);
  color: var(--scp-text, #26251e);
  --crs-text: var(--scp-text);
}

.scp__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-5);
}

.scp__intro {
  margin-bottom: var(--space-7);
}

.scp__intro .crs-heading-stack__subtitle {
  max-width: 52ch;
}

.scp__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  align-items: start;
}

@media screen and (min-width: 900px) {
  .scp__body {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8);
  }
}

/* — Die Zahl — */
.scp__figure {
  min-width: 0;
}

.scp__number {
  margin: 0;
  font-family: var(--font-heading);
  font-size: var(--text-stat);
  line-height: var(--leading-stat);
  font-weight: var(--weight-bold);
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

@media screen and (min-width: 900px) {
  .scp__number {
    font-size: 88px;
  }
}

.scp__number-label {
  margin: var(--space-3) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  opacity: 0.72;
  max-width: 24ch;
}

/* — Beispiele — */
.scp__detail {
  min-width: 0;
  display: grid;
  gap: var(--space-5);
}

.scp__group-label {
  margin: 0 0 var(--space-3);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-body);
  opacity: 0.72;
}

.scp__examples {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.scp__example {
  background: var(--scp-chip, #f7f7f4);
  border-radius: var(--radius-full);
  padding: var(--space-2) var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-body);
}

/* Epigenetik-Chips: Benefit-Tint statt Neutralfläche, damit die zwei
   Messebenen als zwei Familien lesbar sind und die Epigenetik farblich
   an der Teal-Kurve des Kapitels hängt. */
.scp__example--epi {
  background: var(--color-surface-benefit);
}

/* „+ N weitere": ehrlicher Stichproben-Hinweis mit Tür zur Kategorienseite.
   Als einziger Chip ein Link, deshalb als einziger mit Kontur statt Fläche. */
.scp__example-more-item {
  display: contents;
}

.scp__example--more {
  background: transparent;
  border: 1px solid color-mix(in srgb, var(--scp-text) 24%, transparent);
  padding: calc(var(--space-2) - 1px) calc(var(--space-4) - 1px);
  color: inherit;
  text-decoration: none;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}

.scp__example--more:hover {
  border-color: color-mix(in srgb, var(--scp-text) 48%, transparent);
  background: var(--scp-chip, #f7f7f4);
}

.scp__example--more:focus-visible {
  outline: 2px solid var(--color-dark);
  outline-offset: 2px;
}

/* ── Einlauf-Moment ────────────────────────────────────────────
   Gleiche Materiallogik wie der Draw-on-view der Science-Split-Charts:
   die Evidenz kommt einmal an, wenn sie ins Bild kommt. Die Zahl zählt
   hoch (JS), die Report-Chips füllen sich gestaffelt. Default (ohne JS,
   bei Reduced Motion): alles statisch sichtbar. */
.scp-ready .scp__example {
  opacity: 0;
  transform: translateY(8px);
}

.scp-ready.scp-in .scp__example {
  opacity: 1;
  transform: none;
  transition:
    opacity 0.35s ease-out var(--scp-d, 0s),
    transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) var(--scp-d, 0s);
}

.scp__note {
  margin: var(--space-5) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body);
  line-height: var(--leading-relaxed);
  opacity: 0.7;
  max-width: 56ch;
}

.scp__actions {
  margin-top: var(--space-6);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

/* Siehe `lt-science-proof-hero`: die globalen Button-Modifier hängen an den
   Combine-Farbschema-Variablen, die eine LT-Section nicht setzt. */
.scp__actions .button {
  margin: 0;
}

.scp__actions .button--solid {
  background: var(--color-dark);
  border-color: var(--color-dark);
  color: var(--color-white);
}

.scp__actions .button--solid span {
  color: var(--color-white);
}

.scp__actions .button--solid .button__icon svg path {
  fill: var(--color-white);
}

@media screen and (max-width: 899px) {
  .scp__container {
    padding: 0 var(--space-4);
  }
}
{% endstylesheet %}

{% javascript %}
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    var bodies = document.querySelectorAll('.scp__body');
    if (!bodies.length) return;

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var body = entry.target;
          io.unobserve(body);
          body.classList.add('scp-in');
          var num = body.querySelector('[data-scp-count]');
          if (num) {
            var target = parseInt(num.getAttribute('data-scp-count'), 10);
            var t0 = null;
            var step = function (ts) {
              if (t0 === null) t0 = ts;
              var p = Math.min((ts - t0) / 900, 1);
              var eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
              num.textContent = Math.round(target * eased);
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        });
      },
      { threshold: 0.4 }
    );

    bodies.forEach(function (body) {
      body.querySelectorAll('.scp__example').forEach(function (chip, i) {
        chip.style.setProperty('--scp-d', i * 45 + 'ms');
      });
      var numEl = body.querySelector('.scp__number');
      if (numEl) {
        var val = numEl.textContent.trim();
        if (/^\d+$/.test(val)) {
          numEl.innerHTML =
            '<span aria-hidden="true" data-scp-count="' + val + '">' + val + '</span>' +
            '<span class="visually-hidden">' + val + '</span>';
        }
      }
      body.classList.add('scp-ready');
      io.observe(body);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Science Scope",
  "tag": "section",
  "class": "lt-science-scope",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID",
      "info": "Ohne Wert bleibt die automatische ID."
    },
    { "type": "header", "content": "Überschrift" },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Was du bekommst"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "Der Test endet nicht mit einer Zahl."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subline",
      "info": "Ein kurzer Satz."
    },
    { "type": "header", "content": "Zahl" },
    {
      "type": "text",
      "id": "number",
      "label": "Zahl",
      "default": "23"
    },
    {
      "type": "text",
      "id": "number_label",
      "label": "Bezeichnung unter der Zahl",
      "default": "DNA-Kategorien"
    },
    { "type": "header", "content": "Gruppen-Beschriftung" },
    {
      "type": "text",
      "id": "dna_label",
      "label": "Beschriftung DNA-Reihe",
      "default": "Aus den 23 Kategorien, zum Beispiel:",
      "info": "Steht über den Chips der Gruppe „DNA\"."
    },
    {
      "type": "text",
      "id": "epi_label",
      "label": "Beschriftung Epigenetik-Reihe",
      "default": "Dazu sechs epigenetische Bereiche:",
      "info": "Steht über den Chips der Gruppe „Epigenetik\"."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Weitere-Chip (DNA-Reihe)",
      "info": "Optionaler Link-Chip am Ende der DNA-Reihe, z. B. „+ 19 weitere\". Erscheint nur mit Link."
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "Weitere-Chip: Link"
    },
    { "type": "header", "content": "Text und Button" },
    {
      "type": "textarea",
      "id": "note",
      "label": "Erläuterung",
      "info": "Optional, ein Satz."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Alle Kategorien ansehen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button: Link"
    },
    { "type": "header", "content": "Farben und Abstände" },
    { "type": "color", "id": "color_bg", "label": "Hintergrund", "default": "#f2f1ed" },
    { "type": "color", "id": "color_chip_bg", "label": "Fläche Beispiele", "default": "#f7f7f4" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "default": 80 }
  ],
  "blocks": [
    {
      "type": "example",
      "name": "Beispiel-Report",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name des Reports",
          "default": "Körperalter"
        },
        {
          "type": "select",
          "id": "gruppe",
          "label": "Gruppe",
          "options": [
            { "value": "dna", "label": "DNA" },
            { "value": "epi", "label": "Epigenetik" }
          ],
          "default": "dna",
          "info": "Steuert, unter welcher Reihen-Beschriftung der Chip erscheint."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Science Scope",
      "blocks": [
        { "type": "example" },
        { "type": "example" },
        { "type": "example" }
      ]
    }
  ]
}
{% endschema %}
