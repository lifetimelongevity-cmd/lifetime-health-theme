  ],
  "blocks": [
    {
      "type": "example",
      "name": "Beispiel-Report",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name des Reports",
          "default": "Körperalter"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Science Scope",
      "blocks": [
        { "type": "example" },
        { "type": "example" },
        { "type": "example" }
      ]
    }
  ]
}
{% endschema %}
