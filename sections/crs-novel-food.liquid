{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign crs_nf_kicker = section.settings.kicker | strip
  if crs_nf_kicker == '__none__'
    assign crs_nf_kicker = ''
  endif
  assign crs_nf_head = section.settings.heading | strip
  assign crs_nf_sub = section.settings.subheading | strip
  # Ohne diese Guards wuerde der Sentinel woertlich rendern — die Nachbar-
  # Sections haben sie, hier fehlten sie.
  if crs_nf_head == '__none__'
    assign crs_nf_head = ''
  endif
  if crs_nf_sub == '__none__'
    assign crs_nf_sub = ''
  endif
  # Fliesstext gehoert NICHT in crs-heading-stack__pair (docs/section-heading-stack.md).
  # Laengere Einordnungen laufen ueber `intro` unterhalb des Heading-Stacks.
  assign crs_nf_intro = section.settings.intro | strip
  if crs_nf_intro == '__none__'
    assign crs_nf_intro = ''
  endif
  assign crs_nf_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_nf_headline_lg = true
  endif
  assign crs_nf_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_nf_headline_md = true
  endif

  assign crs_nf_link_label = section.settings.link_label | strip
  assign crs_nf_link_url = section.settings.link_url | strip

  # Zweispaltig ist Opt-in: dieselbe Section laeuft auch auf
  # /pages/nmn-deutschland, wo die einspaltige Lesefassung richtig bleibt.
  assign crs_nf_split = false
  if section.settings.layout_variant == 'split'
    assign crs_nf_split = true
  endif

  # Zulassungspfad: der letzte gefuellte Schritt ist der offene. Index vorab
  # bestimmen, damit die gestrichelte Verbindung an der richtigen Stelle sitzt
  # und eine spaetere Zulassung nur ein Haken im Theme-Editor ist.
  assign crs_nf_rail_last = 0
  for rail_i in (1..3)
    assign rail_key = 'rail_' | append: rail_i | append: '_label'
    assign rail_val = section.settings[rail_key] | strip
    if rail_val != blank and rail_val != '__none__'
      assign crs_nf_rail_last = rail_i
    endif
  endfor
  assign crs_nf_rail_pre_open = crs_nf_rail_last | minus: 1
  unless section.settings.rail_last_open
    assign crs_nf_rail_pre_open = 0
  endunless
  assign crs_nf_rail_aria = section.settings.rail_aria_label | strip
  if crs_nf_rail_aria == '__none__' or crs_nf_rail_aria == blank
    assign crs_nf_rail_aria = 'Stand des EU-Zulassungsverfahrens'
  endif
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:       {{ section.settings.color_bg }};
    --crs-card-bg:  {{ section.settings.color_card_bg }};
    --crs-text:     {{ section.settings.color_text }};
    --crs-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.62 }};
    --crs-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.4 }};
    --crs-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.08 }};
    --crs-hairline: {{ section.settings.color_text | color_modify: 'alpha', 0.14 }};
    /* Nicht-Text-UI (Knoten und Verbindungen im Zulassungspfad) braucht 3:1.
       0.14 traegt eine Deko-Linie, aber keine bedeutungstragende Grafik:
       auf #f7f7f4 sind das 1.3:1, bei 0.34 erst 2.03:1. 0.52 erreicht 3.23:1. */
    --crs-rule:     {{ section.settings.color_text | color_modify: 'alpha', 0.52 }};
    /* Die Nachbarwerte 0.62 / 0.4 fallen bei Fliesstext durch AA (4.30:1 bzw.
       2.6:1). Neu gebaute Textebenen laufen deshalb auf 0.70 = 5.50:1. */
    --crs-muted:    {{ section.settings.color_text | color_modify: 'alpha', 0.70 }};
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
  }
{% endstyle %}

<div class="cnf-section" id="section-{{ section.id }}">
  <div class="cnf-container">
   <div class="cnf-layout{% if crs_nf_split %} cnf-layout--split{% endif %}">
    <div class="cnf-aside">

    <div class="cnf-head{% if crs_nf_intro != blank %} cnf-head--with-intro{% endif %} crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_nf_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_nf_headline_md %} crs-heading-stack--headline-md{% endif %}">
      {%- if crs_nf_kicker != blank -%}
        <p class="crs-heading-stack__kicker">{{ crs_nf_kicker | escape }}</p>
      {%- endif -%}
      {%- if crs_nf_head != blank or crs_nf_sub != blank -%}
        <div class="crs-heading-stack__pair">
          {%- if crs_nf_head != blank -%}
            <h2 class="crs-heading-stack__title">{{ crs_nf_head | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if crs_nf_sub != blank -%}
            <p class="crs-heading-stack__subtitle">{{ crs_nf_sub | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if crs_nf_intro != blank -%}
      <p class="cnf-intro">{{ crs_nf_intro | escape | newline_to_br }}</p>
    {%- endif -%}

    </div>

    <div class="cnf-card">

      {%- comment -%} Scannable core — stance + proof chips {%- endcomment -%}
      {%- if section.settings.body_1 != blank -%}
        <p class="cnf-lead">{{ section.settings.body_1 | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- comment -%}
        Zulassungspfad. Die Grafik traegt die Einordnung, damit sie nicht als
        Fliesstext gelesen werden muss: zwei erledigte Stationen, eine offene.
        Die datierte Fassung mit Quellen bleibt im Accordion darunter.
      {%- endcomment -%}
      {%- if crs_nf_rail_last > 0 -%}
        <ol class="cnf-rail" role="list" aria-label="{{ crs_nf_rail_aria | escape }}">
          {%- for rail_i in (1..3) -%}
            {%- assign rail_lk = 'rail_' | append: rail_i | append: '_label' -%}
            {%- assign rail_mk = 'rail_' | append: rail_i | append: '_meta' -%}
            {%- assign rail_lv = section.settings[rail_lk] | strip -%}
            {%- assign rail_mv = section.settings[rail_mk] | strip -%}
            {%- if rail_lv == '__none__' -%}{%- assign rail_lv = '' -%}{%- endif -%}
            {%- if rail_mv == '__none__' -%}{%- assign rail_mv = '' -%}{%- endif -%}
            {%- if rail_lv != blank -%}
              {%- assign rail_is_open = false -%}
              {%- if section.settings.rail_last_open and rail_i == crs_nf_rail_last -%}
                {%- assign rail_is_open = true -%}
              {%- endif -%}
              <li class="cnf-rail__step {% if rail_is_open %}cnf-rail__step--open{% else %}cnf-rail__step--done{% endif %}{% if rail_i == crs_nf_rail_pre_open %} cnf-rail__step--to-open{% endif %}">
                <span class="cnf-rail__node" aria-hidden="true">
                  {%- unless rail_is_open -%}
                    <svg viewBox="0 0 16 16" fill="none" focusable="false"><path d="M3.6 8.4l2.9 2.9 5.9-6.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endunless -%}
                </span>
                {%- comment -%}
                  Der Status steckt sonst nur im gestrichelten Ring und in der
                  Farbe. Ohne diese Zeile bekommt ein Screenreader die
                  Kernaussage der Grafik ("Zulassung steht aus") nicht.
                {%- endcomment -%}
                <span class="cnf-rail__label">{{ rail_lv | escape }}<span class="visually-hidden">, {% if rail_is_open %}noch offen{% else %}abgeschlossen{% endif %}</span></span>
                {%- if rail_mv != blank -%}
                  <span class="cnf-rail__meta">{{ rail_mv | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.chip_1 != blank or section.settings.chip_2 != blank or section.settings.chip_3 != blank -%}
        <ul class="cnf-chips" role="list">
          {%- for i in (1..3) -%}
            {%- assign chip_key = 'chip_' | append: i -%}
            {%- assign chip_val = section.settings[chip_key] | strip -%}
            {%- if chip_val != blank -%}
              <li class="cnf-chip">
                <svg class="cnf-chip__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.5 8.5l3 3 6-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ chip_val | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} Depth on demand — dated regulatory timeline with sources {%- endcomment -%}
      {%- assign has_status = false -%}
      {%- if section.settings.status_1_label != blank or section.settings.status_2_label != blank or section.settings.status_3_label != blank -%}
        {%- assign has_status = true -%}
      {%- endif -%}
      {%- if has_status -%}
        <details class="cnf-reg">
          <summary class="cnf-reg__summary">
            <span class="cnf-reg__summary-label">{{ section.settings.status_title | default: 'Regulatorischer Stand' | escape }}</span>
            {% render 'crs-chevron', class: 'cnf-reg__chevron' %}
          </summary>
          <div class="cnf-reg__body">
            <ol class="cnf-status__list" role="list">
              {%- for i in (1..3) -%}
                {%- assign lbl_key = 'status_' | append: i | append: '_label' -%}
                {%- assign txt_key = 'status_' | append: i | append: '_text' -%}
                {%- assign url_key = 'status_' | append: i | append: '_url' -%}
                {%- assign src_key = 'status_' | append: i | append: '_source' -%}
                {%- assign lbl_val = section.settings[lbl_key] | strip -%}
                {%- assign txt_val = section.settings[txt_key] | strip -%}
                {%- assign url_val = section.settings[url_key] | strip -%}
                {%- assign src_val = section.settings[src_key] | strip -%}
                {%- if lbl_val != blank or txt_val != blank -%}
                  <li class="cnf-step{% if i == 3 %} cnf-step--open{% endif %}">
                    <span class="cnf-step__dot" aria-hidden="true"></span>
                    <div class="cnf-step__body">
                      {%- if lbl_val != blank -%}<span class="cnf-step__label">{{ lbl_val | escape }}</span>{%- endif -%}
                      {%- if txt_val != blank -%}<span class="cnf-step__text">{{ txt_val | escape }}</span>{%- endif -%}
                      {%- if url_val != blank -%}
                        <a class="cnf-step__src" href="{{ url_val | escape }}" target="_blank" rel="noopener noreferrer">
                          {{ src_val | default: 'Quelle' | escape }}
                          <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 3h5v5M9 3l-6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
            {%- if section.settings.footnote != blank -%}
              <p class="cnf-status__foot">{{ section.settings.footnote | escape }}</p>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}

      {%- if crs_nf_link_label != blank and crs_nf_link_url != blank -%}
        <a class="cnf-link" href="{{ crs_nf_link_url }}">{{ crs_nf_link_label | escape }}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 8h8M8.5 4.5L12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}

    </div>
   </div>
  </div>
</div>

{% stylesheet %}
/* ===================================================
   Novel Food Erklärung — crs-novel-food.liquid
   Scanbarer Kern (Haltung + Chips) + Tiefe auf Abruf
   (datierte Regulatorik-Timeline im <details>-Accordion).
   =================================================== */

.cnf-section {
  background: var(--crs-bg, #f7f7f4);
}

.cnf-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Grundzustand einspaltig: der Wrapper ist ein reiner Block, die Abstaende
   kommen weiter aus .cnf-head / .cnf-intro. Zweispaltig wird nur per
   Modifier zugeschaltet. */
.cnf-layout {
  display: block;
}

@media (min-width: 980px) {
  .cnf-layout--split {
    display: grid;
    grid-template-columns: minmax(260px, 380px) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  /* In der Spalte tragen die Abstaende das Grid, nicht die Margins. */
  .cnf-layout--split .cnf-head,
  .cnf-layout--split .cnf-head--with-intro {
    margin-bottom: 0;
    max-width: none;
  }

  .cnf-layout--split .cnf-head--with-intro {
    margin-bottom: var(--space-4);
  }

  .cnf-layout--split .cnf-intro {
    margin-bottom: 0;
    max-width: none;
  }

  /* Ohne Deckel fuellt die Karte die rechte Spalte statt bei 780px zu enden
     und rechts einen toten Streifen zu lassen. */
  .cnf-layout--split .cnf-card {
    max-width: none;
  }
}

.cnf-head {
  margin-bottom: 28px;
  max-width: 44ch;
}

.cnf-head--with-intro {
  margin-bottom: var(--space-4);
}

/* Section-Description: bewusst ausserhalb des Heading-Stacks, damit Titel und
   Subline ein Block bleiben und Fliesstext nicht auf Headline-Groesse laeuft. */
.cnf-intro {
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-regular);
  line-height: var(--leading-relaxed);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.62));
  max-width: 62ch;
  margin: 0 0 28px;
}

.cnf-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 22px;
  max-width: 780px;
  padding: 44px;
  border-radius: 4px;
  background: var(--crs-card-bg, #f2f1ed);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
}

/* Core — stance line */
.cnf-lead {
  margin: 0;
  max-width: 62ch;
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--crs-text, #26251e);
}

/* ---------- Zulassungspfad ----------
   Informationsgrafik, keine Dekoration: zwei erledigte Stationen mit Haken,
   eine offene mit gestricheltem Ring, dazwischen die Verbindung. Der Weg zur
   offenen Station ist gestrichelt, weil er noch nicht gegangen ist. */
.cnf-rail {
  box-sizing: border-box;
  list-style: none;
  margin: 0;
  padding: var(--space-5);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
  background: var(--crs-bg, #f7f7f4);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
  border-radius: 4px;
}

.cnf-rail__step {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
  padding-top: 34px;
}

/* Verbindung zur naechsten Station. Sie laeuft ueber den Grid-gap hinweg bis
   an die Kante der Folgespalte, dort beginnt der naechste Knoten. */
.cnf-rail__step::after {
  content: '';
  position: absolute;
  top: 10px;
  left: 30px;
  right: calc(-1 * var(--space-4));
  border-top: 1.5px solid var(--crs-rule, rgba(38, 37, 30, 0.52));
}

.cnf-rail__step--to-open::after {
  border-top-style: dashed;
}

.cnf-rail__step:last-child::after {
  display: none;
}

.cnf-rail__node {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1.5px solid var(--crs-text, #26251e);
  background: var(--crs-text, #26251e);
  color: var(--crs-bg, #f7f7f4);
}

.cnf-rail__node svg {
  width: 13px;
  height: 13px;
  display: block;
}

.cnf-rail__step--open .cnf-rail__node {
  border-style: dashed;
  border-color: var(--crs-rule, rgba(38, 37, 30, 0.52));
  background: transparent;
}

.cnf-rail__label {
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  line-height: var(--leading-tight);
  color: var(--crs-text, #26251e);
}

.cnf-rail__step--open .cnf-rail__label {
  color: var(--crs-muted, rgba(38, 37, 30, 0.70));
}

.cnf-rail__meta {
  font-family: var(--font-body);
  font-size: var(--text-micro);
  line-height: var(--leading-body);
  color: var(--crs-muted, rgba(38, 37, 30, 0.70));
}

/* Core — proof chips */
.cnf-chips {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.cnf-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 13px;
  border-radius: 999px;
  background: var(--crs-bg, #f7f7f4);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--crs-text, #26251e);
}

.cnf-chip__icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  color: var(--crs-text, #26251e);
}

/* Depth — regulatory accordion */
.cnf-reg {
  border-top: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
  padding-top: 6px;
}

/* War 0.72rem in gesperrten Grau-Versalien und damit optisch ein Kicker,
   kein Bedienelement. Jetzt normale Textgroesse, lesbarer Kontrast und ein
   groesserer Chevron. */
.cnf-reg__summary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 0 2px;
  cursor: pointer;
  list-style: none;
  font-size: var(--text-body-sm);
  font-weight: var(--weight-medium);
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.62));
}

.cnf-reg__summary:hover {
  color: var(--crs-text, #26251e);
}

.cnf-reg__summary::-webkit-details-marker { display: none; }

.cnf-reg__summary:focus-visible {
  outline: 1px solid var(--crs-hairline, rgba(38, 37, 30, 0.4));
  outline-offset: 3px;
  border-radius: 2px;
}

.cnf-reg__chevron {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.cnf-reg[open] .cnf-reg__chevron {
  transform: rotate(180deg);
}

.cnf-reg__body {
  padding-top: 22px;
}

.cnf-status__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}

.cnf-step {
  position: relative;
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: 14px;
  padding-bottom: 20px;
}

.cnf-step:last-child { padding-bottom: 0; }

/* neutral vertical connector, no accent colour */
.cnf-step::before {
  content: '';
  position: absolute;
  left: 7px;
  top: 16px;
  bottom: -2px;
  width: 1px;
  background: var(--crs-hairline, rgba(38, 37, 30, 0.14));
}

.cnf-step:last-child::before { display: none; }

.cnf-step__dot {
  width: 15px;
  height: 15px;
  margin-top: 3px;
  border-radius: 50%;
  border: 1.5px solid var(--crs-text-ter, rgba(38, 37, 30, 0.4));
  background: var(--crs-card-bg, #f2f1ed);
}

.cnf-step--open .cnf-step__dot { border-style: dashed; }

.cnf-step__body {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.cnf-step__label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--crs-text, #26251e);
}

.cnf-step__text {
  font-size: 0.8125rem;
  line-height: 1.5;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.62));
}

.cnf-step__src {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--crs-text-ter, rgba(38, 37, 30, 0.4));
  text-decoration: none;
  border-bottom: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
  padding-bottom: 1px;
  align-self: flex-start;
  transition: color 0.18s ease, border-color 0.18s ease;
}

.cnf-step__src svg { width: 11px; height: 11px; }

.cnf-step__src:hover {
  color: var(--crs-text, #26251e);
  border-color: var(--crs-hairline, rgba(38, 37, 30, 0.14));
}

.cnf-status__foot {
  margin: 18px 0 0;
  font-size: 0.75rem;
  line-height: 1.5;
  color: var(--crs-text-ter, rgba(38, 37, 30, 0.4));
}

/* Optional link */
.cnf-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--crs-text, #26251e);
  text-decoration: none;
  border-bottom: 1px solid var(--crs-hairline, rgba(38, 37, 30, 0.14));
  align-self: flex-start;
  padding-bottom: 2px;
  transition: border-color 0.18s ease;
}

.cnf-link svg { width: 15px; height: 15px; }
.cnf-link:hover { border-color: var(--crs-text, #26251e); }

@media (prefers-reduced-motion: reduce) {
  .cnf-reg__chevron { transition: none; }
}

/* Der Pfad kippt in die Senkrechte, bevor die drei Spalten so schmal werden,
   dass jedes Label vierzeilig umbricht. */
@media (max-width: 760px) {
  .cnf-rail {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .cnf-rail__step {
    padding: 0 0 var(--space-5) 34px;
  }

  .cnf-rail__step:last-child {
    padding-bottom: 0;
  }

  .cnf-rail__step::after {
    top: 26px;
    bottom: -3px;
    left: 10px;
    right: auto;
    border-top: 0;
    border-left: 1.5px solid var(--crs-rule, rgba(38, 37, 30, 0.52));
  }

  .cnf-rail__step--to-open::after {
    border-top-style: solid;
    border-left-style: dashed;
  }
}

/* Responsive — mobile */
@media (max-width: 640px) {
  .cnf-head { margin-bottom: 20px; }
  .cnf-card { padding: 32px 22px; gap: 20px; }
  .cnf-lead { font-size: 1rem; }
  .cnf-rail { padding: var(--space-4); }
}
{% endstylesheet %}

