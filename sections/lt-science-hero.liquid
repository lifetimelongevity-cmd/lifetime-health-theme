{% comment %} Image: human skin texture natural light minimal — Photo by Olga Thelavart on Unsplash {% endcomment %}

{% style %}
  #section-{{ section.id }} {
    --lsh-bg:       {{ section.settings.color_bg | default: '#f7f7f4' }};
    --lsh-text:     {{ section.settings.color_text | default: '#26251e' }};
    --lsh-text-sec: {{ section.settings.color_text | default: '#26251e' | color_modify: 'alpha', 0.55 }};
    --crs-text:     var(--lsh-text);
    --crs-text-sec: var(--lsh-text-sec);
    --crs-text-ter: var(--lsh-text-sec);
    background:     var(--lsh-bg);
    padding-top:    {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

{%- liquid
  assign lsh_alt = section.settings.image_alt
  if lsh_alt == blank
    assign lsh_alt = section.settings.image.alt
  endif
  assign lsh_band = false
  if section.settings.layout == 'bildband' and section.settings.image != blank
    assign lsh_band = true
  endif
  assign lsh_mobil = section.settings.image_mobile | default: section.settings.image
-%}

{%- comment -%}
  Layout „Bildband“ (16.11.2026, Katalog): das Bild ist die Fläche, die Überschrift steht darauf,
  wie im Vollbild-Hero der Startseite, nur flacher. Ab 769 px randloses Querformat, Text links,
  Ausschnitt rechtsbündig. Darunter das Hochformat oben, unten weich in die Grundfarbe ausgeblendet,
  Text darunter auf derselben Farbe. Default bleibt „Text links, Bild rechts“, die anderen Seiten
  mit dieser Section ändern sich nicht.
{%- endcomment -%}
{%- if lsh_band -%}
<section id="section-{{ section.id }}" class="lsh lsh--band">
  <div class="lsh__band{% if section.settings.band_verlauf == 'stark' %} lsh__band--stark{% endif %}" style="--lsh-band-bg: {{ section.settings.band_bg }};{% if section.settings.position_desktop != blank %} --lsh-pos-d: {{ section.settings.position_desktop | escape }};{% endif %}{% if section.settings.position_mobile != blank %} --lsh-pos-m: {{ section.settings.position_mobile | escape }};{% endif %}">
    <div class="lsh__band-bild">
      {%- comment -%}
        Breiten wie im Vollbild-Hero der Startseite (18.11.2026): bis 3344 Desktop und 2244 mobil,
        sonst wird ein HD-Bild auf Retina hochskaliert und wirkt verpixelt. Mobil nur Stufen bis zur
        echten Bildbreite, plus die Bildbreite selbst, damit kein w-Wert mehr verspricht als die Datei hat.
      {%- endcomment -%}
      {%- assign lsh_stufen = '600,900,1320,1800,2244' | split: ',' -%}
      {%- capture lsh_mobil_srcset -%}
        {%- for stufe in lsh_stufen -%}
          {%- assign lsh_w = stufe | plus: 0 -%}
          {%- if lsh_w < lsh_mobil.width -%}{{ lsh_mobil | image_url: width: lsh_w }} {{ lsh_w }}w, {% endif -%}
        {%- endfor -%}
        {{- lsh_mobil | image_url: width: lsh_mobil.width }} {{ lsh_mobil.width }}w
      {%- endcapture -%}
      <picture>
        <source
          media="(max-width: 768px)"
          srcset="{{ lsh_mobil_srcset | strip }}"
          sizes="100vw"
          width="{{ lsh_mobil.width }}"
          height="{{ lsh_mobil.height }}"
        >
        {{
          section.settings.image
          | image_url: width: 3344
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '900, 1200, 1672, 2200, 2800, 3344',
            sizes: '100vw',
            class: 'lsh__band-img',
            alt: lsh_alt
        }}
      </picture>
    </div>
    <div class="lsh__band-text">
      <div class="crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-lg crs-heading-stack--homepage-truth crs-heading-stack--on-dark">
        {%- if section.settings.kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <div class="crs-heading-stack__pair">
          {%- if section.settings.headline != blank -%}
            <h1 class="crs-heading-stack__title">{{ section.settings.headline | escape }}</h1>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="crs-heading-stack__subtitle">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
      {%- comment -%} Knöpfe wie im Vollbild-Hero der Startseite (heller Knopf, Ghost-Knopf). Leer = keine. {%- endcomment -%}
      {%- if section.settings.cta_label != blank or section.settings.cta_2_label != blank -%}
        <div class="lsh__band-knoepfe">
          {%- if section.settings.cta_label != blank -%}
            <a class="lsh__band-knopf lsh__band-knopf--hell" href="{{ section.settings.cta_url | default: '/products/lifetime-age-dna' }}">{{ section.settings.cta_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.cta_2_label != blank -%}
            <a class="lsh__band-knopf lsh__band-knopf--ghost" href="{{ section.settings.cta_2_url | default: '/products/lifetime-age-dna' }}">{{ section.settings.cta_2_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- else -%}

<section id="section-{{ section.id }}" class="lsh">
  <div class="lsh__container">

    {%- comment -%} Text — left column {%- endcomment -%}
    <div class="lsh__content crs-heading-stack crs-heading-stack--align-left crs-heading-stack--headline-lg crs-heading-stack--homepage-truth">
      {%- if section.settings.kicker != blank -%}
        <p class="crs-heading-stack__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <div class="crs-heading-stack__pair">
        {%- if section.settings.headline != blank -%}
          <h1 class="crs-heading-stack__title">{{ section.settings.headline | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="crs-heading-stack__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Image — right column.

      Ohne Bild entfaellt die Spalte ganz, statt einen grauen Platzhalterkasten
      zu rendern. Der Platzhalter ist eine Editor-Hilfe und gehoert nur in den
      Theme-Editor; auf der Live-Seite war er ein leerer Kasten, der eine
      Bildspalte behauptet, die es nicht gibt.
    {%- endcomment -%}
    {%- if section.settings.image != blank -%}
      <div class="lsh__visual">
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            class: 'lsh__img',
            alt: lsh_alt
        }}
      </div>
    {%- elsif request.design_mode -%}
      <div class="lsh__visual">
        <div class="lsh__placeholder">{{ 'image' | placeholder_svg_tag: 'lsh__placeholder-svg' }}</div>
      </div>
    {%- endif -%}

  </div>
</section>
{%- endif -%}

{% stylesheet %}
/*
   lt-science-hero — Science Page Hero
   §3 tokens, §4 layout (split 60/40), §6 typography
   Dominant element: H1 headline
   No CTA — sets editorial tone only
*/

.lsh {
  background: var(--lsh-bg, #f7f7f4);
  overflow: hidden;
}

.lsh__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--space-5);
  display: grid;
  grid-template-columns: 3fr 2fr;
  gap: var(--space-8);
  align-items: center;
}

/* — Text column — */
.lsh__content {
  min-width: 0;
}

/* Ohne Bildspalte spannt der Text über beide Spuren, das Lesemaß wird
   dann am Inhalt gedeckelt und nicht am Container. */
.lsh__content:only-child {
  grid-column: 1 / -1;
  max-width: 46rem;
}

.lsh__content .crs-heading-stack__subtitle {
  max-width: 52ch;
}

/* — Image column — */
.lsh__visual {
  display: flex;
  align-items: stretch;
}

.lsh__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--radius-md);
  display: block;
  aspect-ratio: 3 / 2;
}

.lsh__placeholder {
  width: 100%;
  aspect-ratio: 3 / 2;
  background: #f2f1ed;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(38, 37, 30, 0.08);
}

.lsh__placeholder-svg {
  width: 60px;
  height: 60px;
  opacity: 0.25;
}

/* — Bildband — */
.lsh--band { overflow: visible; }
.lsh__band {
  position: relative;
  overflow: hidden;
  background: var(--lsh-band-bg, var(--color-dark));
  color: var(--color-paper);
}
.lsh__band-bild { position: relative; aspect-ratio: 5 / 4; overflow: hidden; }
.lsh__band-bild picture { display: block; width: 100%; height: 100%; }
.lsh__band-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--lsh-pos-m, 50% 62%);
  -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
  mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
}
.lsh__band-text {
  position: relative;
  z-index: 1;
  max-width: 1280px;
  margin: 0 auto;
  padding: var(--space-2) 20px var(--space-7);
}
.lsh__band-text .crs-heading-stack__subtitle { max-width: 30ch; }
.lsh__band-knoepfe { display: flex; gap: var(--space-3); margin-top: var(--space-5); }
.lsh__band-knopf {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 0;
  min-height: 48px;
  padding: 14px 12px;
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-medium);
  line-height: 1.25;
  white-space: nowrap;
  text-decoration: none;
}
.lsh__band-knopf--hell { background: var(--color-paper); color: var(--color-dark); }
.lsh__band-knopf--hell:hover { background: var(--color-white); }
.lsh__band-knopf--ghost { background: transparent; color: var(--color-paper); border: 1px solid rgba(247, 247, 244, 0.85); }
.lsh__band-knopf--ghost:hover { background: rgba(247, 247, 244, 0.14); }
.lsh__band-knopf:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 4px; }
@media (min-width: 641px) { .lsh__band-text { padding-left: 24px; padding-right: 24px; } }
@media (min-width: 769px) {
  .lsh__band { display: flex; align-items: center; height: clamp(360px, 36vw, 560px); }
  .lsh__band-bild { position: absolute; inset: 0; aspect-ratio: auto; }
  .lsh__band-img { object-position: var(--lsh-pos-d, 100% 58%); -webkit-mask-image: none; mask-image: none; }
  .lsh__band::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to right, rgba(38, 37, 30, 0.32) 0%, rgba(38, 37, 30, 0.12) 38%, rgba(38, 37, 30, 0) 55%);
  }
  /* Starker Verlauf für helle Fotos, Werte wie die Personen-Folie im Hero der Startseite. */
  .lsh__band--stark::after {
    background: linear-gradient(to right, rgba(38, 37, 30, 0.72) 0%, rgba(38, 37, 30, 0.42) 40%, rgba(38, 37, 30, 0.14) 62%, rgba(38, 37, 30, 0) 80%);
  }
  .lsh__band-text { width: 100%; padding-top: 0; padding-bottom: 0; }
  .lsh__band-knoepfe { margin-top: var(--space-6); }
  .lsh__band-knopf { flex: 0 0 auto; padding: 15px 26px; }
}
@media (min-width: 1025px) { .lsh__band-text { padding-left: 40px; padding-right: 40px; } }

/* — Responsive — */
@media (max-width: 1024px) {
  .lsh__container {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
  }
}

@media (max-width: 768px) {
  .lsh__container {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: 0 var(--space-4);
  }
  .lsh__img,
  .lsh__placeholder {
    aspect-ratio: 3 / 2;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Science Hero",
  "tag": "section",
  "class": "lt-science-hero",
  "settings": [
    { "type": "text",         "id": "kicker",         "label": "Kicker",          "default": "Wissenschaft" },
    { "type": "textarea",     "id": "headline",       "label": "Headline",        "default": "Altern ist unvermeidlich. Wie wir altern, ist beeinflussbar." },
    { "type": "textarea",     "id": "subheading",     "label": "Subheading",      "default": "Langlebigkeit beginnt nicht mit Trends, sondern mit Biologie. Wer versteht, was im Körper mit dem Alter passiert, kann gezielter entscheiden, was wirklich sinnvoll ist — und was nicht." },
    { "type": "select",       "id": "layout",         "label": "Layout", "default": "split", "options": [
      { "value": "split",    "label": "Text links, Bild rechts" },
      { "value": "bildband", "label": "Bildband, Text auf dem Bild" }
    ] },
    { "type": "image_picker", "id": "image",          "label": "Bild (im Bildband: Querformat)" },
    { "type": "image_picker", "id": "image_mobile",   "label": "Bildband: Hochformat fürs Handy", "info": "Leer = dasselbe Bild." },
    { "type": "color",        "id": "band_bg",        "label": "Bildband: Grundfarbe", "default": "#364f56", "info": "Die Farbe, in die das Bild auf dem Handy nach unten ausläuft. Am Bildgrund ausrichten." },
    { "type": "select",       "id": "band_verlauf",   "label": "Bildband: Verlauf hinter der Schrift", "default": "leicht", "options": [
      { "value": "leicht", "label": "Leicht (dunkles Bild)" },
      { "value": "stark",  "label": "Stark (helles Foto)" }
    ] },
    { "type": "text",         "id": "position_desktop", "label": "Bildband: Ausschnitt Desktop", "info": "Wie CSS object-position, z. B. 100% 50%. Leer = 100% 58%." },
    { "type": "text",         "id": "position_mobile",  "label": "Bildband: Ausschnitt Handy", "info": "Leer = 50% 62%." },
    { "type": "text",         "id": "cta_label",      "label": "Bildband: Knopf 1 (hell)" },
    { "type": "url",          "id": "cta_url",        "label": "Bildband: Ziel Knopf 1" },
    { "type": "text",         "id": "cta_2_label",    "label": "Bildband: Knopf 2 (Umriss)" },
    { "type": "url",          "id": "cta_2_url",      "label": "Bildband: Ziel Knopf 2" },
    { "type": "text",         "id": "image_alt",      "label": "Bild Alt-Text" },
    { "type": "color",        "id": "color_bg",       "label": "Hintergrund",     "default": "#f7f7f4" },
    { "type": "color",        "id": "color_text",     "label": "Textfarbe",       "default": "#26251e" },
    { "type": "range",        "id": "padding_top",    "label": "Abstand oben",    "min": 0, "max": 160, "step": 8, "default": 80 },
    { "type": "range",        "id": "padding_bottom", "label": "Abstand unten",   "min": 0, "max": 160, "step": 8, "default": 80 }
  ],
  "presets": [{ "name": "Science Hero" }]
}
{% endschema %}
