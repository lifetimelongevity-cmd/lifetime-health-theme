{% comment %}
  lt-leiste — Schluss-Leiste im Wispr-Muster (Bildplan Website, Startseite v2, Oktober 2026).
  Text und Knopf in HTML, nur das verwischte Foto ist ein Bild. Fläche im Footer-Teal
  (--color-dark) statt Schwarz. Instrument Serif nur hier (selbst gehostet).
  Mit „Nahtlos in den Footer“ verliert der Footer auf der Startseite (template index)
  Abstand und Linie, damit die Leiste ohne Kante in ihn übergeht.
  Ersetzt auf der Startseite lt-hp-cta-close (bleibt auf anderen Seiten im Einsatz).
  Vorlage: docs/startseite-v2/startseite.html#schluss
{% endcomment %}

{% style %}
  @font-face {
    font-family: 'LT Instrument Serif';
    src: url({{ 'lt-instrument-serif.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  {%- if section.settings.footer_nahtlos and template.name == 'index' %}
  body.template-index .main-footer { margin-top: 0; border-top: 0; }
  {%- endif %}
{% endstyle %}

<div class="ltl2">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1120
      | image_tag: loading: 'lazy', widths: '560, 1120', sizes: '(min-width: 901px) 70vw, 100vw', class: 'ltl2__foto', alt: ''
    }}
  {%- endif -%}
  <div class="ltl2__text">
    {%- if section.settings.heading != blank -%}
      <h2 class="ltl2__titel">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ltl2__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="ltl2__knopf" href="{{ section.settings.button_url | default: '/products/lifetime-age-dna' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.small != blank -%}
      <span class="ltl2__klein">{{ section.settings.small | escape }}</span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ltl2 {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 520px;
  overflow: hidden;
  background: var(--color-dark);
  color: var(--color-paper);
}
.ltl2__foto {
  position: absolute;
  top: -8%;
  right: -6%;
  width: 70%;
  height: 116%;
  object-fit: cover;
  filter: blur(26px) brightness(0.9) saturate(1.05);
}
.ltl2::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, var(--color-dark) 34%, rgba(54, 79, 86, 0.86) 46%, rgba(54, 79, 86, 0.35) 64%, rgba(54, 79, 86, 0) 82%),
    linear-gradient(180deg, rgba(54, 79, 86, 0) 60%, var(--color-dark) 100%);
}
.ltl2__text {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 96px 40px 88px;
}
.ltl2__titel {
  max-width: 640px;
  margin: 0;
  font-family: 'LT Instrument Serif', Georgia, serif;
  font-size: var(--text-stat);
  font-weight: var(--weight-regular);
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: var(--color-paper);
}
.ltl2__sub {
  margin: var(--space-4) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-lg);
  line-height: 1.5;
  color: rgba(247, 247, 244, 0.72);
}
.ltl2__knopf {
  display: inline-block;
  margin-top: 36px;
  padding: 15px 26px;
  border-radius: var(--radius-full);
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-body);
  text-decoration: none;
}
.ltl2__knopf:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 4px; }
.ltl2__klein {
  display: block;
  margin-top: 14px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: rgba(247, 247, 244, 0.72);
}
@media (max-width: 1024px) { .ltl2__text { padding-left: 24px; padding-right: 24px; } }
@media (max-width: 900px) {
  .ltl2 { display: block; min-height: 0; }
  .ltl2__foto { top: -6%; right: -8%; width: 116%; height: 62%; }
  .ltl2::after { background: linear-gradient(180deg, rgba(54, 79, 86, 0) 18%, rgba(54, 79, 86, 0.6) 34%, var(--color-dark) 52%); }
  .ltl2__text { padding-top: 300px; padding-bottom: 56px; }
  .ltl2__titel { font-size: var(--text-h1); }
}
@media (max-width: 640px) { .ltl2__text { padding-left: 20px; padding-right: 20px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LT Leiste",
  "tag": "section",
  "class": "section lt-leiste",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (Instrument Serif)", "default": "Miss, wo du heute stehst." },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Danach weißt du, wo du ansetzt." },
    { "type": "text", "id": "button_label", "label": "Knopf", "default": "AGE & DNA-Test bestellen →" },
    { "type": "url", "id": "button_url", "label": "Ziel des Knopfs" },
    { "type": "text", "id": "small", "label": "Kleine Zeile", "default": "349 € einmalig · versandkostenfrei · kein Abo" },
    { "type": "image_picker", "id": "image", "label": "Foto (wird verwischt)" },
    { "type": "checkbox", "id": "footer_nahtlos", "label": "Nahtlos in den Footer (nur Startseite)", "default": true, "info": "Footer ohne Abstand und ohne Linie, wenn die Leiste als letzte Section auf der Startseite steht." }
  ],
  "presets": [{ "name": "LT Leiste" }]
}
{% endschema %}
