{% comment %}
  lt-leiste — Schluss-Leiste im Wispr-Muster (Bildplan Website, Startseite v2, Oktober 2026).
  Text und Knopf in HTML, nur das verwischte Foto ist ein Bild. Fläche im Footer-Teal
  (--color-dark) statt Schwarz. Instrument Serif nur hier (selbst gehostet).
  Mit „Nahtlos in den Footer“ verliert der Footer auf der Startseite (template index)
  Abstand und Linie, damit die Leiste ohne Kante in ihn übergeht.
  Ersetzt auf der Startseite lt-hp-cta-close (bleibt auf anderen Seiten im Einsatz).
  Vorlage: docs/startseite-v2/startseite.html#schluss

  Fakten unter dem Knopf (Impeccable 2, 28.10.2026, AGE&DNA-PDP): bis zu drei Paare „Zahl / Text“,
  per Default leer, dann rendert nichts und die Startseite bleibt wie sie ist. Platzhalter:
  {datum} = heute plus datum_tage als „8. Dezember“, {datum_kurz} = „8. Dez.“,
  {bewertungen} = Loox-Zahl, {note} = Loox-Schnitt mit Komma (beide nur auf Produktseiten).
  Das Datum rechnet Liquid (Monatsnamen aus der Liste, Shopifys date lokalisiert %B nicht,
  siehe crs-novel-food) und ein kleines Skript zieht es im Browser auf den heutigen Tag nach,
  weil die Seite gecacht ausgeliefert wird. Ohne JavaScript steht das Serverdatum.
{% endcomment %}

{%- liquid
  assign ltl2_tage = section.settings.datum_tage | default: 42
  assign ltl2_sek = ltl2_tage | times: 86400
  assign ltl2_ts = 'now' | date: '%s' | plus: ltl2_sek
  assign ltl2_monate = 'Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember' | split: ','
  assign ltl2_monate_kurz = 'Jan.,Feb.,März,Apr.,Mai,Juni,Juli,Aug.,Sep.,Okt.,Nov.,Dez.' | split: ','
  assign ltl2_m = ltl2_ts | date: '%m' | plus: 0 | minus: 1
  assign ltl2_d = ltl2_ts | date: '%-d'
  assign ltl2_datum = ltl2_d | append: '. ' | append: ltl2_monate[ltl2_m]
  assign ltl2_datum_kurz = ltl2_d | append: '. ' | append: ltl2_monate_kurz[ltl2_m]
  assign ltl2_datum_html = '<span data-ltl2-datum>' | append: ltl2_datum | append: '</span>'
  assign ltl2_datum_kurz_html = '<span data-ltl2-datum-kurz>' | append: ltl2_datum_kurz | append: '</span>'
  assign ltl2_bewertungen = ''
  assign ltl2_note = ''
  if product
    assign ltl2_bewertungen = product.metafields.loox.num_reviews.value | default: 0 | plus: 0 | append: ''
    assign ltl2_note_raw = product.metafields.loox.avg_rating.value | default: 0 | plus: 0
    if ltl2_note_raw > 0
      assign ltl2_note = ltl2_note_raw | round: 1 | append: '' | replace: '.', ','
    endif
    if ltl2_bewertungen == '0'
      assign ltl2_bewertungen = ''
    endif
  endif
  assign ltl2_fakten = ''
  assign ltl2_datum_aktiv = false
  for i in (1..3)
    assign ltl2_zahl_key = 'fakt_' | append: i | append: '_zahl'
    assign ltl2_text_key = 'fakt_' | append: i | append: '_text'
    assign ltl2_zahl = section.settings[ltl2_zahl_key] | strip
    assign ltl2_text = section.settings[ltl2_text_key] | strip
    if ltl2_zahl == blank and ltl2_text == blank
      continue
    endif
    assign ltl2_paar = ltl2_zahl | append: '|' | append: ltl2_text
    if ltl2_paar contains '{datum'
      assign ltl2_datum_aktiv = true
    endif
    assign ltl2_zahl = ltl2_zahl | escape | replace: '{datum_kurz}', ltl2_datum_kurz_html | replace: '{datum}', ltl2_datum_html | replace: '{bewertungen}', ltl2_bewertungen | replace: '{note}', ltl2_note
    assign ltl2_text = ltl2_text | escape | replace: '{datum_kurz}', ltl2_datum_kurz_html | replace: '{datum}', ltl2_datum_html | replace: '{bewertungen}', ltl2_bewertungen | replace: '{note}', ltl2_note
    assign ltl2_fakt = '<li class="ltl2__fakt"><strong class="ltl2__zahl">' | append: ltl2_zahl | append: '</strong><span class="ltl2__fakt-text">' | append: ltl2_text | append: '</span></li>'
    assign ltl2_fakten = ltl2_fakten | append: ltl2_fakt
  endfor
-%}

{% style %}
  @font-face {
    font-family: 'LT Instrument Serif';
    src: url({{ 'lt-instrument-serif.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  {%- if section.settings.footer_nahtlos and template.name == 'index' %}
  body.template-index .main-footer { margin-top: 0; border-top: 0; }
  {%- endif %}
{% endstyle %}

<div class="ltl2{% if section.settings.kompakt_mobil %} ltl2--kompakt{% endif %}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 1120
      | image_tag: loading: 'lazy', widths: '560, 1120', sizes: '(min-width: 901px) 70vw, 100vw', class: 'ltl2__foto', alt: ''
    }}
  {%- endif -%}
  <div class="ltl2__text">
    {%- if section.settings.heading != blank -%}
      <h2 class="ltl2__titel">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="ltl2__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="ltl2__knopf" href="{{ section.settings.button_url | default: '/products/lifetime-age-dna' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.small != blank -%}
      <span class="ltl2__klein">{{ section.settings.small | escape }}</span>
    {%- endif -%}
    {%- if ltl2_fakten != blank -%}
      <ul class="ltl2__fakten" role="list">{{ ltl2_fakten }}</ul>
      {%- if ltl2_datum_aktiv -%}
        <script>
          (function () {
            var box = document.currentScript.parentNode;
            var d = new Date();
            d.setDate(d.getDate() + {{ ltl2_tage }});
            var lang = d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long' });
            var kurz = d.toLocaleDateString('de-DE', { day: 'numeric', month: 'short' });
            box.querySelectorAll('[data-ltl2-datum]').forEach(function (el) { el.textContent = lang; });
            box.querySelectorAll('[data-ltl2-datum-kurz]').forEach(function (el) { el.textContent = kurz; });
          })();
        </script>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.ltl2 {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 520px;
  overflow: hidden;
  background: var(--color-dark);
  color: var(--color-paper);
}
.ltl2__foto {
  position: absolute;
  top: -8%;
  right: -6%;
  width: 70%;
  height: 116%;
  object-fit: cover;
  filter: blur(26px) brightness(0.9) saturate(1.05);
}
.ltl2::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, var(--color-dark) 34%, rgba(54, 79, 86, 0.86) 46%, rgba(54, 79, 86, 0.35) 64%, rgba(54, 79, 86, 0) 82%),
    linear-gradient(180deg, rgba(54, 79, 86, 0) 60%, var(--color-dark) 100%);
}
.ltl2__text {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 96px 40px 88px;
}
.ltl2__titel {
  max-width: 640px;
  margin: 0;
  font-family: 'LT Instrument Serif', Georgia, serif;
  font-size: var(--text-stat);
  font-weight: var(--weight-regular);
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: var(--color-paper);
}
.ltl2__sub {
  margin: var(--space-4) 0 0;
  font-family: var(--font-body);
  font-size: var(--text-body-lg);
  line-height: 1.5;
  color: rgba(247, 247, 244, 0.72);
}
.ltl2__knopf {
  display: inline-block;
  margin-top: 36px;
  padding: 15px 26px;
  border-radius: var(--radius-full);
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--text-body);
  text-decoration: none;
}
.ltl2__knopf:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 4px; }
.ltl2__klein {
  display: block;
  margin-top: 14px;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: rgba(247, 247, 244, 0.72);
}
/* Fakten unter dem Knopf: Zahl in der Serife der Ueberschrift, Text darunter, drei nebeneinander. */
.ltl2__fakten {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4) var(--space-6);
  margin: var(--space-6) 0 0;
  padding: 0;
  list-style: none;
}
.ltl2__fakt {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ltl2__zahl {
  font-family: 'LT Instrument Serif', Georgia, serif;
  font-size: var(--text-h2);
  font-weight: var(--weight-regular);
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: var(--color-paper);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.ltl2__fakt-text {
  margin-top: var(--space-1);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: 1.45;
  color: rgba(247, 247, 244, 0.72);
}
@media (max-width: 1024px) { .ltl2__text { padding-left: 24px; padding-right: 24px; } }
@media (max-width: 900px) {
  .ltl2 { display: block; min-height: 0; }
  .ltl2__foto { top: -6%; right: -8%; width: 116%; height: 62%; }
  .ltl2::after { background: linear-gradient(180deg, rgba(54, 79, 86, 0) 18%, rgba(54, 79, 86, 0.6) 34%, var(--color-dark) 52%); }
  .ltl2__text { padding-top: 300px; padding-bottom: 56px; }
  .ltl2__titel { font-size: var(--text-h1); }
  /* Kompakt (kompakt_mobil): halb so viel Foto-Vorlauf, der Knopf kommt frueher in den Bildschirm. */
  .ltl2--kompakt .ltl2__foto { height: 46%; }
  .ltl2--kompakt::after { background: linear-gradient(180deg, rgba(54, 79, 86, 0) 10%, rgba(54, 79, 86, 0.6) 24%, var(--color-dark) 40%); }
  .ltl2--kompakt .ltl2__text { padding-top: 168px; }
}
@media (max-width: 640px) {
  .ltl2__text { padding-left: 20px; padding-right: 20px; }
  .ltl2__fakten { gap: var(--space-3) var(--space-5); margin-top: var(--space-5); }
  .ltl2__zahl { font-size: var(--text-h3); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LT Leiste",
  "tag": "section",
  "class": "section lt-leiste",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (Instrument Serif)", "default": "Miss, wo du heute stehst." },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Danach weißt du, wo du ansetzt." },
    { "type": "text", "id": "button_label", "label": "Knopf", "default": "Test bestellen →" },
    { "type": "url", "id": "button_url", "label": "Ziel des Knopfs" },
    { "type": "text", "id": "small", "label": "Kleine Zeile", "default": "395 € einmalig · versandkostenfrei · kein Abo" },
    { "type": "image_picker", "id": "image", "label": "Foto (wird verwischt)" },
    { "type": "checkbox", "id": "footer_nahtlos", "label": "Nahtlos in den Footer (nur Startseite)", "default": true, "info": "Footer ohne Abstand und ohne Linie, wenn die Leiste als letzte Section auf der Startseite steht." },
    { "type": "checkbox", "id": "kompakt_mobil", "label": "Kompakt auf dem Handy", "default": false, "info": "Weniger Foto über dem Text (168 statt 300 px), für Seiten, auf denen die Leiste die letzte Kaufchance ist." },
    { "type": "header", "content": "Fakten unter dem Knopf", "info": "Bis zu drei Paare Zahl und Text. Leer = nichts. Platzhalter: {datum} (heute plus Tage, „8. Dezember“), {datum_kurz} („8. Dez.“), {bewertungen} und {note} (Loox, nur auf Produktseiten)." },
    { "type": "text", "id": "fakt_1_zahl", "label": "Fakt 1: Zahl" },
    { "type": "text", "id": "fakt_1_text", "label": "Fakt 1: Text" },
    { "type": "text", "id": "fakt_2_zahl", "label": "Fakt 2: Zahl" },
    { "type": "text", "id": "fakt_2_text", "label": "Fakt 2: Text" },
    { "type": "text", "id": "fakt_3_zahl", "label": "Fakt 3: Zahl" },
    { "type": "text", "id": "fakt_3_text", "label": "Fakt 3: Text" },
    { "type": "range", "id": "datum_tage", "label": "Tage bis {datum}", "min": 7, "max": 90, "step": 1, "unit": "d", "default": 42 }
  ],
  "presets": [{ "name": "LT Leiste" }]
}
{% endschema %}
