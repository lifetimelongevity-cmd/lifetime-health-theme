{% comment %}
  lt-dna-lp-steps — „So läuft es": vier Schritte, je Titel und Zeitangabe, nichts sonst.
  Beantwortet „Was muss ich tun?" und „Wie lange dauert es?" in einem Blick.
  Surface: --color-paper. Dominantes Element: die Schrittfolge.
{% endcomment %}

<section class="lt-dna-steps">
  <div class="lt-dna-steps__inner lt-dna-wrap">
    {% render 'section-heading-crs', heading: section.settings.heading, subheading: section.settings.subheading, align: 'left', headline_md: true, extra_class: 'lt-dna-steps__header' %}
    <ol class="lt-dna-steps__list">
      {%- for block in section.blocks -%}
        <li class="lt-dna-steps__item" {{ block.shopify_attributes }}>
          <span class="lt-dna-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <div class="lt-dna-steps__text">
            <p class="lt-dna-steps__title">{{ block.settings.title | escape }}</p>
            {%- if block.settings.time != blank -%}
              <p class="lt-dna-steps__time">{{ block.settings.time | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.note != blank -%}
      <p class="lt-dna-steps__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lt-dna-wrap { max-width: 72rem; margin: 0 auto; padding-left: var(--gutter-container, 20px); padding-right: var(--gutter-container, 20px); }
.lt-dna-steps { background: var(--color-paper); color: var(--color-ink); }
.lt-dna-steps__inner { padding-top: var(--space-8); padding-bottom: var(--space-8); }
.lt-dna-steps__header { margin-bottom: var(--space-6); max-width: 40rem; }
.lt-dna-steps__list { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; counter-reset: none; }
.lt-dna-steps__item { display: flex; gap: var(--space-4); align-items: flex-start; }
.lt-dna-steps__num {
  flex: 0 0 36px;
  width: 36px; height: 36px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  font-weight: var(--weight-semibold);
}
.lt-dna-steps__title { margin: 6px 0 0; font-family: var(--font-heading); font-size: var(--text-section); font-weight: var(--weight-bold); line-height: var(--leading-tight); }
.lt-dna-steps__time { margin: var(--space-1) 0 0; font-family: var(--font-body); font-size: var(--text-body); color: var(--color-ink-muted); }
.lt-dna-steps__note { margin: var(--space-6) 0 0; max-width: 40rem; font-family: var(--font-body); font-size: var(--text-body-sm); line-height: var(--leading-body); color: var(--color-ink-muted); }
@media screen and (min-width: 990px) {
  .lt-dna-steps__list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); }
  .lt-dna-steps__item { flex-direction: column; }
  .lt-dna-steps__title { margin-top: var(--space-3); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LT DNA-LP Steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "So läuft es." },
    { "type": "text", "id": "subheading", "label": "Subline", "default": "Ohne Arzttermin." },
    { "type": "textarea", "id": "note", "label": "Fußnote" }
  ],
  "blocks": [
    { "type": "step", "name": "Schritt", "limit": 5, "settings": [
      { "type": "text", "id": "title", "label": "Titel", "default": "Kit kommt" },
      { "type": "text", "id": "time", "label": "Zeit oder Zusatz", "default": "2 bis 3 Werktage" }
    ] }
  ],
  "presets": [{ "name": "LT DNA-LP Steps" }]
}
{% endschema %}
