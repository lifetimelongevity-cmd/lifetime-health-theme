{% comment %}
  lt-dna-lp-offer — Der Kassenzettel: was in den 449 € steckt, Preis, Knopf, Garantie.
  Dunkle Fläche als bewusster Rhythmusbruch (die einzige auf der Seite), weil hier
  die Kaufentscheidung fällt. Preis aus der Variante, Knopf per Cart-Permalink.
  Werte je Zeile nur, wenn es den Preis wirklich gibt (Folgetest 299 €).
  Dominantes Element: der Preis.
{% endcomment %}

{%- liquid
  assign product = all_products[section.settings.product]
  assign variant = product.selected_or_first_available_variant
  assign checkout_url = routes.cart_url | append: '/' | append: variant.id | append: ':1'
-%}

<section class="lt-dna-offer">
  <div class="lt-dna-offer__inner lt-dna-wrap">
    <div class="lt-dna-offer__card">
      {% render 'section-heading-crs', heading: section.settings.heading, subheading: section.settings.subheading, align: 'left', on_dark: true, headline_md: true, extra_class: 'lt-dna-offer__header' %}
      <ul class="lt-dna-offer__rows" role="list">
        {%- for block in section.blocks -%}
          <li class="lt-dna-offer__row" {{ block.shopify_attributes }}>
            <span class="lt-dna-offer__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lt-dna-offer__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.value != blank -%}
              <span class="lt-dna-offer__value">{{ block.settings.value | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="lt-dna-offer__buy">
        <div class="lt-dna-offer__price-row">
          <span class="lt-dna-offer__price">{{ variant.price | money_without_trailing_zeros }}</span>
          {%- if section.settings.price_note != blank -%}
            <span class="lt-dna-offer__price-note">{{ section.settings.price_note | escape }}</span>
          {%- endif -%}
        </div>
        <a class="lt-dna-btn lt-dna-btn--inverted" href="{{ checkout_url }}" data-lt-dna-checkout>{{ section.settings.cta_label | escape }}</a>
        {%- if section.settings.guarantee != blank -%}
          <p class="lt-dna-offer__guarantee">{{ section.settings.guarantee | escape }}</p>
        {%- endif -%}
        {%- if section.settings.footnote != blank -%}
          <p class="lt-dna-offer__footnote">{{ section.settings.footnote | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.lt-dna-wrap { max-width: 72rem; margin: 0 auto; padding-left: var(--gutter-container, 20px); padding-right: var(--gutter-container, 20px); }
.lt-dna-offer { background: var(--color-surface-secondary); }
.lt-dna-offer__inner { padding-top: var(--space-8); padding-bottom: var(--space-8); }
.lt-dna-offer__card {
  max-width: 44rem;
  padding: var(--space-6) var(--space-5);
  border-radius: var(--radius-lg);
  background: var(--color-surface-dark);
  color: var(--color-paper);
}
.lt-dna-offer__header { margin-bottom: var(--space-5); }
.lt-dna-offer__rows { margin: 0; padding: 0; list-style: none; }
.lt-dna-offer__row {
  display: grid;
  grid-template-columns: 20px minmax(0, 1fr) auto;
  gap: var(--space-3);
  align-items: baseline;
  padding: var(--space-3) 0;
  border-top: 1px solid rgba(247, 247, 244, 0.16);
}
.lt-dna-offer__check { width: 20px; height: 20px; color: var(--color-teal); align-self: center; }
.lt-dna-offer__check svg { width: 20px; height: 20px; }
.lt-dna-offer__title { font-family: var(--font-body); font-size: var(--text-body); line-height: var(--leading-body); }
.lt-dna-offer__value { font-family: var(--font-body); font-size: var(--text-body-sm); color: var(--color-text-on-dark-muted); white-space: nowrap; }
.lt-dna-offer__buy { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid rgba(247, 247, 244, 0.16); }
.lt-dna-offer__price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-4); }
.lt-dna-offer__price { font-family: var(--font-heading); font-size: var(--text-display); font-weight: var(--weight-bold); line-height: 1; }
.lt-dna-offer__price-note { font-family: var(--font-body); font-size: var(--text-body-sm); color: var(--color-text-on-dark-muted); }
.lt-dna-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%; min-height: 52px; padding: 14px var(--space-6);
  border-radius: var(--radius-full);
  background: var(--color-cta-bg); color: var(--color-cta-text);
  font-family: var(--font-body); font-size: var(--text-body); font-weight: var(--weight-semibold);
  text-decoration: none; transition: opacity var(--ease-default);
}
.lt-dna-btn:hover { opacity: 0.92; }
.lt-dna-btn--inverted { background: var(--color-paper); color: var(--color-dark); }
.lt-dna-offer__guarantee { margin: var(--space-3) 0 0; font-family: var(--font-body); font-size: var(--text-body-sm); line-height: var(--leading-body); }
.lt-dna-offer__footnote { margin: var(--space-4) 0 0; font-family: var(--font-body); font-size: var(--text-body-sm); color: var(--color-text-on-dark-muted); }
@media screen and (min-width: 750px) {
  .lt-dna-offer__card { padding: var(--space-7); }
  .lt-dna-btn { width: auto; min-width: 18rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LT DNA-LP Offer",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Alles drin. Einmal zahlen." },
    { "type": "text", "id": "subheading", "label": "Subline" },
    { "type": "text", "id": "price_note", "label": "Zusatz neben dem Preis", "default": "einmalig, kein Abo" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Test bestellen" },
    { "type": "text", "id": "guarantee", "label": "Garantie unter dem Knopf" },
    { "type": "text", "id": "footnote", "label": "Fußnote (zweiter Kauf)" }
  ],
  "blocks": [
    { "type": "row", "name": "Zeile", "limit": 6, "settings": [
      { "type": "text", "id": "title", "label": "Was", "default": "Epigenetische Analyse, sechs Bereiche" },
      { "type": "text", "id": "value", "label": "Wert (nur echte Preise)", "default": "einzeln 299 €" }
    ] }
  ],
  "presets": [{ "name": "LT DNA-LP Offer" }]
}
{% endschema %}
