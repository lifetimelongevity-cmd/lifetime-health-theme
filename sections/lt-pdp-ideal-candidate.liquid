{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign ic_kicker = section.settings.kicker | strip
  assign ic_head   = section.settings.heading | strip
  assign ic_sub    = section.settings.subheading | strip
  if ic_kicker == '__none__'
    assign ic_kicker = ''
  endif
  if ic_sub == '__none__'
    assign ic_sub = ''
  endif
  assign crs_h_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  endif
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif
  assign ic_cand_heading = section.settings.candidate_heading | strip
  assign ic_excl_heading = section.settings.exclusion_heading | strip
  assign ic_has_exclusions = false
  assign ic_has_candidates = false
  for block in section.blocks
    if block.type == 'exclusion'
      assign ic_has_exclusions = true
    endif
    if block.type == 'candidate'
      assign ic_has_candidates = true
    endif
  endfor
  assign ic_show_exclusions = false
  if section.settings.show_exclusion_block and ic_has_exclusions
    assign ic_show_exclusions = true
  endif
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:       {{ section.settings.color_bg }};
    --crs-card-bg:  {{ section.settings.color_card_bg }};
    --crs-text:     {{ section.settings.color_text }};
    --crs-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --crs-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.66 }};
    {%- comment -%} 0.05 statt 0.08: gleiche Haarlinie wie .fg-card im Feature-Grid,
        sonst tragen die zwei Kartenarten der PDP unterschiedlich schwere Konturen. {%- endcomment -%}
    --crs-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.05 }};
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
    background:     var(--crs-bg);
  }
{% endstyle %}

<div class="ic-section" id="section-{{ section.id }}">
  <div class="ic-container">

    {%- if ic_kicker != blank or ic_head != blank or ic_sub != blank -%}
      <div class="ic-header crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
        {%- if ic_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ ic_kicker | escape }}</p>
        {%- endif -%}
        {%- if ic_head != blank or ic_sub != blank -%}
          <div class="crs-heading-stack__pair">
            {%- if ic_head != blank -%}
              <h2 class="crs-heading-stack__title">{{ ic_head | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if ic_sub != blank -%}
              <p class="crs-heading-stack__subtitle">{{ ic_sub | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Zwei Spalten statt Kartenraster plus Ausschluss-Kasten (2026-08-14).
        Passt und passt-nicht sind dieselbe Frage aus zwei Richtungen und gehoeren
        nebeneinander, damit der Leser sich in einem Blick einsortiert. Ohne Kaesten:
        die Unterscheidung traegt das Icon und die Spaltenueberschrift, nicht eine
        zweite graue Flaeche auf grauem Grund. {%- endcomment -%}
    <div class="ic-columns">
      {%- if ic_has_candidates -%}
        <div class="ic-col ic-col--candidate">
          {%- if ic_cand_heading != blank -%}
            <p class="ic-col-heading">{{ ic_cand_heading | escape }}</p>
          {%- endif -%}
          <ul class="ic-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'candidate' and block.settings.candidate_description != blank -%}
                <li class="ic-item" {{ block.shopify_attributes }}>
                  <span class="ic-item-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1" opacity="0.45"/>
                      <path d="M5.5 8.2l1.6 1.6 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.candidate_description | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if ic_show_exclusions -%}
        <div class="ic-col ic-col--exclusion">
          {%- if ic_excl_heading != blank -%}
            <p class="ic-col-heading">{{ ic_excl_heading | escape }}</p>
          {%- endif -%}
          <ul class="ic-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'exclusion' and block.settings.exclusion_text != blank -%}
                <li class="ic-item" {{ block.shopify_attributes }}>
                  <span class="ic-item-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1" opacity="0.45"/>
                      <path d="M5.6 8h4.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.exclusion_text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
/* ===================================================
   Ideal Candidate — lt-pdp-ideal-candidate.liquid
   =================================================== */

.ic-section {
  background: var(--crs-bg, #f2f1ed);
}

.ic-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

.ic-header {
  margin-bottom: var(--space-7, 48px);
}

/* Zwei Spalten: passt / passt nicht. Karten-Geometrie bewusst identisch zu
   .fg-card im Feature-Grid darueber (Radius 4px, Haarlinie, 10px Spaltenabstand),
   damit die PDP eine Kartensprache spricht und nicht zwei. */
.ic-columns {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  align-items: stretch;
}

@media (min-width: 768px) {
  .ic-columns {
    grid-template-columns: 1fr 1fr;
  }
}

.ic-col {
  box-sizing: border-box;
  min-width: 0;
  background: var(--crs-card-bg, #ffffff);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.08));
  border-radius: 4px;
  padding: 20px 22px 22px;
}

.ic-col-heading {
  font-size: 16px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--crs-text, #26251e);
  margin: 0 0 16px;
}

.ic-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ic-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.5;
  color: var(--crs-text-sec, rgba(38, 37, 30, 0.72));
}

/* Nur das Icon traegt die Farbe, nicht der Text: Gruen und Rot sollen die Zeile
   sortieren, nicht ihre Lesbarkeit gegen den Kartengrund senken. */
.ic-item-icon {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  margin-top: 3px;
}

.ic-col--candidate .ic-item-icon {
  color: var(--lt-success-text, #3b6d11);
}

.ic-col--exclusion .ic-item-icon {
  color: var(--lt-negative-text, #a33a2a);
}

@media (max-width: 767px) {
  .ic-col {
    padding: 16px 18px 18px;
  }
}
{% endstylesheet %}

