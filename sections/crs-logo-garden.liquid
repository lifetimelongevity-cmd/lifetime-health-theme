{%- liquid
  assign crs_h_align = section.settings.content_align | default: 'left'
  if crs_h_align != 'left' and crs_h_align != 'center' and crs_h_align != 'right'
    assign crs_h_align = 'left'
  endif
  assign crs_lg_kicker = section.settings.kicker | strip
  assign crs_lg_head = section.settings.heading | strip
  assign crs_lg_sub = section.settings.subheading | strip
  if crs_lg_kicker == '__none__'
    assign crs_lg_kicker = ''
  endif
  if crs_lg_sub == '__none__'
    assign crs_lg_sub = ''
  endif
  assign crs_h_headline_lg = false
  if section.settings.heading_size == 'product_title'
    assign crs_h_headline_lg = true
  endif
  assign crs_h_headline_md = false
  if section.settings.heading_size == 'feature'
    assign crs_h_headline_md = true
  endif
  # Presse-Leiste: die Logo-Reihe ist per Flex immer zentriert. Eine links-
  # buendige Headline kippt optisch dagegen. Opt-in, weil dieselbe Section
  # auf index.json, quiz-age, meine-routine und der AGE&DNA-PDP laeuft.
  assign crs_lg_center_desktop = section.settings.center_head_desktop
  # Die 4-up-Breitenformel gilt nur dort, wo auch wirklich ein Logo unter
  # Desktop wegfaellt. Ohne diese Klammer wuerde sie auf index.json,
  # quiz-age, meine-routine und der AGE&DNA-PDP die 5er-Reihe zwischen 481
  # und 532px von 3+2 auf 4+1 umbrechen, also genau auf die Waise, die sie
  # hier verhindern soll.
  assign crs_lg_four_up = false
  # Leiste: eine Zeile statt Kacheln, unter Desktop als ruhiger Ticker.
  # Default bleibt grid, damit Startseite-Altstaende, NMN-, Spermidin- und
  # Quiz-Templates unveraendert rendern; eingeschaltet nur per Template.
  assign crs_lg_layout = section.settings.layout | default: 'grid'
  for lg_block in section.blocks
    if lg_block.settings.hide_below_desktop
      assign crs_lg_four_up = true
    endif
  endfor
-%}
{% style %}
  #section-{{ section.id }} {
    --crs-bg:       {{ section.settings.color_bg }};
    --crs-card-bg:  {{ section.settings.color_card_bg }};
    --crs-text:     {{ section.settings.color_text }};
    --crs-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --crs-text-ter: {{ section.settings.color_text | color_modify: 'alpha', 0.66 }};
    --crs-border:   {{ section.settings.color_text | color_modify: 'alpha', 0.05 }};
    padding-top:    min({{ section.settings.padding_top }}px, 15vw);
    padding-bottom: min({{ section.settings.padding_bottom }}px, 15vw);
  }
{% endstyle %}

{%- if crs_lg_layout == 'strip' -%}
<div class="lg-section lg-section--strip" id="section-{{ section.id }}">
  <div class="lg-container lg-strip">
    {%- if crs_lg_head != blank -%}
      <p class="lg-strip__label">{{ crs_lg_head | escape }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="lg-strip__viewport">
        {%- comment -%}
          Zwei identische Saetze, translateX(-50%) = genau ein Satz: der Ticker
          laeuft nahtlos ohne JS. Der zweite Satz ist fuer Screenreader stumm
          und ab Desktop sowie bei reduzierter Bewegung ausgeblendet.
        {%- endcomment -%}
        <ul class="lg-strip__track" role="list" style="--lg-count: {{ section.blocks.size }}">
          {%- for n in (1..2) -%}
            {%- for block in section.blocks -%}
              <li class="lg-strip__item{% if n == 2 %} lg-strip__item--dup{% endif %}"{% if n == 2 %} aria-hidden="true"{% else %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.url != blank and n == 1 -%}
                  <a href="{{ block.settings.url }}" class="lg-strip__link" target="_blank" rel="noopener">
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {%- capture lg_logo_style -%}--lg-r: {{ block.settings.image.aspect_ratio | default: 3.5 }}{%- endcapture -%}
                  {%- capture lg_logo_class -%}lg-strip__logo{% if block.settings.keep_shading %} lg-strip__logo--shaded{% endif %}{%- endcapture -%}
                  {%- if n == 1 -%}
                    {%- assign lg_logo_alt = block.settings.alt | escape -%}
                  {%- else -%}
                    {%- assign lg_logo_alt = '' -%}
                  {%- endif -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 400',
                      sizes: '200px',
                      class: lg_logo_class,
                      style: lg_logo_style,
                      alt: lg_logo_alt
                  }}
                {%- else -%}
                  <span class="lg-logo-placeholder">{{ block.settings.alt | escape }}</span>
                {%- endif -%}
                {%- if block.settings.url != blank and n == 1 -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>
{%- else -%}
<div class="lg-section" id="section-{{ section.id }}">
  <div class="lg-container">

    {%- if crs_lg_kicker != blank or crs_lg_head != blank or crs_lg_sub != blank -%}
      <div class="lg-section-head{% if crs_lg_center_desktop %} lg-section-head--center-desktop{% endif %} crs-heading-stack crs-heading-stack--align-{{ crs_h_align }}{% if crs_h_headline_lg %} crs-heading-stack--headline-lg{% elsif crs_h_headline_md %} crs-heading-stack--headline-md{% endif %}">
        {%- if crs_lg_kicker != blank -%}
          <p class="crs-heading-stack__kicker">{{ crs_lg_kicker | escape }}</p>
        {%- endif -%}
        {%- if crs_lg_head != blank or crs_lg_sub != blank -%}
          <div class="crs-heading-stack__pair">
            {%- if crs_lg_head != blank -%}
              <h2 class="crs-heading-stack__title">{{ crs_lg_head | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if crs_lg_sub != blank -%}
              <p class="crs-heading-stack__subtitle">{{ crs_lg_sub | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="lg-grid{% if crs_lg_four_up %} lg-grid--four-up{% endif %}" role="list">
        {%- for block in section.blocks -%}
          <li class="lg-card{% if block.settings.hide_below_desktop %} lg-card--hide-below-desktop{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" class="lg-card-link" aria-label="{{ block.settings.alt | escape }}" target="_blank" rel="noopener">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  class: 'lg-logo',
                  alt: block.settings.alt | escape
              }}
            {%- else -%}
              <span class="lg-logo-placeholder">{{ block.settings.alt | escape }}</span>
            {%- endif -%}

            {%- if block.settings.url != blank -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% stylesheet %}
/* ===================================================
   Logo Garden — crs-logo-garden.liquid
   =================================================== */

.lg-section {
  background: var(--crs-bg, #f7f7f4);
}

.lg-container {
  max-width: var(--lt-page-max, 1280px);
  margin: 0 auto;
  padding: 0 var(--lt-page-gutter, 16px);
}

.lg-section-head {
  margin-bottom: var(--space-7);
}

/* Dokumentierte Ausnahme zur linksbuendigen Heading-Regel, nur fuer die
   Presse-Leiste: die Logo-Reihe ist ein zentrierter Flex-Block, gegen den eine
   linke Headline sichtbar kippt. 481px ist genau die Grenze, ab der die Logos
   diese zentrierte Reihe bilden — darunter fuellt das 2x2 die volle Breite und
   eine linke Headline steht richtig. (0,2,0) schlaegt crs-heading-stack--align-*
   (0,1,0) unabhaengig von der Reihenfolge der gebuendelten Stylesheets. */
@media (min-width: 481px) {
  .lg-section-head.lg-section-head--center-desktop {
    text-align: center;
    align-items: center;
  }
}

/* Logos — zentriert (flex), unabhängig von der Anzahl */
.lg-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: stretch;
  gap: var(--space-2);
  list-style: none;
  margin: 0;
  padding: 0;
}

/* Card */
.lg-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: min(11rem, 42vw);
  height: 4rem;
  background: var(--crs-card-bg, #f2f1ed);
  border: 1px solid var(--crs-border, rgba(38, 37, 30, 0.05));
  border-radius: 4px;
  overflow: hidden;
  transition: opacity 0.18s ease;
}

.lg-card:hover {
  opacity: .8;
}

.lg-card-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 12px 16px;
  text-decoration: none;
}

/* Logo image */
/* max-height war 28px bei opacity .65. Zusammen mit der fast identischen
   Karten- und Seitenflaeche waren SAT.1 und SWR1 praktisch unsichtbar.
   36px nutzt die Karteninnenhoehe aus (4rem minus 2x12px Padding), sodass
   quadratischere Logos nicht mehr gegen die schmalen Wortmarken abfallen. */
.lg-logo {
  max-width: 100%;
  max-height: 36px;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  filter: grayscale(1);
  opacity: .85;
  transition: opacity 0.18s ease, filter 0.18s ease;
}

.lg-card:hover .lg-logo {
  opacity: 1;
  filter: grayscale(.4);
}

/* Fallback text when no image */
.lg-logo-placeholder {
  font-size: .75rem;
  color: var(--crs-text-sec, rgba(38,37,30,0.6));
  text-align: center;
  padding: 8px;
  line-height: 1.3;
}

/* Einzelne Logos unter Desktop ausblenden. Fuenf Logos brechen im Tablet-
   Bereich zu 4+1 um, und ein einzelner Nachzuegler in Zeile zwei ist die
   unruhigste aller Varianten. Vier passen in eine Zeile, unter 480px in ein
   sauberes 2x2. */
@media (max-width: 900px) {
  .lg-card--hide-below-desktop {
    display: none;
  }
}

@media (max-width: 1024px) {
  .lg-card {
    width: min(10rem, 22vw);
    height: 4.5rem;
  }

  /* Nur fuer Leisten, die unter Desktop auf vier Logos gehen. 22vw rechnet
     gegen den Viewport und ignoriert das Container-Padding, dadurch brechen
     vier Karten unter 533px auf 3+1 um. calc(25% - gap) rechnet gegen die
     echte Zeilenbreite und passt immer. Ueber 600px liefern beide Formeln
     praktisch dieselben Werte, die Deckelung bei 10rem bleibt.
     (0,2,0) schlaegt .lg-card (0,1,0). */
  .lg-grid--four-up .lg-card {
    width: min(10rem, calc(25% - var(--space-2)));
  }
}

@media (max-width: 480px) {
  .lg-card {
    flex: 0 0 calc(50% - var(--space-2));
    width: calc(50% - var(--space-2));
    max-width: calc(50% - var(--space-2));
    height: 5rem;
  }

  .lg-logo {
    max-height: 32px;
  }
}

/* ===================================================
   Variante Leiste (layout: strip)
   Eine Zeile ohne Kacheln. Unter 1025px laeuft sie als ruhiger Ticker,
   darueber steht sie still, weil fuenf Logos plus Beschriftung dort in eine
   Zeile passen. Ausgemessen am 16.10.2026 fuer die AGE&DNA-PDP: die
   Kachel-Variante war mobil 416px hoch, die Leiste bleibt unter 150px.
   =================================================== */

.lg-section--strip {
  /* Logohoehe bei Seitenverhaeltnis 3,5:1. Breitere Wortmarken werden
     niedriger, kompaktere Bildmarken hoeher, damit alle optisch gleich
     schwer wirken (siehe .lg-strip__logo). */
  --lg-logo-h: 1.625rem;
}

.lg-strip {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
}

.lg-strip__label {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--crs-text-ter);
  white-space: nowrap;
}

.lg-strip__viewport {
  width: 100%;
  overflow: hidden;
  /* Weiche Kanten statt hartem Schnitt: der Ticker laeuft sichtbar weiter */
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
}

.lg-strip__track {
  display: flex;
  align-items: center;
  width: max-content;
  list-style: none;
  margin: 0;
  padding: 0;
  /* rund 7s je Logo, also etwa 20px pro Sekunde: ruhig genug zum Lesen */
  animation: lg-strip-scroll calc(var(--lg-count, 5) * 7s) linear infinite;
}

.lg-strip__viewport:hover .lg-strip__track {
  animation-play-state: paused;
}

@keyframes lg-strip-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* Gleiches Padding links und rechts: beide Saetze sind exakt gleich breit,
   sonst springt der Ticker am Ende jeder Runde. */
.lg-strip__item {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 0 var(--space-5);
}

.lg-strip__link {
  display: flex;
  align-items: center;
}

/* Einheitliche Tonfarbe: brightness(0) macht jede freigestellte Bildmarke
   zur Silhouette, die Deckkraft legt sie auf rund #454544 (Kontrast gut 9:1
   auf #f7f7f4). Vorher standen die Logos zwischen Luminanz 120 (KStA) und
   200 (SWR1), SWR1 war deshalb kaum lesbar.
   Hoehe: Wurzel-Ausgleich ueber das Seitenverhaeltnis (--lg-r aus Liquid),
   gedeckelt auf 70 bis 130 Prozent. Die erste Deklaration ist der Fallback
   fuer Browser ohne pow(). */
.lg-strip__logo {
  display: block;
  width: auto;
  max-width: none;
  height: var(--lg-logo-h);
  height: clamp(
    calc(var(--lg-logo-h) * 0.7),
    calc(var(--lg-logo-h) * pow(calc(3.5 / var(--lg-r, 3.5)), 0.35)),
    calc(var(--lg-logo-h) * 1.3)
  );
  filter: brightness(0);
  opacity: 0.7;
}

/* Fuer Logos mit hellen Innenflaechen (SAT.1-Ball): als Silhouette wuerden
   die weissen Streifen zur schwarzen Scheibe. Graustufen abgedunkelt treffen
   denselben Ton, die Flaechen bleiben lesbar. */
.lg-strip__logo--shaded {
  filter: grayscale(1) brightness(0.5);
  opacity: 1;
}

@media (min-width: 1025px) {
  .lg-section--strip {
    --lg-logo-h: 1.875rem;
  }

  .lg-strip {
    flex-direction: row;
    justify-content: center;
    gap: var(--space-5);
  }

  .lg-strip__viewport {
    width: auto;
    overflow: visible;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .lg-strip__track {
    animation: none;
  }

  .lg-strip__item--dup {
    display: none;
  }
}

/* Reduzierte Bewegung: kein Ticker, sondern eine Reihe zum Wischen */
@media (prefers-reduced-motion: reduce) {
  .lg-strip__track {
    animation: none;
  }

  .lg-strip__item--dup {
    display: none;
  }

  .lg-strip__viewport {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .lg-strip__viewport::-webkit-scrollbar {
    display: none;
  }

  .lg-strip__item {
    scroll-snap-align: start;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Logo Garden",
  "tag": "section",
  "class": "crs-logo-garden",
  "settings": [
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Darstellung",
      "options": [
        { "value": "grid", "label": "Kacheln" },
        { "value": "strip", "label": "Leiste (eine Zeile)" }
      ],
      "default": "grid",
      "info": "Leiste: ohne Kacheln, Logos in einem Ton, mobil als ruhiger Ticker. Die Überschrift wird zur kleinen Beschriftung, Kicker und Unterüberschrift entfallen."
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Seiten-Hintergrund",
      "default": "#f7f7f4"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Karten-Hintergrund",
      "default": "#f2f1ed"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe",
      "default": "#26251e"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Ausrichtung (Überschrift)",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Zentriert" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschrift Größe",
      "options": [
        { "value": "section", "label": "Standard (Abschnitt)" },
        { "value": "feature", "label": "Mittel (Section-Headline)" },
        { "value": "product_title", "label": "Wie Produkttitel" }
      ],
      "default": "section",
      "info": "Zeilenumbruch: Enter in Überschrift/Unterüberschrift."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor)"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unverzichtbar für tausende Teams"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Unterüberschrift (optional)",
      "default": "__none__",
      "info": "__none__ = ausblenden (Theme-Editor)"
    },
    {
      "type": "checkbox",
      "id": "center_head_desktop",
      "label": "Überschrift ab Desktop zentrieren",
      "default": false,
      "info": "Ausnahme für die Presse-Leiste: die Logo-Reihe ist immer zentriert. Mobil bleibt die Überschrift linksbündig."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo-Bild"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Markenname / Alt-Text",
          "default": "Markenname"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link (optional)"
        },
        {
          "type": "checkbox",
          "id": "hide_below_desktop",
          "label": "Unter Desktop ausblenden",
          "default": false,
          "info": "Für das fünfte Logo, damit im Tablet- und Mobilbereich vier Logos in einer Zeile stehen."
        },
        {
          "type": "checkbox",
          "id": "keep_shading",
          "label": "Helle Flächen behalten",
          "default": false,
          "info": "Nur Darstellung Leiste. Für Logos mit weißen Innenflächen (z. B. SAT.1), die als einfarbige Silhouette zur Scheibe würden."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Garden",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Sentry" } },
        { "type": "logo", "settings": { "alt": "Discord" } },
        { "type": "logo", "settings": { "alt": "Rippling" } },
        { "type": "logo", "settings": { "alt": "Sierra" } },
        { "type": "logo", "settings": { "alt": "Shopify" } },
        { "type": "logo", "settings": { "alt": "Datadog" } },
        { "type": "logo", "settings": { "alt": "Airtable" } },
        { "type": "logo", "settings": { "alt": "Samsara" } }
      ]
    }
  ]
}
{% endschema %}
