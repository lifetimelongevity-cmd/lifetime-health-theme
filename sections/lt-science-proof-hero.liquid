    {
      "type": "text",
      "id": "caption",
      "label": "Bildunterschrift",
      "info": "Ordnet den Screenshot ein. Ohne sie wirkt er dekorativ.",
      "default": "Genetische Marker in der LIFETIME-App, jeweils mit Referenz-ID zur öffentlichen NCBI-Datenbank."
    },
    { "type": "header", "content": "Farben und Abstände" },
    { "type": "color", "id": "color_bg", "label": "Hintergrund", "default": "#f7f7f4" },
    { "type": "color", "id": "color_panel", "label": "Bildfläche", "default": "#f2f1ed" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "default": 80 }
  ],
  "presets": [{ "name": "Science Proof Hero" }]
