{% comment %}
  LIFETIME — Wissenschaft · Kapitel 6 (Die Messlatte, Rubrik 04)
  ──────────────────────────────────────────────────────────────
  Vier Kriterien, an denen sich jeder Alterstest messen lassen muss, unserer
  eingeschlossen. Visueller Vertrag: docs/science-preview.html §6.

  Die Icons sind Inline-SVG im Section-Setting, monochrom über currentColor,
  ohne einen Farbwert im Markup. Muster übernommen aus lt-benefits, damit die
  Seite kein zweites Icon-System aufmacht.

  §12 Build Spec:
  - Surface:         Paper B
  - Dominant:        das Kartenraster
  - Heading size:    --text-h1 (headline_lg). Auf dieser Seite frei, weil
                     das Seiten-H1 auf --text-display sitzt (DESIGN.md: Display 48
                     fuer das Deckblatt, Headline 36 je Kapitel).
  - Content pattern: card-info 2×2, Icon 48px in getoenter Flaeche
  - CTA:             keine
  - Entfernt:        eine Zusammenfassungszeile pro Karte; der Abbinder unten
                     leistet das einmal fuer alle vier
  - Quality move:    die Nummer haengt als Zaehler am Titel statt in einer
                     eigenen Zeile, das spart eine Hierarchiestufe
{% endcomment %}

{%- liquid
  assign wl_anchor = section.settings.anchor_id
  if wl_anchor == blank
    assign wl_anchor = 'section-' | append: section.id
  endif

  assign wl_text = section.settings.color_text | default: '#26251e'
  assign wl_pad_t = section.settings.padding_top | default: 80
  assign wl_pad_b = section.settings.padding_bottom | default: 80
  assign wl_pad_t_m = wl_pad_t | times: 0.8 | round
  assign wl_pad_b_m = wl_pad_b | times: 0.8 | round
-%}

{{ 'lt-wissenschaft.css' | asset_url | stylesheet_tag }}

{% style %}
  #{{ wl_anchor }} {
    --ltw-bg:       {{ section.settings.color_bg | default: '#f2f1ed' }};
    --ltw-text:     {{ wl_text }};
    --ltw-text-sec: {{ wl_text | color_modify: 'alpha', 0.72 }};
    --ltw-text-ter: {{ wl_text | color_modify: 'alpha', 0.66 }};
    --ltw-hairline: {{ wl_text | color_modify: 'alpha', 0.12 }};
    --ltw-card:     {{ section.settings.color_card_bg | default: '#f7f7f4' }};
    --ltw-frame:    {{ section.settings.color_icon_bg | default: '#f2f1ed' }};
    --crs-text:     {{ wl_text }};
    --crs-text-sec: {{ wl_text | color_modify: 'alpha', 0.72 }};
    --crs-text-ter: {{ wl_text | color_modify: 'alpha', 0.66 }};
    padding-top:    {{ wl_pad_t }}px;
    padding-bottom: {{ wl_pad_b }}px;
    scroll-margin-top: 96px;
  }

  @media screen and (max-width: 767px) {
    #{{ wl_anchor }} {
      padding-top:    {{ wl_pad_t_m }}px;
      padding-bottom: {{ wl_pad_b_m }}px;
    }
  }
{% endstyle %}

<section id="{{ wl_anchor }}" class="ltw ltw-messlatte">
  <div class="ltw__container">
    {% render 'lt-wiss-rubric',
      number: section.settings.rubric_number,
      label: section.settings.rubric_label %}

    {% render 'section-heading-crs',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      align: 'left',
      heading_tag: 'h2',
      headline_lg: true,
      extra_class: 'ltw-heading'
    %}

    {%- if section.blocks.size > 0 -%}
      <div class="ltw-crit">
        {%- for block in section.blocks -%}
          <div class="ltw-crit__card" {{ block.shopify_attributes }}>
            <div class="ltw-crit__head">
              {%- if block.settings.icon != blank -%}
                <span class="ltw-crit__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="ltw-crit__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
            </div>
            {%- if block.settings.body != blank -%}
              <p class="ltw-crit__body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.closer != blank -%}
      <p class="ltw-closer">{{ section.settings.closer | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wissenschaft Messlatte",
  "tag": "section",
  "class": "lt-wiss-messlatte",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anker-ID", "info": "Ohne Wert bleibt die automatische ID." },

    { "type": "header", "content": "Kapitel-Rubrik" },
    { "type": "text", "id": "rubric_number", "label": "Kapitelziffer", "default": "04" },
    { "type": "text", "id": "rubric_label", "label": "Kapitelname", "default": "Die Messlatte" },

    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "heading", "label": "Überschrift", "default": "Woran du eine Messung erkennst, der du vertrauen kannst." },
    { "type": "textarea", "id": "subheading", "label": "Subline" },
    { "type": "textarea", "id": "closer", "label": "Abbinder", "default": "Diese vier Punkte kannst du an jeden Alterstest anlegen, auch an unseren." },

    { "type": "header", "content": "Farben und Abstände" },
    { "type": "color", "id": "color_bg", "label": "Hintergrund", "default": "#f2f1ed" },
    { "type": "color", "id": "color_card_bg", "label": "Kartenfläche", "default": "#f7f7f4" },
    { "type": "color", "id": "color_icon_bg", "label": "Icon-Fläche", "default": "#f2f1ed" },
    { "type": "color", "id": "color_text", "label": "Textfarbe", "default": "#26251e" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Kriterium",
      "settings": [
        { "type": "textarea", "id": "icon", "label": "Icon (Inline-SVG)", "info": "Nur Konturen, ohne Füllung und ohne Farbwert. Die Farbe kommt über currentColor.", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg>" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Wiederholbarkeit" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Kurzer erklärender Absatz." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Wissenschaft Messlatte" }]
}
{% endschema %}
