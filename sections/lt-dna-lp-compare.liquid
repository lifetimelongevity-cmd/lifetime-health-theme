{% comment %}
  lt-dna-lp-compare — „Was du woanders bekommst": Vergleich in drei Spalten für einen
  Markt der Stufe 4 (viele Anbieter, alle mit Mechanismus, Wettbewerb über das
  Angebot). Keine Anbieternamen (Anwalt), keine Labor- oder ISO-Achse (Fact Sheet,
  GEO-Gate), verglichen wird der Lieferumfang: Alterswert, Bereiche, DNA, Gespräch,
  Preis. Zahlen aus lifetime-produktdetails/hormozi/2026-09-22_offer-agedna.md § 13.
  Zellenwert „ja" und „nein" rendern als Haken und Kreuz, alles andere als Text.
  Gebaut 23.09.2026 nach Mark Builds Brands (Education-Block: Comparison).
  Surface: --color-paper. Dominantes Element: die LIFETIME-Spalte.
{% endcomment %}
<section class="lt-dna-cmp">
  <div class="lt-dna-cmp__inner lt-dna-wrap">
    {% render 'section-heading-crs', heading: section.settings.heading, subheading: section.settings.subheading, align: 'left', headline_md: true, extra_class: 'lt-dna-cmp__header' %}
    <div class="lt-dna-cmp__scroll">
      <table class="lt-dna-cmp__table">
        <thead>
          <tr>
            <th scope="col" class="lt-dna-cmp__th lt-dna-cmp__th--label"><span class="visually-hidden">Merkmal</span></th>
            <th scope="col" class="lt-dna-cmp__th">{{ section.settings.col_1 | escape }}</th>
            <th scope="col" class="lt-dna-cmp__th">{{ section.settings.col_2 | escape }}</th>
            <th scope="col" class="lt-dna-cmp__th lt-dna-cmp__th--us">{{ section.settings.col_3 | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="lt-dna-cmp__row" {{ block.shopify_attributes }}>
              <th scope="row" class="lt-dna-cmp__label">{{ block.settings.label | escape }}</th>
              {%- for i in (1..3) -%}
                {%- assign key = 'cell_' | append: i -%}
                {%- assign val = block.settings[key] | strip | downcase -%}
                <td class="lt-dna-cmp__cell{% if i == 3 %} lt-dna-cmp__cell--us{% endif %}">
                  {%- if val == 'ja' -%}
                    <span class="lt-dna-cmp__yes" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="visually-hidden">ja</span>
                  {%- elsif val == 'nein' -%}
                    <span class="lt-dna-cmp__no" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></span><span class="visually-hidden">nein</span>
                  {%- else -%}
                    {{ block.settings[key] | escape }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="lt-dna-cmp__note">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lt-dna-wrap { max-width: 72rem; margin: 0 auto; padding-left: var(--gutter-container, 20px); padding-right: var(--gutter-container, 20px); }
.lt-dna-cmp { background: var(--color-paper); color: var(--color-ink); }
.lt-dna-cmp__inner { padding-top: var(--space-8); padding-bottom: var(--space-8); }
.lt-dna-cmp__header { margin-bottom: var(--space-5); max-width: 40rem; }
.lt-dna-cmp__scroll { width: 100%; max-width: 100%; min-width: 0; }
.lt-dna-cmp__table {
  width: 100%;
  table-layout: fixed;
  border-collapse: separate;
  border-spacing: 0;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-body);
}
.lt-dna-cmp__th {
  padding: var(--space-3) var(--space-2);
  text-align: center;
  font-size: var(--text-micro);
  font-weight: var(--weight-semibold);
  color: var(--color-ink-muted);
  border-bottom: 1px solid var(--color-border-strong);
  vertical-align: bottom;
  overflow-wrap: anywhere;
}
.lt-dna-cmp__th--label { text-align: left; width: 34%; }
@media screen and (min-width: 750px) {
  .lt-dna-cmp__table { font-size: var(--text-body); }
  .lt-dna-cmp__th { font-size: var(--text-body-sm); padding: var(--space-3); }
  .lt-dna-cmp__th--label { width: 40%; }
}
.lt-dna-cmp__th--us {
  color: var(--color-cta-text);
  background: var(--color-surface-dark);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  border-bottom-color: var(--color-surface-dark);
}
.lt-dna-cmp__label {
  padding: var(--space-4) var(--space-2) var(--space-4) 0;
  text-align: left;
  font-weight: var(--weight-regular);
  color: var(--color-ink);
  border-bottom: 1px solid var(--color-border-default);
  overflow-wrap: anywhere;
}
.lt-dna-cmp__cell {
  padding: var(--space-4) var(--space-2);
  text-align: center;
  color: var(--color-ink-muted);
  border-bottom: 1px solid var(--color-border-default);
  overflow-wrap: anywhere;
}
.lt-dna-cmp__cell--us {
  color: var(--color-cta-text);
  background: var(--color-surface-dark);
  font-weight: var(--weight-semibold);
  border-bottom-color: rgba(255, 255, 255, 0.14);
}
.lt-dna-cmp__row:last-child .lt-dna-cmp__cell--us { border-radius: 0 0 var(--radius-md) var(--radius-md); border-bottom-color: var(--color-surface-dark); }
.lt-dna-cmp__yes, .lt-dna-cmp__no { display: inline-block; width: 22px; height: 22px; vertical-align: middle; }
.lt-dna-cmp__yes svg, .lt-dna-cmp__no svg { display: block; width: 100%; height: 100%; }
.lt-dna-cmp__yes { color: var(--color-teal-dark); }
.lt-dna-cmp__cell--us .lt-dna-cmp__yes { color: var(--color-teal); }
.lt-dna-cmp__no { color: var(--color-ink-muted); opacity: 0.6; }
.lt-dna-cmp__note {
  margin: var(--space-4) 0 0;
  max-width: 40rem;
  font-family: var(--font-body);
  font-size: var(--text-body-sm);
  line-height: var(--leading-body);
  color: var(--color-ink-muted);
}
{% endstylesheet %}

{% schema %}
{
  "name": "LT DNA-LP Vergleich",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Was du woanders bekommst." },
    { "type": "text", "id": "subheading", "label": "Subline", "default": "Den epigenetischen Wert allein gibt es günstiger. Zwei Analysen und ein Gespräch aus einer Probe nicht." },
    { "type": "text", "id": "col_1", "label": "Spalte 1", "default": "Test aus der Apotheke" },
    { "type": "text", "id": "col_2", "label": "Spalte 2", "default": "Epigenetik in der Praxis" },
    { "type": "text", "id": "col_3", "label": "Spalte 3 (wir)", "default": "LIFETIME AGE & DNA" },
    { "type": "textarea", "id": "footnote", "label": "Fußnote (Quelle, Stand)" }
  ],
  "blocks": [
    { "type": "row", "name": "Zeile", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "Merkmal", "default": "Biologisches Alter in Jahren" },
      { "type": "text", "id": "cell_1", "label": "Spalte 1 (ja, nein oder Text)", "default": "ja" },
      { "type": "text", "id": "cell_2", "label": "Spalte 2 (ja, nein oder Text)", "default": "ja" },
      { "type": "text", "id": "cell_3", "label": "Spalte 3 (ja, nein oder Text)", "default": "ja" }
    ] }
  ],
  "presets": [{ "name": "LT DNA-LP Vergleich" }]
}
{% endschema %}
