{% comment %}
  lt-science-bento — Wissenschafts-Bento-Grid
  ─────────────────────────────────────────────────────────
  §12 Build Spec:
  - Surface:         --color-surface-dark (#364F56) — direkte Fortsetzung von lt-hp-science,
                     sodass beide Sections visuell zusammenfließen
  - Dominant:        Variante 1 = Bento-Grid mit Statement, Foto und Facts
                     Variante 2 = Split-Bento mit Copy links und Bild rechts
  - Heading:         Kein klassischer Section-Header — die Flächen selbst tragen die Aussage
  - CTA:             In Split-Variante über zwei Buttons unterhalb der Copy
  - Removed:         Section-Header (kein Kicker/Heading nötig — Bento ist visuelles Element),
                     dekorative Icons, gleichförmige Karten
  - Inspiration:     timeline.com/science — Bento mit variierenden Kacheln + Mood-Foto
  - Image rule:      Mood-Foto: körpernahe Textur, verwackelt/körnig erlaubt
                     Kein Produktfoto, kein generisches Wellness-Bild
{% endcomment %}

{%- liquid
  assign layout_variant = section.settings.layout_variant | default: 'grid'
  assign bento_image_src = section.settings.mood_image | strip
  if bento_image_src contains 'shopify://shop_images/'
    assign bento_image_src = bento_image_src | remove: 'shopify://shop_images/' | file_url
  elsif bento_image_src != blank
    unless bento_image_src contains '://'
      assign bento_image_src = bento_image_src | file_url
    endunless
  endif
  assign primary_button_href = section.settings.primary_button_link | strip
  assign secondary_button_href = section.settings.secondary_button_link | strip
  assign has_primary_cta = false
  assign has_secondary_cta = false
  if section.settings.primary_button_label != blank
    assign has_primary_cta = true
  endif
  if section.settings.secondary_button_label != blank
    assign has_secondary_cta = true
  endif
  assign fact_count = 0
  for block in section.blocks
    if block.type == 'fact'
      assign fact_count = fact_count | plus: 1
    endif
  endfor
-%}

{% style %}
  #section-{{ section.id }} {
    --bento-bg: {{ section.settings.color_bg }};
    --bento-tile-bg: {{ section.settings.color_tile_bg }};
    --bento-text: {{ section.settings.color_text }};
    --bento-text-sec: {{ section.settings.color_text | color_modify: 'alpha', 0.72 }};
    --bento-border: {{ section.settings.color_text | color_modify: 'alpha', 0.12 }};
    --bento-border-strong: {{ section.settings.color_text | color_modify: 'alpha', 0.78 }};
    --bento-cpg-ink: {{ section.settings.cpg_ink | default: '#65c0b6' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="science-bento" id="section-{{ section.id }}">
  <div class="science-bento__container">
    {%- assign bento_image_alt = section.settings.mood_image_alt | default: '' -%}

    {%- if layout_variant == 'split' -%}
      <div class="science-bento__split">
        <div class="science-bento__tile science-bento__tile--statement science-bento__tile--split-copy">
          {%- if section.settings.statement_kicker != blank -%}
            <p class="science-bento__tile-kicker">{{ section.settings.statement_kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_value != blank -%}
            <p class="science-bento__statement-value">{{ section.settings.statement_value | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_text != blank -%}
            <p class="science-bento__statement">{{ section.settings.statement_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_sub != blank -%}
            <p class="science-bento__statement-sub">{{ section.settings.statement_sub | escape }}</p>
          {%- endif -%}

          {%- if has_primary_cta or has_secondary_cta -%}
            <div class="science-bento__actions">
              {%- if has_primary_cta -%}
                <a
                  href="{{ primary_button_href | default: '#' | escape }}"
                  class="button button--{{ section.settings.primary_button_style | default: 'solid' }} button--icon"
                >
                  <span aria-hidden="true" class="button__icon">
                    {%- render 'theme-symbols', icon: 'arrow-right' -%}
                  </span>
                  <span>{{ section.settings.primary_button_label | escape }}</span>
                </a>
              {%- endif -%}
              {%- if has_secondary_cta -%}
                <a
                  href="{{ secondary_button_href | default: '#' | escape }}"
                  class="button button--{{ section.settings.secondary_button_style | default: 'outline' }} button--icon"
                >
                  <span aria-hidden="true" class="button__icon">
                    {%- render 'theme-symbols', icon: 'arrow-right' -%}
                  </span>
                  <span>{{ section.settings.secondary_button_label | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="science-bento__tile science-bento__tile--photo science-bento__tile--split-photo">
          {%- if section.settings.photo_as_cpg -%}
            <div class="science-bento__cpg" data-bento-cpg data-cols="{{ section.settings.cpg_cols | default: 5 }}" data-rows="{{ section.settings.cpg_rows | default: 32 }}" role="img" aria-label="{{ bento_image_alt | escape }}">
              <div class="science-bento__cpg-grid" aria-hidden="true"></div>
            </div>
          {%- elsif bento_image_src != blank -%}
            <img
              src="{{ bento_image_src }}"
              alt="{{ bento_image_alt | escape }}"
              class="science-bento__photo"
              loading="lazy"
              width="800"
              height="900"
            >
          {%- else -%}
            <div class="science-bento__photo-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="science-bento__grid{% if fact_count >= 3 %} science-bento__grid--four{% endif %}">

        {%- comment -%}── Kachel A: Große Kernaussage ──{%- endcomment -%}
        <div class="science-bento__tile science-bento__tile--statement">
          {%- if section.settings.statement_kicker != blank -%}
            <p class="science-bento__tile-kicker">{{ section.settings.statement_kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_value != blank -%}
            <p class="science-bento__statement-value">{{ section.settings.statement_value | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_text != blank -%}
            <p class="science-bento__statement">{{ section.settings.statement_text | escape }}</p>
          {%- endif -%}
          {%- if section.settings.statement_sub != blank -%}
            <p class="science-bento__statement-sub">{{ section.settings.statement_sub | escape }}</p>
          {%- endif -%}
        </div>

        {%- comment -%}── Kachel B: Mood-Foto oder animiertes CpG-Feld ──{%- endcomment -%}
        <div class="science-bento__tile science-bento__tile--photo">
          {%- if section.settings.photo_as_cpg -%}
            <div class="science-bento__cpg" data-bento-cpg data-cols="{{ section.settings.cpg_cols | default: 5 }}" data-rows="{{ section.settings.cpg_rows | default: 32 }}" role="img" aria-label="{{ bento_image_alt | escape }}">
              <div class="science-bento__cpg-grid" aria-hidden="true"></div>
            </div>
          {%- elsif bento_image_src != blank -%}
            <img
              src="{{ bento_image_src }}"
              alt="{{ bento_image_alt | escape }}"
              class="science-bento__photo"
              loading="lazy"
              width="600"
              height="600"
            >
          {%- else -%}
            <div class="science-bento__photo-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>

        {%- comment -%}── Kacheln C–E: Kleine Fact-Kacheln (Blocks) ──{%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            <div class="science-bento__tile science-bento__tile--fact" {{ block.shopify_attributes }}>
              {%- if block.settings.fact_label != blank -%}
                <p class="science-bento__fact-label">{{ block.settings.fact_label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.fact_value != blank -%}
                <p class="science-bento__fact-value">{{ block.settings.fact_value | escape }}</p>
              {%- endif -%}
              {%- if block.settings.fact_desc != blank -%}
                <p class="science-bento__fact-desc">{{ block.settings.fact_desc | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  function build(el) {
    if (el.dataset.bentoCpgReady) return;
    el.dataset.bentoCpgReady = '1';
    var grid = el.querySelector('.science-bento__cpg-grid');
    if (!grid) return;
    var cols = parseInt(el.dataset.cols, 10) || 5;
    // Zeilen aus der echten Kachelhoehe ableiten, damit das Feld auf jedem
    // Geraet fuellt statt ueberzulaufen. Fallback auf data-rows, falls die
    // Kachel (noch) keine Hoehe hat.
    var rowPx = 16;
    var avail = el.getBoundingClientRect().height - 44;
    var rows = avail > rowPx
      ? Math.max(12, Math.round(avail / rowPx))
      : (parseInt(el.dataset.rows, 10) || 30);
    var n = cols * rows;
    grid.style.gridTemplateColumns = 'repeat(' + cols + ', 1fr)';
    var frag = document.createDocumentFragment();
    for (var i = 0; i < n; i++) {
      var s = document.createElement('span');
      s.className = 'science-bento__cpg-id';
      var d = '';
      for (var j = 0; j < 8; j++) { d += Math.floor(Math.random() * 10); }
      s.textContent = 'cg' + d;
      var lo = 0.06 + Math.random() * 0.08;
      var hi = lo + 0.12 + Math.random() * 0.22;
      s.style.setProperty('--lo', lo.toFixed(3));
      s.style.setProperty('--hi', hi.toFixed(3));
      s.style.setProperty('--dur', (4 + Math.random() * 6).toFixed(2) + 's');
      s.style.setProperty('--del', (-Math.random() * 8).toFixed(2) + 's');
      if (Math.random() < 0.06) { s.classList.add('science-bento__cpg-id--flare'); }
      frag.appendChild(s);
    }
    grid.appendChild(frag);
  }
  function init(root) {
    (root || document).querySelectorAll('[data-bento-cpg]').forEach(build);
  }
  if (document.readyState !== 'loading') { init(); }
  else { document.addEventListener('DOMContentLoaded', function () { init(); }); }
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
</script>

{% stylesheet %}
  .science-bento {
    background: var(--bento-bg, #364f56);
  }

  .science-bento__container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .science-bento__split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: stretch;
  }

  .science-bento__split > .science-bento__tile--statement,
  .science-bento__split > .science-bento__tile--photo {
    grid-column: auto;
    grid-row: auto;
  }

  /* ─── BENTO GRID ─── */
  /*
    Desktop: 3 Spalten × 2 Zeilen
    Zeile 1: [Statement — 2 Spalten] [Foto — 1 Spalte, 2 Zeilen]
    Zeile 2: [Fact 1] [Fact 2] (Foto geht durch)
    Mit 3 Facts: links vier gleichwertige Karten im 2-mal-2-Raster
  */
  .science-bento__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-3);
  }

  /* Kachel A: Statement — 2 Spalten breit */
  .science-bento__tile--statement {
    grid-column: span 2;
  }

  .science-bento__grid--four .science-bento__tile--statement {
    grid-column: span 1;
    padding: var(--space-6);
  }

  .science-bento__grid--four .science-bento__statement-value {
    margin: 0;
  }

  .science-bento__grid--four .science-bento__statement {
    margin-block-start: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--bento-text-sec);
  }

  /* Kachel B: Foto — 1 Spalte, 2 Zeilen hoch */
  .science-bento__tile--photo {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  /* ─── TILE BASE ─── */
  .science-bento__tile {
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 200px;
  }

  /* ─── STATEMENT TILE ─── */
  .science-bento__tile--statement {
    background: var(--bento-tile-bg, rgba(255, 255, 255, 0.07));
    border: 1px solid var(--bento-border, rgba(255, 255, 255, 0.12));
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0;
  }

  .science-bento__tile--split-copy {
    justify-content: center;
    min-height: clamp(26rem, 42vw, 32rem);
  }

  .science-bento__tile-kicker {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bento-text-sec);
  }

  .science-bento__statement-value {
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--bento-text);
  }

  .science-bento__statement {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    color: var(--bento-text);
  }

  .science-bento__statement-sub {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    color: var(--bento-text-sec);
  }

  .science-bento__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .science-bento__actions .button {
    margin: 0;
  }

  .science-bento__actions .button--solid {
    background: var(--bento-text);
    border-color: var(--bento-text);
    color: var(--bento-bg);
  }

  .science-bento__actions .button--solid span {
    color: var(--bento-bg);
  }

  .science-bento__actions .button--solid .button__icon svg path {
    fill: var(--bento-bg);
  }

  .science-bento__actions .button--outline {
    background: transparent;
    border-color: var(--bento-border-strong);
    color: var(--bento-text);
  }

  .science-bento__actions .button--outline span {
    color: var(--bento-text);
  }

  .science-bento__actions .button--outline .button__icon svg path {
    fill: var(--bento-text);
  }

  .no-touchevents .science-bento__actions .button--solid:hover {
    background: var(--bento-text);
    border-color: var(--bento-text);
    color: var(--bento-bg);
  }

  .no-touchevents .science-bento__actions .button--solid:hover span {
    color: var(--bento-bg);
  }

  .no-touchevents .science-bento__actions .button--solid:hover .button__icon svg path {
    fill: var(--bento-bg);
  }

  .no-touchevents .science-bento__actions .button--outline:hover {
    border-color: var(--bento-text);
    color: var(--bento-text);
  }

  .no-touchevents .science-bento__actions .button--outline:hover span {
    color: var(--bento-text);
  }

  .no-touchevents .science-bento__actions .button--outline:hover .button__icon svg path {
    fill: var(--bento-text);
  }

  /* ─── FOTO TILE ─── */
  .science-bento__tile--photo {
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--bento-border, rgba(255, 255, 255, 0.12));
  }

  .science-bento__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Kein Filter — Mood-Bilder leben von ihrer Atmosphäre */
  }

  .science-bento__photo-placeholder {
    width: 100%;
    height: 100%;
    min-height: 360px;
    background: rgba(255, 255, 255, 0.03);
  }

  .science-bento__tile--split-photo {
    min-height: clamp(26rem, 42vw, 32rem);
  }

  /* ─── CpG-FELD (ersetzt optional das Foto) ───
     Feld aus Methylierungs-IDs, im Browser erzeugt, dezent flackernd.
     Fuellt die Foto-Kachel; Rand weicher als die Mitte. */
  .science-bento__cpg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .science-bento__cpg-grid {
    position: absolute;
    inset: 0;
    padding: var(--space-5) var(--space-3);
    display: grid;
    gap: 2px var(--space-3);
    align-content: space-between;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--bento-cpg-ink, #65c0b6);
    -webkit-mask-image: radial-gradient(130% 100% at 50% 45%, #000 52%, transparent 100%);
            mask-image: radial-gradient(130% 100% at 50% 45%, #000 52%, transparent 100%);
  }

  .science-bento__cpg-id {
    text-align: center;
    opacity: 0.2;
    animation: bento-cpg-twinkle var(--dur, 6s) ease-in-out var(--del, 0s) infinite;
    will-change: opacity;
  }

  .science-bento__cpg-id--flare {
    color: color-mix(in srgb, var(--bento-cpg-ink, #65c0b6) 55%, #ffffff);
  }

  @keyframes bento-cpg-twinkle {
    0%, 100% { opacity: var(--lo, 0.1); }
    50%      { opacity: var(--hi, 0.32); }
  }

  @media (prefers-reduced-motion: reduce) {
    .science-bento__cpg-id { animation: none; opacity: 0.2; }
  }

  /* ─── FACT TILES ─── */
  .science-bento__tile--fact {
    background: var(--bento-tile-bg, rgba(255, 255, 255, 0.07));
    border: 1px solid var(--bento-border, rgba(255, 255, 255, 0.12));
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    min-height: 180px;
  }

  .science-bento__fact-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-micro);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bento-text-sec);
  }

  .science-bento__fact-value {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--bento-text);
  }

  .science-bento__fact-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--bento-text-sec);
  }

  /* ─── RESPONSIVE ─── */
  @media screen and (max-width: 1024px) {
    .science-bento__split {
      grid-template-columns: 1fr;
    }

    .science-bento__tile--split-copy,
    .science-bento__tile--split-photo {
      min-height: 24rem;
    }

    /* Tablet: 2 Spalten, Foto oben rechts, Facts darunter */
    .science-bento__grid {
      grid-template-columns: 1fr 1fr;
    }

    .science-bento__tile--statement {
      grid-column: 1;
      grid-row: 1;
    }

    .science-bento__tile--photo {
      grid-column: 2;
      grid-row: 1;
    }

    .science-bento__tile--fact {
      grid-column: span 1;
    }
  }

  @media screen and (max-width: 767px) {
    .science-bento__container {
      padding-inline: var(--space-4);
    }

    .science-bento__split {
      gap: var(--space-2);
    }

    .science-bento__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .science-bento__tile--statement {
      grid-column: 1;
      grid-row: auto;
      min-height: 180px;
      padding: var(--space-6);
    }

    .science-bento__tile--split-copy,
    .science-bento__tile--split-photo {
      min-height: 18rem;
    }

    .science-bento__tile--photo {
      grid-column: 1;
      grid-row: auto;
      min-height: 260px;
    }

    .science-bento__tile--fact {
      min-height: 140px;
      padding: var(--space-5);
    }

    .science-bento__statement {
      font-size: var(--text-body-lg);
    }

    .science-bento__statement-sub {
      font-size: var(--text-body-lg);
    }

    .science-bento__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Science Bento",
  "tag": "section",
  "class": "lt-science-bento",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Variante",
      "options": [
        { "value": "grid", "label": "Bento Grid" },
        { "value": "split", "label": "Split mit Bild rechts" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Hintergrund",
      "default": "#364f56"
    },
    {
      "type": "color",
      "id": "color_tile_bg",
      "label": "Kachel-Hintergrund (rgba wird intern gesetzt)",
      "default": "#2d4249"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textfarbe (Basis für Transparenzen)",
      "default": "#f7f7f4"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "0 = direkt an lt-hp-science anschließen (gleiche Farbe)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Kachel A — Statement"
    },
    {
      "type": "text",
      "id": "statement_kicker",
      "label": "Kicker (optional)",
      "default": "LIFETIME Grundlage"
    },
