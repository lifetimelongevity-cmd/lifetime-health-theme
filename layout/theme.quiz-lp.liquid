<!doctype html>
  <html id="html" class="no-js" lang="{{ request.locale.iso_code }}" dir="{%- render 'lang-dir' -%}">
  <head>

    {%- comment -%}
      theme.quiz-lp — Landingpage-Layout für /pages/quiz-age (2026-08-08).

      Zweck: Paid-Traffic-LP ohne Navigations-Leaks (Best-Practice-Abgleich
      lifetime-klaviyo/best-practices-highticket-funnel-2026_2026-08-08.md §3,
      BJ-Entscheid 08.08.: erst ohne Header live, dann gegen Header testen).

      Basis ist layout/theme.liquid, Stand 08.08., mit GENAU drei Abweichungen:
        1. {%- sections 'header-group' -%} ersetzt durch die schlanke Topbar unten
           (Logo, unverlinkt + Loox-Rating wie im Announcement-Bar).
        2. {%- sections 'footer-group' -%} und die drei Popup-Sections ersetzt
           durch den Legal-Mini-Footer (Impressumspflicht: shop.policies-Loop).
        3. Body-Klasse lt-quiz-lp-body ergänzt.
      Alles andere (Assets, KROWN, Cart-/Search-Sidebar, Scripts) ist bewusst
      identisch, damit die Sections der Quiz-Seite exakt wie unter theme.liquid
      rendern. Wenn theme.liquid sich strukturell ändert, hier nachziehen.
    {%- endcomment -%}

    <!-- Google Consent Mode V2 Consentmo -->
{% render 'gcm-integration-script' %}

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">

    {%- render 'favicon' -%}

    {%- comment -%}
      Titel-Budget, identisch zu layout/theme.liquid: kurze Marke, und nur wenn
      der Titel darunter unter 60 Zeichen bleibt. Laengere Titel bekommen keine,
      weil Google von hinten kuerzt und die Marke dann ohnehin wegfaellt.
    {%- endcomment -%}
    {%- capture seo_title -%}
      {{- page_title -}}
      {%- unless page_title contains 'LIFETIME' -%}
        {%- assign seo_title_length = page_title | size | plus: 11 -%}
        {%- if seo_title_length <= 60 %} | LIFETIME{% endif -%}
      {%- endunless -%}
    {%- endcapture -%}

    <title>{{ seo_title }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      render 'open-graph'
      unless settings.disable_microdata
        render 'microdata-schema'
      endunless
    -%}

    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://cdn.shopify.com">
    {%- unless settings.headings_font.system? and settings.body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- render 'head-variables' -%}
    {%- render 'head-preloader' -%}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'crs-section-headings.css' | asset_url | stylesheet_tag }}
    {{ 'lt-pdp.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'lt-quote-carousel.js' | asset_url }}" defer></script>

    {{ content_for_header }}

    <script>

      /* js helpers */
      const debounce = (fn, wait) => {
        let t;
        return (...args) => {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(this, args), wait);
        };
      }
      window.KEYCODES = {
        TAB: 9,
        ESC: 27,
        DOWN: 40,
        RIGHT: 39,
        UP: 38,
        LEFT: 37,
        RETURN: 13
      };

      /* background image sizes */
      const rbi = [];
      const rbiSetSize = (img) => {
        if ( img.offsetWidth / img.dataset.ratio < img.offsetHeight ) {
          img.setAttribute('sizes', `${Math.ceil(img.offsetHeight * img.dataset.ratio)}px`);
        } else {
          img.setAttribute('sizes', `${Math.ceil(img.offsetWidth)}px`);
        }
      }
      window.addEventListener('resize', debounce(()=>{
        for ( let img of rbi ) {
          rbiSetSize(img);
        }
      }, 250));

      /* lazy looad images reveal effect */
      const imageReveal = new IntersectionObserver((entries, observer)=>{
        entries.forEach(entry=>{
          if ( entry.isIntersecting ) {
            setTimeout(()=>{
              entry.target.classList.remove('lazy-image--to-reveal');
            }, 500);
            entry.target.classList.add('lazy-image--revealed');
            observer.unobserve(entry.target);
          }
        });
      }, {rootMargin: '20px 0px 0px 0px'});

    </script>

    <noscript>
      <link rel="stylesheet" href="{{ 'theme-noscript.css' | asset_url }}">
    </noscript>

    <!-- Google Tag Manager -->
